        i += 1
    print "dequantize_q3_k: OK (first 40/256 values match real GGUF data)"

    # --- IQ4_NL: first two blocks of blk.0.ffn_gate.weight, real Q2_K-preset
    # file (first 8 of block 0, first 8 of block 1) ---
    let iq4nl_bytes = [0x06 as uint8, 0x8B as uint8, 0x7D as uint8, 0x04 as uint8, 0xB9 as uint8, 0xC3 as uint8, 0x16 as uint8, 0x63 as uint8, 0x54 as uint8, 0x49 as uint8, 0x9B as uint8, 0xB8 as uint8, 0x66 as uint8, 0x84 as uint8, 0xE4 as uint8, 0x6A as uint8, 0xC5 as uint8, 0xB2 as uint8, 0x7C as uint8, 0x8D as uint8, 0x86 as uint8, 0x67 as uint8, 0xD9 as uint8, 0x50 as uint8, 0x83 as uint8, 0xAB as uint8, 0x44 as uint8, 0xA4 as uint8, 0x48 as uint8, 0x9A as uint8, 0xD5 as uint8, 0xA6 as uint8, 0x8A as uint8, 0x42 as uint8, 0xA8 as uint8, 0xAB as uint8]
    let iq4nl_expected_first8 = [-0.014789, 0.010503, -0.002786, 0.013932, 0.004715, 0.013932, 0.010503, -0.002786]
    let iq4nl_expected_second8 = [0.007364, 0.003347, -0.004352, 0.042512, 0.021758, -0.012720, 0.016402, 0.016402]
    let iq4nl_out = dequantize_iq4_nl(iq4nl_bytes, 0, 64)
    assert_eq(iq4nl_out.length, 64)
    i = 0
    while i < 8:
        assert_close(iq4nl_out[i], iq4nl_expected_first8[i] as float32, "iq4_nl[{i}]")
        assert_close(iq4nl_out[32 + i], iq4nl_expected_second8[i] as float32, "iq4_nl[{32 + i}]")
        i += 1
    print "dequantize_iq4_nl: OK (first 8/32 of 2 real blocks match real GGUF data)"

    print "test_quant_kquant: all assertions passed"
