# Compiled disk-I/O test for standard multi-file GGUF discovery and lazy tensor
# reads. The tiny shards are generated by tools/make_test_gguf.py with the
# official Python gguf writer; no model inference or GPU dispatch is involved.

use gguf
use gguf_file
use io
use model
use prompt_cache

def main() throws:
    # Starting from the second shard must discover the complete set too.
    let file = parse_gguf_path("test/fixtures/tiny-split-00002-of-00002.gguf")
    assert_eq(file.shard_paths.length, 2)
    assert_eq(file.tensors.length, 2)
    let first_size = file_len(file.shard_paths[0])
    assert_eq(file.file_size, first_size + file_len(file.shard_paths[1]))
    let crossing = file_bytes(file, first_size - 4, 8)
    mut [uint8] expected_crossing = []
    for byte in read_at(file.shard_paths[0], first_size - 4, 4):
        expected_crossing.push(byte)
    for byte in read_at(file.shard_paths[1], 0, 4):
        expected_crossing.push(byte)
    assert_eq(crossing, expected_crossing)
    assert(model_fingerprint(file, 1, 2) != 0, "split model fingerprint should span shard boundaries")
    let first = load_tensor_f32(file, "weight.0")
    let second = load_tensor_f32(file, "weight.1")
    assert_eq(first, [1.0 as float32, 2.0 as float32, 3.0 as float32, 4.0 as float32, 5.0 as float32, 6.0 as float32])
    assert_eq(second, [11.0 as float32, 12.0 as float32, 13.0 as float32, 14.0 as float32, 15.0 as float32, 16.0 as float32])
    print "test_gguf_split_real: all assertions passed"
