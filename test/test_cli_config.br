use cli_config
use model

def main() throws:
    assert_eq(parse_cache_type_arg("cache", " F32 "), "f32" as string)
    assert_eq(parse_flash_attention_arg("flash", "ON"), "on" as string)
    assert_eq(parse_flash_attention_arg("flash", " auto "), "auto" as string)
    assert_eq(parse_gpu_layers_arg("layers", "auto"), -1 as int)
    assert_eq(parse_gpu_layers_arg("layers", "ALL"), -1 as int)
    assert_eq(parse_gpu_layers_arg("layers", "99"), 99 as int)
    validate_gpu_layers(-1, 40)
    validate_gpu_layers(40, 40)
    validate_gpu_layers(99, 40)
    assert_eq(effective_prefill_chunk(2048, 512), 512 as int)
    assert_eq(effective_prefill_chunk(256, 512), 256 as int)
    assert_eq(effective_prefill_chunk(2048, 1024), 1024 as int)
    assert_eq(parse_split_mode_arg("split", " NONE "), "none" as string)
    assert_eq(parse_main_gpu_arg("gpu", "0"), 0 as int)
    assert_eq(parse_thread_count_arg("threads", "-1"), -1 as int)
    assert_eq(parse_thread_count_arg("threads", "1"), 1 as int)
    assert_eq(parse_thread_count_arg("threads", "8"), 8 as int)
    assert_eq(parse_bounded_int_arg("priority", "-1", -1, 3), -1 as int)
    assert_eq(parse_bounded_int_arg("priority", "3", -1, 3), 3 as int)
    assert_eq(parse_bounded_int_arg("poll", "0", 0, 100), 0 as int)
    assert_eq(parse_bounded_int_arg("poll", "100", 0, 100), 100 as int)
    assert_eq(parse_cpu_mask_arg("mask", "ff00"), "ff00" as string)
    assert_eq(parse_cpu_mask_arg("mask", "0x01AF"), "0x01AF" as string)
    assert_eq(parse_cpu_range_arg("range", "0-7"), "0-7" as string)
    assert_eq(parse_cpu_range_arg("range", " 4-4 "), "4-4" as string)
    assert_eq(prefill_chunk_len(), 512 as int)
    set_prefill_chunk_len(256)
    assert_eq(prefill_chunk_len(), 256 as int)
    set_prefill_chunk_len(512)
    print "test_cli_config: all assertions passed"
