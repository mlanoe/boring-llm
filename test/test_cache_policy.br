# Interpreter-speed unit tests for src/cache_policy.br: when the on-disk prompt
# cache is written, where, what it drops to stay inside its size cap, and when a
# request starts from it.

use cache_policy

# `n` token ids starting at `base`: two lists with different bases share no prefix.
[int] toks(int base, int n):
    mut [int] out = []
    var int i = 0
    while i < n:
        out.push(base + i)
        i += 1
    out

# The same ids as `a`, cut to `n` tokens, then `extra` more different ones.
[int] branch([int] a, int n, int extra):
    mut [int] out = []
    var int i = 0
    while i < n:
        out.push(a[i])
        i += 1
    var int j = 0
    while j < extra:
        out.push(900000 + j)
        j += 1
    out

def main():
    # restore only when the disk covers clearly more than memory does
    assert(restore_from_disk(0, 0, 5000), "empty memory, big snapshot: restore")
    assert(not restore_from_disk(5000, 0, 5200), "a gain under 256 tokens is not worth the read")
    assert(restore_from_disk(5000, 1, 5256), "a gain of 256 tokens is")
    assert(not restore_from_disk(0, -1, 0), "no snapshot, nothing to restore")

    assert(resolve_context_keep(-1, 5) == 5, "n_keep -1 retains the complete initial prompt")
    assert(resolve_context_keep(2, 5) == 2, "an explicit n_keep is unchanged")

    let no_shift = plan_context_shift(7, 8, 0, 0)
    assert(no_shift.keep == 0 and no_shift.discard == 0, "a context with free space is not shifted")
    let half = plan_context_shift(8, 8, 2, 0)
    assert(half.keep == 2 and half.discard == 3, "default shift drops half the movable context")
    let explicit = plan_context_shift(12, 8, 2, 2)
    assert(explicit.keep == 2 and explicit.discard == 5, "explicit discard grows enough to leave one free position")
    let capped_keep = plan_context_shift(8, 8, 99, 0)
    assert(capped_keep.keep == 7 and capped_keep.discard == 1, "keep leaves one position for generation")
    let discard_all_movable = plan_context_shift(8, 8, 6, 99)
    assert(discard_all_movable.keep == 6 and discard_all_movable.discard == 2, "discard is capped to the movable suffix")
    let shifted = apply_context_shift([0, 1, 2, 3, 4, 5, 6, 7], ContextShiftPlan(2, 3))
    assert(shifted == [0, 1, 5, 6, 7], "shift retains the requested prefix and newest suffix")

    # Exhaust the small state space: every required shift must free at least
    # one position, preserve the exact prefix and suffix, and never retain
    # more than n_ctx - 1 tokens before the next decoded token is appended.
    var int checked_shifts = 0
    var int small_ctx = 2
    while small_ctx <= 12:
        var int n_tokens = small_ctx
        while n_tokens <= small_ctx * 2:
            let source = toks(1000, n_tokens)
            var int requested_keep = 0
            while requested_keep <= n_tokens + 2:
                for requested_discard in [0, 1, small_ctx / 2, small_ctx, n_tokens + 3]:
                    let plan = plan_context_shift(n_tokens, small_ctx, requested_keep, requested_discard)
                    let retained = apply_context_shift(source, plan)
                    assert(plan.keep >= 0 and plan.keep < small_ctx, "shift keep is bounded by context")
                    assert(plan.discard >= 1 and plan.discard <= n_tokens - plan.keep, "shift discard is bounded by movable tokens")
                    assert(retained.length == n_tokens - plan.discard, "shift removes exactly discard tokens")
                    assert(retained.length <= small_ctx - 1, "shift leaves a position for the next token")
                    var int prefix_i = 0
                    while prefix_i < plan.keep:
                        assert(retained[prefix_i] == source[prefix_i], "shift preserves prefix token identity")
                        prefix_i += 1
                    var int suffix_i = plan.keep
                    while suffix_i < retained.length:
                        assert(retained[suffix_i] == source[suffix_i + plan.discard], "shift preserves suffix token identity")
                        suffix_i += 1
                    checked_shifts += 1
                requested_keep += 1
            n_tokens += 1
        small_ctx += 1
    assert(checked_shifts > 2000, "context shift policy received broad exhaustive coverage")

    # Simulate a reply much longer than its context. Each shift rebuilds the
    # logical sequence before the next generated token is appended, exactly as
    # server.br does around the real KV cache. The retained prefix stays fixed,
    # generated tokens remain ordered, and repeated shifts never overfill the
    # context.
    let rolling_ctx = 8
    let rolling_keep = 2
    var mut [int] rolling = [10, 11, 12, 13, 14, 15, 16, 17]
    var int next_token = 100
    var int shift_count = 0
    while next_token < 200:
        if rolling.length >= rolling_ctx:
            let before = rolling.clone()
            let plan = plan_context_shift(rolling.length, rolling_ctx, rolling_keep, 0)
            rolling = apply_context_shift(rolling, plan)
            assert(rolling[0] == 10 and rolling[1] == 11, "repeated shifts preserve the fixed prefix")
            var int retained_i = rolling_keep
            while retained_i < rolling.length:
                assert(rolling[retained_i] == before[retained_i + plan.discard], "repeated shifts preserve suffix order")
                retained_i += 1
            shift_count += 1
        rolling.push(next_token)
        assert(rolling.length <= rolling_ctx, "repeated shifts keep generation inside the context")
        next_token += 1
    assert(shift_count > 20, "long generation exercises repeated context shifts")
    assert(rolling[rolling.length - 1] == 199, "long generation retains the newest token")

    let a = toks(1, 3000)
    let none = plan_save([], toks(1, 1000), 2, 100, 0)
    assert(not none.save, "under 1024 tokens is never written")
    let first = plan_save([], a, 2, 100, 0)
    assert(first.save and first.slot == 0 and first.seq == 1 and first.drop.length == 0, "first snapshot: file 0, seq 1")

    # a longer prompt that extends the saved one replaces it, once it adds 1024 tokens
    let disk1 = [DiskSnap(0, 1, a)]
    let grown = toks(1, 3500)
    assert(not plan_save(disk1, grown, 2, 100, 0).save, "500 new tokens: not yet")
    let grown2 = toks(1, 4100)
    let rep = plan_save(disk1, grown2, 2, 100, 0)
    assert(rep.save and rep.slot == 0 and rep.seq == 2, "extending a snapshot replaces its file")
    assert(not plan_save(disk1, a, 2, 100, 0).save, "an identical cache adds nothing")

    # an unrelated prompt takes the free file, then (files full) the oldest
    let b = toks(50000, 3000)
    let other = plan_save(disk1, b, 2, 100, 0)
    assert(other.save and other.slot == 1 and other.seq == 2, "unrelated prompt: free file 1")
    let disk2 = [DiskSnap(0, 1, a), DiskSnap(1, 2, b)]
    let c = toks(80000, 3000)
    let evict = plan_save(disk2, c, 2, 100, 0)
    assert(evict.save and evict.slot == 0 and evict.seq == 3, "files full: the oldest (file 0) is overwritten")
    let disk2b = [DiskSnap(0, 5, a), DiskSnap(1, 2, b)]
    assert(plan_save(disk2b, c, 2, 100, 0).slot == 1, "the oldest is by seq, not by file number")

    # a branch that diverges from a saved snapshot does not replace it
    let fork = branch(a, 1500, 1600)
    let forked = plan_save(disk1, fork, 2, 100, 0)
    assert(forked.save and forked.slot == 1, "diverging branch keeps the old snapshot and takes a free file")

    # size cap: 100 bytes per token, snapshots of 3000 tokens = 300000 bytes
    assert(not plan_save([], a, 2, 100, 200000).save, "a snapshot over the cap alone is not written")
    let capped = plan_save(disk2, c, 2, 100, 700000)
    assert(capped.save and capped.drop.length == 0, "three of 3000 tokens would be 900000: file 0 is overwritten, 600000 fit")
    let tight = plan_save(disk2, c, 3, 100, 700000)
    assert(tight.save and tight.slot == 2 and tight.drop.length == 1 and tight.drop[0] == 0, "free file, but the cap drops the oldest")
    let tighter = plan_save(disk2, c, 3, 100, 400000)
    assert(tighter.save and tighter.drop.length == 2, "a cap of 400000 drops both older snapshots")
    assert(plan_save(disk2, c, 3, 100, 0).drop.length == 0, "no cap, nothing dropped")

    print "test_cache_policy: all assertions passed"
