    assert(metrics.contains("llamacpp:tokens_predicted_total 30"), "metrics decode counter")
    assert(metrics.contains("llamacpp:n_tokens_max 150"), "metrics high watermark")
    assert(metrics.contains("llamacpp:n_decode_total 37"), "metrics decode call counter")
    assert(metrics.contains("llamacpp:n_busy_slots_per_decode 1"), "serialized busy slot average")
