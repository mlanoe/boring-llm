# Interpreter-speed unit tests for src/openai.br (no GGUF, no socket). A
# literal `{`/`}` in a Boring string is written doubled (`{{`/`}}`).

use jinja
use json
use openai

# The part of `text` stream_bounds says is safe to send, as a string.
string view_of(string text, [string] stops):
    let (vs, vl) = stream_bounds(text, stops)
    let cs = text.chars()
    var string out = ""
    var int i = vs
    while i < vl:
        out = "{out}{cs[i]}"
        i += 1
    out

# Feeds `full` one character at a time (as generation would), cutting stop
# strings like the server does, and returns the final emitted view. Asserts
# the invariant streaming relies on: each view extends the previous one.
string stream_all(string full, [string] stops):
    var string prev = ""
    var string p = ""
    for ch in full.chars():
        p = "{p}{ch}"
        let (cut, hit) = apply_stop(p, stops)
        let v = view_of(cut, stops)
        assert(v.startsWith(prev), "view must extend the previous one: '{prev}' then '{v}' at '{p}'")
        prev = v
        if hit:
            return prev
    prev

def main() throws:
    assert(unix_timestamp() > 1700000000, "Unix timestamp uses the wall clock")
    let (indent_ok, indent_ok_hit) = apply_min_indent("first\n    nested", 4)
    assert_eq(indent_ok, "first\n    nested" as string)
    assert_eq(indent_ok_hit, false)
    let (indent_cut, indent_cut_hit) = apply_min_indent("first\n  dedented", 4)
    assert_eq(indent_cut, "first\n  " as string)
    assert_eq(indent_cut_hit, true)
    let (first_line, first_line_hit) = apply_min_indent("unindented", 4)
    assert_eq(first_line, "unindented" as string)
    assert_eq(first_line_hit, false)
    assert_eq(sse_ping_due(30, 1000, 30999), false)
    assert_eq(sse_ping_due(30, 1000, 31000), true)
    assert_eq(sse_ping_due(-1, 0, 999999), false)
    assert_eq(sse_ping_due(0, 100, 100), true)
    assert_eq(reasoning_format_for_request(json_parse("{{}}"), "deepseek-legacy", true), "deepseek-legacy" as string)
    assert_eq(reasoning_format_for_request(json_parse("{{\"reasoning_format\": \"none\"}}"), "deepseek", true), "none" as string)
    assert_eq(reasoning_format_for_request(json_parse("{{\"reasoning_format\": \"deepseek\"}}"), "auto", false), "none" as string)
    # ── normalize_messages: parts flattened, tool_call arguments parsed ──
    let msgs = json_parse("[{{\"role\": \"developer\", \"content\": \"code carefully\"}}, {{\"role\": \"user\", \"content\": [{{\"type\": \"text\", \"text\": \"a\"}}, {{\"type\": \"text\", \"text\": \"b\"}}]}}, {{\"role\": \"assistant\", \"content\": null, \"tool_calls\": [{{\"id\": \"c1\", \"type\": \"function\", \"function\": {{\"name\": \"get_weather\", \"arguments\": \"{{\\\"city\\\": \\\"Paris\\\"}}\"}}}}]}}, {{\"role\": \"tool\", \"tool_call_id\": \"c1\", \"content\": \"sunny\"}}]")
    mut [JValue] msg_items = []
    match msgs:
        JList(items):
            for it in items:
                msg_items.push(it)
        _:
            throw "expected a list"
    let norm = normalize_messages(msg_items)
    assert_eq(json_get_str(norm[0], "role", ""), "system" as string)
    assert_eq(norm.length, 4 as int)
    assert_eq(jv_to_json(norm[1]), "{{\"role\": \"user\", \"content\": \"ab\"}}" as string)
    assert_eq(jv_to_json(norm[2]), "{{\"role\": \"assistant\", \"content\": \"\", \"tool_calls\": [{{\"id\": \"c1\", \"type\": \"function\", \"function\": {{\"name\": \"get_weather\", \"arguments\": {{\"city\": \"Paris\"}}}}}}]}}" as string)
    assert_eq(jv_to_json(norm[3]), "{{\"role\": \"tool\", \"tool_call_id\": \"c1\", \"content\": \"sunny\"}}" as string)

    # ── request shape validation keeps malformed input out of Jinja ──
    assert_eq(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": \"hi\"}}]}}")), "" as string)
    assert(request_shape_error(json_parse("{{}}")) != "", "messages required")
    assert(request_shape_error(json_parse("{{\"messages\": []}}")) != "", "messages non-empty")
    assert(request_shape_error(json_parse("{{\"messages\": [3]}}")) != "", "message object")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"content\": \"x\"}}]}}")) != "", "role required")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"function\", \"content\": \"x\"}}]}}")) != "", "unsupported role")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": [{{\"type\": \"image_url\", \"image_url\": {{\"url\": \"x\"}}}}]}}]}}")) != "", "multimodal rejected")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": 3}}]}}")) != "", "content type")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": \"x\"}}], \"tools\": {{}}}}")) != "", "tools array")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": \"x\"}}], \"tools\": [{{\"type\": \"function\", \"function\": {{\"name\": \"\"}}}}]}}")) != "", "tool name")
    assert_eq(tool_schema_validation_error(json_parse("{{\"type\": \"object\", \"properties\": {{\"x\": {{\"type\": [\"string\", \"null\"]}}}}, \"required\": [\"x\"], \"additionalProperties\": false}}")), "" as string)
    assert(tool_schema_validation_error(json_parse("{{\"type\": \"date\"}}")) != "", "unsupported schema type")
    assert(tool_schema_validation_error(json_parse("{{\"required\": \"x\"}}")) != "", "required array")
    assert(tool_schema_validation_error(json_parse("{{\"additionalProperties\": \"no\"}}")) != "", "additionalProperties shape")
    assert(tool_schema_validation_error(json_parse("{{\"anyOf\": []}}")) != "", "composition non-empty")
    assert_eq(tool_schema_validation_error(json_parse("{{\"properties\": {{\"x\": false}}}}")), "" as string)
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": \"x\"}}], \"tools\": [{{\"type\": \"function\", \"function\": {{\"name\": \"bad\", \"parameters\": {{\"required\": \"x\"}}}}}}]}}")) != "", "malformed tool schema")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"assistant\", \"content\": null, \"tool_calls\": [{{\"type\": \"custom\", \"function\": {{\"name\": \"x\", \"arguments\": \"{{}}\"}}}}]}}]}}")) != "", "tool-call type")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"tool\", \"content\": \"ok\"}}]}}")) != "", "tool result id")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": \"x\", \"tool_calls\": []}}]}}")) != "", "tool calls only on assistant")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"assistant\", \"content\": null, \"tool_calls\": []}}]}}")) != "", "tool calls non-empty")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"assistant\", \"content\": null, \"tool_calls\": [{{\"type\": \"function\", \"function\": {{\"name\": \"x\", \"arguments\": \"{{}}\"}}}}]}}]}}")) != "", "tool call id")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"assistant\", \"content\": null, \"tool_calls\": [{{\"id\": \"same\", \"type\": \"function\", \"function\": {{\"name\": \"a\", \"arguments\": \"{{}}\"}}}}, {{\"id\": \"same\", \"type\": \"function\", \"function\": {{\"name\": \"b\", \"arguments\": \"{{}}\"}}}}]}}]}}")) != "", "unique tool call ids")
    assert(request_shape_error(json_parse("{{\"messages\": [{{\"role\": \"user\", \"content\": \"x\"}}], \"tools\": [{{\"type\": \"function\", \"function\": {{\"name\": \"same\"}}}}, {{\"type\": \"function\", \"function\": {{\"name\": \"same\"}}}}]}}")) != "", "unique tool names")

    # ── parse_reply ──
    let r0 = parse_reply("  just text  ")
    assert_eq(r0.content, "just text" as string)
    assert_eq(r0.calls.length, 0 as int)

    let r1 = parse_reply("Let me check.\n<tool_call>\n{{\"name\": \"get_weather\", \"arguments\": {{\"city\": \"Paris\", \"days\": 3}}}}\n</tool_call>")
    assert_eq(r1.content, "Let me check." as string)
    assert_eq(r1.calls.length, 1 as int)
    assert_eq(r1.calls[0].name, "get_weather" as string)
    assert_eq(r1.calls[0].arguments, "{{\"city\": \"Paris\", \"days\": 3}}" as string)

    let r2 = parse_reply("<tool_call>\n{{\"name\": \"a\", \"arguments\": {{}}}}\n</tool_call>\n<tool_call>\n{{\"name\": \"b\", \"arguments\": \"raw\"}}\n</tool_call>")
    assert_eq(r2.content, "" as string)
    assert_eq(r2.calls.length, 2 as int)
    assert_eq(r2.calls[0].arguments, "{{}}" as string)
    assert_eq(r2.calls[1].name, "b" as string)
    assert_eq(r2.calls[1].arguments, "raw" as string)

    # Malformed / truncated blocks stay in the content instead of vanishing.
    let r3 = parse_reply("x <tool_call>\n{{\"name\": \"a\", \"argum")
    assert_eq(r3.calls.length, 0 as int)
    assert_eq(r3.content.contains("<tool_call>"), true as bool)

    # Qwen2.5's template teaches a doubled-brace format; a model copying it is
    # still parsed (one brace stripped per end), nested `}}` left intact.
    let rd = parse_reply("<tool_call>\n{{{{\"name\": \"get_weather\", \"arguments\": {{\"city\": \"Paris\"}}}}}}\n</tool_call>")
    assert_eq(rd.calls.length, 1 as int)
    assert_eq(rd.calls[0].name, "get_weather" as string)
    assert_eq(rd.calls[0].arguments, "{{\"city\": \"Paris\"}}" as string)
    let rn = parse_reply("<tool_call>\n{{\"name\": \"f\", \"arguments\": {{\"a\": {{\"b\": 1}}}}}}\n</tool_call>")
    assert_eq(rn.calls[0].arguments, "{{\"a\": {{\"b\": 1}}}}" as string)

    # ── apply_stop ──
    let (s1, st1) = apply_stop("hello END world", ["END"])
    assert_eq(s1, "hello " as string)
    assert_eq(st1, true as bool)
    let (s2, st2) = apply_stop("hello world", ["END", ""])
    assert_eq(s2, "hello world" as string)
    assert_eq(st2, false as bool)
    let (s3, st3) = apply_stop("a b c", ["c", "b"])
    assert_eq(s3, "a " as string)
    assert_eq(st3, true as bool)
    let (s4, st4, word4) = apply_stop_with_word("a b c", ["c", "b"])
    assert_eq(s4, "a " as string)
    assert_eq(st4, true as bool)
    assert_eq(word4, "b" as string)
    let (s5, st5, word5) = apply_stop_with_word("abc", ["bc", "ab"])
    assert_eq(s5, "" as string)
    assert_eq(st5, true as bool)
    assert_eq(word5, "ab" as string)
    assert_eq(native_stopping_word("word", "STOP"), "STOP" as string)
    assert_eq(native_stopping_word("limit", "STOP"), "" as string)
    assert_eq(native_stopping_word("eos", "STOP"), "" as string)
    assert_eq(native_context_truncated(15, 4, 20, false), false)
    assert_eq(native_context_truncated(15, 5, 20, false), true)
    assert_eq(native_context_truncated(15, 5, 20, true), false)
    assert_eq(native_truncated_status(15, 30, 20, false, true, true), true)
    assert_eq(native_truncated_status(15, 5, 20, false, true, false), false)
    assert_eq(native_truncated_status(15, 5, 20, false, false, false), true)
    assert_eq(listen_address("127.0.0.1", 8080), "127.0.0.1:8080" as string)
    assert_eq(listen_address("localhost", 8080), "localhost:8080" as string)
    assert_eq(listen_address("::1", 8080), "[::1]:8080" as string)
    assert_eq(listen_address("[::1]", 8080), "[::1]:8080" as string)
    let auth_headers = "Host: localhost\r\naUtHoRiZaTiOn: Bearer Key:With:Colons\r\nX-aPi-KeY: anthropic-key\r\nContent-Length: 0\r\n"
    assert_eq(http_header_value(auth_headers, "Authorization"), "Bearer Key:With:Colons" as string)
    assert_eq(http_header_value(auth_headers, "x-api-key"), "anthropic-key" as string)
    assert_eq(http_header_value(auth_headers, "missing"), "" as string)
    assert_eq(cors_allow_origin("*", "https://client.test", true), "https://client.test" as string)
    assert_eq(cors_allow_origin("*", "https://client.test", false), "*" as string)
    assert_eq(cors_allow_origin("https://a.test, https://b.test", "https://b.test", true), "https://b.test" as string)
    assert_eq(cors_allow_origin("https://a.test", "https://b.test", true), "" as string)
    assert_eq(cors_allow_origin("localhost", "http://localhost:3000", true), "http://localhost:3000" as string)
    assert_eq(cors_allow_origin("localhost", "http://localhost.evil", true), "" as string)
    assert_eq(api_keys_from_file_text("# comment\n first \n\nKey:With:Colons\r\n"), ["first", "Key:With:Colons"] as [string])
    assert(api_key_authorized([], "", ""), "authentication is disabled without configured keys")
    assert(api_key_authorized(["first", "Key:With:Colons"], "Bearer Key:With:Colons", ""), "one of several Bearer keys")
    assert(api_key_authorized(["first", "second"], "bEaReR first", ""), "Bearer scheme is case-insensitive")
    assert(api_key_authorized(["first", "anthropic-key"], "", "anthropic-key"), "Anthropic x-api-key is accepted")
    assert(api_key_authorized(["first", "anthropic-key"], "Basic wrong", "anthropic-key"), "a valid x-api-key takes priority over unrelated authorization")
    assert(not api_key_authorized(["first", "second"], "Bearer FIRST", ""), "API keys are case-sensitive")
    assert(not api_key_authorized(["first", "second"], "Basic first", ""), "Bearer or x-api-key authentication is required")
    assert(not api_key_authorized(["first", "second"], "", "FIRST"), "x-api-key values are case-sensitive")
    assert(api_key_public_path("/health"), "health is public")
    assert(api_key_public_path("/v1/models"), "model listing is public like llama-server")
    assert(not api_key_public_path("/props"), "props requires authentication")
    assert_eq(generation_route_kind("POST", "/v1/messages"), 1 as int)
    assert_eq(generation_route_kind("POST", "/v1/chat/completions"), 2 as int)
    assert_eq(generation_route_kind("POST", "/chat/completions"), 2 as int)
    assert_eq(generation_route_kind("POST", "/v1/completions"), 3 as int)
    assert_eq(generation_route_kind("POST", "/completion"), 4 as int)
    assert_eq(generation_route_kind("POST", "/completions"), 4 as int)
    assert_eq(generation_route_kind("POST", "/v1/responses"), 5 as int)
    assert_eq(generation_route_kind("POST", "/responses"), 5 as int)
    assert_eq(generation_route_kind("GET", "/v1/responses"), 0 as int)
    assert_eq(generation_route_kind("POST", "/v1/messages/count_tokens"), 0 as int)
    assert_eq(unsupported_model_endpoint("POST", "/embedding"), "embeddings" as string)
    assert_eq(unsupported_model_endpoint("POST", "/reranking"), "reranking" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/audio/transcriptions"), "audio transcriptions" as string)
    assert_eq(unsupported_model_endpoint("POST", "/audio/transcriptions"), "audio transcriptions" as string)
    assert_eq(unsupported_model_endpoint("POST", "/tts"), "text-to-speech" as string)
    assert_eq(unsupported_model_endpoint("POST", "/infill"), "infill" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/systemone"), "decision models" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/chat/completions/control"), "in-flight completion control" as string)
    assert_eq(unsupported_model_endpoint("GET", "/v1/realtime"), "Realtime API" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/realtime"), "Realtime API" as string)
    assert_eq(unsupported_model_endpoint("GET", "/v1/stream"), "resumable streams" as string)
    assert_eq(unsupported_model_endpoint("DELETE", "/v1/stream"), "resumable streams" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/streams/lookup"), "resumable stream lookup" as string)
    assert_eq(unsupported_model_endpoint("POST", "/predict"), "Vertex AI prediction" as string)
    assert_eq(unsupported_model_endpoint("GET", "/predict"), "" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/stream"), "" as string)
    assert_eq(unsupported_model_endpoint("GET", "/tts"), "" as string)
    assert_eq(unsupported_model_endpoint("POST", "/v1/chat/completions"), "" as string)
    assert(feature_disabled_endpoint("GET", "/tools"), "server tools GET is disabled")
    assert(feature_disabled_endpoint("POST", "/tools"), "server tools POST is disabled")
    assert(feature_disabled_endpoint("GET", "/cors-proxy"), "MCP CORS proxy GET is disabled")
    assert(feature_disabled_endpoint("POST", "/cors-proxy"), "MCP CORS proxy POST is disabled")
    assert(not feature_disabled_endpoint("DELETE", "/cors-proxy"), "only registered proxy methods are classified")
    assert(not feature_disabled_endpoint("GET", "/v1/models"), "ordinary routes are not disabled features")
    assert_eq(unsupported_router_endpoint("POST", "/models"), "dynamic model routing" as string)
    assert_eq(unsupported_router_endpoint("POST", "/models/load"), "dynamic model routing" as string)
    assert_eq(unsupported_router_endpoint("POST", "/models/unload"), "dynamic model routing" as string)
    assert_eq(unsupported_router_endpoint("GET", "/models/sse"), "model router events" as string)
    assert_eq(unsupported_router_endpoint("HEAD", "/models/sse"), "model router events" as string)
    assert_eq(unsupported_router_endpoint("DELETE", "/models"), "model cache deletion" as string)
    assert_eq(unsupported_router_endpoint("GET", "/models"), "" as string)
    assert(anthropic_api_path("/v1/messages"), "Anthropic generation route")
    assert(anthropic_api_path("/v1/messages/count_tokens"), "Anthropic token-counting route")
    assert(not anthropic_api_path("/v1/chat/completions"), "OpenAI chat route is not Anthropic")
    assert_eq(http_request_path("/slots/2?action=save&x=1"), "/slots/2" as string)
    assert_eq(http_query_value("/slots/2?action=save&x=1", "action"), "save" as string)
    assert_eq(http_query_value("/slots/2?x=1&action=restore", "action"), "restore" as string)
    assert_eq(http_query_value("/slots/2?action=save-extra", "action"), "save-extra" as string)
    assert_eq(http_query_value("/slots/2", "action"), "" as string)
    assert_eq(strip_api_prefix("/v1/models", ""), "/v1/models" as string)
    assert_eq(strip_api_prefix("/llm/v1/models", "/llm"), "/v1/models" as string)
    assert_eq(strip_api_prefix("/llm", "/llm"), "/" as string)
    assert_eq(strip_api_prefix("/llama/v1/models", "/llm"), "" as string)
    assert_eq(api_prefix_validation_error("/llm"), "" as string)
    assert(api_prefix_validation_error("llm") != "", "prefix starts with slash")
    assert(api_prefix_validation_error("/llm/") != "", "prefix has no trailing slash")
    assert_eq(model_alias_list("primary, second/name", "fallback"), ["primary", "second/name"] as [string])
    assert_eq(model_alias_list("", "fallback"), ["fallback"] as [string])
    assert_eq(url_path_segment("second/name"), "second%2Fname" as string)
    assert_eq(url_path_segment("café"), "caf%C3%A9" as string)
    assert(model_alias_path_matches(["primary", "second/name"], "/v1/models/second%2Fname"), "encoded alias path")
    assert(not model_alias_path_matches(["primary"], "/v1/models/other"), "unknown alias path")

    # ── completion_json is valid JSON with the right fields ──
    let plain = completion_json("7", "m\"1", ParsedReply("hi \"there\"\nbye", []), "stop", 10, 3, 4, 123)
    let pj = json_parse(plain)
    assert_eq(json_get_str(pj, "id", ""), "chatcmpl-7" as string)
    assert_eq(json_get_str(pj, "model", ""), "m\"1" as string)
    let choice = json_get_list(pj, "choices")[0]
    assert_eq(json_get_str(choice, "finish_reason", ""), "stop" as string)
    assert_eq(json_get_str(json_get(choice, "message"), "content", ""), "hi \"there\"\nbye" as string)
    assert_eq(json_get_int(json_get(pj, "usage"), "total_tokens", 0), 13 as int)
    assert_eq(json_get_int(json_get(json_get(pj, "usage"), "prompt_tokens_details"), "cached_tokens", -1), 4 as int)

    let with_calls = completion_json("8", "m", r1, "tool_calls", 5, 6, 0, 123)
    let cj = json_parse(with_calls)
    let cmsg = json_get(json_get_list(cj, "choices")[0], "message")
    let tc = json_get_list(cmsg, "tool_calls")
    assert_eq(tc.length, 1 as int)
    assert_eq(json_get_str(json_get(tc[0], "function"), "name", ""), "get_weather" as string)
    # arguments is a JSON *string* that itself parses back to the object
    let args_back = json_parse(json_get_str(json_get(tc[0], "function"), "arguments", ""))
    assert_eq(json_get_int(args_back, "days", 0), 3 as int)

    let only_calls = completion_json("9", "m", ParsedReply("", r1.calls), "tool_calls", 1, 1, 0, 123)
    assert_eq(only_calls.contains("\"content\": null"), true as bool)

    # ── SSE: every event is `data: <json>` ending in [DONE]; deltas rebuild the reply ──
    let sse = completion_sse("3", "m", r1, "tool_calls", 5, 6, 2, true, 123)
    let events = sse.split("\n\n")
    # role, content, tool_calls, finish, usage, [DONE], trailing ""
    assert_eq(events.length, 7 as int)
    assert_eq(events[5], "data: [DONE]" as string)
    let first = json_parse(events[0].replace("data: ", ""))
    assert_eq(json_get_str(json_get(json_get_list(first, "choices")[0], "delta"), "role", ""), "assistant" as string)
    let fin = json_parse(events[3].replace("data: ", ""))
    assert_eq(json_get_str(json_get_list(fin, "choices")[0], "finish_reason", ""), "tool_calls" as string)
    let usage_evt = json_parse(events[4].replace("data: ", ""))
    assert_eq(json_get_list(usage_evt, "choices").length, 0 as int)
    assert_eq(json_get_int(json_get(usage_evt, "usage"), "completion_tokens", 0), 6 as int)
    assert_eq(json_get_int(json_get(json_get(usage_evt, "usage"), "prompt_tokens_details"), "cached_tokens", -1), 2 as int)
    let timed_usage_evt = json_parse(sse_usage_event_timed("3", "m", 5, 6, 2, 123, 30, 20).split("data: ")[1].trim())
    assert_eq(json_get_int(json_get(timed_usage_evt, "timings"), "cache_n", -1), 2 as int)
    assert_eq(json_get_int(json_get(timed_usage_evt, "timings"), "prompt_n", -1), 3 as int)
    let nousage = completion_sse("3", "m", ParsedReply("x", []), "stop", 1, 1, 0, false, 123)
    assert_eq(nousage.contains("usage"), false as bool)

    assert_eq(common_prefix_len([1, 2, 3], [1, 2, 3, 4]), 3 as int)
    assert_eq(common_prefix_len([1, 2, 3, 4], [1, 2, 9, 4]), 2 as int)
    assert_eq(common_prefix_len([5], [6]), 0 as int)
    assert_eq(common_prefix_len([], [1]), 0 as int)

    let (bi, bl) = best_prefix_slot([[1, 2, 3], [1, 2, 3, 4, 5], [9]], [1, 2, 3, 4, 7])
    assert_eq(bi, 1 as int)
    assert_eq(bl, 4 as int)
    let (ni, nl) = best_prefix_slot([[7, 8]], [1, 2])
    assert_eq(ni, -1 as int)
    assert_eq(nl, 0 as int)
    let (ei, el) = best_prefix_slot([], [1])
    assert_eq(ei, -1 as int)

    # --- stream_bounds ---
    let (s1, l1) = stream_bounds("  hi there  ", [])
    assert_eq(s1, 2 as int)
    assert_eq(l1, 10 as int)
    assert_eq(view_of("Hello <to", []), "Hello" as string)
    assert_eq(view_of("Hello <tool_call", []), "Hello" as string)
    assert_eq(view_of("Hello <tool_call>\n{{\"name\": \"f\"", []), "Hello" as string)
    assert_eq(view_of("abc EN", ["END"]), "abc" as string)
    assert_eq(view_of("a <b", []), "a <b" as string)
    assert_eq(view_of("   ", []), "" as string)
    assert_eq(view_of("", []), "" as string)
    assert_eq(view_of("x\n\n", []), "x" as string)

    let tc_text = "  Let me check.\n<tool_call>\n{{\"name\": \"f\", \"arguments\": {{}}}}\n</tool_call>"
    assert_eq(stream_all(tc_text, []), parse_reply(tc_text).content)
    assert_eq(stream_all("Hello world, how are you?", []), "Hello world, how are you?" as string)
    assert_eq(stream_all("Hello world, how are you?", ["how"]), "Hello world," as string)
    assert_eq(stream_all("one two END three", ["END"]), "one two" as string)
    assert_eq(stream_all("a <b> c < d <tool", []), "a <b> c < d" as string)
    assert_eq(stream_all("  \n lead", []), "lead" as string)

    # a malformed tool call stays in content for parse_reply: the stream emits
    # the part before the marker, the server sends the rest at the end
    let bad = "text <tool_call>not json</tool_call>"
    assert_eq(view_of(bad, []), "text" as string)
    assert(parse_reply(bad).content.startsWith("text"), "parse_reply keeps the malformed call in content")

    # --- SSE event builders compose to completion_sse ---
    let ev = "{sse_role_event("7", "m", 123)}{sse_content_event("7", "m", "hi", 123)}{sse_finish_event("7", "m", "stop", 123)}{sse_done_event()}"
    assert_eq(ev, completion_sse("7", "m", ParsedReply("hi", []), "stop", 1, 1, 0, false, 123))

    # extra leading brace, object closed once (seen from Qwen2.5-0.5B under OpenCode)
    let lead = parse_reply("<tool_call>\n{{\"name\": \"webfetch\", \"arguments\": {{\"url\": \"https://x.com\", \"format\": \"text\"}}}}\n</tool_call>")
    assert_eq(lead.calls.length, 1 as int)
    assert_eq(lead.calls[0].name, "webfetch" as string)
    assert_eq(lead.calls[0].arguments, "{{\"url\": \"https://x.com\", \"format\": \"text\"}}" as string)
    # three opening, four closing braces (seen under OpenCode): the extra closer is ignored
    let extra = parse_reply("<tool_call> {{\"name\": \"read\", \"arguments\": {{\"filePath\": \"/a/b.md\", \"offset\": 0, \"limit\": 2000}}}}}} </tool_call>")
    assert_eq(extra.calls.length, 1 as int)
    assert_eq(extra.calls[0].name, "read" as string)
    assert_eq(extra.calls[0].arguments, "{{\"filePath\": \"/a/b.md\", \"offset\": 0, \"limit\": 2000}}" as string)
    # braces and escaped quotes inside a JSON string must not confuse the scan
    let tricky = parse_reply("<tool_call>{{\"name\": \"w\", \"arguments\": {{\"text\": \"a }} b {{ \\\" c\"}}}}</tool_call>")
    assert_eq(tricky.calls.length, 1 as int)
    assert_eq(tricky.calls[0].name, "w" as string)
    let hopeless = parse_reply("<tool_call>\n{{\"name\": \n</tool_call>")
    assert_eq(hopeless.calls.length, 0 as int)

    # --- tool_choice "none" turns tools off; anything else leaves them on ---
    assert_eq(tools_disabled(json_parse("{{\"tool_choice\": \"none\"}}")), true)
    assert_eq(tools_disabled(json_parse("{{\"tool_choice\": \"auto\"}}")), false)
    assert_eq(tools_disabled(json_parse("{{\"tool_choice\": \"required\"}}")), false)
    assert_eq(tools_disabled(json_parse("{{\"tool_choice\": {{\"type\": \"function\"}}}}")), false)
    assert_eq(tools_disabled(json_parse("{{}}")), false)

    let tool_doc = json_parse("{{\"tools\": [{{\"type\": \"function\", \"function\": {{\"name\": \"a\"}}}}, {{\"type\": \"function\", \"function\": {{\"name\": \"b\"}}}}], \"tool_choice\": {{\"type\": \"function\", \"function\": {{\"name\": \"b\"}}}}}}")
    let tool_list = json_get_list(tool_doc, "tools")
    assert_eq(tool_choice_validation_error(tool_doc, tool_list), "" as string)
    let chosen = tools_for_request(tool_doc, tool_list)
    assert_eq(chosen.length, 1 as int)
    assert_eq(json_get_str(json_get(chosen[0], "function"), "name", ""), "b" as string)
    assert(tool_choice_validation_error(json_parse("{{\"tool_choice\": \"required\"}}"), []) != "", "required needs tools")
    assert(tool_choice_validation_error(json_parse("{{\"tool_choice\": \"sometimes\"}}"), tool_list) != "", "unknown choice")
    let missing_choice = json_parse("{{\"tool_choice\": {{\"type\": \"function\", \"function\": {{\"name\": \"missing\"}}}}}}")
    assert(tool_choice_validation_error(missing_choice, tool_list) != "", "named choice must exist")

    # Required/named choices recover small-model outputs that omit the Hermes
    # wrapper. The same bare JSON remains content in the default auto mode.
    let bare_call = "{{\"name\": \"b\", \"arguments\": {{\"path\": \"x\"}}}}"
    assert_eq(parse_reply_for_tools(bare_call, json_parse("{{}}"), tool_list).calls.length, 0 as int)
    let required_doc = json_parse("{{\"tool_choice\": \"required\"}}")
    let recovered = parse_reply_for_tools(bare_call, required_doc, tool_list)
    assert_eq(recovered.calls.length, 1 as int)
    assert_eq(recovered.calls[0].name, "b" as string)
    assert_eq(recovered.calls[0].arguments, "{{\"path\": \"x\"}}" as string)
    let named_recovered = parse_reply_for_tools("{{\"path\": \"x\"}}", tool_doc, chosen)
    assert_eq(named_recovered.calls.length, 1 as int)
    assert_eq(named_recovered.calls[0].name, "b" as string)
    assert_eq(named_recovered.calls[0].arguments, "{{\"path\": \"x\"}}" as string)
    assert_eq(tool_choice_decoded_candidate_allowed(tool_doc, chosen, "{{\"path\": \"x\"", "{{\"path\": \"x\"}}", false), true)
    assert_eq(tool_choice_decoded_candidate_allowed(tool_doc, chosen, "{{\"path\": 3", "{{\"path\": 3}}", false), true)
    let wrong_wrapped = parse_reply_for_tools("<tool_call>{{\"name\": \"wrong\", \"arguments\": {{}}}}</tool_call>", tool_doc, chosen)
    assert_eq(wrong_wrapped.calls[0].name, "b" as string)

    # Tool arguments are checked against the subset of JSON Schema OpenCode
    # uses: objects/arrays, required properties, primitive types and enum.
    let schema = json_parse("{{\"type\": \"object\", \"properties\": {{\"city\": {{\"type\": \"string\"}}, \"unit\": {{\"type\": \"string\", \"enum\": [\"c\", \"f\"]}}, \"days\": {{\"type\": \"array\", \"items\": {{\"type\": \"integer\"}}}}}}, \"required\": [\"city\"]}}")
    assert_eq(tool_schema_matches(schema, json_parse("{{\"city\": \"Paris\", \"unit\": \"c\", \"days\": [1, 2]}}")), true)
    assert_eq(tool_schema_matches(schema, json_parse("{{\"unit\": \"c\"}}")), false)
    assert_eq(tool_schema_matches(schema, json_parse("{{\"city\": 3}}")), false)
    assert_eq(tool_schema_matches(schema, json_parse("{{\"city\": \"Paris\", \"unit\": \"kelvin\"}}")), false)
    assert_eq(tool_schema_matches(schema, json_parse("{{\"city\": \"Paris\", \"days\": [1, \"two\"]}}")), false)
    let integer_schema = json_parse("{{\"type\": \"integer\"}}")
    assert_eq(tool_schema_matches(integer_schema, json_parse("1.0")), true)
    assert_eq(tool_schema_matches(integer_schema, json_parse("-2.0")), true)
    assert_eq(tool_schema_matches(integer_schema, json_parse("1.5")), false)
    let integer_or_null = json_parse("{{\"type\": [\"integer\", \"null\"]}}")
    assert_eq(tool_schema_matches(integer_or_null, json_parse("3.0")), true)
    assert_eq(tool_schema_matches(integer_or_null, json_parse("null")), true)
    assert_eq(tool_schema_matches(integer_or_null, json_parse("3.25")), false)
    let multiples = json_parse("{{\"type\": \"number\", \"multipleOf\": 0.25}}")
    assert_eq(tool_schema_matches(multiples, json_parse("1.5")), true)
    assert_eq(tool_schema_matches(multiples, json_parse("1.6")), false)
    let decimal_multiple = json_parse("{{\"type\": \"number\", \"multipleOf\": 0.1}}")
    assert_eq(tool_schema_matches(decimal_multiple, json_parse("0.3")), true)
    assert_eq(tool_schema_matches(decimal_multiple, json_parse("-0.3")), true)
    assert_eq(tool_schema_matches(decimal_multiple, json_parse("0.31")), false)
    let patterned = json_parse("{{\"type\": \"string\", \"pattern\": \"^[a-z][a-z0-9_]*$\"}}")
    assert_eq(tool_schema_validation_error(patterned), "" as string)
    assert_eq(tool_schema_matches(patterned, json_parse("\"tool_2\"")), true)
    assert_eq(tool_schema_matches(patterned, json_parse("\"2tool\"")), false)
    assert(tool_schema_validation_error(json_parse("{{\"pattern\": 3}}")) != "", "pattern string")
    assert(tool_schema_validation_error(json_parse("{{\"pattern\": \"(a|b)\"}}")) != "", "unsupported regex is explicit")
    assert(tool_schema_validation_error(json_parse("{{\"multipleOf\": 0}}")) != "", "multipleOf positive")
    let referenced = json_parse("{{\"$defs\": {{\"positive\": {{\"type\": \"integer\", \"minimum\": 1}}, \"a/b\": {{\"const\": \"ok\"}}}}, \"type\": \"object\", \"properties\": {{\"count\": {{\"$ref\": \"#/$defs/positive\"}}, \"label\": {{\"$ref\": \"#/$defs/a~1b\"}}}}, \"required\": [\"count\", \"label\"]}}")
    assert_eq(tool_schema_validation_error(referenced), "" as string)
    assert_eq(tool_schema_matches(referenced, json_parse("{{\"count\": 2, \"label\": \"ok\"}}")), true)
    assert_eq(tool_schema_matches(referenced, json_parse("{{\"count\": 0, \"label\": \"ok\"}}")), false)
    assert_eq(tool_schema_matches(referenced, json_parse("{{\"count\": 2, \"label\": \"no\"}}")), false)
    let legacy_referenced = json_parse("{{\"definitions\": {{\"flag\": {{\"type\": \"boolean\"}}}}, \"$ref\": \"#/definitions/flag\"}}")
    assert_eq(tool_schema_validation_error(legacy_referenced), "" as string)
    assert_eq(tool_schema_matches(legacy_referenced, json_parse("true")), true)
    assert_eq(tool_schema_matches(legacy_referenced, json_parse("\"true\"")), false)
    assert(tool_schema_validation_error(json_parse("{{\"definitions\": {{\"broken\": {{\"type\": 3}}}}}}")) != "", "legacy definitions validate schemas")
    let recursive_schema = json_parse("{{\"type\": \"object\", \"properties\": {{\"next\": {{\"anyOf\": [{{\"type\": \"null\"}}, {{\"$ref\": \"#\"}}]}}}}}}")
    assert_eq(tool_schema_matches(recursive_schema, json_parse("{{\"next\": {{\"next\": null}}}}")), true)
    assert_eq(tool_schema_matches(json_parse("{{\"$ref\": \"#\"}}"), json_parse("1")), false)
    assert(tool_schema_validation_error(json_parse("{{\"$ref\": \"#/$defs/missing\"}}")) != "", "unresolved ref")
    assert(tool_schema_validation_error(json_parse("{{\"$ref\": \"https://example.test/schema\"}}")) != "", "external ref")
    let conditional = json_parse("{{\"if\": {{\"properties\": {{\"kind\": {{\"const\": \"number\"}}}}}}, \"then\": {{\"required\": [\"value\"], \"properties\": {{\"value\": {{\"type\": \"number\"}}}}}}, \"else\": {{\"required\": [\"text\"], \"properties\": {{\"text\": {{\"type\": \"string\"}}}}}}}}")
    assert_eq(tool_schema_matches(conditional, json_parse("{{\"kind\": \"number\", \"value\": 4}}")), true)
    assert_eq(tool_schema_matches(conditional, json_parse("{{\"kind\": \"number\", \"text\": \"four\"}}")), false)
    assert_eq(tool_schema_matches(conditional, json_parse("{{\"kind\": \"text\", \"text\": \"four\"}}")), true)
    assert_eq(tool_schema_matches(conditional, json_parse("{{\"kind\": \"text\", \"value\": 4}}")), false)
    let tuple_schema = json_parse("{{\"type\": \"array\", \"prefixItems\": [{{\"type\": \"string\"}}, {{\"type\": \"integer\"}}], \"contains\": {{\"type\": \"integer\"}}}}")
    assert_eq(tool_schema_matches(tuple_schema, json_parse("[\"x\", 2]")), true)
    assert_eq(tool_schema_matches(tuple_schema, json_parse("[2, \"x\"]")), false)
    assert_eq(tool_schema_matches(tuple_schema, json_parse("[\"x\"]")), false)
    assert(tool_schema_validation_error(json_parse("{{\"prefixItems\": {{}}}}")) != "", "prefixItems array")
    let tuple_tail = json_parse("{{\"prefixItems\": [{{\"type\": \"string\"}}], \"items\": {{\"type\": \"integer\"}}}}")
    assert_eq(tool_schema_matches(tuple_tail, json_parse("[\"head\", 1, 2]")), true)
    assert_eq(tool_schema_matches(tuple_tail, json_parse("[\"head\", \"tail\"]")), false)
    let counted_contains = json_parse("{{\"type\": \"array\", \"contains\": {{\"type\": \"integer\"}}, \"minContains\": 2, \"maxContains\": 2}}")
    assert_eq(tool_schema_matches(counted_contains, json_parse("[1, \"x\", 2]")), true)
    assert_eq(tool_schema_matches(counted_contains, json_parse("[1, \"x\"]")), false)
    assert_eq(tool_schema_matches(counted_contains, json_parse("[1, 2, 3]")), false)
    let dependencies = json_parse("{{\"type\": \"object\", \"dependentRequired\": {{\"credit_card\": [\"billing_address\"]}}}}")
    assert_eq(tool_schema_matches(dependencies, json_parse("{{}}")), true)
    assert_eq(tool_schema_matches(dependencies, json_parse("{{\"credit_card\": \"x\"}}")), false)
    assert_eq(tool_schema_matches(dependencies, json_parse("{{\"credit_card\": \"x\", \"billing_address\": \"y\"}}")), true)
    let property_names = json_parse("{{\"type\": \"object\", \"propertyNames\": {{\"enum\": [\"safe\"]}}}}")
    assert_eq(tool_schema_matches(property_names, json_parse("{{\"safe\": 1}}")), true)
    assert_eq(tool_schema_matches(property_names, json_parse("{{\"unsafe\": 1}}")), false)
    let dependent_schemas = json_parse("{{\"type\": \"object\", \"dependentSchemas\": {{\"kind\": {{\"required\": [\"value\"]}}}}}}")
    assert_eq(tool_schema_matches(dependent_schemas, json_parse("{{}}")), true)
    assert_eq(tool_schema_matches(dependent_schemas, json_parse("{{\"kind\": \"x\"}}")), false)
    assert_eq(tool_schema_matches(dependent_schemas, json_parse("{{\"kind\": \"x\", \"value\": 1}}")), true)
    assert_eq(tool_schema_validation_error(json_parse("true")), "" as string)
    assert_eq(tool_schema_matches(json_parse("true"), json_parse("{{\"anything\": 1}}")), true)
    assert_eq(tool_schema_matches(json_parse("false"), json_parse("{{\"anything\": 1}}")), false)

    let richer = json_parse("{{\"type\": \"object\", \"properties\": {{\"mode\": {{\"const\": \"read\"}}, \"limit\": {{\"anyOf\": [{{\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10}}, {{\"type\": \"null\"}}]}}, \"tags\": {{\"type\": \"array\", \"minItems\": 1, \"maxItems\": 2, \"items\": {{\"type\": \"string\", \"minLength\": 2}}}}}}, \"required\": [\"mode\"], \"additionalProperties\": false}}")
    assert_eq(tool_schema_matches(richer, json_parse("{{\"mode\": \"read\", \"limit\": 3, \"tags\": [\"ab\"]}}")), true)
    assert_eq(tool_schema_matches(richer, json_parse("{{\"mode\": \"write\"}}")), false)
    assert_eq(tool_schema_matches(richer, json_parse("{{\"mode\": \"read\", \"extra\": true}}")), false)
    assert_eq(tool_schema_matches(richer, json_parse("{{\"mode\": \"read\", \"limit\": 11}}")), false)
    assert_eq(tool_schema_matches(richer, json_parse("{{\"mode\": \"read\", \"limit\": null}}")), true)
    assert_eq(tool_schema_matches(richer, json_parse("{{\"mode\": \"read\", \"tags\": [\"x\"]}}")), false)

    let null_const = json_parse("{{\"const\": null}}")
    assert_eq(tool_schema_matches(null_const, json_parse("null")), true)
    assert_eq(tool_schema_matches(null_const, json_parse("false")), false)
    let empty_object_only = json_parse("{{\"type\": \"object\", \"additionalProperties\": false}}")
    assert_eq(tool_schema_matches(empty_object_only, json_parse("{{}}")), true)
    assert_eq(tool_schema_matches(empty_object_only, json_parse("{{\"unexpected\": 1}}")), false)
    assert_eq(json_values_equal(json_parse("{{\"a\": 1, \"b\": [true]}}"), json_parse("{{\"b\": [true], \"a\": 1.0}}")), true)
    assert_eq(json_values_equal(json_parse("[1, 2]"), json_parse("[2, 1]")), false)
    let object_const = json_parse("{{\"const\": {{\"a\": 1, \"b\": 2}}}}")
    assert_eq(tool_schema_matches(object_const, json_parse("{{\"b\": 2, \"a\": 1.0}}")), true)
    let unique = json_parse("{{\"type\": \"array\", \"uniqueItems\": true}}")
    assert_eq(tool_schema_matches(unique, json_parse("[1, 2]")), true)
    assert_eq(tool_schema_matches(unique, json_parse("[1, 1.0]")), false)
    assert_eq(tool_schema_matches(unique, json_parse("[{{\"a\": 1, \"b\": 2}}, {{\"b\": 2, \"a\": 1}}]")), false)

    let composed = json_parse("{{\"allOf\": [{{\"type\": \"integer\", \"exclusiveMinimum\": 0}}, {{\"maximum\": 3}}], \"not\": {{\"const\": 2}}}}")
    assert_eq(tool_schema_matches(composed, json_parse("1")), true)
    assert_eq(tool_schema_matches(composed, json_parse("0")), false)
    assert_eq(tool_schema_matches(composed, json_parse("2")), false)
    assert_eq(tool_schema_matches(composed, json_parse("4")), false)
    let typed_extras = json_parse("{{\"type\": \"object\", \"minProperties\": 1, \"maxProperties\": 2, \"additionalProperties\": {{\"type\": \"string\"}}}}")
    assert_eq(tool_schema_matches(typed_extras, json_parse("{{\"a\": \"x\"}}")), true)
    assert_eq(tool_schema_matches(typed_extras, json_parse("{{}}")), false)
    assert_eq(tool_schema_matches(typed_extras, json_parse("{{\"a\": 1}}")), false)
    assert_eq(tool_schema_matches(typed_extras, json_parse("{{\"a\": \"x\", \"b\": \"y\", \"c\": \"z\"}}")), false)

    let exactly_one = json_parse("{{\"oneOf\": [{{\"type\": \"string\"}}, {{\"type\": \"integer\"}}]}}")
    assert_eq(tool_schema_matches(exactly_one, json_parse("\"x\"")), true)
    assert_eq(tool_schema_matches(exactly_one, json_parse("true")), false)

    let schema_tools_doc = json_parse("{{\"tools\": [{{\"type\": \"function\", \"function\": {{\"name\": \"weather\", \"parameters\": {{\"type\": \"object\", \"properties\": {{\"city\": {{\"type\": \"string\"}}}}, \"required\": [\"city\"]}}}}}}], \"tool_choice\": \"required\"}}")
    let schema_tools = json_get_list(schema_tools_doc, "tools")
    let valid_schema_call = parse_reply_for_tools("{{\"name\": \"weather\", \"arguments\": {{\"city\": \"Paris\"}}}}", schema_tools_doc, schema_tools)
    assert_eq(valid_schema_call.calls.length, 1 as int)
    let invalid_schema_call = parse_reply_for_tools("<tool_call>{{\"name\": \"weather\", \"arguments\": {{}}}}</tool_call>", schema_tools_doc, schema_tools)
    assert_eq(invalid_schema_call.calls.length, 0 as int)
    assert(invalid_schema_call.content.contains("<tool_call>"), "invalid call remains visible content")

    # --- malformed generation parameters fail instead of silently becoming defaults ---
    assert_eq(request_validation_error(json_parse("{{}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"max_tokens\": 1, \"temperature\": 0, \"top_p\": 1}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"max_tokens\": 0}}")) != "", "zero max_tokens")
    assert(request_validation_error(json_parse("{{\"max_completion_tokens\": -1}}")) != "", "negative max_completion_tokens")
    assert_eq(request_validation_error(json_parse("{{\"n_predict\": -1}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"n_predict\": 0}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"n_predict\": -2}}")) != "", "n_predict below sentinel")
    assert(request_validation_error(json_parse("{{\"max_tokens\": 1.5}}")) != "", "fractional max_tokens")
    assert(request_validation_error(json_parse("{{\"temperature\": 3}}")) != "", "temperature range")
    assert(request_validation_error(json_parse("{{\"top_p\": 0}}")) != "", "top_p range")
    assert(request_validation_error(json_parse("{{\"min_p\": -0.1}}")) != "", "min_p lower range")
    assert(request_validation_error(json_parse("{{\"min_p\": 1.1}}")) != "", "min_p upper range")
    assert_eq(request_validation_error(json_parse("{{\"min_p\": 0.05}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"min_keep\": 2}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"min_keep\": -1}}")) != "", "min_keep lower bound")
    assert(request_validation_error(json_parse("{{\"min_keep\": 1.5}}")) != "", "min_keep integer")
    assert_eq(request_validation_error(json_parse("{{\"typical_p\": 0.8}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"typical_p\": 0}}")) != "", "typical_p lower bound")
    assert(request_validation_error(json_parse("{{\"typical_p\": 1.1}}")) != "", "typical_p upper bound")
    assert_eq(request_validation_error(json_parse("{{\"dynatemp_range\": 0.4, \"dynatemp_exponent\": 2}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"dynatemp_range\": -0.1}}")) != "", "dynatemp_range lower bound")
    assert_eq(request_validation_error(json_parse("{{\"dry_multiplier\": 0.8, \"dry_base\": 1.75, \"dry_allowed_length\": 2, \"dry_penalty_last_n\": 64, \"dry_sequence_breakers\": [\"\\n\", \":\"]}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"dry_multiplier\": -0.1}}")) != "", "dry multiplier lower bound")
    assert(request_validation_error(json_parse("{{\"dry_penalty_last_n\": -1}}")) != "", "dry window lower bound")
    assert(request_validation_error(json_parse("{{\"dry_sequence_breakers\": []}}")) != "", "dry breakers non-empty")
    assert(request_validation_error(json_parse("{{\"dynatemp_exponent\": 0}}")) != "", "dynatemp_exponent positive")
    assert_eq(request_validation_error(json_parse("{{\"top_n_sigma\": 1.2}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"top_n_sigma\": \"wide\"}}")) != "", "top_n_sigma number")
    assert_eq(request_validation_error(json_parse("{{\"xtc_probability\": 0.5, \"xtc_threshold\": 0.2}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"xtc_probability\": 1.1}}")) != "", "xtc_probability upper bound")
    assert_eq(request_validation_error(json_parse("{{\"top_k\": -1}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"samplers\": [\"top_k\", \"top_p\", \"temperature\"]}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"samplers\": [\"top_p\", \"top_k\"]}}")) != "", "sampler order")
    assert(request_validation_error(json_parse("{{\"samplers\": [\"unknown\"]}}")) != "", "unknown sampler")
    assert_eq(request_validation_error(json_parse("{{\"mirostat\": 2, \"mirostat_tau\": 5, \"mirostat_eta\": 0.1}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"mirostat\": 3}}")) != "", "mirostat mode")
    assert_eq(request_validation_error(json_parse("{{\"adaptive_target\": 0.2, \"adaptive_decay\": 0.9}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"adaptive_decay\": 1.0}}")) != "", "adaptive decay range")
    assert(request_validation_error(json_parse("{{\"mirostat\": 1, \"adaptive_target\": 0.2}}")) != "", "stateful samplers are exclusive")
    let selected_samplers = request_samplers(json_parse("{{\"samplers\": [\"top_k\", \"top_p\", \"temperature\"]}}"), ["penalties"])
    assert_eq(sampler_enabled(selected_samplers, "top_k"), true)
    assert_eq(sampler_enabled(selected_samplers, "dry"), false)
    assert(request_validation_error(json_parse("{{\"frequency_penalty\": 2.1}}")) != "", "frequency penalty range")
    assert(request_validation_error(json_parse("{{\"repeat_penalty\": 0}}")) != "", "repeat penalty range")
    assert_eq(request_validation_error(json_parse("{{\"repeat_last_n\": 0}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"repeat_last_n\": -1}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"repeat_last_n\": -2}}")) != "", "repeat_last_n lower bound")
    assert(request_validation_error(json_parse("{{\"repeat_last_n\": 1.5}}")) != "", "repeat_last_n integer")
    assert_eq(request_validation_error(json_parse("{{\"n\": 1, \"stream\": true, \"stream_options\": {{\"include_usage\": true}}, \"stop\": [\"a\", \"b\"], \"seed\": 2, \"chat_template_kwargs\": {{}}}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"n\": 2}}")) != "", "only one choice")
    assert(request_validation_error(json_parse("{{\"n\": 1.0}}")) != "", "n integer")
    assert(request_validation_error(json_parse("{{\"stream\": 1}}")) != "", "stream boolean")
    assert_eq(request_validation_error(json_parse("{{\"ignore_eos\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"ignore_eos\": 1}}")) != "", "ignore_eos boolean")
    assert_eq(request_validation_error(json_parse("{{\"cache_prompt\": false}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"cache_prompt\": 1}}")) != "", "cache_prompt boolean")
    assert_eq(request_validation_error(json_parse("{{\"return_tokens\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"return_tokens\": 1}}")) != "", "return_tokens boolean")
    assert_eq(request_validation_error(json_parse("{{\"t_max_predict_ms\": 0}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"t_max_predict_ms\": -1}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"t_max_predict_ms\": -2}}")) != "", "prediction timeout lower bound")
    assert(request_validation_error(json_parse("{{\"t_max_predict_ms\": 1.5}}")) != "", "prediction timeout integer")
    assert_eq(request_validation_error(json_parse("{{\"return_progress\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"return_progress\": 1}}")) != "", "return_progress boolean")
    assert_eq(request_validation_error(json_parse("{{\"timings_per_token\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"timings_per_token\": 1}}")) != "", "timings_per_token boolean")
    assert(request_validation_error(json_parse("{{\"stream_options\": []}}")) != "", "stream options object")
    assert(request_validation_error(json_parse("{{\"stream_options\": {{\"include_usage\": 1}}}}")) != "", "include usage boolean")
    assert(request_validation_error(json_parse("{{\"stop\": [\"ok\", 3]}}")) != "", "stop strings")
    assert(request_validation_error(json_parse("{{\"seed\": 1.5}}")) != "", "seed integer")
    assert(request_validation_error(json_parse("{{\"chat_template_kwargs\": false}}")) != "", "template kwargs object")
    assert(request_validation_error(json_parse("{{\"reasoning_effort\": 3}}")) != "", "reasoning effort string")
    assert_eq(request_validation_error(json_parse("{{\"reasoning_format\": \"none\"}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"reasoning_format\": \"deepseek-legacy\"}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"reasoning_format\": \"other\"}}")) != "", "reasoning format enum")
    assert(request_validation_error(json_parse("{{\"reasoning_format\": 1}}")) != "", "reasoning format string")
    let thought_text = "<think>plan</think>answer"
    let (deepseek_reasoning, deepseek_content) = reasoning_response_parts(thought_text, "deepseek")
    assert_eq(deepseek_reasoning, "plan" as string)
    assert_eq(deepseek_content, "answer" as string)
    let (none_reasoning, none_content) = reasoning_response_parts(thought_text, "none")
    assert_eq(none_reasoning, "" as string)
    assert_eq(none_content, thought_text)
    let (legacy_reasoning, legacy_content) = reasoning_response_parts(thought_text, "deepseek-legacy")
    assert_eq(legacy_reasoning, "plan" as string)
    assert_eq(legacy_content, thought_text)
    assert(request_validation_error(json_parse("{{\"parallel_tool_calls\": \"no\"}}")) != "", "parallel tool calls boolean")
    assert_eq(request_validation_error(json_parse("{{\"response_format\": {{\"type\": \"text\"}}}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"model\": \"qwen\"}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"model\": 3}}")) != "", "model string")
    assert(request_validation_error(json_parse("{{\"model\": \"\"}}")) != "", "model non-empty")
    assert_eq(request_validation_error(json_parse("{{\"response_format\": {{\"type\": \"json_object\"}}}}")), "" as string)
    let response_schema = json_parse("{{\"type\": \"object\", \"properties\": {{\"ok\": {{\"type\": \"boolean\"}}}}, \"required\": [\"ok\"], \"additionalProperties\": false}}")
    let response_format = json_parse("{{\"response_format\": {{\"type\": \"json_schema\", \"json_schema\": {{\"name\": \"answer\", \"strict\": true, \"schema\": {{\"type\": \"object\", \"properties\": {{\"ok\": {{\"type\": \"boolean\"}}}}, \"required\": [\"ok\"], \"additionalProperties\": false}}}}}}}}")
    assert_eq(request_validation_error(response_format), "" as string)
    assert(request_validation_error(json_parse("{{\"response_format\": {{\"type\": \"json_schema\"}}}}")) != "", "JSON Schema response needs envelope")
    assert(request_validation_error(json_parse("{{\"response_format\": {{\"type\": \"json_schema\", \"json_schema\": {{\"name\": \"\", \"schema\": {{}}}}}}}}")) != "", "JSON Schema response needs name")
    assert_eq(jv_to_json(response_json_schema(response_format)), jv_to_json(response_schema))
    let direct_response_format = json_parse("{{\"response_format\": {{\"type\": \"json_schema\", \"schema\": {{\"type\": \"object\", \"properties\": {{\"ok\": {{\"type\": \"boolean\"}}}}, \"required\": [\"ok\"], \"additionalProperties\": false}}}}}}")
    assert_eq(request_validation_error(direct_response_format), "" as string)
    assert_eq(jv_to_json(response_json_schema(direct_response_format)), jv_to_json(response_schema))
    let object_response_format = json_parse("{{\"response_format\": {{\"type\": \"json_object\", \"schema\": {{\"type\": \"object\", \"maxProperties\": 1}}}}}}")
    assert_eq(request_validation_error(object_response_format), "" as string)
    assert_eq(json_get_int(response_json_schema(object_response_format), "maxProperties", 0), 1 as int)
    assert(request_validation_error(json_parse("{{\"response_format\": {{\"type\": \"json_object\", \"schema\": {{\"required\": [1]}}}}}}")) != "", "direct response schema is validated")
    let native_json_schema = json_parse("{{\"json_schema\": {{\"type\": \"object\", \"properties\": {{\"ok\": {{\"type\": \"boolean\"}}}}, \"required\": [\"ok\"], \"additionalProperties\": false}}}}")
    assert_eq(request_validation_error(native_json_schema), "" as string)
    assert_eq(jv_to_json(response_json_schema(native_json_schema)), jv_to_json(response_schema))
    assert_eq(request_validation_error(json_parse("{{\"json_schema\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"json_schema\": \"object\"}}")) != "", "native JSON Schema is validated")
    let empty_native_schema = json_parse("{{\"json_schema\": {{}}, \"response_format\": {{\"type\": \"text\"}}, \"grammar\": \"ignored\"}}")
    assert_eq(request_validation_error(empty_native_schema), "" as string)
    assert_eq(json_get_str(response_json_schema(empty_native_schema), "type", ""), "object" as string)
    assert_eq(request_validation_error(json_parse("{{\"grammar\": \"\"}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"grammar\": \"root ::= \\\"ok\\\"\"}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"grammar\": false}}")) != "", "native grammar string")
    assert_eq(json_schema_decoded_candidate_allowed(response_schema, "{{\"ok\": true", "{{\"ok\": true}}", false), true)
    assert_eq(json_schema_decoded_candidate_allowed(response_schema, "{{\"ok\": true}}", "", true), true)
    assert_eq(json_schema_decoded_candidate_allowed(response_schema, "{{\"ok\": 1", "{{\"ok\": 1}}", false), false)
    assert_eq(json_schema_decoded_candidate_allowed(response_schema, "{{\"other\": true", "{{\"other\": true}}", false), false)
    let array_response_schema = json_parse("{{\"type\": \"array\", \"items\": {{\"type\": \"integer\"}}, \"minItems\": 2}}")
    assert_eq(json_schema_decoded_candidate_allowed(array_response_schema, "", "[1", false), true)
    assert_eq(json_schema_decoded_candidate_allowed(array_response_schema, "[1", "[1, 2]", false), true)
    assert_eq(json_schema_decoded_candidate_allowed(array_response_schema, "[1, 2]", "", true), true)
    assert_eq(json_schema_decoded_candidate_allowed(array_response_schema, "[1", "[1]", false), false)
    let string_response_schema = json_parse("{{\"type\": \"string\", \"minLength\": 2}}")
    assert_eq(json_schema_decoded_candidate_allowed(string_response_schema, "", "\"ok\"", false), true)
    assert_eq(json_schema_decoded_candidate_allowed(string_response_schema, "", "\"x\"", false), false)
    assert_eq(json_schema_should_stop(string_response_schema, "\"ok\""), true)
    let number_response_schema = json_parse("{{\"type\": \"number\"}}")
    assert_eq(json_schema_decoded_candidate_allowed(number_response_schema, "1", "", true), true)
    assert_eq(json_schema_should_stop(number_response_schema, "1"), false)
    assert_eq(json_schema_decoded_candidate_allowed(number_response_schema, "1", "12", false), true)
    assert(request_validation_error(json_parse("{{\"response_format\": []}}")) != "", "response format object")
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": false, \"top_logprobs\": 0}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"logprobs\": true, \"stream\": true}}")) != "", "streaming chat logprobs need raw reasoning")
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": true, \"stream\": true, \"reasoning_format\": \"none\"}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"logprobs\": true, \"stream\": true, \"reasoning_format\": \"none\", \"tools\": [{{\"type\": \"function\"}}]}}")) != "", "streaming chat logprobs reject active tools")
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": true, \"stream\": true, \"reasoning_format\": \"none\", \"tools\": [{{\"type\": \"function\"}}], \"tool_choice\": \"none\"}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": 5}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"logprobs\": 6}}")) != "", "completion logprobs limit")
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": 1, \"stream\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"top_logprobs\": 3}}")) != "", "top logprobs need logprobs")
    assert_eq(request_validation_error(json_parse("{{\"logprobs\": true, \"top_logprobs\": 3}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"logprobs\": true, \"top_logprobs\": 21}}")) != "", "top logprobs limit")
    assert_eq(request_validation_error(json_parse("{{\"n_probs\": 5}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"n_probs\": 21}}")) != "", "native probabilities limit")
    assert_eq(request_validation_error(json_parse("{{\"n_probs\": 1, \"stream\": true}}")), "" as string)
    assert_eq(endpoint_request_validation_error(json_parse("{{\"logprobs\": true, \"top_logprobs\": 3}}"), true, false), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"logprobs\": 3}}"), true, false) != "", "Chat rejects Text Completion logprobs")
    assert(endpoint_request_validation_error(json_parse("{{\"n_probs\": 3}}"), true, false) != "", "Chat rejects native probabilities")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"logprobs\": 3}}"), false, false), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"logprobs\": true}}"), false, false) != "", "Text Completion rejects Chat logprobs")
    assert(endpoint_request_validation_error(json_parse("{{\"top_logprobs\": 0}}"), false, false) != "", "Text Completion rejects Chat top_logprobs")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"n_probs\": 3}}"), false, true), "" as string)
    assert_eq(endpoint_request_validation_error(json_parse("{{\"logit_bias\": [[1, false]]}}"), false, true), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"logit_bias\": [[1, false]]}}"), true, false) != "", "Chat logit bias object")
    assert(endpoint_request_validation_error(json_parse("{{\"logprobs\": 3}}"), false, true) != "", "native completion rejects OpenAI logprobs")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"id_slot\": -1}}"), false, true), "" as string)
    assert_eq(endpoint_request_validation_error(json_parse("{{\"id_slot\": 2}}"), false, true), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"id_slot\": -2}}"), false, true) != "", "native slot lower bound")
    assert(endpoint_request_validation_error(json_parse("{{\"id_slot\": 1.5}}"), false, true) != "", "native slot integer")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"id_slot\": 0, \"return_tokens\": true, \"return_progress\": true, \"timings_per_token\": true}}"), false, true), "" as string)
    for native_only in ["id_slot", "return_tokens", "return_progress", "timings_per_token"]:
        let native_value = if native_only == "id_slot": "0" else: "true"
        let native_body = json_parse("{{\"{native_only}\": {native_value}}}")
        assert(endpoint_request_validation_error(native_body, true, false) != "", "Chat rejects native {native_only}")
        assert(endpoint_request_validation_error(native_body, false, false) != "", "Text Completion rejects native {native_only}")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"n_cmpl\": 1}}"), false, true), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"n_cmpl\": 2}}"), false, true) != "", "multiple native completions are explicit")
    assert(endpoint_request_validation_error(json_parse("{{\"n_cmpl\": 1}}"), true, false) != "", "chat rejects native completion count")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"lora\": []}}"), false, true), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"lora\": [{{\"id\": 0, \"scale\": 1}}]}}"), false, true) != "", "native LoRA requests are explicit")
    assert(endpoint_request_validation_error(json_parse("{{\"lora\": {{}}}}"), false, true) != "", "native LoRA list type")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"lora\": []}}"), true, false), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"lora\": [{{\"id\": 0, \"scale\": 1}}]}}"), true, false) != "", "Chat LoRA requests are explicit")
    assert(endpoint_request_validation_error(json_parse("{{\"lora\": [{{\"id\": 0, \"scale\": 1}}]}}"), false, false) != "", "Text Completion LoRA requests are explicit")
    for chat_only in ["tools", "tool_choice", "parallel_tool_calls", "chat_template_kwargs", "reasoning_effort", "reasoning_format"]:
        let chat_value = if chat_only == "tools": "[]" elif chat_only == "parallel_tool_calls": "false" elif chat_only == "chat_template_kwargs": "{{}}" else: "\"none\""
        let chat_body = json_parse("{{\"{chat_only}\": {chat_value}}}")
        assert_eq(endpoint_request_validation_error(chat_body, true, false), "" as string)
        assert(endpoint_request_validation_error(chat_body, false, false) != "", "Text Completion rejects Chat {chat_only}")
        assert(endpoint_request_validation_error(chat_body, false, true) != "", "native completion rejects Chat {chat_only}")
    assert(endpoint_request_validation_error(json_parse("{{\"n\": 1}}"), false, true) != "", "native completion rejects OpenAI choice count")
    assert(endpoint_request_validation_error(json_parse("{{\"max_completion_tokens\": 3}}"), false, true) != "", "native completion rejects OpenAI token limit")
    assert(endpoint_request_validation_error(json_parse("{{\"stream_options\": {{\"include_usage\": true}}}}"), false, true) != "", "native completion rejects OpenAI stream options")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"n_keep\": 0, \"n_discard\": 0, \"n_cache_reuse\": 0}}"), false, true), "" as string)
    assert_eq(endpoint_request_validation_error(json_parse("{{\"n_keep\": -1}}"), false, true), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"n_keep\": -2}}"), false, true) != "", "native retained prompt must be -1 or non-negative")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"n_discard\": 128}}"), false, true), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"n_cache_reuse\": 64}}"), false, true) != "", "native cache reuse shifting is explicit")
    assert(endpoint_request_validation_error(json_parse("{{\"n_keep\": 0.5}}"), false, true) != "", "native n_keep is integer")
    assert(endpoint_request_validation_error(json_parse("{{\"n_discard\": 0}}"), true, false) != "", "chat rejects native discard count")
    assert(endpoint_request_validation_error(json_parse("{{\"n_discard\": 0}}"), false, false) != "", "text completion rejects native discard count")
    assert_eq(request_validation_error(json_parse("{{\"logit_bias\": {{\"42\": -100, \"7\": 4.5}}}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"logit_bias\": [[1]]}}")) != "", "logit bias pair shape")
    assert_eq(request_validation_error(json_parse("{{\"logit_bias\": {{\"word\": 1, \"other\": false}}}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"logit_bias\": {{\"-1\": 1}}}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"logit_bias\": [[-1, 1]]}}")), "" as string)
    assert(endpoint_request_validation_error(json_parse("{{\"logit_bias\": {{\"-1\": 1}}}}"), true, false) != "", "OpenAI negative logit bias token id")
    assert(endpoint_request_validation_error(json_parse("{{\"logit_bias\": {{\"word\": 1}}}}"), true, false) != "", "OpenAI logit bias token id")
    assert(endpoint_request_validation_error(json_parse("{{\"logit_bias\": {{\"1\": false}}}}"), true, false) != "", "OpenAI logit bias numeric values")
    assert(request_validation_error(json_parse("{{\"logit_bias\": {{\"1\": 101}}}}")) != "", "logit bias range")
    assert_eq(request_validation_error(json_parse("{{\"logit_bias\": [[1, 2.5], [3, false]]}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"logit_bias\": [[\"word\", 1]]}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"logit_bias\": [[\"\", 1]]}}")) != "", "empty text native logit bias")
    assert(request_validation_error(json_parse("{{\"logit_bias\": [[1, true]]}}")) != "", "true native logit bias")
    assert_eq(request_validation_error(json_parse("{{\"response_fields\": [\"content\", \"generation_settings/n_predict\"]}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"response_fields\": \"content\"}}")) != "", "response fields list")
    assert(request_validation_error(json_parse("{{\"response_fields\": [\"generation_settings//n_predict\"]}}")) != "", "response fields path")
    assert(endpoint_request_validation_error(json_parse("{{\"response_fields\": [\"content\"]}}"), true, false) != "", "chat rejects native response fields")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"response_fields\": [\"content\"]}}"), false, true), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"n_indent\": 4}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"n_indent\": -1}}")) != "", "negative n_indent")
    assert(request_validation_error(json_parse("{{\"n_indent\": 2.5}}")) != "", "integer n_indent")
    assert_eq(request_validation_error(json_parse("{{\"sse_ping_interval\": -1}}")), "" as string)
    assert_eq(request_validation_error(json_parse("{{\"sse_ping_interval\": 0}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"sse_ping_interval\": -2}}")) != "", "sse ping interval lower bound")
    assert(request_validation_error(json_parse("{{\"sse_ping_interval\": 1.5}}")) != "", "integer sse ping interval")
    assert_eq(request_validation_error(json_parse("{{\"post_sampling_probs\": true}}")), "" as string)
    assert(request_validation_error(json_parse("{{\"post_sampling_probs\": 1}}")) != "", "boolean post-sampling probabilities")
    assert(endpoint_request_validation_error(json_parse("{{\"post_sampling_probs\": true}}"), true, false) != "", "chat rejects native post-sampling probabilities")
    assert_eq(endpoint_request_validation_error(json_parse("{{\"post_sampling_probs\": true}}"), false, true), "" as string)

    let no_reasoning = chat_template_variables(json_parse("{{\"reasoning_effort\": \"none\"}}"))
    assert_eq(json_get_str(no_reasoning, "reasoning_effort", ""), "none" as string)
    assert_eq(json_get_bool(no_reasoning, "enable_thinking", true), false)
    let explicit_thinking = chat_template_variables(json_parse("{{\"reasoning_effort\": \"none\", \"chat_template_kwargs\": {{\"enable_thinking\": true, \"custom\": 7}}}}"))
    assert_eq(json_get_bool(explicit_thinking, "enable_thinking", false), true)
    assert_eq(json_get_int(explicit_thinking, "custom", 0), 7 as int)
    let high_reasoning = chat_template_variables(json_parse("{{\"reasoning_effort\": \"high\"}}"))
    assert_eq(json_get_str(high_reasoning, "reasoning_effort", ""), "high" as string)
    let default_reasoning = chat_template_variables_default(json_parse("{{}}"), "medium")
    assert_eq(json_get_str(default_reasoning, "reasoning_effort", ""), "medium" as string)
    let overridden_reasoning = chat_template_variables_default(json_parse("{{\"reasoning_effort\": \"low\"}}"), "high")
    assert_eq(json_get_str(overridden_reasoning, "reasoning_effort", ""), "low" as string)
    let default_no_reasoning = chat_template_variables_default(json_parse("{{}}"), "none")
    assert_eq(json_get_bool(default_no_reasoning, "enable_thinking", true), false)
    let template_default_reasoning = chat_template_variables_default(json_parse("{{}}"), "default")
    assert(not jv_to_json(template_default_reasoning).contains("reasoning_effort"), "default effort leaves template default undefined")
    let server_template_vars = chat_template_variables_server_default(json_parse("{{\"chat_template_kwargs\": {{\"shared\": \"request\", \"request_only\": 2, \"reasoning_effort\": \"low\"}}}}"), json_parse("{{\"shared\": \"server\", \"server_only\": 1}}"), "medium")
    assert_eq(json_get_str(server_template_vars, "shared", ""), "request" as string)
    assert_eq(json_get_int(server_template_vars, "server_only", 0), 1 as int)
    assert_eq(json_get_int(server_template_vars, "request_only", 0), 2 as int)
    assert_eq(json_get_str(server_template_vars, "reasoning_effort", ""), "low" as string)
    let reasoning_off = chat_template_variables_server_default(json_parse("{{}}"), json_parse("{{\"enable_thinking\": false}}"), "")
    assert_eq(json_get_bool(reasoning_off, "enable_thinking", true), false)
    let request_reasoning_on = chat_template_variables_server_default(json_parse("{{\"chat_template_kwargs\": {{\"enable_thinking\": true}}}}"), json_parse("{{\"enable_thinking\": false}}"), "")
    assert_eq(json_get_bool(request_reasoning_on, "enable_thinking", false), true)
    let preserve_reasoning = chat_template_variables_server_default(json_parse("{{}}"), json_parse("{{\"preserve_reasoning\": true}}"), "")
    assert_eq(json_get_bool(preserve_reasoning, "preserve_reasoning", false), true)
    let request_drops_reasoning = chat_template_variables_server_default(json_parse("{{\"chat_template_kwargs\": {{\"preserve_reasoning\": false}}}}"), json_parse("{{\"preserve_reasoning\": true}}"), "")
    assert_eq(json_get_bool(request_drops_reasoning, "preserve_reasoning", true), false)
    assert(not jv_to_json(high_reasoning).contains("enable_thinking"), "high effort leaves enable_thinking undefined")
    let serial_tools = chat_template_variables(json_parse("{{\"parallel_tool_calls\": false}}"))
    assert_eq(json_get_bool(serial_tools, "parallel_tool_calls", true), false)

    let responses_string = json_parse("{{\"instructions\": \"Be terse\", \"input\": \"Hello\"}}")
    assert_eq(responses_input_validation_error(responses_string), "" as string)
    assert_eq(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"store\": false, \"background\": false, \"prompt_cache_key\": \"session\", \"include\": [\"reasoning.encrypted_content\"], \"reasoning\": {{\"effort\": \"high\", \"summary\": \"auto\"}}, \"text\": {{\"verbosity\": \"low\"}}}}")), "" as string)
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"store\": true}}")) != "", "stored Responses are rejected")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"background\": true}}")) != "", "background Responses are rejected")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"previous_response_id\": \"resp_1\"}}")) != "", "previous stored Response is rejected")
    assert_eq(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"truncation\": \"disabled\"}}")), "" as string)
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"truncation\": \"auto\"}}")) != "", "automatic Responses truncation is rejected")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"truncation\": false}}")) != "", "Responses truncation is a string")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"include\": [1]}}")) != "", "Responses include strings")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"metadata\": []}}")) != "", "Responses metadata object")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"metadata\": {{\"attempt\": 1}}}}")) != "", "Responses metadata values are strings")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"metadata\": {{\"12345678901234567890123456789012345678901234567890123456789012345\": \"x\"}}}}")) != "", "Responses metadata keys are bounded")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"metadata\": {{\"a\":\"\",\"b\":\"\",\"c\":\"\",\"d\":\"\",\"e\":\"\",\"f\":\"\",\"g\":\"\",\"h\":\"\",\"i\":\"\",\"j\":\"\",\"k\":\"\",\"l\":\"\",\"m\":\"\",\"n\":\"\",\"o\":\"\",\"p\":\"\",\"q\":\"\"}}}}")) != "", "Responses metadata entry count is bounded")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"reasoning\": []}}")) != "", "Responses reasoning object")
    assert(responses_input_validation_error(json_parse("{{\"input\": \"hi\", \"text\": {{\"verbosity\": \"loud\"}}}}")) != "", "Responses verbosity enum")
    let responses_string_messages = responses_input_messages(responses_string)
    assert_eq(responses_string_messages.length, 2 as int)
    assert_eq(json_get_str(responses_string_messages[0], "role", ""), "system" as string)
    assert_eq(json_get_str(responses_string_messages[1], "content", ""), "Hello" as string)
    let responses_messages = json_parse("{{\"input\": [{{\"type\": \"message\", \"role\": \"user\", \"content\": [{{\"type\": \"input_text\", \"text\": \"one \"}}, {{\"type\": \"input_text\", \"text\": \"two\"}}]}}]}}")
    assert_eq(responses_input_validation_error(responses_messages), "" as string)
    assert_eq(json_get_str(responses_input_messages(responses_messages)[0], "content", ""), "one two" as string)
    let responses_tools = json_parse("{{\"input\": \"hi\", \"tools\": [{{\"type\": \"function\", \"name\": \"lookup\", \"description\": \"Look up\", \"parameters\": {{\"type\": \"object\"}}}}]}}")
    assert_eq(responses_input_validation_error(responses_tools), "" as string)
    assert_eq(json_get_str(json_get(responses_input_tools(responses_tools)[0], "function"), "name", ""), "lookup" as string)
    let responses_no_tools = json_parse("{{\"input\": \"hi\", \"tools\": [{{\"type\": \"function\", \"name\": \"lookup\"}}], \"tool_choice\": \"none\"}}")
    assert_eq(responses_input_validation_error(responses_no_tools), "" as string)
    assert_eq(responses_input_tools(responses_no_tools).length, 0 as int)
    let responses_named_tool = json_parse("{{\"input\": \"hi\", \"tools\": [{{\"type\": \"function\", \"name\": \"one\"}}, {{\"type\": \"function\", \"name\": \"two\"}}], \"tool_choice\": {{\"type\": \"function\", \"name\": \"two\"}}}}")
    assert_eq(responses_input_validation_error(responses_named_tool), "" as string)
    assert_eq(json_get_str(json_get(responses_input_tools(responses_named_tool)[0], "function"), "name", ""), "two" as string)
    let responses_generation = json_parse("{{\"model\": \"qwen\", \"input\": \"json\", \"max_output_tokens\": 32, \"reasoning\": {{\"effort\": \"none\"}}, \"text\": {{\"format\": {{\"type\": \"json_schema\", \"name\": \"answer\", \"strict\": true, \"schema\": {{\"type\": \"object\"}}}}}}, \"tools\": [{{\"type\": \"function\", \"name\": \"lookup\"}}], \"tool_choice\": {{\"type\": \"function\", \"name\": \"lookup\"}}}}")
    let responses_chat = responses_chat_body(responses_generation)
    assert_eq(json_get_int(responses_chat, "max_completion_tokens", 0), 32 as int)
    assert_eq(json_get_str(responses_chat, "reasoning_effort", ""), "none" as string)
    assert_eq(json_get_str(json_get(json_get(responses_chat, "response_format"), "json_schema"), "name", ""), "answer" as string)
    assert_eq(json_get_str(json_get(json_get(responses_chat, "tool_choice"), "function"), "name", ""), "lookup" as string)
    assert_eq(json_get_str(json_get(responses_chat, "responses_tool_choice"), "name", ""), "lookup" as string)
    assert_eq(json_get_str(json_get_list(responses_chat, "responses_tools")[0], "name", ""), "lookup" as string)
    assert_eq(request_validation_error(responses_chat), "" as string)
    assert_eq(tool_choice_validation_error(responses_chat, json_get_list(responses_chat, "tools")), "" as string)
    let responses_tool_history = json_parse("{{\"input\": [{{\"type\": \"function_call\", \"call_id\": \"call_1\", \"name\": \"lookup\", \"arguments\": \"{{\\\"q\\\":\\\"x\\\"}}\"}}, {{\"type\": \"function_call_output\", \"call_id\": \"call_1\", \"output\": \"found\"}}]}}")
    assert_eq(responses_input_validation_error(responses_tool_history), "" as string)
    let tool_history_messages = responses_input_messages(responses_tool_history)
    assert_eq(json_get_str(tool_history_messages[0], "role", ""), "assistant" as string)
    assert_eq(json_get_str(json_get(json_get_list(tool_history_messages[0], "tool_calls")[0], "function"), "name", ""), "lookup" as string)
    assert_eq(json_get_str(tool_history_messages[1], "role", ""), "tool" as string)
    assert_eq(json_get_str(tool_history_messages[1], "tool_call_id", ""), "call_1" as string)
    let responses_rich_tool_output = json_parse("{{\"input\": [{{\"type\": \"function_call\", \"call_id\": \"call_2\", \"name\": \"lookup\", \"arguments\": \"{{}}\"}}, {{\"type\": \"function_call_output\", \"call_id\": \"call_2\", \"output\": [{{\"type\": \"input_text\", \"text\": \"found \"}}, {{\"type\": \"input_text\", \"text\": \"it\"}}]}}]}}")
    assert_eq(responses_input_validation_error(responses_rich_tool_output), "" as string)
    assert_eq(json_get_str(responses_input_messages(responses_rich_tool_output)[1], "content", ""), "found it" as string)
    assert(responses_input_validation_error(json_parse("{{\"input\": [{{\"type\": \"function_call\", \"call_id\": \"call_3\", \"name\": \"lookup\", \"arguments\": \"{{}}\"}}, {{\"type\": \"function_call_output\", \"call_id\": \"call_3\", \"output\": [{{\"type\": \"input_image\", \"image_url\": \"data:image/png;base64,x\"}}]}}]}}")) != "", "Responses tool output media is rejected")
    assert(responses_input_validation_error(json_parse("{{\"input\": [{{\"type\": \"function_call_output\", \"call_id\": \"\", \"output\": \"x\"}}]}}")) != "", "Responses tool history ids are validated")
    assert(responses_input_validation_error(json_parse("{{\"input\": [{{\"type\": \"function_call_output\", \"call_id\": \"missing\", \"output\": \"x\"}}]}}")) != "", "Responses tool output references a call")
    assert(responses_input_validation_error(json_parse("{{\"input\": [{{\"type\": \"message\", \"role\": \"user\", \"content\": [{{\"type\": \"input_image\"}}]}}]}}")) != "", "Responses media is rejected")

    # --- Anthropic Messages input adapter (count_tokens path) ---
    let anthropic = json_parse("{{\"model\":\"qwen\",\"system\":[{{\"type\":\"text\",\"text\":\"Be terse\"}}],\"messages\":[{{\"role\":\"user\",\"content\":[{{\"type\":\"text\",\"text\":\"Hello\"}}]}}],\"tools\":[{{\"name\":\"lookup\",\"description\":\"Look up\",\"input_schema\":{{\"type\":\"object\"}}}}],\"tool_choice\":{{\"type\":\"tool\",\"name\":\"lookup\",\"disable_parallel_tool_use\":true}}}}")
    assert_eq(anthropic_input_validation_error(anthropic), "" as string)
    let anthropic_chat = anthropic_chat_body(anthropic)
    assert_eq(json_get_str(json_get_list(anthropic_chat, "messages")[0], "role", ""), "system" as string)
    assert_eq(json_get_str(json_get_list(anthropic_chat, "messages")[1], "content", ""), "Hello" as string)
    assert_eq(json_get_str(json_get(json_get_list(anthropic_chat, "tools")[0], "function"), "name", ""), "lookup" as string)
    assert_eq(json_get_str(json_get(json_get(anthropic_chat, "tool_choice"), "function"), "name", ""), "lookup" as string)
    assert_eq(json_get_bool(anthropic_chat, "parallel_tool_calls", true), false)
    assert_eq(request_shape_error(anthropic_chat), "" as string)
    let anthropic_extra = json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\"temperature\":0.7,\"extra_params\":{{\"temperature\":0.2,\"seed\":42,\"min_p\":0.05,\"messages\":[]}}}}")
    assert_eq(anthropic_input_validation_error(anthropic_extra), "" as string)
    let anthropic_extra_chat = anthropic_chat_body(anthropic_extra)
    assert(json_get_float(anthropic_extra_chat, "temperature", 0.0) > 0.19, "Anthropic extra_params override ordinary completion parameters")
    assert_eq(json_get_int(anthropic_extra_chat, "seed", 0), 42 as int)
    assert(json_get_float(anthropic_extra_chat, "min_p", 0.0) > 0.04, "Anthropic extra sampling parameter")
    assert_eq(json_get_list(anthropic_extra_chat, "messages").length, 1 as int)
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\"extra_params\":[]}}")) != "", "Anthropic extra_params is an object")
    let anthropic_history = json_parse("{{\"messages\":[{{\"role\":\"assistant\",\"content\":[{{\"type\":\"text\",\"text\":\"Checking\"}},{{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"lookup\",\"input\":{{\"q\":\"x\"}}}}]}},{{\"role\":\"user\",\"content\":[{{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_1\",\"content\":[{{\"type\":\"text\",\"text\":\"found\"}}],\"is_error\":true}}]}}]}}")
    assert_eq(anthropic_input_validation_error(anthropic_history), "" as string)
    let anthropic_history_messages = json_get_list(anthropic_chat_body(anthropic_history), "messages")
    assert_eq(json_get_str(anthropic_history_messages[0], "content", ""), "Checking" as string)
    assert_eq(json_get_str(json_get_list(anthropic_history_messages[0], "tool_calls")[0], "id", ""), "toolu_1" as string)
    assert_eq(json_get_str(json_get(json_get_list(anthropic_history_messages[0], "tool_calls")[0], "function"), "name", ""), "lookup" as string)
    assert_eq(json_get_str(anthropic_history_messages[1], "role", ""), "tool" as string)
    assert_eq(json_get_str(anthropic_history_messages[1], "tool_call_id", ""), "toolu_1" as string)
    assert_eq(json_get_str(anthropic_history_messages[1], "content", ""), "found" as string)
    assert_eq(json_get_bool(anthropic_history_messages[1], "is_error", false), true)
    let anthropic_thinking_history = json_parse("{{\"messages\":[{{\"role\":\"assistant\",\"content\":[{{\"type\":\"thinking\",\"thinking\":\"considering\",\"signature\":\"sig_1\"}},{{\"type\":\"text\",\"text\":\"answer\"}}]}},{{\"role\":\"user\",\"content\":\"continue\"}}]}}")
    assert_eq(anthropic_input_validation_error(anthropic_thinking_history), "" as string)
    let thinking_messages = json_get_list(anthropic_chat_body(anthropic_thinking_history), "messages")
    assert_eq(json_get_str(thinking_messages[0], "reasoning_content", ""), "considering" as string)
    assert_eq(json_get_str(thinking_messages[0], "content", ""), "answer" as string)
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"assistant\",\"content\":[{{\"type\":\"thinking\",\"thinking\":1}}]}}]}}")) != "", "Anthropic thinking text is validated")
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"assistant\",\"content\":[{{\"type\":\"thinking\",\"thinking\":\"ok\",\"signature\":1}}]}}]}}")) != "", "Anthropic thinking signatures are validated")
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":[{{\"type\":\"image\"}}]}}]}}")) != "", "Anthropic media is rejected")
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\"tools\":[{{\"name\":\"lookup\"}}]}}")) != "", "Anthropic tools require input_schema")
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\"tool_choice\":{{\"type\":\"auto\",\"disable_parallel_tool_use\":\"yes\"}}}}")) != "", "Anthropic parallel tool control is boolean")
    let anthropic_thinking = json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":\"think\"}}],\"thinking\":{{\"type\":\"enabled\",\"budget_tokens\":128}}}}")
    assert_eq(anthropic_input_validation_error(anthropic_thinking), "" as string)
    assert_eq(json_get_bool(json_get(anthropic_chat_body(anthropic_thinking), "chat_template_kwargs"), "enable_thinking", false), true)
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":\"think\"}}],\"thinking\":{{\"type\":\"enabled\",\"budget_tokens\":0}}}}")) != "", "Anthropic thinking budget is positive")
    assert(anthropic_input_validation_error(json_parse("{{\"messages\":[{{\"role\":\"user\",\"content\":[{{\"type\":\"tool_result\",\"tool_use_id\":\"missing\",\"content\":\"x\"}}]}}]}}")) != "", "Anthropic tool results reference prior calls")
    let invalid_tool_error = json_parse("{{\"messages\":[{{\"role\":\"assistant\",\"content\":[{{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"lookup\",\"input\":{{}}}}]}},{{\"role\":\"user\",\"content\":[{{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_1\",\"content\":\"failed\",\"is_error\":\"yes\"}}]}}]}}")
    assert(anthropic_input_validation_error(invalid_tool_error) != "", "Anthropic tool result error state is boolean")
    let anthropic_text_response = json_parse(anthropic_message_json("7", "qwen", ParsedReply("hello", []), "", "stop", "", 10, 2, 4))
    assert_eq(json_get_str(anthropic_text_response, "id", ""), "msg_7" as string)
    assert_eq(json_get_str(anthropic_text_response, "stop_reason", ""), "end_turn" as string)
    assert_eq(json_get_str(json_get_list(anthropic_text_response, "content")[0], "text", ""), "hello" as string)
    assert_eq(json_get_int(json_get(anthropic_text_response, "usage"), "cache_read_input_tokens", 0), 4 as int)
    assert_eq(json_get_int(json_get(anthropic_text_response, "usage"), "input_tokens", 0), 6 as int)
    assert_eq(anthropic_uncached_input_tokens(4, 8), 0 as int)
    let anthropic_reasoning_response = json_parse(anthropic_message_json("7", "qwen", ParsedReply("answer", []), "thought", "stop", "", 10, 4, 0))
    assert_eq(json_get_str(json_get_list(anthropic_reasoning_response, "content")[0], "type", ""), "thinking" as string)
    assert_eq(json_get_str(json_get_list(anthropic_reasoning_response, "content")[0], "thinking", ""), "thought" as string)
    assert_eq(json_get_str(json_get_list(anthropic_reasoning_response, "content")[0], "signature", "missing"), "" as string)
    assert_eq(json_get_str(json_get_list(anthropic_reasoning_response, "content")[1], "text", ""), "answer" as string)
    let anthropic_stopped_response = json_parse(anthropic_message_json("7", "qwen", ParsedReply("hello", []), "", "stop", "END\n", 10, 2, 4))
    assert_eq(json_get_str(anthropic_stopped_response, "stop_reason", ""), "stop_sequence" as string)
    assert_eq(json_get_str(anthropic_stopped_response, "stop_sequence", ""), "END\n" as string)
    let anthropic_tool_response = json_parse(anthropic_message_json("8", "qwen", ParsedReply("", [ParsedToolCall("lookup", "{{\"q\":\"x\"}}")]), "", "tool_calls", "", 12, 3, 0))
    assert_eq(json_get_str(anthropic_tool_response, "stop_reason", ""), "tool_use" as string)
    assert_eq(json_get_str(json_get_list(anthropic_tool_response, "content")[0], "type", ""), "tool_use" as string)
    assert_eq(json_get_str(json_get_list(anthropic_tool_response, "content")[0], "name", ""), "lookup" as string)
    assert_eq(json_get_str(json_get(json_get_list(anthropic_tool_response, "content")[0], "input"), "q", ""), "x" as string)
    let anthropic_start = anthropic_message_start_sse("9", "qwen", 15, 6)
    assert(anthropic_start.startsWith("event: message_start\ndata: "), "Anthropic streams name their SSE events")
    assert(anthropic_start.contains("\"id\":\"msg_9\""), "Anthropic message_start carries the message id")
    assert(anthropic_start.contains("\"cache_read_input_tokens\":6"), "Anthropic message_start reports cache reuse")
    assert(anthropic_start.contains("\"input_tokens\":9"), "Anthropic message_start reports only non-cached input tokens")
    assert(anthropic_text_start_sse(0).contains("\"type\":\"text\""), "Anthropic streams open text blocks")
    assert(anthropic_text_delta_sse(0, "hi\n").contains("\"text\":\"hi\\n\""), "Anthropic text deltas are JSON escaped")
    assert(anthropic_thinking_start_sse(0).contains("\"type\":\"thinking\""), "Anthropic streams open thinking blocks")
    assert(anthropic_thinking_delta_sse(0, "why\n").contains("\"thinking\":\"why\\n\""), "Anthropic thinking deltas are JSON escaped")
    let anthropic_signature = anthropic_signature_delta_sse(0, anthropic_thinking_signature("9"))
    assert(anthropic_signature.contains("\"type\":\"signature_delta\""), "Anthropic streams identify signature deltas")
    assert(anthropic_signature.contains("\"signature\":\"\""), "Anthropic streams identify unavailable local signatures honestly")
    let anthropic_call = ParsedToolCall("lookup", "{{\"q\":\"x\"}}")
    assert(anthropic_tool_start_sse("9", 0, 1, anthropic_call).contains("\"id\":\"toolu_9_0\""), "Anthropic tool blocks have stable ids")
    assert(anthropic_tool_delta_sse(1, anthropic_call.arguments).contains("\"type\":\"input_json_delta\""), "Anthropic streams tool arguments as JSON deltas")
    assert(anthropic_content_stop_sse(1).startsWith("event: content_block_stop"), "Anthropic streams close content blocks")
    assert(anthropic_message_delta_sse("tool_calls", "", 3).contains("\"stop_reason\":\"tool_use\""), "Anthropic tool streams use the native stop reason")
    assert(anthropic_message_delta_sse("length", "", 3).contains("\"stop_reason\":\"max_tokens\""), "Anthropic length streams use the native stop reason")
    let anthropic_stopped_delta = anthropic_message_delta_sse("stop", "END\n", 3)
    assert(anthropic_stopped_delta.contains("\"stop_reason\":\"stop_sequence\""), "Anthropic stop sequences use the native stop reason")
    assert(anthropic_stopped_delta.contains("\"stop_sequence\":\"END\\n\""), "Anthropic streams report the matched stop sequence")
    assert(anthropic_message_stop_sse().startsWith("event: message_stop"), "Anthropic streams have a native terminal event")
    assert_eq(anthropic_ping_sse(), "event: ping\ndata: {{\"type\":\"ping\"}}\n\n" as string)
    assert(anthropic_error_sse("bad\nthing").contains("\"message\":\"bad\\nthing\""), "Anthropic stream errors are JSON escaped")
    let anthropic_failure = anthropic_stream_failure_sse("failed")
    assert(anthropic_failure.startsWith("event: error"), "Anthropic stream failures emit an error event")
    assert(not anthropic_failure.contains("event: message_stop"), "Anthropic stream errors are terminal without a successful message_stop")
    let anthropic_error = json_parse(anthropic_error_json("42", "bad\nthing", "invalid_request_error"))
    assert_eq(json_get_str(anthropic_error, "type", ""), "error" as string)
    assert_eq(json_get_str(json_get(anthropic_error, "error"), "type", ""), "invalid_request_error" as string)
    assert_eq(json_get_str(json_get(anthropic_error, "error"), "message", ""), "bad\nthing" as string)
    assert_eq(json_get_str(anthropic_error, "request_id", ""), "req_42" as string)
    assert(not jv_to_json(anthropic_error).contains("\"code\""), "Anthropic errors do not expose OpenAI error codes")
    assert_eq(jv_to_json(json_parse(provider_error_json(true, "42", "bad", "invalid_request_error", "invalid"))), jv_to_json(json_parse(anthropic_error_json("42", "bad", "invalid_request_error"))))
    let anthropic_auth = json_parse(provider_error_json(true, "43", "Invalid API Key", "authentication_error", "invalid_api_key"))
    assert_eq(json_get_str(json_get(anthropic_auth, "error"), "type", ""), "authentication_error" as string)
    assert(not jv_to_json(anthropic_auth).contains("invalid_api_key"), "Anthropic authentication errors omit OpenAI codes")

    let it = json_parse(input_tokens_json(42))
    assert_eq(json_get_str(it, "object", ""), "response.input_tokens" as string)
    assert_eq(json_get_int(it, "input_tokens", 0), 42 as int)
    let anthropic_it = json_parse(anthropic_input_tokens_json(42))
    assert_eq(json_get_int(anthropic_it, "input_tokens", 0), 42 as int)
    assert(request_value_is_undefined(json_get(anthropic_it, "object")), "Anthropic token counts omit the OpenAI object discriminator")
    let response_settings_body = responses_chat_body(json_parse("{{\"instructions\": \"Be terse\", \"input\": \"hi\", \"max_output_tokens\": 32, \"metadata\": {{\"request\": \"abc\"}}, \"tools\": [{{\"type\": \"function\", \"name\": \"lookup\"}}], \"tool_choice\": \"none\", \"parallel_tool_calls\": false}}"))
    let response_settings = responses_settings_json(response_settings_body, 0.25, 0.9)
    let response_text = json_parse(responses_json_timed("9", "model", ParsedReply("answer", []), "stop", 10, 4, 7, 123, 130, 30, 20, response_settings))
    assert_eq(json_get_str(response_text, "id", ""), "resp_9" as string)
    assert_eq(json_get_str(response_text, "status", ""), "completed" as string)
    assert_eq(json_get_int(response_text, "created_at", 0), 123 as int)
    assert_eq(json_get_int(response_text, "completed_at", 0), 130 as int)
    assert_eq(json_get_str(json_get(response_text, "metadata"), "request", ""), "abc" as string)
    assert_eq(json_get_str(response_text, "instructions", ""), "Be terse" as string)
    assert_eq(json_get_str(response_text, "input", ""), "hi" as string)
    assert_eq(json_get_int(response_text, "max_output_tokens", 0), 32 as int)
    assert_eq(json_get_float(response_text, "temperature", 0.0), 0.25)
    assert_eq(json_get_float(response_text, "top_p", 0.0), 0.9)
    assert_eq(json_get_str(response_text, "truncation", ""), "disabled" as string)
    assert_eq(json_get_str(response_text, "tool_choice", ""), "none" as string)
    assert_eq(json_get_str(json_get_list(response_text, "tools")[0], "name", ""), "lookup" as string)
    assert_eq(json_get_bool(response_text, "parallel_tool_calls", true), false)
    assert_eq(json_get_str(json_get_list(json_get_list(response_text, "output")[0], "content")[0], "text", ""), "answer" as string)
    assert_eq(json_get_int(json_get(response_text, "usage"), "input_tokens", 0), 10 as int)
    let default_response_settings = responses_settings_json(json_parse("{{}}"), 1.0, 1.0)
    let response_call = json_parse(responses_json_timed("9", "model", ParsedReply("", [ParsedToolCall("lookup", "{{\"q\":\"x\"}}")]), "tool_calls", 10, 4, 7, 123, 130, 30, 20, default_response_settings))
    assert_eq(json_get_str(json_get_list(response_call, "output")[0], "type", ""), "function_call" as string)
    assert_eq(json_get_str(json_get_list(response_call, "output")[0], "call_id", ""), "call_9_0" as string)
    let response_incomplete = json_parse(responses_json_timed("9", "model", ParsedReply("partial", []), "length", 10, 4, 0, 123, 130, 30, 20, default_response_settings))
    assert_eq(json_get_str(response_incomplete, "status", ""), "incomplete" as string)
    assert_eq(json_get_str(json_get(response_incomplete, "incomplete_details"), "reason", ""), "max_output_tokens" as string)
    let response_with_reasoning = json_parse(responses_json_reasoning_timed("9", "model", ParsedReply("answer", []), "plan", "stop", 10, 4, 0, 123, 130, 30, 20, default_response_settings))
    assert_eq(json_get_str(json_get_list(response_with_reasoning, "output")[0], "type", ""), "reasoning" as string)
    assert_eq(json_get_str(json_get_list(json_get_list(response_with_reasoning, "output")[0], "summary")[0], "text", ""), "plan" as string)
    assert_eq(json_get_str(json_get_list(response_with_reasoning, "output")[1], "type", ""), "message" as string)
    let response_created_event = json_parse(responses_created_sse("9", "model", 123, 0, "response.created", response_settings).split("data: ")[1].trim())
    assert_eq(json_get_str(response_created_event, "type", ""), "response.created" as string)
    assert(jv_to_json(json_get(response_created_event, "response")).contains("\"completed_at\": null"), "in-progress Responses completion time is null")
    assert_eq(json_get_str(json_get(json_get(response_created_event, "response"), "metadata"), "request", ""), "abc" as string)
    let response_delta_event = json_parse(responses_text_delta_sse("9", "hi", 0, 4).split("data: ")[1].trim())
