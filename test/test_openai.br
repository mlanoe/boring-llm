    let ns_probs = json_parse(native_completion_sse_event_logprobs("hi", [7], false, stream_timings, ["hi"], [-0.2 as float32],
                              [[104 as uint8, 105 as uint8]],
                              [[TokenLogprobAlternative(7, "hi", [104 as uint8, 105 as uint8], -0.2 as float32)]], false).split("data: ")[1].trim())
    assert_eq(json_get_list(ns_probs, "completion_probabilities").length, 1 as int)
    assert_eq(json_get_int(json_get_list(ns_probs, "completion_probabilities")[0], "id", -1), 7 as int)
    assert_eq(json_get_int(nc_probs, "id_slot", -1), 1 as int)
    let nfinal = json_parse(native_completion_final_sse_event("model", 2, "word", "STOP", true, 3, 2, 1, 20, 10, native_settings, "prompt", true).split("data: ")[1].trim())
    assert_eq(json_get_bool(nfinal, "stop", false), true)
    assert_eq(json_get_str(nfinal, "stop_type", ""), "word" as string)
    assert_eq(json_get_int(nfinal, "id_slot", -1), 2 as int)
    assert_eq(json_get_str(nfinal, "prompt", ""), "prompt" as string)
    assert_eq(json_get_bool(nfinal, "has_new_line", false), true)
    assert_eq(json_get_bool(nfinal, "truncated", false), true)
    assert_eq(json_get_str(nfinal, "stopping_word", "missing"), "STOP" as string)
    assert_eq(json_get_int(json_get(nfinal, "generation_settings"), "n_probs", 0), 3 as int)
    assert_eq(json_get_int(json_get(nfinal, "timings"), "prompt_n", 0), 2 as int)
    assert_eq(text_stream_limit(" hello ", []), 7 as int)
    assert_eq(text_stream_limit("hello ST", ["STOP"]), 6 as int)
    assert_eq(text_stream_limit("hello STOP", ["STOP"]), 10 as int)
    let props = json_parse(props_json("weights/m.gguf", "{{{{ messages }}}}", 4096, 3, 40, 0.0 as float32, 0.3 as float32, 2.0 as float32, 1.2 as float32, 50, 0.8 as float32, 1.0 as float32, 0.05 as float32, 0.2 as float32, 0.15 as float32, 2, 7, 1.0 as float32, 64, 0.7 as float32, 1.8 as float32, 3, 32, 2, 6.0 as float32, 0.2 as float32, -1.0 as float32, 0.8 as float32, 0.4 as float32, 0.3 as float32, ["penalties", "top_k", "temperature"], true))
    assert_eq(json_get_str(props, "model_path", ""), "weights/m.gguf" as string)
    assert_eq(json_get_str(props, "chat_template", ""), "{{{{ messages }}}}" as string)
    assert_eq(json_get_str(props, "build_info", ""), "boring-llm" as string)
    assert_eq(json_get_str(props, "media_marker", "missing"), "" as string)
    let plain_caps = json_get(props, "chat_template_caps")
    assert_eq(json_get_bool(plain_caps, "supports_tools", true), false)
    assert_eq(json_get_bool(plain_caps, "supports_tool_calls", true), false)
    assert_eq(json_get_bool(plain_caps, "supports_object_arguments", true), false)
    assert_eq(json_get_bool(plain_caps, "supports_string_content", false), true)
    assert_eq(json_get_bool(plain_caps, "supports_typed_content", true), false)
    let tool_props = json_parse(props_json("weights/m.gguf", "{{{{ tools }}}} {{{{ message.tool_calls }}}} {{{{ message.reasoning_content }}}} {{{{ parallel_tool_calls }}}} {{{{ reasoning_effort }}}}", 4096, 1, 40, 0.0 as float32, 0.0 as float32, 1.0 as float32, -1.0 as float32, 50, 1.0 as float32, 1.0 as float32, 0.05 as float32, 0.0 as float32, 0.1 as float32, 0, 7, 1.0 as float32, 64, 0.0 as float32, 1.75 as float32, 2, 64, 0, 5.0 as float32, 0.1 as float32, 0.25 as float32, 0.8 as float32, 0.0 as float32, 0.0 as float32, ["penalties", "dry", "top_n_sigma", "top_k", "typ_p", "top_p", "min_p", "xtc", "temperature"], false))
    let tool_caps = json_get(tool_props, "chat_template_caps")
    assert_eq(json_get_bool(tool_caps, "supports_tools", false), true)
    assert_eq(json_get_bool(tool_caps, "supports_tool_calls", false), true)
    assert_eq(json_get_bool(tool_caps, "supports_object_arguments", false), true)
    assert_eq(json_get_bool(tool_caps, "supports_parallel_tool_calls", false), true)
    assert_eq(json_get_bool(tool_caps, "supports_preserve_reasoning", false), true)
    assert_eq(json_get_bool(tool_caps, "supports_reasoning_effort", false), true)
    assert_eq(json_get_float(json_get(json_get(tool_props, "default_generation_settings"), "params"), "adaptive_target", -1.0), 0.25 as float)
    assert_eq(json_get_int(json_get(props, "default_generation_settings"), "n_ctx", 0), 4096 as int)
    assert_eq(json_get_int(json_get(props, "default_generation_settings"), "id", -1), 0 as int)
    assert_eq(json_get_int(json_get(props, "default_generation_settings"), "id_task", 0), -1 as int)
    assert_eq(json_get_bool(json_get(props, "default_generation_settings"), "speculative", true), false)
    assert_eq(json_get_bool(json_get(props, "default_generation_settings"), "is_processing", true), false)
    assert_eq(json_get_int(json_get(json_get(props, "default_generation_settings"), "params"), "seed", 0), 7 as int)
    assert_eq(json_get_float(json_get(json_get(props, "default_generation_settings"), "params"), "min_p", 0.0), 0.05 as float)
    assert_eq(json_get_float(json_get(json_get(props, "default_generation_settings"), "params"), "typical_p", 0.0), 0.8 as float)
    assert_eq(json_get_float(json_get(json_get(props, "default_generation_settings"), "params"), "dry_multiplier", -1.0), 0.7 as float)
    let prop_params = json_get(json_get(props, "default_generation_settings"), "params")
    assert_eq(json_get_float(prop_params, "dynatemp_range", 0.0), 0.3 as float)
    assert_eq(json_get_float(prop_params, "dynatemp_exponent", 0.0), 2.0 as float)
    assert_eq(json_get_float(prop_params, "top_n_sigma", 0.0), 1.2 as float)
    assert_eq(json_get_float(prop_params, "xtc_probability", 0.0), 0.2 as float)
    assert_eq(json_get_float(prop_params, "xtc_threshold", 0.0), 0.15 as float)
    assert_eq(json_get_int(prop_params, "min_keep", 0), 2 as int)
    assert_eq(json_get_float(prop_params, "dry_base", 0.0), 1.8 as float)
    assert_eq(json_get_int(prop_params, "dry_allowed_length", 0), 3 as int)
    assert_eq(json_get_int(prop_params, "dry_penalty_last_n", 0), 32 as int)
    assert_eq(json_get_int(prop_params, "mirostat", 0), 2 as int)
    assert_eq(json_get_float(prop_params, "mirostat_tau", 0.0), 6.0 as float)
    assert_eq(json_get_float(prop_params, "mirostat_eta", 0.0), 0.2 as float)
    assert_eq(json_get_float(prop_params, "adaptive_target", 0.0), -1.0 as float)
    assert_eq(json_get_float(prop_params, "adaptive_decay", 0.0), 0.8 as float)
    assert_eq(json_get_float(prop_params, "presence_penalty", 0.0), 0.4 as float)
    assert_eq(json_get_float(prop_params, "frequency_penalty", 0.0), 0.3 as float)
    assert_eq(json_get_bool(prop_params, "ignore_eos", false), true)
    assert_eq(json_get_bool(prop_params, "stream", false), true)
    assert_eq(json_get_int(prop_params, "n_probs", -1), 0 as int)
    assert_eq(json_get_str(prop_params, "grammar", "missing"), "" as string)
    assert_eq(json_get_str(prop_params, "reasoning_format", "missing"), "none" as string)
    assert_eq(json_get_bool(prop_params, "reasoning_in_content", true), false)
    assert_eq(json_get_str(prop_params, "generation_prompt", "missing"), "" as string)
    assert_eq(json_get_list(prop_params, "samplers").length, 3 as int)
    assert_eq(json_get_bool(prop_params, "timings_per_token", true), false)
    assert_eq(json_get_str(json_get(props, "default_generation_settings"), "prompt", "missing"), "" as string)
    let next_token = json_get(json_get(props, "default_generation_settings"), "next_token")
    assert_eq(json_get_bool(next_token, "has_next_token", false), true)
    assert_eq(json_get_bool(next_token, "has_new_line", true), false)
    assert_eq(json_get_int(next_token, "n_remain", 0), 40 as int)
    assert_eq(json_get_int(next_token, "n_decoded", -1), 0 as int)
    assert_eq(json_get_str(next_token, "stopping_word", "missing"), "" as string)
    assert_eq(json_get_int(props, "total_slots", 0), 3 as int)
    let slots = json_parse(slots_json(3, [120, 250], "weights/m.gguf", 4096, 40, 0.0 as float32, 0.3 as float32, 2.0 as float32, 1.2 as float32, 50, 0.8 as float32, 1.0 as float32, 0.05 as float32, 0.2 as float32, 0.15 as float32, 2, 7, 1.0 as float32, 64, 0.7 as float32, 1.8 as float32, 3, 32, 2, 6.0 as float32, 0.2 as float32, -1.0 as float32, 0.8 as float32, 0.4 as float32, 0.3 as float32, ["penalties", "top_k", "temperature"], true))
    match slots:
        JList(items):
            assert_eq(items.length, 3 as int)
            assert_eq(json_get_int(items[0], "id", -1), 0 as int)
            assert_eq(json_get_int(items[2], "id", -1), 2 as int)
            assert_eq(json_get_int(items[0], "n_ctx", 0), 4096 as int)
            assert_eq(json_get_bool(items[0], "is_processing", true), false)
            assert_eq(json_get_int(items[0], "id_task", 0), -1 as int)
            assert_eq(json_get_int(json_get(items[0], "params"), "top_k", 0), 50 as int)
            assert_eq(json_get_list(json_get(items[0], "params"), "stop").length, 0 as int)
            assert_eq(jv_to_json(json_get(items[0], "params")), jv_to_json(json_get(json_get(props, "default_generation_settings"), "params")))
            assert_eq(json_get_int(items[0], "n_predicted", -1), 0 as int)
            assert_eq(json_get_str(items[0], "prompt", "missing"), "" as string)
            assert_eq(json_get_str(items[0], "generated", "missing"), "" as string)
            assert_eq(json_get_int(json_get(items[0], "next_token"), "n_remain", 0), 40 as int)
            assert_eq(json_get_bool(json_get(items[0], "next_token"), "has_next_token", false), true)
            assert_eq(json_get_int(items[0], "n_past", -1), 120 as int)
            assert_eq(json_get_int(items[1], "n_past", -1), 250 as int)
            assert_eq(json_get_int(items[2], "n_past", -1), 0 as int)
        _: assert(false, "slots response is an array")

    # --- the context-overflow error carries the code, both phrases clients look for, and the counts ---
    let ce = json_parse(context_exceeded_json(5000, 4096))
    let ce_err = json_get(ce, "error")
    assert_eq(json_get_str(ce_err, "code", ""), "context_length_exceeded" as string)
    assert_eq(json_get_str(ce_err, "type", ""), "invalid_request_error" as string)
    assert_eq(json_get_int(ce_err, "n_prompt_tokens", 0), 5000 as int)
    assert_eq(json_get_int(ce_err, "n_ctx", 0), 4096 as int)
    let ce_msg = json_get_str(ce_err, "message", "")
    assert(ce_msg.contains("maximum context length is 4096"), "message: {ce_msg}")
    assert(ce_msg.contains("exceeds the available context size"), "message: {ce_msg}")
    assert(ce_msg.contains("5000 tokens"), "message: {ce_msg}")
    assert(ce_msg.contains("--ctx-size"), "message: {ce_msg}")
    let anthropic_ce = json_parse(provider_context_exceeded_json(true, "44", 5000, 4096))
    assert_eq(json_get_str(anthropic_ce, "type", ""), "error" as string)
    assert_eq(json_get_str(json_get(anthropic_ce, "error"), "type", ""), "invalid_request_error" as string)
    assert_eq(json_get_str(anthropic_ce, "request_id", ""), "req_44" as string)
    assert(json_get_str(json_get(anthropic_ce, "error"), "message", "").contains("maximum context length is 4096"), "Anthropic context errors retain useful details")

    # --- reasoning: <think>...</think> goes to reasoning_content, the rest is content ---
    let (r1, c1) = split_reasoning("<think>\nLet me think.\nSecond line.\n</think>\n\nThe answer is 4.")
    assert_eq(r1, "Let me think.\nSecond line." as string)
    assert_eq(c1, "The answer is 4." as string)
    let (r2, c2) = split_reasoning("Just an answer.")
    assert_eq(r2, "" as string)
    assert_eq(c2, "Just an answer." as string)
    let (r3, c3) = split_reasoning("<think>\nStill thinking when the tokens ran out")
    assert_eq(r3, "Still thinking when the tokens ran out" as string)
    assert_eq(c3, "" as string)
    let (r4, c4) = split_reasoning("<think>\n\n</think>\n\nDirect.")
    assert_eq(r4, "" as string)
    assert_eq(c4, "Direct." as string)
    let (r5, c5) = split_reasoning("  <think>\nhm\n</think>\n\n<tool_call>\n{{\"name\": \"f\", \"arguments\": {{}}}}\n</tool_call>")
    assert_eq(r5, "hm" as string)
    assert_eq(parse_reply(c5).calls.length, 1 as int)

    # while streaming, what has been split off only ever grows (a prefix of the final split)
    let think_full = "<think>\nOkay, so 2+2.\nThat is 4.\n</think>\n\nIt is 4.\n"
    var string tprev_r = ""
    var string tprev_c = ""
    var string tp = ""
    for ch in think_full.chars():
        tp = "{tp}{ch}"
        let (sr, sc) = stream_split(tp)
        assert(sr.startsWith(tprev_r), "reasoning must extend: '{tprev_r}' then '{sr}' at '{tp}'")
        assert(sc.startsWith(tprev_c), "content must extend: '{tprev_c}' then '{sc}' at '{tp}'")
        assert(not sr.contains("</"), "marker leaked into reasoning at '{tp}': '{sr}'")
        tprev_r = sr
        tprev_c = sc
    let (fr, fc) = split_reasoning(think_full)
    assert_eq(tprev_r, fr)
    assert_eq(trim_nl(tprev_c, false, true), trim_nl(fc, false, true))
    let (hold_r, hold_c) = stream_split("<thi")
    assert_eq(hold_r, "" as string)
    assert_eq(hold_c, "" as string)
    let (plain_r, plain_c) = stream_split("Hello <b")
    assert_eq(plain_r, "" as string)
    assert_eq(plain_c, "Hello <b" as string)

    # --- reasoning in the response bodies ---
    let with_reasoning = json_parse(completion_json_r("5", "m", ParsedReply("4", []), "Two and two.", "stop", 3, 9, 2, 123))
    let msg_r = json_get(json_get_list(with_reasoning, "choices")[0], "message")
    assert_eq(json_get_str(msg_r, "reasoning_content", ""), "Two and two." as string)
    assert_eq(json_get_str(msg_r, "content", ""), "4" as string)
    let without_reasoning = completion_json("5", "m", ParsedReply("4", []), "stop", 3, 9, 2, 123)
    assert(not without_reasoning.contains("reasoning_content"), "no reasoning_content when there is none")
    assert_eq(without_reasoning, completion_json_r("5", "m", ParsedReply("4", []), "", "stop", 3, 9, 2, 123))
    let rev = json_parse(sse_reasoning_event("5", "m", "think", 123).replace("data: ", "").trim())
    assert_eq(json_get_str(json_get(json_get_list(rev, "choices")[0], "delta"), "reasoning_content", ""), "think" as string)

    print "test_openai: ok"
