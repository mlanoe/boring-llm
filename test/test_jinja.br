# Interpreter-speed unit tests for src/jinja.br's core constructs, using
# small hand-written templates (no real GGUF file needed — see
# test_jinja_real.br for verification against the two real chat templates
# this project actually targets). Every literal `{`/`}` character below is
# built via chr(123)/chr(125) interpolation rather than written directly,
# since a literal single brace in a Boring string is itself the start of
# Boring's OWN string-interpolation syntax (book.md: "use `{{` for a
# literal `{`") — this sidesteps needing to hand-count brace-doubling for
# every Jinja delimiter.

use jinja

def main() throws:
    let ob = chr(123)
    let cb = chr(125)

    mut {string=JValue} env = {=}
    env["name"] = JValue.JStr("World")
    let out1 = render_jinja("Hello, {ob}{ob} name {cb}{cb}!", env)
    assert_eq(out1, "Hello, World!" as string)

    mut {string=JValue} env2 = {=}
    env2["show"] = JValue.JBool(true)
    let out2 = render_jinja("{ob}%- if show -%{cb}yes{ob}%- else -%{cb}no{ob}%- endif -%{cb}", env2)
    assert_eq(out2, "yes" as string)

    mut {string=JValue} env3 = {=}
    env3["show"] = JValue.JBool(false)
    let out3 = render_jinja("{ob}%- if show -%{cb}yes{ob}%- else -%{cb}no{ob}%- endif -%{cb}", env3)
    assert_eq(out3, "no" as string)

    mut {string=JValue} env4 = {=}
    mut [JValue] items = []
    items.push(JValue.JStr("a"))
    items.push(JValue.JStr("b"))
    items.push(JValue.JStr("c"))
    env4["items"] = JValue.JList(items)
    let tmpl4 = "{ob}%- for x in items -%{cb}[{ob}{ob} x {cb}{cb}:{ob}{ob} loop.index0 {cb}{cb}:{ob}{ob} loop.first {cb}{cb}:{ob}{ob} loop.last {cb}{cb}]{ob}%- endfor -%{cb}"
    let out4 = render_jinja(tmpl4, env4)
    assert_eq(out4, "[a:0:True:False][b:1:False:False][c:2:False:True]" as string)

    # attribute access, index access, string concat, == / and / not
    mut {string=JValue} msg = {=}
    msg["role"] = JValue.JStr("user")
    msg["content"] = JValue.JStr("hi")
    mut [JValue] messages = []
    messages.push(JValue.JDict(msg, ["role", "content"]))
    mut {string=JValue} env5 = {=}
    env5["messages"] = JValue.JList(messages)
    let tmpl5 = "{ob}%- if messages[0]['role'] == \"user\" and not (messages[0].role == \"system\") -%{cb}{ob}{ob} messages[0].role {cb}{cb}:{ob}{ob} messages[0]['content'] {cb}{cb}{ob}%- endif -%{cb}"
    let out5 = render_jinja(tmpl5, env5)
    assert_eq(out5, "user:hi" as string)

    # `+` adds two ints (index arithmetic) but still concatenates strings, and
    # Qwen's consecutive-tool-message pattern (lookahead at messages[idx + 1])
    # only closes a tool group at the LAST tool message of the group.
    mut {string=JValue} env7 = {=}
    mut [JValue] seq7 = []
    for r in ["tool", "tool", "user"]:
        mut {string=JValue} mm = {=}
        mm["role"] = JValue.JStr(r)
        seq7.push(JValue.JDict(mm, ["role"]))
    env7["msgs"] = JValue.JList(seq7)
    let out7a = render_jinja("{ob}%- for m in msgs -%{cb}[{ob}{ob} loop.index0 + 1 {cb}{cb}]{ob}%- endfor -%{cb}", env7)
    assert_eq(out7a, "[1][2][3]" as string)
    let out7b = render_jinja("{ob}%- for m in msgs -%{cb}{ob}{ob} 'a' + 'b' {cb}{cb}|{ob}%- endfor -%{cb}", env7)
    assert_eq(out7b, "ab|ab|ab|" as string)
    let out7c = render_jinja("{ob}%- for m in msgs -%{cb}{ob}%- if loop.last or (msgs[loop.index0 + 1].role != \"tool\") -%{cb}E{ob}%- else -%{cb}.{ob}%- endif -%{cb}{ob}%- endfor -%{cb}", env7)
    assert_eq(out7c, ".EE" as string)

    # is defined + set
    mut {string=JValue} env6 = {=}
    let tmpl6 = "{ob}%- set greeting = 'hi' -%{cb}{ob}%- if missing is defined -%{cb}yes{ob}%- else -%{cb}no{ob}%- endif -%{cb}:{ob}{ob} greeting {cb}{cb}"
    let out6 = render_jinja(tmpl6, env6)
    assert_eq(out6, "no:hi" as string)

    # tojson filter
    mut {string=JValue} env7 = {=}
    env7["x"] = JValue.JStr("a\"b")
    let out7 = render_jinja("{ob}{ob} x | tojson {cb}{cb}", env7)
    assert_eq(out7, "\"a\\\"b\"" as string)

    # a real Jinja quirk: exactly one trailing newline in the raw template
    # source is always dropped (keep_trailing_newline=False, real Jinja2's
    # own default) — verified separately against Qwen2.5's real template in
    # test_jinja_real.br; this is the minimal, GGUF-independent repro.
    let out8 = render_jinja("a\n\n", env)
    assert_eq(out8, "a\n" as string)

    # --- constructs Qwen3's template needs (checked against the real template and
    #     jinja2 in test_jinja_real.br); `r` renders a template with {ob}{ob}/{ob}% delimiters ---
    let ns_t = "{ob}%- set ns = namespace(a=0, b=true) -%{cb}{ob}%- for i in range(4) -%{cb}{ob}%- set ns.a = ns.a + i -%{cb}{ob}%- endfor -%{cb}{ob}{ob} ns.a {cb}{cb}{ob}{ob} ns.b {cb}{cb}"
    assert_eq(render_jinja(ns_t, env), "6True" as string)

    let range_t = "{ob}%- for i in range(2, -1, -1) -%{cb}{ob}{ob} i {cb}{cb}{ob}%- endfor -%{cb},{ob}%- for j in range(3) -%{cb}{ob}{ob} j {cb}{cb}{ob}%- endfor -%{cb}"
    assert_eq(render_jinja(range_t, env), "210,012" as string)

    # a `set` inside a for body does not leak out of it (Jinja scoping), a namespace does
    let scope_t = "{ob}%- set x = 1 -%{cb}{ob}%- for i in range(2) -%{cb}{ob}%- set x = 5 -%{cb}{ob}%- endfor -%{cb}{ob}{ob} x {cb}{cb}"
    assert_eq(render_jinja(scope_t, env), "1" as string)

    # string methods, negative indices, chained calls
    assert_eq(render_jinja("{ob}{ob} 'a,b,c'.split(',')[-1] {cb}{cb}", env), "c" as string)
    assert_eq(render_jinja("{ob}{ob} 'a,b,c'.split(',')[0] {cb}{cb}", env), "a" as string)
    assert_eq(render_jinja("{ob}{ob} ('x' + '\n').rstrip('\n') + '|' {cb}{cb}", env), "x|" as string)
    assert_eq(render_jinja("{ob}{ob} ('\n\nab\n').strip('\n') {cb}{cb}", env), "ab" as string)
    assert_eq(render_jinja("{ob}{ob} '\n\nab'.lstrip('\n') {cb}{cb}", env), "ab" as string)
    assert_eq(render_jinja("{ob}{ob} 'abc'.startswith('ab') {cb}{cb}{ob}{ob} 'abc'.endswith('x') {cb}{cb}", env), "TrueFalse" as string)
    assert_eq(render_jinja("{ob}{ob} 'a-b'.replace('-', '+') {cb}{cb}", env), "a+b" as string)

    # membership and comparisons; `not` binds looser than `==` and `in`, like Jinja
    assert_eq(render_jinja("{ob}{ob} 'b' in 'abc' {cb}{cb}{ob}{ob} 'z' in 'abc' {cb}{cb}{ob}{ob} 'z' not in 'abc' {cb}{cb}", env), "TrueFalseTrue" as string)
    assert_eq(render_jinja("{ob}%- if 3 > 2 and 2 <= 2 and 1 < 2 and 5 >= 5 -%{cb}ok{ob}%- endif -%{cb}", env), "ok" as string)
    assert_eq(render_jinja("{ob}%- if not 1 == 2 -%{cb}t{ob}%- endif -%{cb}", env), "t" as string)
    assert_eq(render_jinja("{ob}%- if not('x' in 'abc' and 'a' in 'abc') -%{cb}t{ob}%- else -%{cb}f{ob}%- endif -%{cb}", env), "t" as string)

    # tests and the length filter
    mut {string=JValue} env5 = {=}
    env5["s"] = JValue.JStr("text")
    env5["items"] = JValue.JList(items)
    env5["off"] = JValue.JBool(false)
    assert_eq(render_jinja("{ob}{ob} s is string {cb}{cb}{ob}{ob} items is string {cb}{cb}{ob}{ob} missing is defined {cb}{cb}{ob}{ob} missing is none {cb}{cb}{ob}{ob} s is not none {cb}{cb}{ob}{ob} off is false {cb}{cb}{ob}{ob} s is false {cb}{cb}", env5), "TrueFalseFalseTrueTrueTrueFalse" as string)
    assert_eq(render_jinja("{ob}{ob} items|length - 1 {cb}{cb}{ob}{ob} s|length {cb}{cb}", env5), "24" as string)
    assert_eq(render_jinja("{ob}{ob} items[items|length - 1] {cb}{cb}", env5), "c" as string)

    # TinyLlama's plain template (no trim markers), expected text from real jinja2:
    # `not`/comparison precedence and loop scoping must not change what it renders
    let tl = "{ob}% for message in messages %{cb}\n{ob}% if message['role'] == 'user' %{cb}\n{ob}{ob} '<|user|>\n' + message['content'] + eos_token {cb}{cb}\n{ob}% elif message['role'] == 'system' %{cb}\n{ob}{ob} '<|system|>\n' + message['content'] + eos_token {cb}{cb}\n{ob}% elif message['role'] == 'assistant' %{cb}\n{ob}{ob} '<|assistant|>\n'  + message['content'] + eos_token {cb}{cb}\n{ob}% endif %{cb}\n{ob}% if loop.last and add_generation_prompt %{cb}\n{ob}{ob} '<|assistant|>' {cb}{cb}\n{ob}% endif %{cb}\n{ob}% endfor %{cb}"
    mut [JValue] tl_msgs = []
    tl_msgs.push(jv_chat_message("system", "Be brief."))
    tl_msgs.push(jv_chat_message("user", "Hi"))
    tl_msgs.push(jv_chat_message("assistant", "Hello!"))
    tl_msgs.push(jv_chat_message("user", "Bye"))
    mut {string=JValue} tl_env = build_chat_env(tl_msgs, true, "<s>", "</s>")
    assert_eq(render_jinja(tl, tl_env), "\n\n<|system|>\nBe brief.</s>\n\n\n\n\n<|user|>\nHi</s>\n\n\n\n\n<|assistant|>\nHello!</s>\n\n\n\n\n<|user|>\nBye</s>\n\n\n<|assistant|>\n\n" as string)

    print "test_jinja: all assertions passed"
