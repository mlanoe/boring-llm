# N-gram drafting (src/speculative.br).   boring run test/test_speculative.br

use speculative

def main() throws:
    # ... 5 6 7 8 9 ... 5 6 7  -> the continuation of the earlier 5 6 7 is 8 9 ...
    let t = [1, 2, 5, 6, 7, 8, 9, 3, 4, 5, 6, 7]
    assert_eq(ngram_draft(t, 8, 3, 2), [8, 9, 3, 4, 5, 6, 7])
    assert_eq(ngram_draft(t, 2, 3, 2), [8, 9])
    # no 3-gram match, falls back to the 2-gram
    let u = [9, 6, 7, 1, 2, 3, 4, 8, 6, 7]
    assert_eq(ngram_draft(u, 4, 3, 2), [1, 2, 3, 4])
    assert_eq(ngram_draft(u, 4, 3, 3), [] as [int])
    # the most recent earlier occurrence wins
    let v = [1, 2, 3, 9, 1, 2, 3, 8, 1, 2, 3]
    assert_eq(ngram_draft(v, 1, 3, 3), [8])
    assert_eq(ngram_draft([1, 2], 4, 3, 1), [] as [int])
    assert_eq(ngram_draft([4, 4], 4, 1, 1), [4] as [int])
    print "test_speculative: all assertions passed"
