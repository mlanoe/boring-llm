# Architecture and RoPE-scaling tests: tiny synthetic GGUF models (F32, built by
# tools/make_arch_test_ggufs.py) whose expected logits come from an independent
# float64 numpy transcription of llama.cpp's graph. Covers Phi-3's fused
# attn_qkv/ffn_up tensors and per-pair RoPE factors, Gemma's GeGLU, embedding
# scale and head size != d_model / n_head, Gemma 2/3's post-norms, soft-capping,
# sliding windows and per-layer RoPE tables, and linear / YaRN RoPE scaling.
#   boring run test/test_arch.br

use io
use gguf
use model

def check_case(string name) throws:
    check_case_ctx(name, name, 4096)

# `fixture` names the GGUF, `name` the expected-logits file; `n_ctx` is the engine's context size
# (Phi-3 LongRoPE takes its short or long factors from it).
def check_case_ctx(string name, string fixture, int n_ctx) throws:
    set_rope_context_size(n_ctx)
    let file = parse_gguf(fs.readBytes("test/fixtures/arch-{fixture}.gguf"))
    let m = load_model(file)
    let tokens = [3, 1, 4, 1, 5, 9, 2, 6]
    let logits = forward(m, tokens)
    let expected = fs.readBytes("test/fixtures/arch-{name}.logits.f32")
    assert_eq(logits.length, tokens.length * m.config.vocab_size)
    var float32 worst = 0.0
    var int i = 0
    while i < logits.length:
        let want = read_f32_le(expected, i * 4) as float32
        let err = (logits[i] - want).abs()
        if err > worst:
            worst = err
        i += 1
    assert(worst < 0.002 as float32, "{name}: max |logit - reference| = {worst}")
    check_fp32_gpu_gate(name, forward_gpu_unsupported(m))
    print "{name}: OK (max logit error {worst})"

# forward_gpu implements the plain Llama-shaped layer only: it must refuse the
# architectures it would otherwise run to plausible-looking wrong logits.
def check_fp32_gpu_gate(string name, string unsupported):
    if ["plain", "yarn", "linear-llama"].contains(name):
        assert(unsupported == "", "{name}: the fp32 GPU path should accept it, got: {unsupported}")
    if ["gemma2", "gemma3", "mixtral", "granite", "smollm3", "olmo2", "gpt2", "phi2", "falcon", "starcoder2", "stablelm", "command-r"].contains(name):
        assert(unsupported != "", "{name}: the fp32 GPU path must refuse it")
    if unsupported != "":
        print "{name}: fp32 GPU path refused ({unsupported})"

def main() throws:
    check_case("plain")
    check_case("yarn")
    check_case("linear-llama")
    check_case("phi3")
    check_case("gemma")
    check_case("gemma2")
    check_case("gemma3")
    check_case("mixtral")
    check_case("qwen3moe")
    check_case("qwen2moe")
    check_case("olmoe")
    check_case("granite")
    check_case("granitemoe")
    check_case("deepseek")
    check_case("smollm3")
    check_case("olmo2")
    check_case("exaone")
    check_case("exaone4")
    check_case("internlm2")
    check_case("mistral3")
    check_case("glm4")
    check_case("minicpm")
    check_case("exaone-moe")
    check_case("phi2")
    check_case("starcoder2")
    check_case("gptneox")
    check_case("partial-gptneox")
    check_case("partial-gptneox-yarn")
    check_case("partial-glm4")
    check_case("falcon")
    check_case("command-r")
    check_case("cohere2")
    check_case("phimoe")
    check_case("dots1")
    check_case("ernie4_5")
    check_case("ernie4_5-moe")
    check_case("hunyuan-dense")
    check_case("hunyuan-moe")
    check_case("glm4moe")
    check_case("bailingmoe2")
    check_case("arcee")
    check_case("seed_oss")
    check_case("bailingmoe")
    check_case("olmo")
    check_case("stablelm")
    check_case("gpt2")
    check_case("afmoe")
    check_case("smallthinker")
    # Phi-3 with both factor sets (original context 1024): short up to a 1024 context, long beyond
    check_case_ctx("phi3-short", "phi3-short", 64)
    check_case_ctx("phi3-long", "phi3-short", 2048)
    set_rope_context_size(4096)
