# Tests for src/tokenizer.br's low-level pieces (UTF-8 codec, byte-to-
# unicode table, pretokenization) that don't need the real model's vocab.
# The full encode()/encode_chat() vs. llama-cpp-python check lives in
# test/test_tokenizer_real.br (needs the real GGUF, compiled path).
#
# Run with:
#   boring run test/test_tokenizer.br

use tokenizer
use io

def main() throws:
    # --- UTF-8 round-trip: ASCII ---
    let a = utf8_encode_char("A")
    assert_eq(a.length, 1)
    assert_eq(a[0], 65)
    assert_eq(bytes_to_str([65 as uint8]), "A")

    # --- UTF-8 round-trip: 2-byte char (é = U+00E9) ---
    let e = utf8_encode_char("é")
    assert_eq(e.length, 2)
    assert_eq(e[0], 0xC3)
    assert_eq(e[1], 0xA9)
    assert_eq(bytes_to_str([0xC3 as uint8, 0xA9 as uint8]), "é")
    # truncated or invalid sequences become U+FFFD, never an out-of-bounds read
    let fffd = chr(0xFFFD)
    assert_eq(bytes_to_str([0xC3 as uint8]), fffd)
    assert_eq(bytes_to_str([65 as uint8, 0xE6 as uint8, 0x97 as uint8]), "A{fffd}{fffd}")
    assert_eq(bytes_to_str([0xF0 as uint8, 0x9F as uint8, 0x98 as uint8]), "{fffd}{fffd}{fffd}")
    assert_eq(bytes_to_str([0xF0 as uint8, 0x9F as uint8, 0x98 as uint8, 0x80 as uint8]), "😀")
    assert_eq(bytes_to_str([0x80 as uint8, 66 as uint8]), "{fffd}B")
    assert_eq(bytes_to_str([0xE6 as uint8, 0x97 as uint8, 0xA5 as uint8]), "日")
    assert_eq(add_configured_special_tokens([4, 5], 1, 2, true, false, true), [1, 4, 5])
    assert_eq(add_configured_special_tokens([4, 5], 1, 2, false, true, true), [4, 5, 2])
    assert_eq(add_configured_special_tokens([4, 5], 1, 2, true, true, true), [1, 4, 5, 2])
    assert_eq(add_configured_special_tokens([4, 5], 1, 2, true, true, false), [4, 5])

    # --- byte-to-unicode: space (32) -> U+0120 'Ġ'; 'A' (65) -> identity ---
    let b2u = build_byte_to_unicode()
    assert_eq(b2u[32], "{chr(288)}")
    assert_eq(b2u[65], "A")
    # every one of the 256 byte values must have an entry
    var i = 0
    while i < 256:
        assert(b2u.contains(i), "byte_to_unicode missing entry for byte {i}")
        i += 1

    # --- pretokenize: word boundaries, leading-space folding, punctuation ---
    let seg1 = pretokenize("Hello world")
    assert_eq(seg1.length, 2)
    assert_eq(seg1[0], "Hello")
    assert_eq(seg1[1], " world")

    let seg2 = pretokenize("France?")
    assert_eq(seg2.length, 2)
    assert_eq(seg2[0], "France")
    assert_eq(seg2[1], "?")

    let seg3 = pretokenize("system\nYou")
    assert_eq(seg3.length, 3)
    assert_eq(seg3[0], "system")
    assert_eq(seg3[1], "\n")
    assert_eq(seg3[2], "You")

    # --- encode_with_specials: a tiny synthetic vocab (no real GGUF needed,
    # see test_tokenizer_real.br for the full real-vocab verification) to
    # exercise the special-token partitioning in isolation: plain-text spans
    # go through ordinary BPE, special-token spans become a single atomic id.
    let byte_to_uni = build_byte_to_unicode()
    let uni_to_byte = build_unicode_to_byte()
    mut {string=int} vocab = {=}
    vocab["h"] = 1
    vocab["i"] = 2
    vocab["b"] = 3
    vocab["y"] = 4
    vocab["e"] = 5
    mut {string=int} special = {=}
    special["<SPECIAL>"] = 999
    mut {int=string} reverse = {=}
    reverse[1] = "h"
    reverse[2] = "i"
    reverse[3] = "b"
    reverse[4] = "y"
    reverse[5] = "e"
    reverse[6] = byte_to_uni[0xC3]
    reverse[999] = "<SPECIAL>"
    let tok = Tokenizer(vocab, reverse, {=}, byte_to_uni, uni_to_byte, 0, 0, false, false, false, [], [], special)
    let ids = tok.encode_with_specials("hi<SPECIAL>bye")
    assert_eq(ids.length, 6)
    assert_eq(ids[0], 1)
    assert_eq(ids[1], 2)
    assert_eq(ids[2], 999)
    assert_eq(ids[3], 3)
    assert_eq(ids[4], 4)
    assert_eq(ids[5], 5)
    assert_eq(tok.decode(ids), "hi<SPECIAL>bye" as string)
    assert_eq(tok.encode_completion_prompt("hi")[0], 1 as int)
    let tok_bos = Tokenizer(vocab, reverse, {=}, byte_to_uni, uni_to_byte, 42, 0, true, false, false, [], [], special)
    let bos_ids = tok_bos.encode_completion_prompt("hi")
    assert_eq(bos_ids.length, 3 as int)
    assert_eq(bos_ids[0], 42 as int)
    assert_eq(bos_ids[1], 1 as int)
    assert_eq(bos_ids[2], 2 as int)
    let h_piece = tok.piece_bytes(1)
    assert_eq(h_piece.length, 1)
    assert_eq(int(h_piece[0]), 104)
    let partial_piece = tok.piece_bytes(6)
    assert_eq(partial_piece.length, 1)
    assert_eq(int(partial_piece[0]), 0xC3)
    let special_piece = tok.piece_bytes(999)
    assert_eq(bytes_to_str(special_piece), "<SPECIAL>" as string)

    # Longest-match preference: "<ab>" must win over the shorter "<a>" even
    # though both match starting at the same position.
    mut {string=int} overlapping = {=}
    overlapping["<a>"] = 900
    overlapping["<ab>"] = 901
    let tok2 = Tokenizer({=}, {=}, {=}, byte_to_uni, uni_to_byte, 0, 0, false, false, false, [], [], overlapping)
    let ids2 = tok2.encode_with_specials("<ab>")
    assert_eq(ids2.length, 1)
    assert_eq(ids2[0], 901)

    print "test_tokenizer: all assertions passed"
