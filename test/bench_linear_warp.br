# Ad hoc wall-clock benchmark: linear_gpu (16x16-tiled, shared-memory
# reduction) vs. linear_warp_gpu (one warp per output cell, shuffle-based
# reduction, zero shared memory) vs. linear_warp_shared_gpu (one warp per
# output cell, shuffle-based reduction, PLUS a shared x-row cache reused
# by every warp in a block) — plus the same three kernels' Q8_0
# fused-dequant counterparts (q8_linear_gpu / q8_linear_warp_gpu /
# q8_linear_warp_broadcast_gpu — no shared-x-cache Q8_0 variant exists,
# `linear_warp_shared_gpu` never won against plain `linear_warp_gpu` so it
# wasn't worth porting; `q8_linear_warp_broadcast_gpu` targets a different,
# more specific cost instead — see its own doc comment in math_gpu.br) —
# at this project's actual model dimensions (d_model up to 2048, ffn up to
# 5632, vocab up to 151936) and at BOTH the prefill shape (seq=26, a real
# prompt length) and the decode-step shape (seq=1 — the dominant real
# workload once `--kv-cache` is in use, since every token after the first
# prefill is a single-row matvec) — not a unit test, just answering "which
# kernel is actually faster at the sizes this project cares about", run
# manually, not part of the CI-adjacent test/*.br suite.
#
# Build + run:
#   boring build --target metal test/bench_linear_warp.br
#   cd test/bench_linear_warp_metal && cargo build --release
#   ./target/release/bench_linear_warp <kernel> <shape>
#     kernel: tiled | warp | warpshared | q8 | q8tensor | q8warp | q8warpbcast |
#             q5 | q5tensor | q5bcast | q4 | q4tensor | q4bcast |
#             q4nl | q4nltensor | q4nlbcast
#     shape:  small-seq26 | big-seq26 | small-seq1 | big-seq1

# Boring has no documented stopwatch-style elapsed-time API (Instant/
# Duration are oriented around timeout/wait, not measurement) — timed via
# separate process invocations + the shell's own `time` instead: pass
# "<kernel> <shape>" as argv[1]/argv[2] to run just one section per
# invocation.

use math_gpu

def main() throws:
    let [string] argv = args()
    guard argv.length > 2 else throw "usage: bench_linear_warp <tiled|warp|warpshared> <small-seq26|big-seq26|small-seq1|big-seq1>"
    let kernel_name = argv[1]
    let shape = argv[2]

    let d_model = 896
    let vocab = 8192   # a representative large d_out without allocating the real 151936-wide bias/output arrays

    let seq = if shape == "small-seq1" or shape == "big-seq1": 1 else: 26
    let is_big = shape == "big-seq26" or shape == "big-seq1"
    let d_out = if is_big: vocab else: d_model

    var [float32] x = [0.0 for i in 0..<(seq * d_model)]
    var [float32] w = [0.0 for i in 0..<(d_out * d_model)]
    var [float32] bv = [0.0 for i in 0..<d_out]
    var i = 0
    while i < x.length:
        x[i] = ((i % 13) as float32) * (0.01 as float32)
        i += 1
    i = 0
    while i < w.length:
        w[i] = ((i % 11) as float32) * (0.01 as float32)
        i += 1

    # Synthetic Q8_0-packed bytes for the fused-dequant kernels — d_model
    # (896) is a multiple of 32, so this is exactly (d_out * d_model / 32)
    # real 34-byte blocks (2-byte f16 scale + 32 signed int8 values), same
    # shape real GGUF Q8_0 tensors use.
    var [uint8] w_packed = []
    if kernel_name == "q8" or kernel_name == "q8tensor" or kernel_name == "q8warp" or kernel_name == "q8warpbcast":
        let n_blocks = (d_out * d_model) / 32
        var b = 0
        while b < n_blocks:
            w_packed.push(0x00 as uint8)
            w_packed.push(0x3C as uint8)   # f16 1.0 scale
            var qj = 0
            while qj < 32:
                w_packed.push(((qj + b) % 7) as uint8)
                qj += 1
            b += 1

    # Synthetic Q5_0-packed bytes (22 bytes/block: 2-byte scale + 4-byte
    # qh + 16 bytes nibbles), same d_model-multiple-of-32 shape as above.
    var [uint8] w5_packed = []
    if kernel_name == "q5" or kernel_name == "q5tensor" or kernel_name == "q5bcast":
        let n_blocks5 = (d_out * d_model) / 32
        var b5 = 0
        while b5 < n_blocks5:
            w5_packed.push(0x00 as uint8)
            w5_packed.push(0x3C as uint8)   # f16 1.0 scale
            w5_packed.push(0xFF as uint8)
            w5_packed.push(0xFF as uint8)
            w5_packed.push(0xFF as uint8)
            w5_packed.push(0xFF as uint8)   # qh = all-1s
            var qj5 = 0
            while qj5 < 16:
                w5_packed.push(((qj5 + b5) % 16) as uint8)
                qj5 += 1
            b5 += 1

    # Synthetic Q4_0-packed bytes (18 bytes/block: 2-byte scale + 16 bytes
    # nibbles) — same layout shape as IQ4_NL (reused for both below).
    var [uint8] w4_packed = []
    if kernel_name == "q4" or kernel_name == "q4tensor" or kernel_name == "q4bcast" or kernel_name == "q4nl" or kernel_name == "q4nltensor" or kernel_name == "q4nlbcast":
        let n_blocks4 = (d_out * d_model) / 32
        var b4 = 0
        while b4 < n_blocks4:
            w4_packed.push(0x00 as uint8)
            w4_packed.push(0x3C as uint8)   # f16 1.0 scale
            var qj4 = 0
            while qj4 < 16:
                w4_packed.push((((qj4 + b4) % 16) | (((qj4 + b4 + 1) % 16) << 4)) as uint8)
                qj4 += 1
            b4 += 1

    let n_iter = 200
    var iter = 0

    if kernel_name == "tiled":
        while iter < n_iter:
            let out = linear_gpu(x, w, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "linear_gpu (tiled), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "warp":
        while iter < n_iter:
            let out = linear_warp_gpu(x, w, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "linear_warp_gpu, seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "warpshared":
        while iter < n_iter:
            let out = linear_warp_shared_gpu(x, w, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "linear_warp_shared_gpu, seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q8":
        while iter < n_iter:
            let out = q8_linear_gpu(x, w_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q8_linear_gpu (tiled, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q8tensor":
        while iter < n_iter:
            let out = tensor_linear_gpu(x, w_packed, 8, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "gpu.tensor.linear Q8_0, seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q8warp":
        while iter < n_iter:
            let out = q8_linear_warp_gpu(x, w_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q8_linear_warp_gpu (warp-shuffle, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q8warpbcast":
        while iter < n_iter:
            let out = q8_linear_warp_broadcast_gpu(x, w_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q8_linear_warp_broadcast_gpu (warp-shuffle + scale-broadcast, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q5":
        while iter < n_iter:
            let out = q5_linear_gpu(x, w5_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q5_linear_gpu (tiled, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q5tensor":
        while iter < n_iter:
            let out = tensor_linear_gpu(x, w5_packed, 6, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "gpu.tensor.linear Q5_0, seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q5bcast":
        while iter < n_iter:
            let out = q5_linear_warp_broadcast_gpu(x, w5_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q5_linear_warp_broadcast_gpu (warp-shuffle + scale-broadcast, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q4":
        while iter < n_iter:
            let out = q4_linear_gpu(x, w4_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q4_linear_gpu (tiled, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q4tensor":
        while iter < n_iter:
            let out = tensor_linear_gpu(x, w4_packed, 2, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "gpu.tensor.linear Q4_0, seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q4bcast":
        while iter < n_iter:
            let out = q4_linear_warp_broadcast_gpu(x, w4_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q4_linear_warp_broadcast_gpu (warp-shuffle + scale-broadcast, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q4nl":
        while iter < n_iter:
            let out = q4nl_linear_gpu(x, w4_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q4nl_linear_gpu (tiled, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q4nltensor":
        while iter < n_iter:
            let out = tensor_linear_gpu(x, w4_packed, 20, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "gpu.tensor.linear IQ4_NL, seq={seq} d_out={d_out}, {n_iter} iters: done"
    elif kernel_name == "q4nlbcast":
        while iter < n_iter:
            let out = q4nl_linear_warp_broadcast_gpu(x, w4_packed, bv, seq, d_model, d_out)
            let sink = passthrough(out)
            iter += 1
        print "q4nl_linear_warp_broadcast_gpu (warp-shuffle + scale-broadcast, fused-dequant), seq={seq} d_out={d_out}, {n_iter} iters: done"
    else:
        throw "unknown kernel '{kernel_name}'"
