# Tests for src/io.br's binary readers and f16 bit-decode. Run with:
#   boring run test/test_io.br
# Style follows boring-numlib/tests/*_test.br: a flat script of
# assert/assert_eq calls that panics on the first failure.

use io

# --- LE integer readers --------------------------------------------------

let b16 = [0x34 as uint8, 0x12 as uint8]
assert_eq(read_u16_le(b16, 0), 0x1234)

let b32 = [0x78 as uint8, 0x56 as uint8, 0x34 as uint8, 0x12 as uint8]
assert_eq(read_u32_le(b32, 0), 0x12345678)

let b64 = [0xEF as uint8, 0xCD as uint8, 0xAB as uint8, 0x90 as uint8,
           0x78 as uint8, 0x56 as uint8, 0x34 as uint8, 0x12 as uint8]
assert_eq(read_u64_le(b64, 0), 0x1234567890ABCDEF)

# read at a nonzero offset
let b_off = [0xFF as uint8, 0x01 as uint8, 0x00 as uint8]
assert_eq(read_u16_le(b_off, 1), 1)

# --- f32 reader ------------------------------------------------------------

# 1.0f32 = 0x3F800000
let bf32 = [0x00 as uint8, 0x00 as uint8, 0x80 as uint8, 0x3F as uint8]
assert_eq(read_f32_le(bf32, 0), 1.0)

# --- UTF-8 string reader ----------------------------------------------------

let bstr = [0x68 as uint8, 0x69 as uint8]  # "hi"
assert_eq(read_utf8(bstr, 0, 2), "hi")

# --- f16 bit-decode ----------------------------------------------------------
# Reference bit patterns from the IEEE 754 half-precision format.

assert_eq(f16_bits_to_f32(0x3C00), 1.0 as float32)     # 1.0
assert_eq(f16_bits_to_f32(0x4000), 2.0 as float32)     # 2.0
assert_eq(f16_bits_to_f32(0xC000), -2.0 as float32)    # -2.0
assert_eq(f16_bits_to_f32(0xB800), -0.5 as float32)    # -0.5
assert_eq(f16_bits_to_f32(0x0000), 0.0 as float32)     # +0.0
assert_eq(f16_bits_to_f32(0x8000), 0.0 as float32)     # -0.0 (compares equal to +0.0)
assert_eq(f16_bits_to_f32(0x4200), 3.0 as float32)     # 3.0
assert_eq(f16_bits_to_f32(0x3555), 0.33325195 as float32)  # ~1/3, exact f16->f32 value

# subnormal: bits 0x0001 = smallest positive subnormal = 2^-24
assert_eq(f16_bits_to_f32(0x0001), pow2i(-24))

# infinity
assert(f16_bits_to_f32(0x7C00) > 3.0e38 as float32, "0x7C00 should decode to +Inf")

print "test_io: all assertions passed"
