# src/model.br — config extraction from GGUF metadata, weight loading
# (dequantizing Q8_0 tensors on the fly), and the Phase 1 CPU-only forward
# pass (no KV-cache — full re-forward every position, see math.br's header
# comment for why that's deliberate at this phase).
#
# Architecture-generic across the Llama/Mistral/Qwen2 GGUF family: every
# `Config` field is read from GGUF's own `{arch}.*` metadata keys (never
# hardcoded to one architecture's values), RoPE dispatches on the real
# per-architecture rotation convention (see rope_style_for_arch's own doc
# comment below — Qwen2 and Llama/Mistral genuinely differ here, GGUF has
# no metadata key for it), and attention Q/K/V bias tensors (present for
# Qwen2, absent for Llama/Mistral) fall back to an all-zero vector via
# `load_tensor_f32_or_zero` when the GGUF file doesn't have them. Verified
# against real Qwen2 and Llama GGUF files; the reproducible comparison tools
# live under tools/.

use io
use gguf
use gguf_file
use quant
use math
use math_gpu
use float16_gpu
use q8kv_gpu
use kvplane
use sampling

pub struct Config:
    int vocab_size
    int d_model
    int n_layer
    int n_head
    int n_kv_head
    int d_head
    int ffn_dim
    float32 rope_freq_base
    [float32] rope_freqs   # per-pair RoPE table incl. scaling, d_head/2 + 1 floats (see math.br rope_apply_at)
    float32 rms_eps
    bool tied_embeddings
    int rope_neox   # 1 = NEOX/"rotate-half" (Qwen2), 0 = NORM/interleaved (Llama/Mistral)
    int act         # FFN activation: 0 = silu (gated) / gelu (non-gated), 1 = gelu tanh (GeGLU), 2 = relu2 (non-gated), 3 = relu (ReGLU)
    float32 embd_scale   # token embeddings are multiplied by this (Gemma: sqrt(d_model)), 1 otherwise
    # Gemma 2/3 (all neutral for every other architecture)
    bool attn_ext          # use the general attention path (explicit scale, softcap, window)
    float32 attn_scale     # attention score scale (1 / sqrt(d_head) unless the architecture says otherwise)
    float32 attn_softcap   # > 0: attention scores are soft-capped (Gemma 2)
    float32 final_softcap  # > 0: output logits are soft-capped (Gemma 2)
    int swa_window         # > 0: sliding-window layers attend to this many recent positions
    int swa_pattern        # layer l is sliding-window when l % swa_pattern < swa_pattern - 1
    [float32] rope_freqs_local   # RoPE table of the sliding-window layers
    bool post_norms        # RMS norms on the attention and FFN outputs before the residual add
    bool no_pre_norm       # OLMo2 / EXAONE 4.0: no pre-attention or pre-FFN norm (only post-attention and post-FFN norms)
    int n_expert           # mixture of experts: experts per MoE layer (0 = dense model)
    int n_expert_used      # experts each token is routed to
    int expert_ffn         # width of one expert's FFN
    float32 residual_scale # branch outputs (attention, FFN) are multiplied by this before the residual add (Granite)
    float32 logit_mul      # the output logits are multiplied by this (Granite: 1 / logit_scale)
    int nope_step          # SmolLM3: every nope_step-th layer has no rotary embedding (0 = all layers have one)
    bool qk_norm    # Qwen3/OLMoE/Hunyuan: an RMS norm over Q and K (per-head d_head or full-row qkv_dim/kv_dim)
    bool qk_norm_post_rope # Hunyuan: apply attn_q_norm/attn_k_norm after RoPE instead of before
    int q_norm_heads
    int q_norm_dim
    int k_norm_heads
    int k_norm_dim
    int shexp_ffn          # shared-expert FFN width (0 = no shared expert)
    bool moe_norm_weights  # whether routed top-k expert weights are renormalized to sum to 1
    float32 moe_weights_scale # scale factor applied to routed expert weights (default 1.0)
    int moe_gating_func    # 1 = softmax (default), 2 = sigmoid
    bool use_layer_norm    # true = LayerNorm (subtract mean), false = RMSNorm
    bool has_norm_bias     # true = norms use bias vectors (LayerNorm or RMSNorm + bias)
    int residual_type      # 0 = sequential, 1 = single-norm parallel, 2 = dual-norm parallel
    bool ffn_gated         # true = gated GLU FFN, false = non-gated FFN
    bool has_linear_bias   # true = o_b / up_b / down_b / output_b may be non-zero
    bool has_pos_embd      # GPT-2: learned position_embd.weight added to token embeddings
    bool pre_attn_router   # SmallThinker: MoE router logits projected from pre-attention residual
    bool swa_first_global  # SmallThinker: l % swa_pattern == 0 is full+NoPE (vs < swa_pattern - 1 SWA)

pub struct Layer:
    [float32] attn_norm_w
    [float32] attn_norm_b
    [float32] q_w
    [float32] q_b
    [float32] k_w
    [float32] k_b
    [float32] v_w
    [float32] v_b
    [float32] o_w
    [float32] o_b
    [float32] ffn_norm_w
    [float32] ffn_norm_b
    [float32] gate_w
    [float32] up_w
    [float32] up_b
    [float32] down_w
    [float32] down_b
    [float32] q_norm_w   # q_norm_dim floats; zeros and unused unless config.qk_norm
    [float32] k_norm_w
    [float32] attn_post_norm_w   # d_model floats; zeros and unused unless config.post_norms
    [float32] ffn_post_norm_w
    bool is_moe                  # this layer's FFN is a mixture of experts (router_w + exp_* instead of gate/up/down)
    [float32] router_w           # (n_expert x d_model)
    [float32] exp_probs_b        # n_expert expert selection bias (zeros when absent)
    [[float32]] exp_gate         # per expert (expert_ffn x d_model)
    [[float32]] exp_up
    [[float32]] exp_down         # per expert (d_model x expert_ffn)
    bool has_shexp
    [float32] shexp_gate_w
    [float32] shexp_up_w
    [float32] shexp_down_w
    bool has_shexp_gate
    [float32] shexp_gate_inp_w
    bool has_attn_gate
    [float32] attn_gate_w

pub struct Model:
    Config config
    [float32] tok_embd
    [float32] pos_embd
    [Layer] layers
    [float32] output_norm_w
    [float32] output_norm_b
    [float32] output_w
    [float32] output_b

# Phase 2b: same shape as Layer, but every big matmul-heavy weight (Q/K/V/O
# projections, FFN gate/up/down) stays as raw quantized-packed bytes
# instead of being dequantized to a full [float32] copy at load time —
# biases and norms are always F32 in real GGUF files regardless of
# quantization level, so those stay plain [float32] here too. Each weight
# carries its own ggml type tag alongside its bytes (`*_type`) because a
# real quantized GGUF file mixes formats per tensor role, not one format
# for the whole file — verified directly against a real downloaded
# Qwen2.5-0.5B-Instruct "Q4_K_M" file: attn_q/k/attn_output/ffn_gate/
# ffn_up are Q5_0, attn_v is Q8_0, ffn_down alternates Q4_K/Q6_K by layer.
# tensor_linear_gpu (math_gpu.br) dispatches on this tag to the matching
# quantized tensor format.
# One expert's three projections, resident on the GPU in their own quantization.
pub struct ExpertW:
    [uint8]'kernel'unified gate_w
    int gate_type
    [uint8]'kernel'unified up_w
    int up_type
    [uint8]'kernel'unified down_w
    int down_type

pub struct QuantLayer:
    [float32]'kernel'unified attn_norm_w
    [float32]'kernel'unified attn_norm_b
    [uint8]'kernel'unified q_w_q8
    int q_w_type
    [float32]'kernel'unified q_b
    [uint8]'kernel'unified k_w_q8
    int k_w_type
    [float32]'kernel'unified k_b
    [uint8]'kernel'unified v_w_q8
    int v_w_type
    [float32]'kernel'unified v_b
    [uint8]'kernel'unified qkv_w_q8
    [float32]'kernel'unified qkv_b
    bool qkv_fused
    [uint8]'kernel'unified o_w_q8
    int o_w_type
    [float32]'kernel'unified o_b
    [float32]'kernel'unified ffn_norm_w
    [float32]'kernel'unified ffn_norm_b
    [uint8]'kernel'unified gate_w_q8
    int gate_w_type
    [uint8]'kernel'unified up_w_q8
    int up_w_type
    [float32]'kernel'unified up_b
    [uint8]'kernel'unified down_w_q8
    int down_w_type
    [float32]'kernel'unified down_b
    [float32]'kernel'unified q_norm_w   # d_head floats; zeros and unused unless config.qk_norm
    [float32]'kernel'unified k_norm_w
    [float32]'kernel'unified attn_post_norm_w
    [float32]'kernel'unified ffn_post_norm_w
    [float32]'kernel'unified rope_freqs   # this layer's resident RoPE table (global or sliding-window)
    bool is_moe
    [float32]'kernel'unified router_w     # (n_expert x d_model), float32
    [float32]'kernel'unified router_b     # n_expert zeros
    [float32] exp_probs_b                 # n_expert expert selection bias (host-side, zeros when absent)
    [ExpertW] experts
    bool has_shexp
    [uint8]'kernel'unified shexp_gate_w_q8
    int shexp_gate_w_type
    [uint8]'kernel'unified shexp_up_w_q8
    int shexp_up_w_type
    [uint8]'kernel'unified shexp_down_w_q8
    int shexp_down_w_type
    bool has_shexp_gate
    [float32]'kernel'unified shexp_gate_inp_w
    [float32]'kernel'unified shexp_gate_inp_b
    bool has_attn_gate
    [uint8]'kernel'unified attn_gate_w_q8
    int attn_gate_w_type

pub struct QuantModel:
    Config config
    [uint8] tok_embd_q8
    int tok_embd_type
    [float32] pos_embd
    [QuantLayer] layers
    [float32]'kernel'unified output_norm_w
    [float32]'kernel'unified output_norm_b
    [uint8]'kernel'unified output_w_q8
    int output_w_type
    [float32]'kernel'unified output_b

GgufTensorInfo find_tensor([GgufTensorInfo] tensors, string name) throws:
    for t in tensors:
        if t.name == name:
            return t
    throw "tensor not found: {name}"

bool tensor_exists([GgufTensorInfo] tensors, string name):
    for t in tensors:
        if t.name == name:
            return true
    false

# Qwen2's attention Q/K/V projections carry a bias tensor; Llama/Mistral's
# don't (llama.cpp never even writes `*.attn_{q,k,v}.bias` into their
# GGUFs) — treating it as always-present, as an earlier Qwen2-only version
# of this file did, throws "tensor not found" on any non-Qwen2 GGUF. Falls
# back to an all-zero bias vector of the expected width when absent, which
# is a no-op added onto `linear_bias`'s output either way.
pub [float32] load_tensor_f32_or_zero(GgufFile file, string name, int n) throws:
    load_tensor_f32_or(file, name, n, 0.0 as float32)

[float32] load_tensor_f32_or_one(GgufFile file, string name, int n) throws:
    load_tensor_f32_or(file, name, n, 1.0 as float32)

[float32] load_tensor_f32_or(GgufFile file, string name, int n, float32 fill) throws:
    if tensor_exists(file.tensors, name):
        load_tensor_f32(file, name)
    else:
        [fill for i in 0..<n]

int tensor_n_elements(GgufTensorInfo t):
    var int n = 1
    for d in t.dims:
        n = n * d
    n

# Loads a tensor's raw packed bytes plus its own ggml type — any of the
# quantized formats this project's fused GPU kernels understand (Q5_0,
# Q8_0, Q4_K, Q6_K; see quant.br's quantized_row_bytes for the type ids).
pub ([uint8], int) load_tensor_quantized(GgufFile file, string name) throws:
    let t = find_tensor(file.tensors, name)
    let n = tensor_n_elements(t)
    let n_bytes = quantized_row_bytes(t.ggml_type, n)
    let start = file.data_offset + t.offset
    (file_bytes(file, start, n_bytes), t.ggml_type)

pub [float32] load_tensor_f32(GgufFile file, string name) throws:
    let t = find_tensor(file.tensors, name)
    let n = tensor_n_elements(t)
    let start = file.data_offset + t.offset
    # read only this tensor's bytes (from disk when the file was opened by
    # path), then decode from offset 0
    let n_bytes = if t.ggml_type == 0: n * 4 elif t.ggml_type == 1: n * 2 else: quantized_row_bytes(t.ggml_type, n)
    let raw = file_bytes(file, start, n_bytes)
    if t.ggml_type == 0:
        mut [float32] result = [0.0 for i in 0..<n]
        var int i = 0
        while i < n:
            result[i] = read_f32_le(raw, i * 4) as float32
            i += 1
        result
    elif t.ggml_type == 1:
        mut [float32] result = [0.0 for i in 0..<n]
        var int i = 0
        while i < n:
            result[i] = f16_bits_to_f32(read_u16_le(raw, i * 2))
            i += 1
        result
    elif t.ggml_type == 2:
        dequantize_q4_0(raw, 0, n)
    elif t.ggml_type == 6:
        dequantize_q5_0(raw, 0, n)
    elif t.ggml_type == 8:
        dequantize_q8_0(raw, 0, n)
    elif t.ggml_type == 10:
        dequantize_q2_k(raw, 0, n)
    elif t.ggml_type == 11:
        dequantize_q3_k(raw, 0, n)
    elif t.ggml_type == 12:
        dequantize_q4_k(raw, 0, n)
    elif t.ggml_type == 14:
        dequantize_q6_k(raw, 0, n)
    elif t.ggml_type == 20:
        dequantize_iq4_nl(raw, 0, n)
    elif t.ggml_type == 3 or t.ggml_type == 7 or t.ggml_type == 13 or t.ggml_type == 23 or t.ggml_type == 30 or is_grid_quant_type(t.ggml_type):
        dequantize_row(t.ggml_type, raw, 0, n)
    else:
        throw "load_tensor_f32: unsupported ggml type {ggml_type_name(t.ggml_type)} for tensor '{name}'"

# GGUF has no explicit metadata key for RoPE's rotation convention (NEOX
# "rotate-half", pairs (j, j+half_dim) vs NORM/GPT-J "interleaved", pairs
# (2j, 2j+1)) — llama.cpp itself hardcodes this per architecture
# (`llama_model_rope_type` in its own src/llama-model.cpp), not derived
# from any GGUF field, so this project has to mirror that table rather
# than read it. Verified empirically against real downloaded weights, not
# just transcribed from llama.cpp's source: Qwen2.5-0.5B-Instruct needs
# NEOX (already correct pre-generalization) and TinyLlama-1.1B-Chat
# (architecture "llama" — also covers plain Mistral, which reuses the same
# GGUF architecture string) needs NORM — a 4-decimal-place logit match on
# the interleaved formula against NEOX's complete divergence beyond
# position 0 leaves no ambiguity about which is which. Scoped to exactly
# this project's target family for now; throws
# on anything else rather than silently guessing (same "fail loud on an
# unhandled case" convention as quant.br's unsupported-ggml-type error).
int rope_style_for_arch(string arch) throws:
    if arch == "qwen2" or arch == "qwen3" or arch == "phi3" or arch == "phi2" or arch == "phimoe" or arch == "starcoder2" or arch == "gptneox" or arch == "falcon" or arch == "gemma" or arch == "gemma2" or arch == "gemma3" or arch == "qwen3moe" or arch == "qwen2moe" or arch == "olmoe" or arch == "olmo2" or arch == "exaone" or arch == "exaone4" or arch == "exaone-moe" or arch == "dots1" or arch == "hunyuan-dense" or arch == "hunyuan-moe" or arch == "glm4moe" or arch == "bailingmoe2" or arch == "seed_oss" or arch == "afmoe" or arch == "smallthinker" or arch == "stablelm":
        1
    elif arch == "llama" or arch == "granite" or arch == "granitemoe" or arch == "smollm3" or arch == "deepseek" or arch == "internlm2" or arch == "mistral3" or arch == "glm4" or arch == "minicpm" or arch == "command-r" or arch == "cohere2" or arch == "ernie4_5" or arch == "ernie4_5-moe" or arch == "arcee" or arch == "bailingmoe" or arch == "olmo" or arch == "gpt2":
        0
    else:
        throw "config_from_gguf: unsupported architecture '{arch}' (supported: 'llama' (also Mistral and Mixtral), 'mistral3', 'qwen2', 'qwen2moe', 'qwen3', 'qwen3moe', 'olmo', 'olmo2', 'olmoe', 'exaone', 'exaone4', 'exaone-moe', 'internlm2', 'glm4', 'glm4moe', 'minicpm', 'granite', 'granitemoe', 'deepseek', 'smollm3', 'phi3', 'phi2', 'phimoe', 'starcoder2', 'gptneox', 'gpt2', 'stablelm', 'falcon', 'command-r', 'cohere2', 'gemma', 'gemma2', 'gemma3', 'dots1', 'ernie4_5', 'ernie4_5-moe', 'hunyuan-dense', 'hunyuan-moe', 'bailingmoe', 'bailingmoe2', 'arcee', 'seed_oss', 'afmoe', 'smallthinker'; check llama.cpp's llama_model_rope_type() and build_* graph before adding one)"

# The context size the engine runs with (`--ctx-size`), set before the model is loaded:
# Phi-3's LongRoPE picks its factor set from it.
static var int rope_context_size = 4096

pub def set_rope_context_size(int n):
    rope_context_size = n

# Builds the per-pair RoPE table (math.br `rope_apply_at`) from the GGUF's
# scaling metadata, mirroring llama.cpp:
#   - a `rope_freqs.weight` tensor (Llama 3.1+; the converter precomputes the
#     per-pair divisors) or Phi-3's `rope_factors_short/long.weight` (long once
#     `set_rope_context_size` exceeds the original context, as llama.cpp does)
#     divide the plain frequencies;
#   - `{arch}.rope.scaling.type` = `linear` divides every frequency by `factor`;
#   - `yarn` uses `factor`, `original_context_length`, `yarn_beta_fast`/`slow`
#     (llama.cpp defaults 32 / 1) and `attn_factor` (default 1).
[float32] rope_table_from_gguf(GgufFile file, string arch, int d_head, float32 base) throws:
    let attn_factor = gguf_get_f32(file.metadata, "{arch}.rope.scaling.attn_factor") else (1.0 as float32)
    if tensor_exists(file.tensors, "rope_freqs.weight"):
        rope_freqs_factors(d_head, base, load_tensor_f32(file, "rope_freqs.weight"), 1.0)
    elif tensor_exists(file.tensors, "rope_factors_short.weight"):
        # Phi-3 LongRoPE: like llama.cpp, the long factors apply once the context the engine
        # runs with (n_ctx, padded to a multiple of 256) exceeds the original training context.
        let ctx_train = gguf_get_int(file.metadata, "{arch}.context_length") else 4096
        let orig_ctx = gguf_get_int(file.metadata, "{arch}.rope.scaling.original_context_length") else ctx_train
        let n_ctx = ((rope_context_size + 255) / 256) * 256
        let use_long = tensor_exists(file.tensors, "rope_factors_long.weight") and n_ctx > orig_ctx
        let factors_name = if use_long: "rope_factors_long.weight" else: "rope_factors_short.weight"
        rope_freqs_factors(d_head, base, load_tensor_f32(file, factors_name), attn_factor)
    else:
        let kind = gguf_get_string(file.metadata, "{arch}.rope.scaling.type") else "none"
        let factor = gguf_get_f32(file.metadata, "{arch}.rope.scaling.factor") else (1.0 as float32)
        if kind == "linear":
            rope_freqs_linear(d_head, base, factor)
        elif kind == "yarn":
            let orig = gguf_get_int(file.metadata, "{arch}.rope.scaling.original_context_length") else 4096
            let beta_fast = gguf_get_f32(file.metadata, "{arch}.rope.scaling.yarn_beta_fast") else (32.0 as float32)
            let beta_slow = gguf_get_f32(file.metadata, "{arch}.rope.scaling.yarn_beta_slow") else (1.0 as float32)
            rope_freqs_yarn(d_head, base, factor, orig as float32, beta_fast, beta_slow, attn_factor)
        elif kind == "none":
            rope_freqs_plain(d_head, base)
        else:
            throw "config_from_gguf: unsupported {arch}.rope.scaling.type '{kind}' (supported: none, linear, yarn)"

pub Config config_from_gguf(GgufFile file) throws:
    guard let arch = gguf_get_string(file.metadata, "general.architecture") else throw "GGUF: missing general.architecture"
    guard let n_layer = gguf_get_int(file.metadata, "{arch}.block_count") else throw "GGUF: missing {arch}.block_count"
    guard let d_model = gguf_get_int(file.metadata, "{arch}.embedding_length") else throw "GGUF: missing {arch}.embedding_length"
    guard let n_head = gguf_get_int(file.metadata, "{arch}.attention.head_count") else throw "GGUF: missing {arch}.attention.head_count"
    let n_kv_head = gguf_get_int(file.metadata, "{arch}.attention.head_count_kv") else n_head
    let n_expert = gguf_get_int(file.metadata, "{arch}.expert_count") else 0
    let n_expert_used = gguf_get_int(file.metadata, "{arch}.expert_used_count") else 0
    let expert_ffn_key = gguf_get_int(file.metadata, "{arch}.expert_feed_forward_length") else 0
    guard n_expert == 0 or (n_expert_used >= 1 and n_expert_used <= n_expert) else throw "GGUF: {arch}.expert_used_count must be between 1 and expert_count"
    let ffn_dim = gguf_get_int(file.metadata, "{arch}.feed_forward_length") else expert_ffn_key
    guard ffn_dim > 0 else throw "GGUF: missing {arch}.feed_forward_length"
    let expert_ffn = if expert_ffn_key > 0: expert_ffn_key else: ffn_dim
    let rope_freq_base = gguf_get_f32(file.metadata, "{arch}.rope.freq_base") else (10000.0 as float32)
    let use_layer_norm = arch == "phi2" or arch == "starcoder2" or arch == "gptneox" or arch == "falcon" or arch == "command-r" or arch == "cohere2" or arch == "olmo" or arch == "stablelm" or arch == "gpt2"
    let rms_eps = if use_layer_norm:
        gguf_get_f32(file.metadata, "{arch}.attention.layer_norm_epsilon") else (1.0e-5 as float32)
    else:
        gguf_get_f32(file.metadata, "{arch}.attention.layer_norm_rms_epsilon") else (1.0e-6 as float32)
    let vocab_size = gguf_get_string_array(file.metadata, "tokenizer.ggml.tokens").length
    let rope_neox = rope_style_for_arch(arch)

    var bool has_output = false
    for t in file.tensors:
        if t.name == "output.weight":
            has_output = true

    # The head size is `{arch}.attention.key_length` when the file says so (Qwen3's
    # is 128 whatever d_model / n_head is: 2560 / 32 = 80 for the 4B model);
    # otherwise d_model / n_head, which is what Llama and Qwen2 files mean.
    let d_head = gguf_get_int(file.metadata, "{arch}.attention.key_length") else (d_model / n_head)
    let value_len = gguf_get_int(file.metadata, "{arch}.attention.value_length") else d_head
    guard value_len == d_head else throw "config_from_gguf: key_length {d_head} != value_length {value_len} is not supported"
    let qk_norm = tensor_exists(file.tensors, "blk.0.attn_q_norm.weight")
    let qk_norm_post_rope = qk_norm and (arch == "hunyuan-dense" or arch == "hunyuan-moe")
    let q_norm_dim = if qk_norm: find_tensor(file.tensors, "blk.0.attn_q_norm.weight").dims[0] else: d_head
    let k_norm_dim = if qk_norm: find_tensor(file.tensors, "blk.0.attn_k_norm.weight").dims[0] else: d_head
    let q_norm_heads = (n_head * d_head) / q_norm_dim
    let k_norm_heads = (n_kv_head * d_head) / k_norm_dim
    let shexp_ffn_key = gguf_get_int(file.metadata, "{arch}.expert_shared_feed_forward_length") else 0
    let n_shexp = gguf_get_int(file.metadata, "{arch}.expert_shared_count") else 0
    let shexp_ffn = if shexp_ffn_key > 0: shexp_ffn_key else: n_shexp * expert_ffn
    let default_moe_norm = if arch == "smallthinker":
        true
    else:
        not (arch == "qwen2moe" or arch == "olmoe" or arch == "deepseek" or arch == "dots1" or arch == "glm4moe" or arch == "bailingmoe" or arch == "bailingmoe2" or arch == "afmoe")
    let moe_norm_weights = if arch == "smallthinker": true else: (gguf_get_bool(file.metadata, "{arch}.expert_weights_norm") else default_moe_norm)
    let moe_weights_scale = gguf_get_f32(file.metadata, "{arch}.expert_weights_scale") else (1.0 as float32)
    let default_moe_gating = if arch == "exaone-moe" or arch == "glm4moe" or arch == "afmoe":
        2
    elif arch == "smallthinker":
        3
    else:
        1
    let moe_gating_func = gguf_get_int(file.metadata, "{arch}.expert_gating_func") else default_moe_gating

    let rope_freqs = rope_table_from_gguf(file, arch, d_head, rope_freq_base)
    # Gemma: GeGLU instead of SwiGLU, and token embeddings scaled by sqrt(d_model)
    # (its converter already stores the RMSNorm weights as w + 1).
    let is_gemma = arch == "gemma" or arch == "gemma2" or arch == "gemma3"
    let is_gemma_ext = arch == "gemma2" or arch == "gemma3"
    let has_post_norms = tensor_exists(file.tensors, "blk.0.post_ffw_norm.weight") or (tensor_exists(file.tensors, "blk.0.post_attention_norm.weight") and tensor_exists(file.tensors, "blk.0.ffn_norm.weight"))
    let no_pre_norm = not use_layer_norm and not tensor_exists(file.tensors, "blk.0.attn_norm.weight")
    # Granite / MiniCPM: explicit scales instead of sqrt(d) / 1 / sqrt(d_head) / 1
    let granite_embd = gguf_get_f32(file.metadata, "{arch}.embedding_scale") else (0.0 as float32)
    let granite_attn = gguf_get_f32(file.metadata, "{arch}.attention.scale") else (0.0 as float32)
    let granite_resid = gguf_get_f32(file.metadata, "{arch}.residual_scale") else (0.0 as float32)
    let granite_logit = gguf_get_f32(file.metadata, "{arch}.logit_scale") else (0.0 as float32)
    let is_cohere = arch == "command-r" or arch == "cohere2"
    let logit_mul = if granite_logit > 0.0: (if is_cohere: granite_logit else: (1.0 as float32) / granite_logit) else: (1.0 as float32)
    let is_exaone_swa = (arch == "exaone4" and n_layer == 64) or arch == "exaone-moe"
    let is_swa_arch = is_gemma_ext or arch == "olmo2" or is_exaone_swa or arch == "cohere2" or arch == "afmoe" or arch == "smallthinker"
    let raw_swa_window = if is_swa_arch: (gguf_get_int(file.metadata, "{arch}.attention.sliding_window") else 0) else: 0
    let swa_window = if arch == "smallthinker" and raw_swa_window > 0: 4096 else: raw_swa_window
    let swa_pattern = if arch == "gemma3":
        6
    elif arch == "olmo2" or is_exaone_swa or arch == "cohere2" or arch == "afmoe" or arch == "smallthinker":
        gguf_get_int(file.metadata, "{arch}.attention.sliding_window_pattern") else 4
    else:
        2
    let swa_first_global = arch == "smallthinker"
    let nope_step = if arch == "gpt2":
        1
    elif arch == "smollm3":
        4
    elif arch == "smallthinker":
        if raw_swa_window > 0 and n_layer != 4: 4 else: 0
    elif (is_exaone_swa or arch == "cohere2" or arch == "afmoe") and swa_window > 0:
        swa_pattern
    else:
        0
    let act = if is_gemma: 1 elif arch == "arcee": 2 elif arch == "smallthinker": 3 else: 0
    let embd_scale = if is_gemma or arch == "afmoe": (d_model as float32).sqrt() elif granite_embd > 0.0: granite_embd else: (1.0 as float32)

    # Gemma 2/3 (mirrors llama.cpp's load_hparams / build_gemma2 / build_gemma3):
    # post-attention and post-FFN norms, a score scale of 1/sqrt(d_head) (the
    # largest models use 1/sqrt(d_model / n_head)), sliding-window layers
    # (every other layer for Gemma 2, five of six for Gemma 3) and, for Gemma 2,
    # soft-capping of attention scores and output logits. Gemma 3's sliding
    # layers use their own unscaled RoPE base.
    let big = (arch == "gemma2" and n_layer == 46) or (arch == "gemma3" and n_layer == 62)
    let attn_scale = if granite_attn > 0.0: granite_attn elif big: 1.0 / ((d_model / n_head) as float32).sqrt() else: 1.0 / (d_head as float32).sqrt()
    let attn_softcap = if arch == "gemma2": (gguf_get_f32(file.metadata, "{arch}.attn_logit_softcapping") else (0.0 as float32)) else: (0.0 as float32)
    let final_softcap = if arch == "gemma2": (gguf_get_f32(file.metadata, "{arch}.final_logit_softcapping") else (0.0 as float32)) else: (0.0 as float32)
    let rope_local_base = gguf_get_f32(file.metadata, "{arch}.rope.freq_base_swa") else (10000.0 as float32)
    let rope_freqs_local = if arch == "gemma3": rope_freqs_plain(d_head, rope_local_base) else: rope_freqs
    let has_norm_bias = use_layer_norm or tensor_exists(file.tensors, "output_norm.bias") or tensor_exists(file.tensors, "blk.0.attn_norm.bias")
    let gptneox_par = gguf_get_bool(file.metadata, "gptneox.use_parallel_residual") else true
    let falcon_two_norms = tensor_exists(file.tensors, "blk.0.attn_norm_2.weight")
    let stablelm_par = arch == "stablelm" and not tensor_exists(file.tensors, "blk.0.ffn_norm.weight")
    let residual_type = if arch == "phi2" or is_cohere or (arch == "falcon" and not falcon_two_norms) or stablelm_par:
        1
    elif (arch == "gptneox" and gptneox_par) or (arch == "falcon" and falcon_two_norms):
        2
    else:
        0
    let ffn_gated = not (arch == "phi2" or arch == "starcoder2" or arch == "gptneox" or arch == "falcon" or arch == "arcee" or arch == "gpt2")
    let has_linear_bias = tensor_exists(file.tensors, "blk.0.attn_output.bias") or tensor_exists(file.tensors, "blk.0.ffn_up.bias") or tensor_exists(file.tensors, "blk.0.ffn_down.bias") or tensor_exists(file.tensors, "output.bias")
    let has_pos_embd = tensor_exists(file.tensors, "position_embd.weight")
    let pre_attn_router = arch == "smallthinker"

    Config(vocab_size, d_model, n_layer, n_head, n_kv_head, d_head,
           ffn_dim, rope_freq_base, rope_freqs, rms_eps, not has_output, rope_neox, act, embd_scale,
           is_gemma_ext or granite_attn > 0.0 or swa_window > 0, attn_scale, attn_softcap, final_softcap, swa_window, swa_pattern, rope_freqs_local,
           has_post_norms, no_pre_norm, n_expert, n_expert_used, expert_ffn,
           if granite_resid > 0.0: granite_resid else: (1.0 as float32),
           logit_mul, nope_step, qk_norm, qk_norm_post_rope,
           q_norm_heads, q_norm_dim, k_norm_heads, k_norm_dim,
           shexp_ffn, moe_norm_weights, moe_weights_scale, moe_gating_func,
           use_layer_norm, has_norm_bias, residual_type, ffn_gated, has_linear_bias,
           has_pos_embd, pre_attn_router, swa_first_global)

# Phi-3 stores the attention projections as one `attn_qkv.weight` (rows: Q, then
# K, then V) and the FFN as one `ffn_up.weight` holding gate then up (ggml's
# swiglu activates the first half), with no separate `ffn_gate`. These helpers
# return one logical projection of a layer as either its own tensor or the
# matching row range of the fused one, so everything downstream sees the usual
# separate Q/K/V/gate/up weights. Rows of a quantized matrix are contiguous, so
# a row range is a plain byte range.
#
# `which`: 0 = Q, 1 = K, 2 = V (attention); 0 = gate, 1 = up (FFN).
(int, int) attn_rows(Config c, int which):
    let q_dim = c.n_head * c.d_head
    let kv_dim = c.n_kv_head * c.d_head
    if which == 0:
        (0, q_dim)
    elif which == 1:
        (q_dim, kv_dim)
    else:
        (q_dim + kv_dim, kv_dim)

([uint8], int) load_rows_quantized(GgufFile file, string name, int row_start, int n_rows) throws:
    let t = find_tensor(file.tensors, name)
    let row_bytes = quantized_row_bytes(t.ggml_type, t.dims[0])
    let start = file.data_offset + t.offset + row_start * row_bytes
    (file_bytes(file, start, n_rows * row_bytes), t.ggml_type)

([uint8], int) load_attn_quantized(GgufFile file, Config c, string prefix, int which) throws:
    if tensor_exists(file.tensors, "{prefix}.attn_qkv.weight"):
        let (row_start, n_rows) = attn_rows(c, which)
        load_rows_quantized(file, "{prefix}.attn_qkv.weight", row_start, n_rows)
    else:
        let names = ["attn_q", "attn_k", "attn_v"]
        load_tensor_quantized(file, "{prefix}.{names[which]}.weight")

([uint8], int) load_ffn_in_quantized(GgufFile file, Config c, string prefix, int which) throws:
    if not c.ffn_gated:
        if which == 0:
            ([0 as uint8], 8)
        else:
            load_tensor_quantized(file, "{prefix}.ffn_up.weight")
    elif tensor_exists(file.tensors, "{prefix}.ffn_gate.weight"):
        let names = ["ffn_gate", "ffn_up"]
        load_tensor_quantized(file, "{prefix}.{names[which]}.weight")
    else:
        load_rows_quantized(file, "{prefix}.ffn_up.weight", which * c.ffn_dim, c.ffn_dim)

[float32] load_rows_f32(GgufFile file, string name, int row_start, int n_rows) throws:
    let t = find_tensor(file.tensors, name)
    let all = load_tensor_f32(file, name)
    let d_in = t.dims[0]
    let offset = row_start * d_in
    [all[offset + i] for i in 0..<(n_rows * d_in)]

[float32] load_attn_f32(GgufFile file, Config c, string prefix, int which) throws:
    if tensor_exists(file.tensors, "{prefix}.attn_qkv.weight"):
        let (row_start, n_rows) = attn_rows(c, which)
        load_rows_f32(file, "{prefix}.attn_qkv.weight", row_start, n_rows)
    else:
        let names = ["attn_q", "attn_k", "attn_v"]
        load_tensor_f32(file, "{prefix}.{names[which]}.weight")

[float32] load_attn_bias_f32(GgufFile file, Config c, string prefix, int which) throws:
    let (row_start, n_rows) = attn_rows(c, which)
    if tensor_exists(file.tensors, "{prefix}.attn_qkv.bias"):
        let all = load_tensor_f32(file, "{prefix}.attn_qkv.bias")
        [all[row_start + i] for i in 0..<n_rows]
    else:
        let names = ["attn_q", "attn_k", "attn_v"]
        load_tensor_f32_or_zero(file, "{prefix}.{names[which]}.bias", n_rows)

[float32] load_ffn_in_f32(GgufFile file, Config c, string prefix, int which) throws:
    if not c.ffn_gated:
        if which == 0:
            [0.0 as float32]
        else:
            load_tensor_f32(file, "{prefix}.ffn_up.weight")
    elif tensor_exists(file.tensors, "{prefix}.ffn_gate.weight"):
        let names = ["ffn_gate", "ffn_up"]
        load_tensor_f32(file, "{prefix}.{names[which]}.weight")
    else:
        load_rows_f32(file, "{prefix}.ffn_up.weight", which * c.ffn_dim, c.ffn_dim)

# Mixture of experts: the router is `ffn_gate_inp.weight` and each projection of every expert is one
# row range of a stacked tensor `ffn_{gate,up,down}_exps.weight` (dims [d_in, d_out, n_expert]).
bool layer_is_moe(GgufFile file, string prefix):
    tensor_exists(file.tensors, "{prefix}.ffn_gate_inp.weight")

# Expert e of a stacked tensor, dequantized: rows e * n_rows ..< (e + 1) * n_rows.
[[float32]] load_experts_f32(GgufFile file, string name, int n_expert, int n_rows) throws:
    let t = find_tensor(file.tensors, name)
    let all = load_tensor_f32(file, name)
    let per = n_rows * t.dims[0]
    mut [[float32]] out = []
    var int e = 0
    while e < n_expert:
        let offset = e * per
        out.push([all[offset + i] for i in 0..<per])
        e += 1
    out

pub Model load_model(GgufFile file) throws:
    let config = config_from_gguf(file)
    let tok_embd = load_tensor_f32(file, "token_embd.weight")
    let pos_embd = if config.has_pos_embd: load_tensor_f32(file, "position_embd.weight") else: [0.0 as float32]
    let norm_fill = if config.use_layer_norm: (1.0 as float32) else: (0.0 as float32)
    let qkv_dim = config.n_head * config.d_head
    let kv_dim = config.n_kv_head * config.d_head

    mut [Layer] layers = []
    var int l = 0
    while l < config.n_layer:
        let prefix = "blk.{l}"
        let moe = layer_is_moe(file, prefix)
        let has_shexp = tensor_exists(file.tensors, "{prefix}.ffn_gate_shexp.weight")
        let has_shexp_gate = tensor_exists(file.tensors, "{prefix}.ffn_gate_inp_shexp.weight")
        let has_attn_gate = tensor_exists(file.tensors, "{prefix}.attn_gate.weight")
        let has_norm_2 = tensor_exists(file.tensors, "{prefix}.attn_norm_2.weight")
        let has_post_as_ffn = not tensor_exists(file.tensors, "{prefix}.ffn_norm.weight") and tensor_exists(file.tensors, "{prefix}.post_attention_norm.weight")
        let attn_norm_name = if has_norm_2: "{prefix}.attn_norm_2" else: "{prefix}.attn_norm"
        let ffn_norm_name = if has_norm_2: "{prefix}.attn_norm" elif has_post_as_ffn: "{prefix}.post_attention_norm" else: "{prefix}.ffn_norm"
        let layer = Layer(
            load_tensor_f32_or(file, "{attn_norm_name}.weight", config.d_model, norm_fill),
            load_tensor_f32_or_zero(file, "{attn_norm_name}.bias", config.d_model),
            load_attn_f32(file, config, prefix, 0),
            load_attn_bias_f32(file, config, prefix, 0),
            load_attn_f32(file, config, prefix, 1),
            load_attn_bias_f32(file, config, prefix, 1),
            load_attn_f32(file, config, prefix, 2),
            load_attn_bias_f32(file, config, prefix, 2),
            load_tensor_f32(file, "{prefix}.attn_output.weight"),
            load_tensor_f32_or_zero(file, "{prefix}.attn_output.bias", config.d_model),
            load_tensor_f32_or(file, "{ffn_norm_name}.weight", config.d_model, norm_fill),
            load_tensor_f32_or_zero(file, "{ffn_norm_name}.bias", config.d_model),
            if moe: [0.0 as float32] else: load_ffn_in_f32(file, config, prefix, 0),
            if moe: [0.0 as float32] else: load_ffn_in_f32(file, config, prefix, 1),
            load_tensor_f32_or_zero(file, "{prefix}.ffn_up.bias", config.ffn_dim),
            if moe: [0.0 as float32] else: load_tensor_f32(file, "{prefix}.ffn_down.weight"),
            load_tensor_f32_or_zero(file, "{prefix}.ffn_down.bias", config.d_model),
            load_tensor_f32_or_zero(file, "{prefix}.attn_q_norm.weight", config.q_norm_dim),
            load_tensor_f32_or_zero(file, "{prefix}.attn_k_norm.weight", config.k_norm_dim),
            load_tensor_f32_or_zero(file, "{prefix}.post_attention_norm.weight", config.d_model),
            load_tensor_f32_or_zero(file, "{prefix}.post_ffw_norm.weight", config.d_model),
            moe,
            if moe: load_tensor_f32(file, "{prefix}.ffn_gate_inp.weight") else: [0.0 as float32],
            if moe: load_tensor_f32_or_zero(file, "{prefix}.exp_probs_b.bias", config.n_expert) else: [0.0 as float32],
            if moe: load_experts_f32(file, "{prefix}.ffn_gate_exps.weight", config.n_expert, config.expert_ffn) else: [],
            if moe: load_experts_f32(file, "{prefix}.ffn_up_exps.weight", config.n_expert, config.expert_ffn) else: [],
            if moe: load_experts_f32(file, "{prefix}.ffn_down_exps.weight", config.n_expert, config.d_model) else: [],
            has_shexp,
            if has_shexp: load_tensor_f32(file, "{prefix}.ffn_gate_shexp.weight") else: [0.0 as float32],
            if has_shexp: load_tensor_f32(file, "{prefix}.ffn_up_shexp.weight") else: [0.0 as float32],
            if has_shexp: load_tensor_f32(file, "{prefix}.ffn_down_shexp.weight") else: [0.0 as float32],
            has_shexp_gate,
            if has_shexp_gate: load_tensor_f32(file, "{prefix}.ffn_gate_inp_shexp.weight") else: [0.0 as float32],
            has_attn_gate,
            if has_attn_gate: load_tensor_f32(file, "{prefix}.attn_gate.weight") else: [0.0 as float32])
        layers.push(layer)
        l += 1

    let output_norm_w = load_tensor_f32_or_one(file, "output_norm.weight", config.d_model)
    let output_norm_b = load_tensor_f32_or_zero(file, "output_norm.bias", config.d_model)
    let output_w = resolve_output_weight(file, config, tok_embd)
    let output_b = load_tensor_f32_or_zero(file, "output.bias", config.vocab_size)

    Model(config, tok_embd, pos_embd, layers, output_norm_w, output_norm_b, output_w, output_b)

# Split out of load_model as its own function specifically so `tok_embd` is
# borrowed here (arrays are always passed by reference to functions) rather
# than moved — reusing it directly via `var output_w = tok_embd` followed by
# a later reference to the original `tok_embd` is a real move-then-use error
# in the transpiled Rust (`Vec<f32>` isn't `Copy`), since a bare local-to-
# local array assignment moves rather than clones.
[float32] resolve_output_weight(GgufFile file, Config config, [float32] tok_embd) throws:
    if config.tied_embeddings:
        tok_embd
    else:
        load_tensor_f32(file, "output.weight")

# Phase 2b model loading: every big matmul-heavy weight stays as raw
# quantized-packed bytes (see QuantLayer's doc comment), each tagged with
# its own ggml type — throws clearly (via load_tensor_quantized/
# quantized_row_bytes) if a tensor's type isn't one of the four this
# project's fused GPU kernels understand (Q5_0/Q8_0/Q4_K/Q6_K), rather than
# silently misreading its bytes.
pub QuantModel load_model_quantized(GgufFile file) throws:
    let config = config_from_gguf(file)
    let (tok_embd_q8, tok_embd_type) = load_tensor_quantized(file, "token_embd.weight")
    let pos_embd = if config.has_pos_embd: load_tensor_f32(file, "position_embd.weight") else: [0.0 as float32]
    let norm_fill = if config.use_layer_norm: (1.0 as float32) else: (0.0 as float32)
    let qkv_dim = config.n_head * config.d_head
    let kv_dim = config.n_kv_head * config.d_head

    mut [QuantLayer] layers = []
    var int l = 0
    while l < config.n_layer:
        let prefix = "blk.{l}"
        let (q_w, q_ty) = load_attn_quantized(file, config, prefix, 0)
        let (k_w, k_ty) = load_attn_quantized(file, config, prefix, 1)
        let (v_w, v_ty) = load_attn_quantized(file, config, prefix, 2)
        let (o_w, o_ty) = load_tensor_quantized(file, "{prefix}.attn_output.weight")
        let moe = layer_is_moe(file, prefix)
        # a MoE layer has no dense FFN: one-byte placeholders keep the layer's field layout
        let placeholder = [0 as uint8]
        let (gate_w, gate_ty) = if moe: (placeholder, 8) else: load_ffn_in_quantized(file, config, prefix, 0)
        let (up_w, up_ty) = if moe: (placeholder, 8) else: load_ffn_in_quantized(file, config, prefix, 1)
        let (down_w, down_ty) = if moe: (placeholder, 8) else: load_tensor_quantized(file, "{prefix}.ffn_down.weight")
        # Every expert's three projections become their own resident buffers (row ranges of the stacked tensors).
        mut [ExpertW] experts = []
        if moe:
            var int e = 0
            while e < config.n_expert:
                let (eg, eg_ty) = load_rows_quantized(file, "{prefix}.ffn_gate_exps.weight", e * config.expert_ffn, config.expert_ffn)
                let (eu, eu_ty) = load_rows_quantized(file, "{prefix}.ffn_up_exps.weight", e * config.expert_ffn, config.expert_ffn)
                let (ed, ed_ty) = load_rows_quantized(file, "{prefix}.ffn_down_exps.weight", e * config.d_model, config.d_model)
                experts.push(ExpertW(upload_bytes_gpu(with_iq_prefix(eg, eg_ty)), gpu_weight_type(eg_ty), upload_bytes_gpu(with_iq_prefix(eu, eu_ty)), gpu_weight_type(eu_ty), upload_bytes_gpu(with_iq_prefix(ed, ed_ty)), gpu_weight_type(ed_ty)))
                e += 1
        let router_w_host = if moe: load_tensor_f32(file, "{prefix}.ffn_gate_inp.weight") else: [0.0 as float32]
        let has_shexp = tensor_exists(file.tensors, "{prefix}.ffn_gate_shexp.weight")
        let (sh_gate_w, sh_gate_ty) = if has_shexp: load_tensor_quantized(file, "{prefix}.ffn_gate_shexp.weight") else: (placeholder, 8)
        let (sh_up_w, sh_up_ty) = if has_shexp: load_tensor_quantized(file, "{prefix}.ffn_up_shexp.weight") else: (placeholder, 8)
        let (sh_down_w, sh_down_ty) = if has_shexp: load_tensor_quantized(file, "{prefix}.ffn_down_shexp.weight") else: (placeholder, 8)
        let has_shexp_gate = tensor_exists(file.tensors, "{prefix}.ffn_gate_inp_shexp.weight")
        let shexp_gate_inp_host = if has_shexp_gate: load_tensor_f32(file, "{prefix}.ffn_gate_inp_shexp.weight") else: [0.0 as float32]
        let has_attn_gate = tensor_exists(file.tensors, "{prefix}.attn_gate.weight")
        let (attn_gate_w, attn_gate_ty) = if has_attn_gate: load_tensor_quantized(file, "{prefix}.attn_gate.weight") else: (placeholder, 8)
        let q_b = load_attn_bias_f32(file, config, prefix, 0)
        let k_b = load_attn_bias_f32(file, config, prefix, 1)
        let v_b = load_attn_bias_f32(file, config, prefix, 2)
        let has_norm_2 = tensor_exists(file.tensors, "{prefix}.attn_norm_2.weight")
        let has_post_as_ffn = not tensor_exists(file.tensors, "{prefix}.ffn_norm.weight") and tensor_exists(file.tensors, "{prefix}.post_attention_norm.weight")
        let attn_norm_name = if has_norm_2: "{prefix}.attn_norm_2" else: "{prefix}.attn_norm"
        let ffn_norm_name = if has_norm_2: "{prefix}.attn_norm" elif has_post_as_ffn: "{prefix}.post_attention_norm" else: "{prefix}.ffn_norm"
        # Q/K/V have the same row-packed Q8_0 layout on the 0.5B model. Joining
        # their rows lets decode issue one native projection instead of three.
        # Keep a one-element placeholder elsewhere: duplicating hundreds of MB
        # of weights on larger or mixed-format models would erase the benefit.
        let qkv_fused = config.d_model <= 1024 and q_ty == 8 and k_ty == 8 and v_ty == 8
        mut [uint8] qkv_w = [0 as uint8]
        mut [float32] qkv_b = [0.0 as float32]
        if qkv_fused:
            qkv_w = []
            for value in q_w: qkv_w.push(value)
            for value in k_w: qkv_w.push(value)
            for value in v_w: qkv_w.push(value)
            qkv_b = []
            for value in q_b: qkv_b.push(value)
            for value in k_b: qkv_b.push(value)
            for value in v_b: qkv_b.push(value)
        # Every weight and norm/bias is uploaded to the GPU exactly once, here,
        # and stays resident for the model's lifetime (see upload_bytes_gpu).
        let layer = QuantLayer(
            upload_floats_gpu(load_tensor_f32_or(file, "{attn_norm_name}.weight", config.d_model, norm_fill)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{attn_norm_name}.bias", config.d_model)),
            upload_bytes_gpu(with_iq_prefix(q_w, q_ty)), gpu_weight_type(q_ty),
            upload_floats_gpu(q_b),
            upload_bytes_gpu(with_iq_prefix(k_w, k_ty)), gpu_weight_type(k_ty),
            upload_floats_gpu(k_b),
            upload_bytes_gpu(with_iq_prefix(v_w, v_ty)), gpu_weight_type(v_ty),
            upload_floats_gpu(v_b),
            upload_bytes_gpu(qkv_w), upload_floats_gpu(qkv_b), qkv_fused,
            upload_bytes_gpu(with_iq_prefix(o_w, o_ty)), gpu_weight_type(o_ty),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.attn_output.bias", config.d_model)),
            upload_floats_gpu(load_tensor_f32_or(file, "{ffn_norm_name}.weight", config.d_model, norm_fill)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{ffn_norm_name}.bias", config.d_model)),
            upload_bytes_gpu(with_iq_prefix(gate_w, gate_ty)), gpu_weight_type(gate_ty),
            upload_bytes_gpu(with_iq_prefix(up_w, up_ty)), gpu_weight_type(up_ty),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.ffn_up.bias", config.ffn_dim)),
            upload_bytes_gpu(with_iq_prefix(down_w, down_ty)), gpu_weight_type(down_ty),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.ffn_down.bias", config.d_model)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.attn_q_norm.weight", config.q_norm_dim)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.attn_k_norm.weight", config.k_norm_dim)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.post_attention_norm.weight", config.d_model)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.post_ffw_norm.weight", config.d_model)),
            upload_floats_gpu(layer_rope_freqs(config, l)),
            moe, upload_floats_gpu(router_w_host), upload_floats_gpu([0.0 for i in 0..<(if moe: config.n_expert else: 1)]),
            if moe: load_tensor_f32_or_zero(file, "{prefix}.exp_probs_b.bias", config.n_expert) else: [0.0 as float32],
            experts,
            has_shexp,
            upload_bytes_gpu(with_iq_prefix(sh_gate_w, sh_gate_ty)), gpu_weight_type(sh_gate_ty),
            upload_bytes_gpu(with_iq_prefix(sh_up_w, sh_up_ty)), gpu_weight_type(sh_up_ty),
            upload_bytes_gpu(with_iq_prefix(sh_down_w, sh_down_ty)), gpu_weight_type(sh_down_ty),
            has_shexp_gate, upload_floats_gpu(shexp_gate_inp_host), upload_floats_gpu([0.0 as float32]),
            has_attn_gate, upload_bytes_gpu(with_iq_prefix(attn_gate_w, attn_gate_ty)), gpu_weight_type(attn_gate_ty))
        layers.push(layer)
        l += 1

    let output_norm_w = load_tensor_f32_or_one(file, "output_norm.weight", config.d_model)
    let output_norm_b = load_tensor_f32_or_zero(file, "output_norm.bias", config.d_model)
    let (output_w_q8, output_w_type) = resolve_output_weight_q8(file, config, tok_embd_q8, tok_embd_type)
    let output_b = load_tensor_f32_or_zero(file, "output.bias", config.vocab_size)

    QuantModel(config, tok_embd_q8, tok_embd_type, pos_embd, layers, upload_floats_gpu(output_norm_w), upload_floats_gpu(output_norm_b), upload_bytes_gpu(with_iq_prefix(output_w_q8, output_w_type)), gpu_weight_type(output_w_type), upload_floats_gpu(output_b))

([uint8], int) resolve_output_weight_q8(GgufFile file, Config config, [uint8] tok_embd_q8, int tok_embd_type) throws:
    if config.tied_embeddings:
        (tok_embd_q8, tok_embd_type)
    else:
        load_tensor_quantized(file, "output.weight")

# Sliding-window layers: when `swa_first_global` (SmallThinker), layer l % pattern == 0 is global
# and l % pattern > 0 is local; otherwise (Gemma 2/3, OLMo 2, EXAONE 4/MoE, Cohere 2, AfMoE),
# l % pattern < pattern - 1 is local.
bool layer_is_swa(Config c, int l):
    if c.swa_window <= 0:
        false
    elif c.swa_first_global:
        (l % c.swa_pattern) > 0
    else:
        (l % c.swa_pattern) < c.swa_pattern - 1

int layer_window(Config c, int l):
    if layer_is_swa(c, l):
        c.swa_window
    else:
        0

# NoPE / GPT-2 (nope_step == 1) / SmallThinker (swa_first_global: l % nope_step == 0) /
# SmolLM3, EXAONE4, Cohere2, AfMoE ((l + 1) % nope_step == 0): identity rotation.
[float32] layer_rope_freqs(Config c, int l):
    let is_nope = if c.nope_step <= 0:
        false
    elif c.nope_step == 1:
        true
    elif c.swa_first_global:
        (l % c.nope_step) == 0
    else:
        (l + 1) % c.nope_step == 0
    if is_nope:
        return [if i == c.rope_freqs.length - 1: (1.0 as float32) else: (0.0 as float32) for i in 0..<c.rope_freqs.length]
    if layer_is_swa(c, l):
        c.rope_freqs_local
    else:
        c.rope_freqs

# The output logits as the model defines them: scaled (Granite), then soft-capped (Gemma 2).
[float32] finish_logits([float32] logits, Config c):
    if c.logit_mul != 1.0:
        softcap_logits([logits[i] * c.logit_mul for i in 0..<logits.length], c.final_softcap)
    else:
        softcap_logits(logits, c.final_softcap)

# Soft-caps every logit: cap * tanh(logit / cap) (Gemma 2's final_logit_softcapping).
[float32] softcap_logits([float32] logits, float32 cap):
    if cap > 0.0:
        [cap * (logits[i] / cap).tanh() for i in 0..<logits.length]
    else:
        logits

# Multiplies an embedding row by `scale` (Gemma scales token embeddings by
# sqrt(d_model); 1.0 for every other architecture leaves the row untouched).
[float32] scale_row([float32] row, float32 scale):
    if scale == 1.0:
        row
    else:
        [row[i] * scale for i in 0..<row.length]

# Routing of one token, as llama.cpp's build_moe_ffn: softmax (1 or 3 = softmax_weight) or sigmoid (2)
# over the router logits, the n_used most probable experts, optionally renormalized to sum to 1
# (`norm_weights`) and scaled by `weights_scale`. Returns (expert ids, weights).
pub ([int], [float32]) moe_route_ext([float32] logits, [float32] exp_probs_b, int n_expert, int n_used, int gating_func, bool norm_weights, float32 weights_scale):
    mut [float32] probs = [0.0 for k in 0..<n_expert]
    if gating_func == 2:
        var int i = 0
        while i < n_expert:
            probs[i] = 1.0 / (1.0 + (0.0 - logits[i]).exp())
            i += 1
    else:
        var float32 maximum = logits[0]
        var int i = 1
        while i < n_expert:
            if logits[i] > maximum:
                maximum = logits[i]
            i += 1
        var float32 total = 0.0
        i = 0
        while i < n_expert:
            probs[i] = (logits[i] - maximum).exp()
            total = total + probs[i]
            i += 1
        i = 0
        while i < n_expert:
            probs[i] = probs[i] / total
            i += 1
    mut [int] chosen = []
    mut [float32] weights = []
    var float32 kept = 0.0
    var int pick = 0
    while pick < n_used:
        var int best = -1
        var int e = 0
        while e < n_expert:
            let sel_e = probs[e] + exp_probs_b[e]
            let sel_best = if best >= 0: probs[best] + exp_probs_b[best] else: (0.0 as float32)
            if not chosen.contains(e) and (best < 0 or sel_e > sel_best):
                best = e
            e += 1
        chosen.push(best)
        weights.push(probs[best])
        kept = kept + probs[best]
        pick += 1
    mut [float32] out_weights = []
    for w in weights:
        let normed_w = if norm_weights and kept > 0.0: w / kept else: w
        out_weights.push(normed_w * weights_scale)
    (chosen, out_weights)

pub ([int], [float32]) moe_route([float32] logits, int n_expert, int n_used):
    moe_route_ext(logits, [0.0 as float32 for k in 0..<n_expert], n_expert, n_used, 1, true, 1.0 as float32)

# CPU mixture-of-experts FFN using precomputed `router_logits` (over `seq` rows of d_model floats).
pub [float32] moe_ffn_with_logits_cpu(Config config, Layer layer, [float32] x, [float32] router_logits, int seq):
    let d = config.d_model
    mut [float32] out = [0.0 for i in 0..<(seq * d)]
    var int t = 0
    while t < seq:
        let row = [x[t * d + i] for i in 0..<d]
        let (chosen, weights) = moe_route_ext([router_logits[t * config.n_expert + e] for e in 0..<config.n_expert], layer.exp_probs_b, config.n_expert, config.n_expert_used, config.moe_gating_func, config.moe_norm_weights, config.moe_weights_scale)
        var int k = 0
        while k < chosen.length:
            let e = chosen[k]
            let y = swiglu_ffn(row, layer.exp_gate[e], layer.exp_up[e], layer.exp_down[e], 1, d, config.expert_ffn, config.act)
            var int i = 0
            while i < d:
                out[t * d + i] = out[t * d + i] + weights[k] * y[i]
                i += 1
            k += 1
        t += 1
    if layer.has_shexp:
        let sh_out = swiglu_ffn(x, layer.shexp_gate_w, layer.shexp_up_w, layer.shexp_down_w, seq, d, config.shexp_ffn, config.act)
        if layer.has_shexp_gate:
            var int r = 0
            while r < seq:
                var float32 dot = 0.0
                var int j = 0
                while j < d:
                    dot = dot + x[r * d + j] * layer.shexp_gate_inp_w[j]
                    j += 1
                let g = 1.0 / (1.0 + (0.0 - dot).exp())
                j = 0
                while j < d:
                    out[r * d + j] = out[r * d + j] + g * sh_out[r * d + j]
                    j += 1
                r += 1
        else:
            var int idx = 0
            while idx < seq * d:
                out[idx] = out[idx] + sh_out[idx]
                idx += 1
    out

# CPU mixture-of-experts FFN over `seq` rows of d_model floats.
pub [float32] moe_ffn_cpu(Config config, Layer layer, [float32] x, int seq):
    let router_logits = linear(x, layer.router_w, seq, config.d_model, config.n_expert)
    moe_ffn_with_logits_cpu(config, layer, x, router_logits, seq)

# GPU mixture-of-experts FFN over `n` rows (`normed2`: n x d_model, resident), with either
# precomputed host router logits (when `pre_logits.length > 0`) or freshly projected ones.
([float32]'kernel'unified, int) moe_ffn_gpu(QuantModel model, QuantLayer layer, [float32]'kernel'unified normed2, [float32] pre_logits, int n) throws:
    let d = model.config.d_model
    let n_expert = model.config.n_expert
    let ffn_e = model.config.expert_ffn
    var [float32] logits = pre_logits
    if pre_logits.length == 0:
        let router_logits = linear_gpu(normed2, layer.router_w, layer.router_b, n, d, n_expert)
        logits = passthrough(router_logits)
    mut [[int]] rows_of = [[] for e in 0..<n_expert]
    mut [[float32]] weights_of = [[] for e in 0..<n_expert]
    var int t = 0
    while t < n:
        let (chosen, weights) = moe_route_ext([logits[t * n_expert + e] for e in 0..<n_expert], layer.exp_probs_b, n_expert, model.config.n_expert_used, model.config.moe_gating_func, model.config.moe_norm_weights, model.config.moe_weights_scale)
        var int k = 0
        while k < chosen.length:
            rows_of[chosen[k]].push(t)
            weights_of[chosen[k]].push(weights[k])
            k += 1
        t += 1
    var [float32]'kernel'unified acc = upload_floats_gpu([0.0 for i in 0..<(n * d)])
    var int e = 0
    while e < n_expert:
        let m = rows_of[e].length
        if m > 0:
            let ex = layer.experts[e]
            let xin = gather_rows_gpu(normed2, [rows_of[e][i] as float32 for i in 0..<m], m, d)
            let gate = tensor_linear_nobias_gpu(xin, ex.gate_w, ex.gate_type, m, d, ffn_e)
            let up = tensor_linear_nobias_gpu(xin, ex.up_w, ex.up_type, m, d, ffn_e)
            let hidden = glu_combine_gpu(gate, up, model.config.act)
            let y = tensor_linear_nobias_gpu(hidden, ex.down_w, ex.down_type, m, ffn_e, d)
            mut [float32] pos = [-1.0 as float32 for r in 0..<n]
            var int i = 0
            while i < m:
                pos[rows_of[e][i]] = i as float32
                i += 1
            acc = moe_accumulate_gpu(acc, y, pos, weights_of[e], n, d)
        e += 1
    if layer.has_shexp:
        let ffn_sh = model.config.shexp_ffn
        let sh_gate = tensor_linear_nobias_gpu(normed2, layer.shexp_gate_w_q8, layer.shexp_gate_w_type, n, d, ffn_sh)
        let sh_up = tensor_linear_nobias_gpu(normed2, layer.shexp_up_w_q8, layer.shexp_up_w_type, n, d, ffn_sh)
        let sh_hidden = glu_combine_gpu(sh_gate, sh_up, model.config.act)
        var sh_out = tensor_linear_nobias_gpu(sh_hidden, layer.shexp_down_w_q8, layer.shexp_down_w_type, n, ffn_sh, d)
        if layer.has_shexp_gate:
            let sh_logits = linear_gpu(normed2, layer.shexp_gate_inp_w, layer.shexp_gate_inp_b, n, d, 1)
            sh_out = sigmoid_gate_rows_gpu(sh_out, sh_logits, n, d)
        acc = add_gpu(acc, sh_out, n * d)
    (acc, 0)

[float32] apply_qk_norm_cpu([float32] x, [float32] w, int rows, int dim, Config config):
    if config.use_layer_norm:
        norm_cpu(x, w, [0.0 as float32 for i in 0..<dim], rows, dim, config.rms_eps, true)
    else:
        rms_norm(x, w, rows, dim, config.rms_eps)

[float32] with_pos_embd_host([float32] x, [float32] pos_embd, Config c, int seq, int start_pos):
    if not c.has_pos_embd:
        return x
    let d = c.d_model
    mut [float32] out = [x[i] for i in 0..<x.length]
    var int p = 0
    while p < seq:
        let pos = start_pos + p
        var int i = 0
        while i < d:
            out[p * d + i] = out[p * d + i] + pos_embd[pos * d + i]
            i += 1
        p += 1
    out

[float32] embed_tokens_q(QuantModel model, [int] tokens, int start_pos) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let tok_embd_row_bytes = quantized_row_bytes(model.tok_embd_type, d)
    mut [float32] x = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        let row_byte_offset = tok * tok_embd_row_bytes
        let row = dequantize_row(model.tok_embd_type, model.tok_embd_q8, row_byte_offset, d)
        var int i = 0
        while i < d:
            x[p * d + i] = row[i] * model.config.embd_scale
            i += 1
        p += 1
    with_pos_embd_host(x, model.pos_embd, model.config, seq, start_pos)

req [float32]'kernel'unified apply_nongated_ffn_gpu(Config config, QuantLayer layer, [float32]'kernel'unified normed2, int seq) throws:
    let up = tensor_linear_gpu(normed2, layer.up_w_q8, layer.up_w_type, layer.up_b, seq, config.d_model, config.ffn_dim)
    let hidden = nongated_act_gpu(up, seq * config.ffn_dim, config.act)
    tensor_linear_gpu(hidden, layer.down_w_q8, layer.down_w_type, layer.down_b, seq, config.ffn_dim, config.d_model)

[float32] compute_pre_router_logits(Config config, QuantLayer layer, [float32]'kernel'unified x, int seq) throws:
    if layer.is_moe and config.pre_attn_router:
        let raw = linear_gpu(x, layer.router_w, layer.router_b, seq, config.d_model, config.n_expert)
        return passthrough(raw)
    []

# Full (uncached) forward pass over every position in `tokens`. Returns
# logits for every position (seq * vocab_size), row-major — the caller
# typically only needs the last position's row for greedy next-token
# prediction, but every position is computed since there's no KV-cache yet.
pub [float32] forward(Model model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    var mut [float32] x = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        var int i = 0
        while i < d:
            let pos_add = if model.config.has_pos_embd: model.pos_embd[p * d + i] else: (0.0 as float32)
            x[p * d + i] = model.tok_embd[tok * d + i] * model.config.embd_scale + pos_add
            i += 1
        p += 1

    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]
        let pre_router_logits = if layer.is_moe and model.config.pre_attn_router:
            linear(x, layer.router_w, seq, d, model.config.n_expert)
        else:
            []

        let normed = if model.config.no_pre_norm:
            x
        elif model.config.has_norm_bias:
            norm_cpu(x, layer.attn_norm_w, layer.attn_norm_b, seq, d, model.config.rms_eps, model.config.use_layer_norm)
        else:
            rms_norm(x, layer.attn_norm_w, seq, d, model.config.rms_eps)
        var q = linear_bias(normed, layer.q_w, layer.q_b, seq, d, qkv_dim)
        var k = linear_bias(normed, layer.k_w, layer.k_b, seq, d, kv_dim)
        let v = linear_bias(normed, layer.v_w, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm and not model.config.qk_norm_post_rope:
            q = apply_qk_norm_cpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config)
            k = apply_qk_norm_cpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config)
        let rope_t = layer_rope_freqs(model.config, l)
        q = rope_apply(q, seq, model.config.n_head, model.config.d_head, rope_t, model.config.rope_neox)
        k = rope_apply(k, seq, model.config.n_kv_head, model.config.d_head, rope_t, model.config.rope_neox)
        if model.config.qk_norm_post_rope:
            q = apply_qk_norm_cpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config)
            k = apply_qk_norm_cpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config)
        var attn_out = gqa_attention_ext(q, k, v, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head,
                                         model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        if layer.has_attn_gate:
            let gate_proj = linear(normed, layer.attn_gate_w, seq, d, qkv_dim)
            attn_out = mul_sigmoid_cpu(attn_out, gate_proj)
        var attn_proj = if model.config.has_linear_bias: linear_bias(attn_out, layer.o_w, layer.o_b, seq, qkv_dim, d) else: linear(attn_out, layer.o_w, seq, qkv_dim, d)
        if model.config.post_norms:
            attn_proj = rms_norm(attn_proj, layer.attn_post_norm_w, seq, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            attn_proj = [attn_proj[i] * model.config.residual_scale for i in 0..<attn_proj.length]
        if model.config.residual_type == 0:
            x = vec_add(x, attn_proj)
        let normed2 = if model.config.residual_type == 1:
            normed
        elif model.config.residual_type == 2:
            if model.config.has_norm_bias: norm_cpu(x, layer.ffn_norm_w, layer.ffn_norm_b, seq, d, model.config.rms_eps, model.config.use_layer_norm) else: rms_norm(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        else:
            if model.config.no_pre_norm: x elif model.config.has_norm_bias: norm_cpu(x, layer.ffn_norm_w, layer.ffn_norm_b, seq, d, model.config.rms_eps, model.config.use_layer_norm) else: rms_norm(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        var ffn_out = if layer.is_moe and model.config.pre_attn_router:
            moe_ffn_with_logits_cpu(model.config, layer, normed2, pre_router_logits, seq)
        elif layer.is_moe:
            moe_ffn_cpu(model.config, layer, normed2, seq)
        elif model.config.ffn_gated:
            swiglu_ffn(normed2, layer.gate_w, layer.up_w, layer.down_w, seq, d, model.config.ffn_dim, model.config.act)
        else:
            nongated_ffn(normed2, layer.up_w, layer.up_b, layer.down_w, layer.down_b, seq, d, model.config.ffn_dim, model.config.act)
        if model.config.post_norms:
            ffn_out = rms_norm(ffn_out, layer.ffn_post_norm_w, seq, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            ffn_out = [ffn_out[i] * model.config.residual_scale for i in 0..<ffn_out.length]
        if model.config.residual_type != 0:
            x = vec_add(x, vec_add(attn_proj, ffn_out))
        else:
            x = vec_add(x, ffn_out)

        l += 1

    let final_normed = if model.config.has_norm_bias: norm_cpu(x, model.output_norm_w, model.output_norm_b, seq, d, model.config.rms_eps, model.config.use_layer_norm) else: rms_norm(x, model.output_norm_w, seq, d, model.config.rms_eps)
    let raw_logits = if model.config.has_linear_bias: linear_bias(final_normed, model.output_w, model.output_b, seq, d, model.config.vocab_size) else: linear(final_normed, model.output_w, seq, d, model.config.vocab_size)
    finish_logits(raw_logits, model.config)

# Phase 2a: same forward pass, but every matmul/norm/RoPE/attention op runs
# as a real GPU kernel (math_gpu.br) instead of a CPU loop. Still no
# KV-cache — full re-forward every position, same as forward() above — the
# goal here is proving the kernel architecture matches Phase 1's CPU output
# bit-for-bit-ish (float32 rounding aside), not decode performance yet.
pub [float32] forward_gpu(Model model, [int] tokens) throws:
    guard not model.config.attn_ext else throw "forward_gpu: Gemma 2/3 need the quantized GPU path (--quantized)"
    guard model.config.n_expert == 0 else throw "forward_gpu: mixture-of-experts models need the quantized GPU path (--quantized)"
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    var mut [float32] x = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        var int i = 0
        while i < d:
            x[p * d + i] = model.tok_embd[tok * d + i] * model.config.embd_scale
            i += 1
        p += 1

    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        # Chaining one GPU host function's result directly into the next
        # used to need a `passthrough()` round-trip (task_63a8da7f/
        # task_6179e0f9, both fixed upstream — confirmed empirically before
        # removing this) — direct chaining works correctly now.
        let normed = rms_norm_gpu(x, layer.attn_norm_w, seq, d, model.config.rms_eps)
        var q = linear_gpu(normed, layer.q_w, layer.q_b, seq, d, qkv_dim)
        var k = linear_gpu(normed, layer.k_w, layer.k_b, seq, d, kv_dim)
        let v = linear_gpu(normed, layer.v_w, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm and not model.config.qk_norm_post_rope:
            q = rms_norm_gpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps)
            k = rms_norm_gpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps)
        q = rope_apply_gpu(q, seq, model.config.n_head, model.config.d_head, model.config.rope_freqs, model.config.rope_neox)
        k = rope_apply_gpu(k, seq, model.config.n_kv_head, model.config.d_head, model.config.rope_freqs, model.config.rope_neox)
        if model.config.qk_norm_post_rope:
            q = rms_norm_gpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps)
            k = rms_norm_gpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps)
        let attn_out = attention_gqa_gpu(q, k, v, seq, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head, true, 0)
        let attn_proj = linear_nobias_gpu(attn_out, layer.o_w, seq, qkv_dim, d)
        x = vec_add(x, attn_proj)

        let normed2 = rms_norm_gpu(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        let gate = linear_nobias_gpu(normed2, layer.gate_w, seq, d, model.config.ffn_dim)
        let up = linear_nobias_gpu(normed2, layer.up_w, seq, d, model.config.ffn_dim)
        let hidden = glu_combine_gpu(gate, up, model.config.act)
        let ffn_out = linear_nobias_gpu(hidden, layer.down_w, seq, model.config.ffn_dim, d)
        x = vec_add(x, ffn_out)

        l += 1

    let final_normed = rms_norm_gpu(x, model.output_norm_w, seq, d, model.config.rms_eps)
    linear_nobias_gpu(final_normed, model.output_w, seq, d, model.config.vocab_size)

# Phase 2b: same forward pass as forward_gpu, but every big matmul-heavy
# weight is handled by the tensor quantized-linear primitive
# reading raw packed bytes directly — no CPU-side dequantization, no full
# fp32 weight copy ever materialized for these tensors (see math_gpu.br's
# Q8LinearKernel doc comment for the memory-savings rationale). Token
# embedding lookup dequantizes just the one needed row per position (cheap,
# CPU-side, quant.br's dequantize_q8_0) rather than the whole vocab table.
req [float32]'kernel'unified apply_norm_gpu([float32]'kernel'unified x, [float32] w, [float32] b, int seq, int d, Config config) throws:
    if config.has_norm_bias:
        return norm_gpu(x, w, b, seq, d, config.rms_eps, config.use_layer_norm)
    rms_norm_gpu(x, w, seq, d, config.rms_eps)

req [float32]'kernel'unified apply_pre_norm_gpu([float32]'kernel'unified x, [float32] w, [float32] b, int seq, int d, Config config) throws:
    if config.no_pre_norm:
        return x
    if config.has_norm_bias:
        return norm_gpu(x, w, b, seq, d, config.rms_eps, config.use_layer_norm)
    rms_norm_gpu(x, w, seq, d, config.rms_eps)

req [float32]'kernel'unified apply_linear_gpu([float32]'kernel'unified x, [uint8]'kernel'unified w_q8, int w_type, [float32]'kernel'unified b, int seq, int d_in, int d_out, bool has_bias) throws:
    if has_bias:
        return tensor_linear_gpu(x, w_q8, w_type, b, seq, d_in, d_out)
    tensor_linear_nobias_gpu(x, w_q8, w_type, seq, d_in, d_out)

req [float32]'kernel'unified forward_hidden_gpu_quantized(QuantModel model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let x0 = embed_tokens_q(model, tokens, 0)
    var [float32]'kernel'unified x = upload_floats_gpu(x0)

    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        let pre_router_logits = compute_pre_router_logits(model.config, layer, x, seq)
        let normed = apply_pre_norm_gpu(x, layer.attn_norm_w, layer.attn_norm_b, seq, d, model.config)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, seq, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, seq, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm and not model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k = apply_qk_norm_gpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        let rope_t = layer_rope_freqs(model.config, l)
        q = rope_apply_gpu(q, seq, model.config.n_head, model.config.d_head, rope_t, model.config.rope_neox)
        k = rope_apply_gpu(k, seq, model.config.n_kv_head, model.config.d_head, rope_t, model.config.rope_neox)
        if model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k = apply_qk_norm_gpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        var attn_out = attention_layer_gpu(q, k, v, seq, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head, 0,
            model.config.attn_ext, model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        if layer.has_attn_gate:
            let gate_proj = tensor_linear_nobias_gpu(normed, layer.attn_gate_w_q8, layer.attn_gate_w_type, seq, d, qkv_dim)
            attn_out = mul_sigmoid_gpu(attn_out, gate_proj, seq * qkv_dim)
        let attn_proj = apply_linear_gpu(attn_out, layer.o_w_q8, layer.o_w_type, layer.o_b, seq, qkv_dim, d, model.config.has_linear_bias)
        mut [float32]'kernel'unified attn_res = attn_proj
        if model.config.post_norms:
            attn_res = rms_norm_gpu(attn_proj, layer.attn_post_norm_w, seq, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            attn_res = scale_gpu(attn_res, model.config.residual_scale, seq * d)
        if model.config.residual_type == 0:
            x = add_gpu(x, attn_res, seq * d)
        mut [float32]'kernel'unified normed2 = []
        if model.config.residual_type == 1:
            normed2 = normed
        elif model.config.residual_type == 2:
            normed2 = apply_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, seq, d, model.config)
        else:
            normed2 = apply_pre_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, seq, d, model.config)
        mut [float32]'kernel'unified ffn_out = []
        if layer.is_moe:
            let ([float32]'kernel'unified moe_out, int moe_pad) = moe_ffn_gpu(model, layer, normed2, pre_router_logits, seq)
            ffn_out = moe_out
        elif model.config.ffn_gated:
            let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, seq, d, model.config.ffn_dim)
            let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, seq, d, model.config.ffn_dim)
            let hidden = glu_combine_gpu(gate, up, model.config.act)
            ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, seq, model.config.ffn_dim, d)
        else:
            ffn_out = apply_nongated_ffn_gpu(model.config, layer, normed2, seq)
        mut [float32]'kernel'unified ffn_res = []
        if model.config.post_norms:
            ffn_res = rms_norm_gpu(ffn_out, layer.ffn_post_norm_w, seq, d, model.config.rms_eps)
        else:
            ffn_res = ffn_out
        if model.config.residual_scale != 1.0:
            ffn_res = scale_gpu(ffn_res, model.config.residual_scale, seq * d)
        if model.config.residual_type != 0:
            let both_res = add_gpu(attn_res, ffn_res, seq * d)
            x = add_gpu(x, both_res, seq * d)
        else:
            x = add_gpu(x, ffn_res, seq * d)

        l += 1

    apply_norm_gpu(x, model.output_norm_w, model.output_norm_b, seq, d, model.config)

pub [float32] forward_gpu_quantized(QuantModel model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let final_normed = forward_hidden_gpu_quantized(model, tokens)
    let logits_raw = apply_linear_gpu(final_normed, model.output_w_q8, model.output_w_type, model.output_b, seq, d, model.config.vocab_size, model.config.has_linear_bias)
    finish_logits(passthrough(logits_raw), model.config)

# The embedding forward pass: the same layers as forward_gpu_quantized, but it returns the
# final-norm hidden state of every position (seq rows of d_model floats, no output head), which
# embedding.br pools.
pub [float32] hidden_states_gpu_quantized(QuantModel model, [int] tokens) throws:
    let final_normed = forward_hidden_gpu_quantized(model, tokens)
    passthrough(final_normed)

# Phase 3: greedy decoding — repeatedly calls forward_gpu_quantized on the
# whole sequence so far (no KV-cache, deliberately still deferred — see
# math.br's/forward()'s own header comments) and appends the argmax token,
# stopping at `eos_id` or once `max_new_tokens` have been generated.
# O(seq) forward passes each doing O(seq)-ish work, so total cost grows
# faster than linear in the number of new tokens — fine for a small model
# and short generations, a real cost KV-cache would remove (a documented,
# deliberate Phase 4 stretch item, not fixed here).
pub struct SamplingParams:
    float32 temperature   # <= 0 -> greedy argmax, ignores top_k/typical_p/top_p/min_p entirely
    float32 dynatemp_range # <= 0 -> fixed temperature
    float32 dynatemp_exponent # entropy-to-temperature curve
    float32 top_n_sigma   # <= 0 -> disabled; retain logits within n standard deviations of the maximum
    int top_k             # <= 0 -> use the full vocabulary, matching llama.cpp
    float32 typical_p     # >= 1.0 -> disabled; retain locally typical token probabilities
    float32 top_p         # >= 1.0 -> no nucleus filtering (keep the whole top-k set)
    float32 min_p         # <= 0 -> disabled; keep tokens at least min_p * max probability
    float32 xtc_probability # <= 0 -> disabled; chance of excluding top choices
    float32 xtc_threshold   # > 0.5 -> disabled; probability threshold for exclusion
    int min_keep          # minimum candidates retained by typical-p, top-p, min-p and XTC filters
    int seed
    float32 repeat_penalty  # == 1.0 -> disabled (this project's own default; llama.cpp's own default is 1.1)
    int repeat_last_n       # <= 0 -> penalize the whole history; llama.cpp's own default is 64
    float32 dry_multiplier  # == 0.0 -> disabled
    float32 dry_base
    int dry_allowed_length
    int dry_penalty_last_n
    [[int]] dry_breakers

pub SamplingParams greedy_params():
    SamplingParams(0.0 as float32, 0.0 as float32, 1.0 as float32, -1.0 as float32, 0, 1.0 as float32, 1.0 as float32,
        0.0 as float32, 0.0 as float32, 0.1 as float32, 0, 0, 1.0 as float32, 64,
        0.0 as float32, 1.75 as float32, 2, 64, [])

[float32] extract_row([float32] logits, int row, int vocab):
    mut [float32] out = [0.0 for i in 0..<vocab]
    let base = row * vocab
    var int i = 0
    while i < vocab:
        out[i] = logits[base + i]
        i += 1
    out

pub [int] generate(QuantModel model, [int] prompt_tokens, int max_new_tokens, int eos_id,
                    SamplingParams params) throws:
    mut [int] tokens = []
    for t in prompt_tokens:
        tokens.push(t)

    var rng = seed_rng(params.seed)
    let vocab = model.config.vocab_size
    var int generated = 0
    while generated < max_new_tokens:
        let logits = forward_gpu_quantized(model, tokens)
        let seq = tokens.length
        let last_logits = extract_row(logits, seq - 1, vocab)

        let (next_tok, new_rng) = sample(rng, last_logits, vocab, params.temperature, params.dynatemp_range, params.dynatemp_exponent, params.top_n_sigma, params.top_k, params.typical_p, params.top_p, params.min_p, params.xtc_probability, params.xtc_threshold, params.min_keep, tokens, params.repeat_penalty, params.repeat_last_n, params.dry_multiplier, params.dry_base, params.dry_allowed_length, params.dry_penalty_last_n, params.dry_breakers)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1
        if is_eog_token(next_tok, eos_id):
            return tokens

    tokens

# Same as generate() above, but for a plain Model —
# every tensor already dequantized to float32 at load time (load_model),
# with forward_gpu's fp32 kernels doing the actual compute. This remains a
# useful reference path for comparing the packed-weight tensor path against
# weights dequantized once at load time.
pub [int] generate_f32(Model model, [int] prompt_tokens, int max_new_tokens, int eos_id,
                        SamplingParams params) throws:
    mut [int] tokens = []
    for t in prompt_tokens:
        tokens.push(t)

    var rng = seed_rng(params.seed)
    let vocab = model.config.vocab_size
    var int generated = 0
    while generated < max_new_tokens:
        let logits = forward_gpu(model, tokens)
        let seq = tokens.length
        let last_logits = extract_row(logits, seq - 1, vocab)

        let (next_tok, new_rng) = sample(rng, last_logits, vocab, params.temperature, params.dynatemp_range, params.dynatemp_exponent, params.top_n_sigma, params.top_k, params.typical_p, params.top_p, params.min_p, params.xtc_probability, params.xtc_threshold, params.min_keep, tokens, params.repeat_penalty, params.repeat_last_n, params.dry_multiplier, params.dry_base, params.dry_allowed_length, params.dry_penalty_last_n, params.dry_breakers)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1
        if is_eog_token(next_tok, eos_id):
            return tokens

    tokens

# ── Phase 4: KV-cache incremental decode ────────────────────────────────
# generate() above re-forwards the WHOLE sequence from scratch every step
# (O(total_seq) work per layer's GEMMs, every single step) — correct, and
# the right thing to prove first, but wasteful. forward_step() below
# processes exactly ONE new token per call, growing each layer's K/V cache
# by one position instead of recomputing it — O(1) GEMM work per step
# (only attention's cost still scales with the cache size, which is
# unavoidable without a fundamentally different algorithm).
#
# Cache growing returns a NEW GenCache rather than mutating one in place —
# whisper-boring's decoder.br already documents why: passing a struct field
# as a `var [T]` parameter to mutate it doesn't actually write the mutation
# back, neither under `boring run` nor in the transpiled Rust. Returning
# the grown state and having the caller reassign is the pattern that
# actually works (mirrors mha_step_gpu's own `(out, new_cache_k,
# new_cache_v)` return shape).

# `k`/`v` are GPU-resident (`'kernel'unified`): they live on the device for the
# whole generation and are grown there by `kv_append_gpu`, never read back.
#
# A kernel cannot grow a device buffer in place, so every append builds a new
# buffer and copies the old rows: with the whole cache in one buffer that is a
# copy of the entire context per layer per token (35 ms/token at 2k tokens on
# the 7B model, growing linearly). The cache is therefore split in two: the
# main buffer (`k`/`v`, the oldest rows) and a short tail (`tk`/`tv`, the
# newest `GenCache.tail` rows). A decode step appends to the tail (a few dozen
# rows copied at most) and the tail is folded into the main buffer every
# TAIL_MAX tokens, so the full copy is amortised over TAIL_MAX steps. Prefill
# folds the tail first and works on one buffer.
pub struct LayerCache:
    Plane kp                       # main K rows: the first `GenCache.pos - GenCache.tail` are valid
    Plane vp
    [float32]'kernel'unified tk    # the newest `GenCache.tail` rows ([] when there are none)
    [float32]'kernel'unified tv

pub struct GenCache:
    [LayerCache] layers
    int pos        # absolute position of the NEXT token to be processed
    int tail       # how many of the newest positions live in the tail buffers
    int kt         # storage type of the main K rows: 0 f32, 1 f16, 2 q8_0 (see kvplane.br)
    int vt         # same for V

let int TAIL_MAX = 64

# Diagnostic marginal-cost mode. A non-zero value queues one extra copy of a
# decode stage using the same resident inputs and discards its result. There is
# deliberately no synchronization around the copy: the delta is measured in
# the real pipelined command stream. See tools/profile_decode_marginal.py.
static var int decode_profile_stage = 0
static var int kv_type_k = 0
static var int kv_type_v = 0

pub def set_decode_profile_stage(int stage):
    decode_profile_stage = stage

pub def set_kv_cache_types(string type_k, string type_v) throws:
    kv_type_k = kv_type_from_name(type_k)
    kv_type_v = kv_type_from_name(type_v)

pub def set_kv_cache_type(string cache_type) throws:
    set_kv_cache_types(cache_type, cache_type)

pub bool uses_float16_kv_cache():
    kv_type_k == 1 and kv_type_v == 1

pub bool uses_q8_kv_cache():
    kv_type_k == 2 and kv_type_v == 2

pub int kv_cache_type_k():
    kv_type_k

pub int kv_cache_type_v():
    kv_type_v

# Batched prefill: processes the WHOLE prompt in one pass per layer (same
# structure as forward_gpu_quantized — same kernels, same dispatch count
# regardless of how many prompt tokens there are), instead of feeding
# prompt tokens one at a time through forward_step. Capturing each layer's
# post-RoPE K/V here (rather than re-deriving them one position at a time)
# is what makes generate_kv() actually faster than the no-cache path for
# realistic prompt lengths — processing a 26-token prompt as 26 individual
# single-token GPU dispatch sequences turned out to be *slower* wall-clock
# than one batched 26-token forward, purely from per-kernel-launch overhead
# at this model's small scale (confirmed empirically before adding this).
pub ([float32], GenCache) prefill_gpu_quantized(QuantModel model, [int] tokens) throws:
    guard (kv_type_k == 0 and kv_type_v == 0) or model.config.attn_ext or (model.config.d_head % 32 == 0 and model.config.d_head <= 128) else throw "packed KV caches require an attention head size that is a multiple of 32 up to 128"
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    # Residual stream: uploaded once, then kept on the device across layers.
    var x = upload_floats_gpu(embed_tokens_q(model, tokens, 0))

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        let pre_router_logits = compute_pre_router_logits(model.config, layer, x, seq)
        let normed = apply_pre_norm_gpu(x, layer.attn_norm_w, layer.attn_norm_b, seq, d, model.config)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, seq, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, seq, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm and not model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k = apply_qk_norm_gpu(k, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        let rope_t = layer_rope_freqs(model.config, l)
        q = rope_apply_gpu(q, seq, model.config.n_head, model.config.d_head, rope_t, model.config.rope_neox)
        var k_rope_raw = rope_apply_gpu(k, seq, model.config.n_kv_head, model.config.d_head, rope_t, model.config.rope_neox)
        if model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, seq * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k_rope_raw = apply_qk_norm_gpu(k_rope_raw, layer.k_norm_w, seq * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        var attn_out = attention_layer_gpu(q, k_rope_raw, v, seq, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head, 0,
            model.config.attn_ext, model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        if layer.has_attn_gate:
            let gate_proj = tensor_linear_nobias_gpu(normed, layer.attn_gate_w_q8, layer.attn_gate_w_type, seq, d, qkv_dim)
            attn_out = mul_sigmoid_gpu(attn_out, gate_proj, seq * qkv_dim)
        let attn_proj = apply_linear_gpu(attn_out, layer.o_w_q8, layer.o_w_type, layer.o_b, seq, qkv_dim, d, model.config.has_linear_bias)
        mut [float32]'kernel'unified attn_res = attn_proj
        if model.config.post_norms:
            attn_res = rms_norm_gpu(attn_proj, layer.attn_post_norm_w, seq, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            attn_res = scale_gpu(attn_res, model.config.residual_scale, seq * d)
        mut [float32]'kernel'unified normed2 = []
        if model.config.residual_type == 1:
            normed2 = normed
        elif model.config.residual_type == 2:
            normed2 = apply_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, seq, d, model.config)
        else:
            x = add_gpu(x, attn_res, seq * d)
            normed2 = apply_pre_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, seq, d, model.config)
        mut [float32]'kernel'unified ffn_out = []
        if layer.is_moe:
            let ([float32]'kernel'unified moe_out, int moe_pad) = moe_ffn_gpu(model, layer, normed2, pre_router_logits, seq)
            ffn_out = moe_out
        elif model.config.ffn_gated:
            let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, seq, d, model.config.ffn_dim)
            let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, seq, d, model.config.ffn_dim)
            let hidden = glu_combine_gpu(gate, up, model.config.act)
            ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, seq, model.config.ffn_dim, d)
        else:
            ffn_out = apply_nongated_ffn_gpu(model.config, layer, normed2, seq)
        mut [float32]'kernel'unified ffn_res = []
        if model.config.post_norms:
            ffn_res = rms_norm_gpu(ffn_out, layer.ffn_post_norm_w, seq, d, model.config.rms_eps)
        else:
            ffn_res = ffn_out
        if model.config.residual_scale != 1.0:
            ffn_res = scale_gpu(ffn_res, model.config.residual_scale, seq * d)
        if model.config.residual_type != 0:
            let both_res = add_gpu(attn_res, ffn_res, seq * d)
            x = add_gpu(x, both_res, seq * d)
        else:
            x = add_gpu(x, ffn_res, seq * d)

        # `k_rope_raw`/`v` already ARE the whole prompt's post-RoPE cache for
        # this layer (seq positions, 0..seq-1) — nothing to grow, and they
        # stay on the device as the resident cache.
        new_layers.push(LayerCache(plane_pack(k_rope_raw, kv_type_k), plane_pack(v, kv_type_v), [], []))
        l += 1

    # Only the LAST position's logits are ever used (they pick the first
    # generated token), so only the last row goes through the final norm and
    # the vocab-wide output projection — the biggest single matmul in the
    # model (d_model x vocab_size, e.g. 896 x 151936). Running it over all
    # `seq` rows (as this used to) cost `seq`x the work and read back
    # seq*vocab_size floats, ~97% of a 38-token prefill's wall-clock.
    # RMSNorm is row-independent, so the last row's logits are the same
    # math; as a seq=1 projection it also takes fused_linear_gpu's
    # decode-shape (warp-broadcast) kernel.
    let x_last = upload_floats_gpu(extract_row(x, seq - 1, d))
    let final_normed = apply_norm_gpu(x_last, model.output_norm_w, model.output_norm_b, 1, d, model.config)
    let logits_raw = apply_linear_gpu(final_normed, model.output_w_q8, model.output_w_type, model.output_b, 1, d, model.config.vocab_size, model.config.has_linear_bias)
    # returned inside a tuple below, which — like a struct constructor —
    # doesn't trigger the GPU-result-to-array conversion automatically.
    let last_logits = finish_logits(passthrough(logits_raw), model.config)

    (last_logits, GenCache(new_layers, seq, 0, kv_type_k, kv_type_v))

# Batched cache-append: like prefill_gpu_quantized above, but appends
# `tokens` (a batch of N new tokens, N >= 1) to an EXISTING, possibly
# non-empty cache, instead of always starting from position 0 — the case
# prefill_gpu_quantized doesn't handle (it always builds a brand-new
# GenCache from an implicit empty one). This is what lets a multi-turn
# chat's later turns reuse the KV-cache already computed for earlier turns
# instead of re-prefilling the whole conversation from scratch every turn
# (run_chat in main.br). Kept as a separate function from
# prefill_gpu_quantized, mirroring generate()/generate_kv()'s own existing
# split, rather than unifying them behind an "empty vs non-empty cache"
# branch — same GPU-orchestration code, same reasoning.
pub ([float32], GenCache) prefill_step_gpu_quantized(QuantModel model, GenCache cache0, [int] tokens) throws:
    guard (cache0.kt == 0 and cache0.vt == 0) or model.config.attn_ext or (model.config.d_head % 32 == 0 and model.config.d_head <= 128) else throw "packed KV caches require an attention head size that is a multiple of 32 up to 128"
    if cache0.pos == 0:
        return prefill_gpu_quantized(model, tokens)
    let cache = fold_cache(model, cache0)
    let n = tokens.length
    let base_pos = cache.pos
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    # Residual stream: uploaded once, then kept on the device across layers.
    var x = upload_floats_gpu(embed_tokens_q(model, tokens, base_pos))

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]
        let lc = cache.layers[l]

        let pre_router_logits = compute_pre_router_logits(model.config, layer, x, n)
        let normed = apply_pre_norm_gpu(x, layer.attn_norm_w, layer.attn_norm_b, n, d, model.config)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, n, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, n, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, n, d, kv_dim)
        if model.config.qk_norm and not model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, n * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k = apply_qk_norm_gpu(k, layer.k_norm_w, n * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        # RoPE positions for this batch start at `base_pos` (the number of
        # positions already in the cache), not 0 — same rope_apply_at_gpu
        # forward_step already uses for a single new token, just batched.
        let rope_t = layer_rope_freqs(model.config, l)
        q = rope_apply_at_gpu(q, n, model.config.n_head, model.config.d_head, rope_t, base_pos, model.config.rope_neox)
        var k_rope_raw = rope_apply_at_gpu(k, n, model.config.n_kv_head, model.config.d_head, rope_t, base_pos, model.config.rope_neox)
        if model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, n * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k_rope_raw = apply_qk_norm_gpu(k_rope_raw, layer.k_norm_w, n * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        let seq_k = base_pos + n
        mut [float32]'kernel'unified full_k = []
        mut [float32]'kernel'unified full_v = []
        mut [float32]'kernel'unified attn_out = []
        # Batched prefill uses the general float32 attention path: widen the old
        # main cache when it is packed, then repack the result.
        if cache.kt == 0:
            full_k = kv_append_gpu(lc.kp.f, k_rope_raw, base_pos * kv_dim, n * kv_dim)
        else:
            let old_k = plane_widen(lc.kp, cache.kt)
            full_k = kv_append_gpu(old_k, k_rope_raw, base_pos * kv_dim, n * kv_dim)
        if cache.vt == 0:
            full_v = kv_append_gpu(lc.vp.f, v, base_pos * kv_dim, n * kv_dim)
        else:
            let old_v = plane_widen(lc.vp, cache.vt)
            full_v = kv_append_gpu(old_v, v, base_pos * kv_dim, n * kv_dim)
        attn_out = attention_layer_gpu(q, full_k, full_v, n, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head, base_pos,
            model.config.attn_ext, model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        if layer.has_attn_gate:
            let gate_proj = tensor_linear_nobias_gpu(normed, layer.attn_gate_w_q8, layer.attn_gate_w_type, n, d, qkv_dim)
            attn_out = mul_sigmoid_gpu(attn_out, gate_proj, n * qkv_dim)
        let attn_proj = apply_linear_gpu(attn_out, layer.o_w_q8, layer.o_w_type, layer.o_b, n, qkv_dim, d, model.config.has_linear_bias)
        mut [float32]'kernel'unified attn_res = attn_proj
        if model.config.post_norms:
            attn_res = rms_norm_gpu(attn_proj, layer.attn_post_norm_w, n, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            attn_res = scale_gpu(attn_res, model.config.residual_scale, n * d)
        mut [float32]'kernel'unified normed2 = []
        if model.config.residual_type == 1:
            normed2 = normed
        elif model.config.residual_type == 2:
            normed2 = apply_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, n, d, model.config)
        else:
            x = add_gpu(x, attn_res, n * d)
            normed2 = apply_pre_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, n, d, model.config)
        mut [float32]'kernel'unified ffn_out = []
        if layer.is_moe:
            let ([float32]'kernel'unified moe_out, int moe_pad) = moe_ffn_gpu(model, layer, normed2, pre_router_logits, n)
            ffn_out = moe_out
        elif model.config.ffn_gated:
            let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, n, d, model.config.ffn_dim)
            let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, n, d, model.config.ffn_dim)
            let hidden = glu_combine_gpu(gate, up, model.config.act)
            ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, n, model.config.ffn_dim, d)
        else:
            ffn_out = apply_nongated_ffn_gpu(model.config, layer, normed2, n)
        mut [float32]'kernel'unified ffn_res = []
        if model.config.post_norms:
            ffn_res = rms_norm_gpu(ffn_out, layer.ffn_post_norm_w, n, d, model.config.rms_eps)
        else:
            ffn_res = ffn_out
        if model.config.residual_scale != 1.0:
            ffn_res = scale_gpu(ffn_res, model.config.residual_scale, n * d)
        if model.config.residual_type != 0:
            let both_res = add_gpu(attn_res, ffn_res, n * d)
            x = add_gpu(x, both_res, n * d)
        else:
            x = add_gpu(x, ffn_res, n * d)

        new_layers.push(LayerCache(plane_pack(full_k, cache.kt), plane_pack(full_v, cache.vt), [], []))
        l += 1

    # Last row only — see prefill_gpu_quantized's identical tail for why.
    let x_last = upload_floats_gpu(extract_row(x, n - 1, d))
    let final_normed = apply_norm_gpu(x_last, model.output_norm_w, model.output_norm_b, 1, d, model.config)
    let logits_raw = apply_linear_gpu(final_normed, model.output_w_q8, model.output_w_type, model.output_b, 1, d, model.config.vocab_size, model.config.has_linear_bias)
    let last_logits = finish_logits(passthrough(logits_raw), model.config)

    (last_logits, GenCache(new_layers, base_pos + n, 0, cache.kt, cache.vt))

# Speculative decoding's verification pass: feeds `tokens` (n >= 1) after an existing cache like
# prefill_step_gpu_quantized, but returns the logits of every row, not just the last.
pub ([float32], GenCache) forward_batch_gpu_quantized(QuantModel model, GenCache cache0, [int] tokens) throws:
    guard (cache0.kt == 0 and cache0.vt == 0) or model.config.attn_ext or (model.config.d_head % 32 == 0 and model.config.d_head <= 128) else throw "packed KV caches require an attention head size that is a multiple of 32 up to 128"
    guard cache0.pos > 0 else throw "forward_batch needs a prefilled cache"
    let cache = fold_cache(model, cache0)
    let n = tokens.length
    let base_pos = cache.pos
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    # Residual stream: uploaded once, then kept on the device across layers.
    var x = upload_floats_gpu(embed_tokens_q(model, tokens, base_pos))

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]
        let lc = cache.layers[l]

        let pre_router_logits = compute_pre_router_logits(model.config, layer, x, n)
        let normed = apply_pre_norm_gpu(x, layer.attn_norm_w, layer.attn_norm_b, n, d, model.config)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, n, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, n, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, n, d, kv_dim)
        if model.config.qk_norm and not model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, n * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k = apply_qk_norm_gpu(k, layer.k_norm_w, n * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        # RoPE positions for this batch start at `base_pos` (the number of
        # positions already in the cache), not 0 — same rope_apply_at_gpu
        # forward_step already uses for a single new token, just batched.
        let rope_t = layer_rope_freqs(model.config, l)
        q = rope_apply_at_gpu(q, n, model.config.n_head, model.config.d_head, rope_t, base_pos, model.config.rope_neox)
        var k_rope_raw = rope_apply_at_gpu(k, n, model.config.n_kv_head, model.config.d_head, rope_t, base_pos, model.config.rope_neox)
        if model.config.qk_norm_post_rope:
            q = apply_qk_norm_gpu(q, layer.q_norm_w, n * model.config.q_norm_heads, model.config.q_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
            k_rope_raw = apply_qk_norm_gpu(k_rope_raw, layer.k_norm_w, n * model.config.k_norm_heads, model.config.k_norm_dim, model.config.rms_eps, model.config.use_layer_norm)
        let seq_k = base_pos + n
        mut [float32]'kernel'unified full_k = []
        mut [float32]'kernel'unified full_v = []
        mut [float32]'kernel'unified attn_out = []
        # Batched prefill uses the general float32 attention path: widen the old
        # main cache when it is packed, then repack the result.
        if cache.kt == 0:
            full_k = kv_append_gpu(lc.kp.f, k_rope_raw, base_pos * kv_dim, n * kv_dim)
        else:
            let old_k = plane_widen(lc.kp, cache.kt)
            full_k = kv_append_gpu(old_k, k_rope_raw, base_pos * kv_dim, n * kv_dim)
        if cache.vt == 0:
            full_v = kv_append_gpu(lc.vp.f, v, base_pos * kv_dim, n * kv_dim)
        else:
            let old_v = plane_widen(lc.vp, cache.vt)
            full_v = kv_append_gpu(old_v, v, base_pos * kv_dim, n * kv_dim)
        attn_out = attention_layer_gpu(q, full_k, full_v, n, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head, base_pos,
            model.config.attn_ext, model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        if layer.has_attn_gate:
            let gate_proj = tensor_linear_nobias_gpu(normed, layer.attn_gate_w_q8, layer.attn_gate_w_type, n, d, qkv_dim)
            attn_out = mul_sigmoid_gpu(attn_out, gate_proj, n * qkv_dim)
        let attn_proj = apply_linear_gpu(attn_out, layer.o_w_q8, layer.o_w_type, layer.o_b, n, qkv_dim, d, model.config.has_linear_bias)
        mut [float32]'kernel'unified attn_res = attn_proj
        if model.config.post_norms:
            attn_res = rms_norm_gpu(attn_proj, layer.attn_post_norm_w, n, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            attn_res = scale_gpu(attn_res, model.config.residual_scale, n * d)
        mut [float32]'kernel'unified normed2 = []
        if model.config.residual_type == 1:
            normed2 = normed
        elif model.config.residual_type == 2:
            normed2 = apply_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, n, d, model.config)
        else:
            x = add_gpu(x, attn_res, n * d)
            normed2 = apply_pre_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, n, d, model.config)
        mut [float32]'kernel'unified ffn_out = []
        if layer.is_moe:
            let ([float32]'kernel'unified moe_out, int moe_pad) = moe_ffn_gpu(model, layer, normed2, pre_router_logits, n)
            ffn_out = moe_out
        elif model.config.ffn_gated:
            let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, n, d, model.config.ffn_dim)
            let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, n, d, model.config.ffn_dim)
            let hidden = glu_combine_gpu(gate, up, model.config.act)
            ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, n, model.config.ffn_dim, d)
        else:
            ffn_out = apply_nongated_ffn_gpu(model.config, layer, normed2, n)
        mut [float32]'kernel'unified ffn_res = []
        if model.config.post_norms:
            ffn_res = rms_norm_gpu(ffn_out, layer.ffn_post_norm_w, n, d, model.config.rms_eps)
        else:
            ffn_res = ffn_out
        if model.config.residual_scale != 1.0:
            ffn_res = scale_gpu(ffn_res, model.config.residual_scale, n * d)
        if model.config.residual_type != 0:
            let both_res = add_gpu(attn_res, ffn_res, n * d)
            x = add_gpu(x, both_res, n * d)
        else:
            x = add_gpu(x, ffn_res, n * d)

        new_layers.push(LayerCache(plane_pack(full_k, cache.kt), plane_pack(full_v, cache.vt), [], []))
        l += 1

    # Every row's logits (n * vocab_size floats): row j is the distribution after tokens[j].
    let final_normed = apply_norm_gpu(x, model.output_norm_w, model.output_norm_b, n, d, model.config)
    let logits_raw = apply_linear_gpu(final_normed, model.output_w_q8, model.output_w_type, model.output_b, n, d, model.config.vocab_size, model.config.has_linear_bias)
    let rows = finish_logits(passthrough(logits_raw), model.config)

    (rows, GenCache(new_layers, base_pos + n, 0, cache.kt, cache.vt))

pub GenCache empty_cache(int n_layer):
    mut [LayerCache] layers = []
    var int l = 0
    while l < n_layer:
        layers.push(LayerCache(Plane([], [], [], []), Plane([], [], [], []), [], []))
        l += 1
    GenCache(layers, 0, 0, kv_type_k, kv_type_v)

# The cache with its tail folded into the main buffers (nothing to do when the
# tail is empty): what prefill and the disk snapshots need, one buffer per layer.
pub GenCache fold_cache(QuantModel model, GenCache cache) throws:
    if cache.tail == 0:
        return cache
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let main_n = cache.pos - cache.tail
    mut [LayerCache] layers = []
    var int l = 0
    while l < model.config.n_layer:
        let lc = cache.layers[l]
        let kp = plane_append(lc.kp, lc.tk, main_n * kv_dim, cache.tail * kv_dim, cache.kt)
        let vp = plane_append(lc.vp, lc.tv, main_n * kv_dim, cache.tail * kv_dim, cache.vt)
        layers.push(LayerCache(kp, vp, [], []))
        l += 1
    GenCache(layers, cache.pos, 0, cache.kt, cache.vt)

# Processes exactly one new token against the existing cache. Returns the
# new token's own logits row (vocab_size long — there's only ever one
# position per call) and the grown cache.
pub ([float32], GenCache) forward_step(QuantModel model, GenCache cache, int token) throws:
    guard cache.pos > 0 else throw "forward_step needs a prefilled cache"
        # Launches per command buffer. Not monotonic: on the 3B Q4_K_M the old value 8
    # decoded at ~105 ms/token, 6 at ~149, and 1-4 or 12+ at ~55-60 (paired A/B,
    # same outputs); 3 is the one that never lost on the 0.5B models either.
    set_gpu_batch_limit(3)
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let pos = cache.pos

    # Residual stream: uploaded once, then it stays on the device — every
    # `add_gpu` below consumes and produces a resident buffer.
    var x = upload_floats_gpu(embed_tokens_q(model, [token], pos))
    var normed = apply_pre_norm_gpu(x, model.layers[0].attn_norm_w, model.layers[0].attn_norm_b, 1, d, model.config)

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]
        let lc = cache.layers[l]

        let pre_router_logits = compute_pre_router_logits(model.config, layer, x, 1)

        # Project and prepare Q/K/V as one resident pipeline. On the fused
        # Q8_0 path this consumes slices of the joined projection directly,
        # avoiding the decode-only QKV split kernel.
        let tail_len = cache.tail
        let ([float32]'kernel'unified q, [float32]'kernel'unified tk_new, [float32]'kernel'unified tv_new) = project_qkv_attention_decode_gpu(normed,
            layer.q_w_q8, layer.q_w_type, layer.q_b,
            layer.k_w_q8, layer.k_w_type, layer.k_b,
            layer.v_w_q8, layer.v_w_type, layer.v_b,
            layer.qkv_w_q8, layer.qkv_b, layer.qkv_fused,
            layer.q_norm_w, layer.k_norm_w, model.config.qk_norm, model.config.qk_norm_post_rope, model.config.use_layer_norm,
            model.config.q_norm_dim, model.config.k_norm_dim,
            lc.tk, lc.tv, tail_len,
            d, qkv_dim, kv_dim, model.config.n_head, model.config.n_kv_head, model.config.d_head,
            model.config.rms_eps, layer.rope_freqs, pos, model.config.rope_neox)
        if decode_profile_stage == 1:
            let (_, _, _) = project_qkv_attention_decode_gpu(normed,
                layer.q_w_q8, layer.q_w_type, layer.q_b,
                layer.k_w_q8, layer.k_w_type, layer.k_b,
                layer.v_w_q8, layer.v_w_type, layer.v_b,
                layer.qkv_w_q8, layer.qkv_b, layer.qkv_fused,
                layer.q_norm_w, layer.k_norm_w, model.config.qk_norm, model.config.qk_norm_post_rope, model.config.use_layer_norm,
                model.config.q_norm_dim, model.config.k_norm_dim,
                lc.tk, lc.tv, tail_len,
                d, qkv_dim, kv_dim, model.config.n_head, model.config.n_kv_head, model.config.d_head,
                model.config.rms_eps, layer.rope_freqs, pos, model.config.rope_neox)

        # The new row goes to the tail (see LayerCache); the tail is folded into
        # the main buffers once it reaches TAIL_MAX rows.
        let seq_k = pos + 1
        let main_len = pos - tail_len

        # No causal mask: the single new query is always the most recent
        # position, so every key already in the cache (including the one
        # just appended) is a legitimate position to attend to.
        # Gemma 2/3 (extended attention) read a widened float32 copy of a packed
        # main cache: that path already joins the whole cache every step, so the
        # extra pass keeps the same per-token cost while storage stays packed.
        # (float32 mode passes `lc.k` straight through below: assigning it to
        # `wide_k` here moves the field and breaks the later reads of `lc.k`.)
        mut [float32]'kernel'unified wide_k = []
        mut [float32]'kernel'unified wide_v = []
        let packed = cache.kt != 0 or cache.vt != 0
        if model.config.attn_ext and packed:
            wide_k = plane_widen(lc.kp, cache.kt)
            wide_v = plane_widen(lc.vp, cache.vt)
        var attn_out = if model.config.attn_ext and packed:
            attention_tail_ext_gpu(q, wide_k, wide_v, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head,
                model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        elif model.config.attn_ext:
            attention_tail_ext_gpu(q, lc.kp.f, lc.vp.f, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head,
                model.config.attn_scale, model.config.attn_softcap, layer_window(model.config, l))
        elif cache.kt == 0 and cache.vt == 0:
            attention_gqa_tail_gpu(q, lc.kp.f, lc.vp.f, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        elif cache.kt == 1 and cache.vt == 1:
            attention_gqa_tail_f16_gpu(q, lc.kp.h, lc.vp.h, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        elif cache.kt == 2 and cache.vt == 2:
            attention_gqa_tail_q8_gpu(q, lc.kp.q, lc.kp.s, lc.vp.q, lc.vp.s, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        else:
            attention_gqa_tail_mix_gpu(q, lc.kp, lc.vp, cache.kt, cache.vt, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        if decode_profile_stage == 2:
            if cache.kt == 0 and cache.vt == 0:
                let _ = attention_gqa_tail_gpu(q, lc.kp.f, lc.vp.f, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
            else:
                let _ = attention_gqa_tail_mix_gpu(q, lc.kp, lc.vp, cache.kt, cache.vt, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        if layer.has_attn_gate:
            let gate_proj = tensor_linear_nobias_gpu(normed, layer.attn_gate_w_q8, layer.attn_gate_w_type, 1, d, qkv_dim)
            attn_out = mul_sigmoid_gpu(attn_out, gate_proj, qkv_dim)
        let attn_proj = apply_linear_gpu(attn_out, layer.o_w_q8, layer.o_w_type, layer.o_b, 1, qkv_dim, d, model.config.has_linear_bias)
        if decode_profile_stage == 3:
            let _ = tensor_linear_nobias_gpu(attn_out, layer.o_w_q8, layer.o_w_type, 1, qkv_dim, d)
        mut [float32]'kernel'unified attn_res = attn_proj
        if model.config.post_norms:
            attn_res = rms_norm_gpu(attn_proj, layer.attn_post_norm_w, 1, d, model.config.rms_eps)
        if model.config.residual_scale != 1.0:
            attn_res = scale_gpu(attn_res, model.config.residual_scale, 1 * d)
        mut [float32]'kernel'unified normed2 = []
        if model.config.residual_type == 1:
            normed2 = normed
        elif model.config.residual_type == 2:
            normed2 = apply_norm_gpu(x, layer.ffn_norm_w, layer.ffn_norm_b, 1, d, model.config)
        elif model.config.no_pre_norm:
            x = add_gpu(x, attn_res, d)
            normed2 = x
        elif model.config.has_norm_bias:
            let ([float32]'kernel'unified x_after_attn, [float32]'kernel'unified n2) = add_norm_decode_gpu(
                x, attn_res, layer.ffn_norm_w, layer.ffn_norm_b, d, model.config.rms_eps, model.config.use_layer_norm)
            x = x_after_attn
            normed2 = n2
        else:
            let ([float32]'kernel'unified x_after_attn, [float32]'kernel'unified n2) = add_rms_norm_decode_gpu(
                x, attn_res, layer.ffn_norm_w, d, model.config.rms_eps)
            if decode_profile_stage == 4:
                let (_, _) = add_rms_norm_decode_gpu(x, attn_proj, layer.ffn_norm_w, d, model.config.rms_eps)
            x = x_after_attn
            normed2 = n2
        mut [float32]'kernel'unified ffn_out = []
        if layer.is_moe:
            let ([float32]'kernel'unified moe_out, int moe_pad) = moe_ffn_gpu(model, layer, normed2, pre_router_logits, 1)
            ffn_out = moe_out
        elif model.config.ffn_gated:
            let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, 1, d, model.config.ffn_dim)
            if decode_profile_stage == 7:
                let _ = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, 1, d, model.config.ffn_dim)
            let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, 1, d, model.config.ffn_dim)
            if decode_profile_stage == 8:
                let _ = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, 1, d, model.config.ffn_dim)
            let hidden = glu_combine_gpu(gate, up, model.config.act)
            if decode_profile_stage == 9:
                let _ = glu_combine_gpu(gate, up, model.config.act)
            ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, 1, model.config.ffn_dim, d)
            if decode_profile_stage == 10:
                let _ = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, 1, model.config.ffn_dim, d)
            if decode_profile_stage == 5:
                let profile_gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, 1, d, model.config.ffn_dim)
                let profile_up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, 1, d, model.config.ffn_dim)
                let profile_hidden = glu_combine_gpu(profile_gate, profile_up, model.config.act)
                let _ = tensor_linear_nobias_gpu(profile_hidden, layer.down_w_q8, layer.down_w_type, 1, model.config.ffn_dim, d)
        else:
            ffn_out = apply_nongated_ffn_gpu(model.config, layer, normed2, 1)
        mut [float32]'kernel'unified ffn_res = []
        if model.config.post_norms:
            ffn_res = rms_norm_gpu(ffn_out, layer.ffn_post_norm_w, 1, d, model.config.rms_eps)
        else:
            ffn_res = ffn_out
        if model.config.residual_scale != 1.0:
            ffn_res = scale_gpu(ffn_res, model.config.residual_scale, 1 * d)
        mut [float32]'kernel'unified step_res = ffn_res
        if model.config.residual_type != 0:
            step_res = add_gpu(attn_res, ffn_res, d)
        if l + 1 < model.config.n_layer:
            if model.config.no_pre_norm:
                x = add_gpu(x, step_res, d)
                normed = x
            elif model.config.has_norm_bias:
                let ([float32]'kernel'unified x_next, [float32]'kernel'unified normed_next) = add_norm_decode_gpu(
                    x, step_res, model.layers[l + 1].attn_norm_w, model.layers[l + 1].attn_norm_b, d, model.config.rms_eps, model.config.use_layer_norm)
                x = x_next
                normed = normed_next
            else:
                let ([float32]'kernel'unified x_next, [float32]'kernel'unified normed_next) = add_rms_norm_decode_gpu(
                    x, step_res, model.layers[l + 1].attn_norm_w, d, model.config.rms_eps)
                x = x_next
                normed = normed_next
        else:
            if model.config.has_norm_bias:
                let ([float32]'kernel'unified x_final, [float32]'kernel'unified normed_final) = add_norm_decode_gpu(
                    x, step_res, model.output_norm_w, model.output_norm_b, d, model.config.rms_eps, model.config.use_layer_norm)
                x = x_final
                normed = normed_final
            else:
                let ([float32]'kernel'unified x_final, [float32]'kernel'unified normed_final) = add_rms_norm_decode_gpu(
                    x, step_res, model.output_norm_w, d, model.config.rms_eps)
                x = x_final
                normed = normed_final

        if tail_len + 1 >= TAIL_MAX:
            let kp2 = plane_append(lc.kp, tk_new, main_len * kv_dim, (tail_len + 1) * kv_dim, cache.kt)
            let vp2 = plane_append(lc.vp, tv_new, main_len * kv_dim, (tail_len + 1) * kv_dim, cache.vt)
            new_layers.push(LayerCache(kp2, vp2, [], []))
        else:
            new_layers.push(LayerCache(lc.kp, lc.vp, tk_new, tv_new))
        l += 1

    let new_tail = if cache.tail + 1 >= TAIL_MAX: 0 else: cache.tail + 1
    let logits_raw = apply_linear_gpu(normed, model.output_w_q8, model.output_w_type, model.output_b, 1, d, model.config.vocab_size, model.config.has_linear_bias)
    if decode_profile_stage == 6:
        let _ = tensor_linear_nobias_gpu(normed, model.output_w_q8, model.output_w_type, 1, d, model.config.vocab_size)
    set_gpu_batch_limit(1)
    # returned inside a tuple below, which — like a struct constructor —
    # doesn't trigger the GPU-result-to-array conversion automatically.
    let logits = finish_logits(passthrough(logits_raw), model.config)

    (logits, GenCache(new_layers, pos + 1, new_tail, cache.kt, cache.vt))

# Prefill in fixed-size chunks. One big prefill builds, per layer, a
# (n_head x seq_q x seq_k) score matrix — 14 x 8000 x 8000 x 4 B = 3.5 GB for a
# long agent prompt — so a long prompt is fed `PREFILL_CHUNK` tokens at a time,
# each chunk attending over the already-cached keys plus its own (causal offset
# = tokens already cached). Only the last chunk's logits matter and are returned.
# A cache that is still empty is handled by prefill_step_gpu_quantized itself.
static var int prefill_chunk_size = 512

pub def set_prefill_chunk_len(int size):
    prefill_chunk_size = size

pub ([float32], GenCache) prefill_chunked(QuantModel model, GenCache cache0, [int] tokens) throws:
    guard tokens.length > 0 else throw "prefill_chunked: no tokens"
    var cache = cache0
    var [float32] logits = []
    var int start = 0
    while start < tokens.length:
        var int end = start + prefill_chunk_size
        if end > tokens.length:
            end = tokens.length
        let (lg, c) = prefill_step_gpu_quantized(model, cache, tokens[start..<end])
        logits = lg
        cache = c
        start = end
    (logits, cache)

pub [int] generate_kv(QuantModel model, [int] prompt_tokens, int max_new_tokens, int eos_id,
                       SamplingParams params) throws:
    mut [int] tokens = []
    for t in prompt_tokens:
        tokens.push(t)

    let (first_logits, cache0) = prefill_chunked(model, empty_cache(model.config.n_layer), prompt_tokens)
    var logits = first_logits
    var cache = cache0
    var rng = seed_rng(params.seed)

    let vocab = model.config.vocab_size
    var int generated = 0
    while generated < max_new_tokens:
        let (next_tok, new_rng) = sample(rng, logits, vocab, params.temperature, params.dynatemp_range, params.dynatemp_exponent, params.top_n_sigma, params.top_k, params.typical_p, params.top_p, params.min_p, params.xtc_probability, params.xtc_threshold, params.min_keep, tokens, params.repeat_penalty, params.repeat_last_n, params.dry_multiplier, params.dry_base, params.dry_allowed_length, params.dry_penalty_last_n, params.dry_breakers)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1
        if is_eog_token(next_tok, eos_id):
            return tokens

        let (step_logits2, new_cache2) = forward_step(model, cache, next_tok)
        logits = step_logits2
        cache = new_cache2

    tokens

# Prefill that resumes from a cache built by an EARLIER request: the server
# keeps the previous requests' caches and, since an agent client resends its
# whole history every turn, only the tokens after the shared prefix need a
# forward pass. `reuse` is how many leading positions of `cache` are valid for
# `prompt_tokens` (the caller computed the common prefix; 0 = start fresh).
# The cache's buffers may be longer than `reuse` positions: every append reads
# only the first `pos * kv_dim` floats, so "truncating" is just setting `pos`.
# `reuse` must be < prompt_tokens.length (the last prompt token is always
# processed — its logits pick the first generated token).
#
# Returns those logits and the cache covering the whole prompt. The caller runs
# the decode loop itself (sample, forward_step, ...), which is what lets the
# server stream each token as it is produced. After such a loop the cache covers
# every token that went through a forward pass: all but the last generated one
# when the reply ended on EOS or a stop string (sampled, never fed back), so use
# `cache.pos`, not the token count, as the number of valid cached positions.
pub ([float32], GenCache) prefill_resume(QuantModel model, GenCache cache, int reuse, [int] prompt_tokens) throws:
    let start_cache = resume_cache(model, cache, reuse, prompt_tokens.length)
    prefill_chunked(model, start_cache, prompt_tokens[reuse..<prompt_tokens.length])

# The cache a resumed prefill starts from: `cache` truncated to its first
# `reuse` positions (0 = a fresh one). `n_prompt` is only used to range-check.
pub GenCache resume_cache(QuantModel model, GenCache cache, int reuse, int n_prompt) throws:
    guard reuse >= 0 and reuse < n_prompt else throw "prefill_resume: reuse {reuse} out of range for a {n_prompt}-token prompt"
    if reuse == 0:
        return empty_cache(model.config.n_layer)
    let main_n = cache.pos - cache.tail
    if reuse == cache.pos:
        return cache
    if reuse <= main_n:
        # inside the main buffers: the tail is dropped, the rows past `reuse` ignored
        mut [LayerCache] cut = []
        for lc in cache.layers:
            cut.push(LayerCache(lc.kp, lc.vp, [], []))
        return GenCache(cut, reuse, 0, cache.kt, cache.vt)
    # inside the tail: the first `reuse - main_n` tail rows join the main ones
    let kv_dim = model.config.n_kv_head * model.config.d_head
    mut [LayerCache] joined = []
    for lc in cache.layers:
        let jn = (reuse - main_n) * kv_dim
        let jkp = plane_append(lc.kp, lc.tk, main_n * kv_dim, jn, cache.kt)
        let jvp = plane_append(lc.vp, lc.tv, main_n * kv_dim, jn, cache.vt)
        joined.push(LayerCache(jkp, jvp, [], []))
    GenCache(joined, reuse, 0, cache.kt, cache.vt)

# Tokens per `prefill_step_gpu_quantized` call in `prefill_chunked`, for a
# caller that drives the chunks itself (the server, to show progress).
pub int prefill_chunk_len():
    prefill_chunk_size

# ── Chat mode: KV-cache reuse across turns ───────────────────────────────
# generate_kv() above is single-shot — it always calls prefill_gpu_quantized
# (which always starts from an empty cache) and, on returning, discards the
# cache it built, so it's unusable across separate calls. The two functions
# below let a multi-turn chat (run_chat in main.br) reuse the SAME cache
# across turns: the first turn calls generate_kv_chat_first (full prefill
# from empty, same as generate_kv, but returns the cache instead of
# dropping it); every later turn calls generate_kv_chat_continue (appends
# only the new turn's own tokens to the existing cache via
# prefill_step_gpu_quantized, instead of re-prefilling the whole
# conversation-so-far). Both share this decode loop, which is otherwise
# identical to generate_kv()'s own loop body.
pub ([int], GenCache) generate_kv_chat_first(QuantModel model, [int] prompt_tokens, int max_new_tokens,
                                              int eos_id, SamplingParams params) throws:
    let (first_logits, cache0) = prefill_chunked(model, empty_cache(model.config.n_layer), prompt_tokens)
    generate_kv_chat_loop(model, first_logits, cache0, prompt_tokens, max_new_tokens, eos_id, params)

pub ([int], GenCache) generate_kv_chat_continue(QuantModel model, GenCache cache, [int] new_tokens,
                                                 [int] tokens_so_far, int max_new_tokens, int eos_id,
                                                 SamplingParams params) throws:
    let (first_logits, cache1) = prefill_chunked(model, cache, new_tokens)
    mut [int] full_history = []
    for t in tokens_so_far:
        full_history.push(t)
    for t in new_tokens:
        full_history.push(t)
    generate_kv_chat_loop(model, first_logits, cache1, full_history, max_new_tokens, eos_id, params)

([int], GenCache) generate_kv_chat_loop(QuantModel model, [float32] first_logits, GenCache cache0,
                                         [int] tokens_so_far, int max_new_tokens, int eos_id,
                                         SamplingParams params) throws:
    mut [int] tokens = []
    for t in tokens_so_far:
        tokens.push(t)

    var logits = first_logits
    var cache = cache0
    var rng = seed_rng(params.seed)

    let vocab = model.config.vocab_size
    var int generated = 0
    var bool hit_eos = false
    while generated < max_new_tokens and not hit_eos:
        let (next_tok, new_rng) = sample(rng, logits, vocab, params.temperature, params.dynatemp_range, params.dynatemp_exponent, params.top_n_sigma, params.top_k, params.typical_p, params.top_p, params.min_p, params.xtc_probability, params.xtc_threshold, params.min_keep, tokens, params.repeat_penalty, params.repeat_last_n, params.dry_multiplier, params.dry_base, params.dry_allowed_length, params.dry_penalty_last_n, params.dry_breakers)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1

        # Unlike generate_kv() (single-shot, never continued), this ALWAYS
        # runs the just-generated token through forward_step — including
        # the EOS/<|im_end|> that ends the turn — so the returned cache
        # stays in sync with `tokens` (cache.pos == tokens.length). A later
        # chat turn's continuation (generate_kv_chat_continue) needs every
        # token, including this one's closing marker, to actually be part
        # of the KV-cache: it's real conversation history the next turn's
        # attention must be able to see, and its position must be
        # accounted for so the next turn's RoPE offsets land correctly.
        let (step_logits2, new_cache2) = forward_step(model, cache, next_tok)
        logits = step_logits2
        cache = new_cache2

        if is_eog_token(next_tok, eos_id):
            hit_eos = true

    if not hit_eos:
        # max_new_tokens reached without the model ever emitting EOS —
        # force-close the turn anyway. A later continuation always assumes
        # the token stream ends right after a real closing special token
        # (main.br's run_chat, tokenizer.br's render_chat_prompt); without
        # this, the next turn's tokens would follow directly after an
        # unterminated reply,
        # a malformed, out-of-distribution context the model was never
        # trained on (confirmed empirically: this exact gap produced
        # visibly wrong/degenerate continuations before this fix).
        let close_id = turn_close_token(eos_id)
        tokens.push(close_id)
        let (_, final_cache) = forward_step(model, cache, close_id)
        cache = final_cache

    (tokens, cache)
