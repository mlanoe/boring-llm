# src/model.br — config extraction from GGUF metadata, weight loading
# (dequantizing Q8_0 tensors on the fly), and the Phase 1 CPU-only forward
# pass (no KV-cache — full re-forward every position, see math.br's header
# comment for why that's deliberate at this phase).
#
# Architecture-generic across the Llama/Mistral/Qwen2 GGUF family: every
# `Config` field is read from GGUF's own `{arch}.*` metadata keys (never
# hardcoded to one architecture's values), RoPE dispatches on the real
# per-architecture rotation convention (see rope_style_for_arch's own doc
# comment below — Qwen2 and Llama/Mistral genuinely differ here, GGUF has
# no metadata key for it), and attention Q/K/V bias tensors (present for
# Qwen2, absent for Llama/Mistral) fall back to an all-zero vector via
# `load_tensor_f32_or_zero` when the GGUF file doesn't have them. Verified
# against a real Qwen2 GGUF and a real Llama GGUF — see
# docs/development-log.md.

use io
use gguf
use gguf_file
use quant
use math
use math_gpu
use sampling

pub struct Config:
    int vocab_size
    int d_model
    int n_layer
    int n_head
    int n_kv_head
    int d_head
    int ffn_dim
    float32 rope_freq_base
    float32 rms_eps
    bool tied_embeddings
    int rope_neox   # 1 = NEOX/"rotate-half" (Qwen2), 0 = NORM/interleaved (Llama/Mistral)
    bool qk_norm    # Qwen3: an RMS norm over each head's Q and K (weights of d_head floats) before RoPE

pub struct Layer:
    [float32] attn_norm_w
    [float32] q_w
    [float32] q_b
    [float32] k_w
    [float32] k_b
    [float32] v_w
    [float32] v_b
    [float32] o_w
    [float32] ffn_norm_w
    [float32] gate_w
    [float32] up_w
    [float32] down_w
    [float32] q_norm_w   # d_head floats; zeros and unused unless config.qk_norm
    [float32] k_norm_w

pub struct Model:
    Config config
    [float32] tok_embd
    [Layer] layers
    [float32] output_norm_w
    [float32] output_w

# Phase 2b: same shape as Layer, but every big matmul-heavy weight (Q/K/V/O
# projections, FFN gate/up/down) stays as raw quantized-packed bytes
# instead of being dequantized to a full [float32] copy at load time —
# biases and norms are always F32 in real GGUF files regardless of
# quantization level, so those stay plain [float32] here too. Each weight
# carries its own ggml type tag alongside its bytes (`*_type`) because a
# real quantized GGUF file mixes formats per tensor role, not one format
# for the whole file — verified directly against a real downloaded
# Qwen2.5-0.5B-Instruct "Q4_K_M" file: attn_q/k/attn_output/ffn_gate/
# ffn_up are Q5_0, attn_v is Q8_0, ffn_down alternates Q4_K/Q6_K by layer.
# tensor_linear_gpu (math_gpu.br) dispatches on this tag to the matching
# quantized tensor format.
pub struct QuantLayer:
    [float32]'kernel'unified attn_norm_w
    [uint8]'kernel'unified q_w_q8
    int q_w_type
    [float32]'kernel'unified q_b
    [uint8]'kernel'unified k_w_q8
    int k_w_type
    [float32]'kernel'unified k_b
    [uint8]'kernel'unified v_w_q8
    int v_w_type
    [float32]'kernel'unified v_b
    [uint8]'kernel'unified qkv_w_q8
    [float32]'kernel'unified qkv_b
    bool qkv_fused
    [uint8]'kernel'unified o_w_q8
    int o_w_type
    [float32]'kernel'unified ffn_norm_w
    [uint8]'kernel'unified gate_w_q8
    int gate_w_type
    [uint8]'kernel'unified up_w_q8
    int up_w_type
    [uint8]'kernel'unified down_w_q8
    int down_w_type
    [float32]'kernel'unified q_norm_w   # d_head floats; zeros and unused unless config.qk_norm
    [float32]'kernel'unified k_norm_w

pub struct QuantModel:
    Config config
    [uint8] tok_embd_q8
    int tok_embd_type
    [QuantLayer] layers
    [float32]'kernel'unified output_norm_w
    [uint8]'kernel'unified output_w_q8
    int output_w_type

GgufTensorInfo find_tensor([GgufTensorInfo] tensors, string name) throws:
    for t in tensors:
        if t.name == name:
            return t
    throw "tensor not found: {name}"

bool tensor_exists([GgufTensorInfo] tensors, string name):
    for t in tensors:
        if t.name == name:
            return true
    false

# Qwen2's attention Q/K/V projections carry a bias tensor; Llama/Mistral's
# don't (llama.cpp never even writes `*.attn_{q,k,v}.bias` into their
# GGUFs) — treating it as always-present, as an earlier Qwen2-only version
# of this file did, throws "tensor not found" on any non-Qwen2 GGUF. Falls
# back to an all-zero bias vector of the expected width when absent, which
# is a no-op added onto `linear_bias`'s output either way.
pub [float32] load_tensor_f32_or_zero(GgufFile file, string name, int n) throws:
    if tensor_exists(file.tensors, name):
        load_tensor_f32(file, name)
    else:
        [0.0 for i in 0..<n]

int tensor_n_elements(GgufTensorInfo t):
    var int n = 1
    for d in t.dims:
        n = n * d
    n

# Loads a tensor's raw packed bytes plus its own ggml type — any of the
# quantized formats this project's fused GPU kernels understand (Q5_0,
# Q8_0, Q4_K, Q6_K; see quant.br's quantized_row_bytes for the type ids).
pub ([uint8], int) load_tensor_quantized(GgufFile file, string name) throws:
    let t = find_tensor(file.tensors, name)
    let n = tensor_n_elements(t)
    let n_bytes = quantized_row_bytes(t.ggml_type, n)
    let start = file.data_offset + t.offset
    (file_bytes(file, start, n_bytes), t.ggml_type)

pub [float32] load_tensor_f32(GgufFile file, string name) throws:
    let t = find_tensor(file.tensors, name)
    let n = tensor_n_elements(t)
    let start = file.data_offset + t.offset
    # read only this tensor's bytes (from disk when the file was opened by
    # path), then decode from offset 0
    let n_bytes = if t.ggml_type == 0: n * 4 elif t.ggml_type == 1: n * 2 else: quantized_row_bytes(t.ggml_type, n)
    let raw = file_bytes(file, start, n_bytes)
    if t.ggml_type == 0:
        mut [float32] result = [0.0 for i in 0..<n]
        var int i = 0
        while i < n:
            result[i] = read_f32_le(raw, i * 4) as float32
            i += 1
        result
    elif t.ggml_type == 1:
        mut [float32] result = [0.0 for i in 0..<n]
        var int i = 0
        while i < n:
            result[i] = f16_bits_to_f32(read_u16_le(raw, i * 2))
            i += 1
        result
    elif t.ggml_type == 2:
        dequantize_q4_0(raw, 0, n)
    elif t.ggml_type == 6:
        dequantize_q5_0(raw, 0, n)
    elif t.ggml_type == 8:
        dequantize_q8_0(raw, 0, n)
    elif t.ggml_type == 10:
        dequantize_q2_k(raw, 0, n)
    elif t.ggml_type == 11:
        dequantize_q3_k(raw, 0, n)
    elif t.ggml_type == 12:
        dequantize_q4_k(raw, 0, n)
    elif t.ggml_type == 14:
        dequantize_q6_k(raw, 0, n)
    elif t.ggml_type == 20:
        dequantize_iq4_nl(raw, 0, n)
    else:
        throw "load_tensor_f32: unsupported ggml type {ggml_type_name(t.ggml_type)} for tensor '{name}'"

# GGUF has no explicit metadata key for RoPE's rotation convention (NEOX
# "rotate-half", pairs (j, j+half_dim) vs NORM/GPT-J "interleaved", pairs
# (2j, 2j+1)) — llama.cpp itself hardcodes this per architecture
# (`llama_model_rope_type` in its own src/llama-model.cpp), not derived
# from any GGUF field, so this project has to mirror that table rather
# than read it. Verified empirically against real downloaded weights, not
# just transcribed from llama.cpp's source: Qwen2.5-0.5B-Instruct needs
# NEOX (already correct pre-generalization) and TinyLlama-1.1B-Chat
# (architecture "llama" — also covers plain Mistral, which reuses the same
# GGUF architecture string) needs NORM — a 4-decimal-place logit match on
# the interleaved formula against NEOX's complete divergence beyond
# position 0 (see docs/development-log.md) leaves no ambiguity about which
# is which. Scoped to exactly this project's target family for now; throws
# on anything else rather than silently guessing (same "fail loud on an
# unhandled case" convention as quant.br's unsupported-ggml-type error).
int rope_style_for_arch(string arch) throws:
    if arch == "qwen2" or arch == "qwen3":
        1
    elif arch == "llama":
        0
    else:
        throw "config_from_gguf: unknown RoPE convention for architecture '{arch}' (only 'qwen2'/'qwen3'/'llama' are known — check llama.cpp's llama_model_rope_type() before adding a new one)"

pub Config config_from_gguf(GgufFile file) throws:
    guard let arch = gguf_get_string(file.metadata, "general.architecture") else throw "GGUF: missing general.architecture"
    guard let n_layer = gguf_get_int(file.metadata, "{arch}.block_count") else throw "GGUF: missing {arch}.block_count"
    guard let d_model = gguf_get_int(file.metadata, "{arch}.embedding_length") else throw "GGUF: missing {arch}.embedding_length"
    guard let n_head = gguf_get_int(file.metadata, "{arch}.attention.head_count") else throw "GGUF: missing {arch}.attention.head_count"
    let n_kv_head = gguf_get_int(file.metadata, "{arch}.attention.head_count_kv") else n_head
    guard let ffn_dim = gguf_get_int(file.metadata, "{arch}.feed_forward_length") else throw "GGUF: missing {arch}.feed_forward_length"
    let rope_freq_base = gguf_get_f32(file.metadata, "{arch}.rope.freq_base") else (10000.0 as float32)
    let rms_eps = gguf_get_f32(file.metadata, "{arch}.attention.layer_norm_rms_epsilon") else (1.0e-6 as float32)
    let vocab_size = gguf_get_string_array(file.metadata, "tokenizer.ggml.tokens").length
    let rope_neox = rope_style_for_arch(arch)

    var bool has_output = false
    for t in file.tensors:
        if t.name == "output.weight":
            has_output = true

    # The head size is `{arch}.attention.key_length` when the file says so (Qwen3's
    # is 128 whatever d_model / n_head is: 2560 / 32 = 80 for the 4B model);
    # otherwise d_model / n_head, which is what Llama and Qwen2 files mean.
    let d_head = gguf_get_int(file.metadata, "{arch}.attention.key_length") else (d_model / n_head)
    let value_len = gguf_get_int(file.metadata, "{arch}.attention.value_length") else d_head
    guard value_len == d_head else throw "config_from_gguf: key_length {d_head} != value_length {value_len} is not supported"
    let qk_norm = tensor_exists(file.tensors, "blk.0.attn_q_norm.weight")

    Config(vocab_size, d_model, n_layer, n_head, n_kv_head, d_head,
           ffn_dim, rope_freq_base, rms_eps, not has_output, rope_neox, qk_norm)

pub Model load_model(GgufFile file) throws:
    let config = config_from_gguf(file)
    let tok_embd = load_tensor_f32(file, "token_embd.weight")
    let qkv_dim = config.n_head * config.d_head
    let kv_dim = config.n_kv_head * config.d_head

    mut [Layer] layers = []
    var int l = 0
    while l < config.n_layer:
        let prefix = "blk.{l}"
        let layer = Layer(
            load_tensor_f32(file, "{prefix}.attn_norm.weight"),
            load_tensor_f32(file, "{prefix}.attn_q.weight"),
            load_tensor_f32_or_zero(file, "{prefix}.attn_q.bias", qkv_dim),
            load_tensor_f32(file, "{prefix}.attn_k.weight"),
            load_tensor_f32_or_zero(file, "{prefix}.attn_k.bias", kv_dim),
            load_tensor_f32(file, "{prefix}.attn_v.weight"),
            load_tensor_f32_or_zero(file, "{prefix}.attn_v.bias", kv_dim),
            load_tensor_f32(file, "{prefix}.attn_output.weight"),
            load_tensor_f32(file, "{prefix}.ffn_norm.weight"),
            load_tensor_f32(file, "{prefix}.ffn_gate.weight"),
            load_tensor_f32(file, "{prefix}.ffn_up.weight"),
            load_tensor_f32(file, "{prefix}.ffn_down.weight"),
            load_tensor_f32_or_zero(file, "{prefix}.attn_q_norm.weight", config.d_head),
            load_tensor_f32_or_zero(file, "{prefix}.attn_k_norm.weight", config.d_head))
        layers.push(layer)
        l += 1

    let output_norm_w = load_tensor_f32(file, "output_norm.weight")
    let output_w = resolve_output_weight(file, config, tok_embd)

    Model(config, tok_embd, layers, output_norm_w, output_w)

# Split out of load_model as its own function specifically so `tok_embd` is
# borrowed here (arrays are always passed by reference to functions) rather
# than moved — reusing it directly via `var output_w = tok_embd` followed by
# a later reference to the original `tok_embd` is a real move-then-use error
# in the transpiled Rust (`Vec<f32>` isn't `Copy`), since a bare local-to-
# local array assignment moves rather than clones.
[float32] resolve_output_weight(GgufFile file, Config config, [float32] tok_embd) throws:
    if config.tied_embeddings:
        tok_embd
    else:
        load_tensor_f32(file, "output.weight")

# Phase 2b model loading: every big matmul-heavy weight stays as raw
# quantized-packed bytes (see QuantLayer's doc comment), each tagged with
# its own ggml type — throws clearly (via load_tensor_quantized/
# quantized_row_bytes) if a tensor's type isn't one of the four this
# project's fused GPU kernels understand (Q5_0/Q8_0/Q4_K/Q6_K), rather than
# silently misreading its bytes.
pub QuantModel load_model_quantized(GgufFile file) throws:
    let config = config_from_gguf(file)
    let (tok_embd_q8, tok_embd_type) = load_tensor_quantized(file, "token_embd.weight")
    let qkv_dim = config.n_head * config.d_head
    let kv_dim = config.n_kv_head * config.d_head

    mut [QuantLayer] layers = []
    var int l = 0
    while l < config.n_layer:
        let prefix = "blk.{l}"
        let (q_w, q_ty) = load_tensor_quantized(file, "{prefix}.attn_q.weight")
        let (k_w, k_ty) = load_tensor_quantized(file, "{prefix}.attn_k.weight")
        let (v_w, v_ty) = load_tensor_quantized(file, "{prefix}.attn_v.weight")
        let (o_w, o_ty) = load_tensor_quantized(file, "{prefix}.attn_output.weight")
        let (gate_w, gate_ty) = load_tensor_quantized(file, "{prefix}.ffn_gate.weight")
        let (up_w, up_ty) = load_tensor_quantized(file, "{prefix}.ffn_up.weight")
        let (down_w, down_ty) = load_tensor_quantized(file, "{prefix}.ffn_down.weight")
        let q_b = load_tensor_f32_or_zero(file, "{prefix}.attn_q.bias", qkv_dim)
        let k_b = load_tensor_f32_or_zero(file, "{prefix}.attn_k.bias", kv_dim)
        let v_b = load_tensor_f32_or_zero(file, "{prefix}.attn_v.bias", kv_dim)
        # Q/K/V have the same row-packed Q8_0 layout on the 0.5B model. Joining
        # their rows lets decode issue one native projection instead of three.
        # Keep a one-element placeholder elsewhere: duplicating hundreds of MB
        # of weights on larger or mixed-format models would erase the benefit.
        let qkv_fused = config.d_model <= 1024 and q_ty == 8 and k_ty == 8 and v_ty == 8
        mut [uint8] qkv_w = [0 as uint8]
        mut [float32] qkv_b = [0.0 as float32]
        if qkv_fused:
            qkv_w = []
            for value in q_w: qkv_w.push(value)
            for value in k_w: qkv_w.push(value)
            for value in v_w: qkv_w.push(value)
            qkv_b = []
            for value in q_b: qkv_b.push(value)
            for value in k_b: qkv_b.push(value)
            for value in v_b: qkv_b.push(value)
        # Every weight and norm/bias is uploaded to the GPU exactly once, here,
        # and stays resident for the model's lifetime (see upload_bytes_gpu).
        let layer = QuantLayer(
            upload_floats_gpu(load_tensor_f32(file, "{prefix}.attn_norm.weight")),
            upload_bytes_gpu(q_w), q_ty,
            upload_floats_gpu(q_b),
            upload_bytes_gpu(k_w), k_ty,
            upload_floats_gpu(k_b),
            upload_bytes_gpu(v_w), v_ty,
            upload_floats_gpu(v_b),
            upload_bytes_gpu(qkv_w), upload_floats_gpu(qkv_b), qkv_fused,
            upload_bytes_gpu(o_w), o_ty,
            upload_floats_gpu(load_tensor_f32(file, "{prefix}.ffn_norm.weight")),
            upload_bytes_gpu(gate_w), gate_ty,
            upload_bytes_gpu(up_w), up_ty,
            upload_bytes_gpu(down_w), down_ty,
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.attn_q_norm.weight", config.d_head)),
            upload_floats_gpu(load_tensor_f32_or_zero(file, "{prefix}.attn_k_norm.weight", config.d_head)))
        layers.push(layer)
        l += 1

    let output_norm_w = load_tensor_f32(file, "output_norm.weight")
    let (output_w_q8, output_w_type) = resolve_output_weight_q8(file, config, tok_embd_q8, tok_embd_type)

    QuantModel(config, tok_embd_q8, tok_embd_type, layers, upload_floats_gpu(output_norm_w), upload_bytes_gpu(output_w_q8), output_w_type)

([uint8], int) resolve_output_weight_q8(GgufFile file, Config config, [uint8] tok_embd_q8, int tok_embd_type) throws:
    if config.tied_embeddings:
        (tok_embd_q8, tok_embd_type)
    else:
        load_tensor_quantized(file, "output.weight")

# Full (uncached) forward pass over every position in `tokens`. Returns
# logits for every position (seq * vocab_size), row-major — the caller
# typically only needs the last position's row for greedy next-token
# prediction, but every position is computed since there's no KV-cache yet.
pub [float32] forward(Model model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    var mut [float32] x = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        var int i = 0
        while i < d:
            x[p * d + i] = model.tok_embd[tok * d + i]
            i += 1
        p += 1

    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        let normed = rms_norm(x, layer.attn_norm_w, seq, d, model.config.rms_eps)
        var q = linear_bias(normed, layer.q_w, layer.q_b, seq, d, qkv_dim)
        var k = linear_bias(normed, layer.k_w, layer.k_b, seq, d, kv_dim)
        let v = linear_bias(normed, layer.v_w, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm:
            q = rms_norm(q, layer.q_norm_w, seq * model.config.n_head, model.config.d_head, model.config.rms_eps)
            k = rms_norm(k, layer.k_norm_w, seq * model.config.n_kv_head, model.config.d_head, model.config.rms_eps)
        q = rope_apply(q, seq, model.config.n_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        k = rope_apply(k, seq, model.config.n_kv_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        let attn_out = gqa_attention(q, k, v, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        let attn_proj = linear(attn_out, layer.o_w, seq, qkv_dim, d)
        x = vec_add(x, attn_proj)

        let normed2 = rms_norm(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        let ffn_out = swiglu_ffn(normed2, layer.gate_w, layer.up_w, layer.down_w, seq, d, model.config.ffn_dim)
        x = vec_add(x, ffn_out)

        l += 1

    let final_normed = rms_norm(x, model.output_norm_w, seq, d, model.config.rms_eps)
    linear(final_normed, model.output_w, seq, d, model.config.vocab_size)

# Phase 2a: same forward pass, but every matmul/norm/RoPE/attention op runs
# as a real GPU kernel (math_gpu.br) instead of a CPU loop. Still no
# KV-cache — full re-forward every position, same as forward() above — the
# goal here is proving the kernel architecture matches Phase 1's CPU output
# bit-for-bit-ish (float32 rounding aside), not decode performance yet.
pub [float32] forward_gpu(Model model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head

    var mut [float32] x = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        var int i = 0
        while i < d:
            x[p * d + i] = model.tok_embd[tok * d + i]
            i += 1
        p += 1

    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        # Chaining one GPU host function's result directly into the next
        # used to need a `passthrough()` round-trip (task_63a8da7f/
        # task_6179e0f9, both fixed upstream — confirmed empirically before
        # removing this) — direct chaining works correctly now.
        let normed = rms_norm_gpu(x, layer.attn_norm_w, seq, d, model.config.rms_eps)
        var q = linear_gpu(normed, layer.q_w, layer.q_b, seq, d, qkv_dim)
        var k = linear_gpu(normed, layer.k_w, layer.k_b, seq, d, kv_dim)
        let v = linear_gpu(normed, layer.v_w, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm:
            q = rms_norm_gpu(q, layer.q_norm_w, seq * model.config.n_head, model.config.d_head, model.config.rms_eps)
            k = rms_norm_gpu(k, layer.k_norm_w, seq * model.config.n_kv_head, model.config.d_head, model.config.rms_eps)
        q = rope_apply_gpu(q, seq, model.config.n_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        k = rope_apply_gpu(k, seq, model.config.n_kv_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        let attn_out = attention_gqa_gpu(q, k, v, seq, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head, true, 0)
        let attn_proj = linear_nobias_gpu(attn_out, layer.o_w, seq, qkv_dim, d)
        x = vec_add(x, attn_proj)

        let normed2 = rms_norm_gpu(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        let gate = linear_nobias_gpu(normed2, layer.gate_w, seq, d, model.config.ffn_dim)
        let up = linear_nobias_gpu(normed2, layer.up_w, seq, d, model.config.ffn_dim)
        let hidden = swiglu_combine_gpu(gate, up)
        let ffn_out = linear_nobias_gpu(hidden, layer.down_w, seq, model.config.ffn_dim, d)
        x = vec_add(x, ffn_out)

        l += 1

    let final_normed = rms_norm_gpu(x, model.output_norm_w, seq, d, model.config.rms_eps)
    linear_nobias_gpu(final_normed, model.output_w, seq, d, model.config.vocab_size)

# Phase 2b: same forward pass as forward_gpu, but every big matmul-heavy
# weight is handled by the tensor quantized-linear primitive
# reading raw packed bytes directly — no CPU-side dequantization, no full
# fp32 weight copy ever materialized for these tensors (see math_gpu.br's
# Q8LinearKernel doc comment for the memory-savings rationale). Token
# embedding lookup dequantizes just the one needed row per position (cheap,
# CPU-side, quant.br's dequantize_q8_0) rather than the whole vocab table.
pub [float32] forward_gpu_quantized(QuantModel& model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let tok_embd_row_bytes = quantized_row_bytes(model.tok_embd_type, d)

    var mut [float32] x = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        let row_byte_offset = tok * tok_embd_row_bytes
        let row = dequantize_row(model.tok_embd_type, model.tok_embd_q8, row_byte_offset, d)
        var int i = 0
        while i < d:
            x[p * d + i] = row[i]
            i += 1
        p += 1

    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        let normed = rms_norm_gpu(x, layer.attn_norm_w, seq, d, model.config.rms_eps)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, seq, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, seq, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm:
            q = rms_norm_gpu(q, layer.q_norm_w, seq * model.config.n_head, model.config.d_head, model.config.rms_eps)
            k = rms_norm_gpu(k, layer.k_norm_w, seq * model.config.n_kv_head, model.config.d_head, model.config.rms_eps)
        q = rope_apply_gpu(q, seq, model.config.n_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        k = rope_apply_gpu(k, seq, model.config.n_kv_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        let attn_out = attention_gqa_gpu(q, k, v, seq, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head, true, 0)
        let attn_proj = tensor_linear_nobias_gpu(attn_out, layer.o_w_q8, layer.o_w_type, seq, qkv_dim, d)
        x = vec_add(x, attn_proj)

        let normed2 = rms_norm_gpu(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, seq, d, model.config.ffn_dim)
        let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, seq, d, model.config.ffn_dim)
        let hidden = swiglu_combine_gpu(gate, up)
        let ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, seq, model.config.ffn_dim, d)
        x = vec_add(x, ffn_out)

        l += 1

    let final_normed = rms_norm_gpu(x, model.output_norm_w, seq, d, model.config.rms_eps)
    tensor_linear_nobias_gpu(final_normed, model.output_w_q8, model.output_w_type, seq, d, model.config.vocab_size)

# Phase 3: greedy decoding — repeatedly calls forward_gpu_quantized on the
# whole sequence so far (no KV-cache, deliberately still deferred — see
# math.br's/forward()'s own header comments) and appends the argmax token,
# stopping at `eos_id` or once `max_new_tokens` have been generated.
# O(seq) forward passes each doing O(seq)-ish work, so total cost grows
# faster than linear in the number of new tokens — fine for a small model
# and short generations, a real cost KV-cache would remove (a documented,
# deliberate Phase 4 stretch item, not fixed here).
pub struct SamplingParams:
    float32 temperature   # <= 0 -> greedy argmax, ignores top_k/top_p entirely
    int top_k             # <= 0 -> defaults to 50 (see sampling.br's own doc comment)
    float32 top_p         # >= 1.0 -> no nucleus filtering (keep the whole top-k set)
    int seed
    float32 repeat_penalty  # == 1.0 -> disabled (this project's own default; llama.cpp's own default is 1.1)
    int repeat_last_n       # <= 0 -> penalize the whole history; llama.cpp's own default is 64

pub SamplingParams greedy_params():
    SamplingParams(0.0 as float32, 0, 1.0 as float32, 0, 1.0 as float32, 64)

[float32] extract_row([float32] logits, int row, int vocab):
    mut [float32] out = [0.0 for i in 0..<vocab]
    let base = row * vocab
    var int i = 0
    while i < vocab:
        out[i] = logits[base + i]
        i += 1
    out

pub [int] generate(QuantModel& model, [int] prompt_tokens, int max_new_tokens, int eos_id,
                    SamplingParams params) throws:
    mut [int] tokens = []
    for t in prompt_tokens:
        tokens.push(t)

    var rng = seed_rng(params.seed)
    let vocab = model.config.vocab_size
    var int generated = 0
    while generated < max_new_tokens:
        let logits = forward_gpu_quantized(model, tokens)
        let seq = tokens.length
        let last_logits = extract_row(logits, seq - 1, vocab)

        let (next_tok, new_rng) = sample(rng, last_logits, vocab, params.temperature, params.top_k, params.top_p, tokens, params.repeat_penalty, params.repeat_last_n)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1
        if next_tok == eos_id:
            return tokens

    tokens

# Same as generate() above, but for a plain Model —
# every tensor already dequantized to float32 at load time (load_model),
# with forward_gpu's fp32 kernels doing the actual compute. This remains a
# useful reference path for comparing the packed-weight tensor path against
# weights dequantized once at load time.
pub [int] generate_f32(Model model, [int] prompt_tokens, int max_new_tokens, int eos_id,
                        SamplingParams params) throws:
    mut [int] tokens = []
    for t in prompt_tokens:
        tokens.push(t)

    var rng = seed_rng(params.seed)
    let vocab = model.config.vocab_size
    var int generated = 0
    while generated < max_new_tokens:
        let logits = forward_gpu(model, tokens)
        let seq = tokens.length
        let last_logits = extract_row(logits, seq - 1, vocab)

        let (next_tok, new_rng) = sample(rng, last_logits, vocab, params.temperature, params.top_k, params.top_p, tokens, params.repeat_penalty, params.repeat_last_n)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1
        if next_tok == eos_id:
            return tokens

    tokens

# ── Phase 4: KV-cache incremental decode ────────────────────────────────
# generate() above re-forwards the WHOLE sequence from scratch every step
# (O(total_seq) work per layer's GEMMs, every single step) — correct, and
# the right thing to prove first, but wasteful. forward_step() below
# processes exactly ONE new token per call, growing each layer's K/V cache
# by one position instead of recomputing it — O(1) GEMM work per step
# (only attention's cost still scales with the cache size, which is
# unavoidable without a fundamentally different algorithm).
#
# Cache growing returns a NEW GenCache rather than mutating one in place —
# whisper-boring's decoder.br already documents why: passing a struct field
# as a `var [T]` parameter to mutate it doesn't actually write the mutation
# back, neither under `boring run` nor in the transpiled Rust. Returning
# the grown state and having the caller reassign is the pattern that
# actually works (mirrors mha_step_gpu's own `(out, new_cache_k,
# new_cache_v)` return shape).

# `k`/`v` are GPU-resident (`'kernel'unified`): they live on the device for the
# whole generation and are grown there by `kv_append_gpu`, never read back.
#
# A kernel cannot grow a device buffer in place, so every append builds a new
# buffer and copies the old rows: with the whole cache in one buffer that is a
# copy of the entire context per layer per token (35 ms/token at 2k tokens on
# the 7B model, growing linearly). The cache is therefore split in two: the
# main buffer (`k`/`v`, the oldest rows) and a short tail (`tk`/`tv`, the
# newest `GenCache.tail` rows). A decode step appends to the tail (a few dozen
# rows copied at most) and the tail is folded into the main buffer every
# TAIL_MAX tokens, so the full copy is amortised over TAIL_MAX steps. Prefill
# folds the tail first and works on one buffer.
pub struct LayerCache:
    [float32]'kernel'unified k     # main rows: the first `GenCache.pos - GenCache.tail` are valid
    [float32]'kernel'unified v
    [float32]'kernel'unified tk    # the newest `GenCache.tail` rows ([] when there are none)
    [float32]'kernel'unified tv

pub struct GenCache:
    [LayerCache] layers
    int pos        # absolute position of the NEXT token to be processed
    int tail       # how many of the newest positions live in the tail buffers

let int TAIL_MAX = 64

# Batched prefill: processes the WHOLE prompt in one pass per layer (same
# structure as forward_gpu_quantized — same kernels, same dispatch count
# regardless of how many prompt tokens there are), instead of feeding
# prompt tokens one at a time through forward_step. Capturing each layer's
# post-RoPE K/V here (rather than re-deriving them one position at a time)
# is what makes generate_kv() actually faster than the no-cache path for
# realistic prompt lengths — processing a 26-token prompt as 26 individual
# single-token GPU dispatch sequences turned out to be *slower* wall-clock
# than one batched 26-token forward, purely from per-kernel-launch overhead
# at this model's small scale (confirmed empirically before adding this).
pub ([float32], GenCache) prefill_gpu_quantized(QuantModel& model, [int] tokens) throws:
    let seq = tokens.length
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let tok_embd_row_bytes = quantized_row_bytes(model.tok_embd_type, d)

    mut [float32] x_host = [0.0 for i in 0..<(seq * d)]
    var int p = 0
    while p < seq:
        let tok = tokens[p]
        let row_byte_offset = tok * tok_embd_row_bytes
        let row = dequantize_row(model.tok_embd_type, model.tok_embd_q8, row_byte_offset, d)
        var int i = 0
        while i < d:
            x_host[p * d + i] = row[i]
            i += 1
        p += 1

    # Residual stream: uploaded once, then kept on the device across layers.
    var x = upload_floats_gpu(x_host)

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]

        let normed = rms_norm_gpu(x, layer.attn_norm_w, seq, d, model.config.rms_eps)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, seq, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, seq, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, seq, d, kv_dim)
        if model.config.qk_norm:
            q = rms_norm_gpu(q, layer.q_norm_w, seq * model.config.n_head, model.config.d_head, model.config.rms_eps)
            k = rms_norm_gpu(k, layer.k_norm_w, seq * model.config.n_kv_head, model.config.d_head, model.config.rms_eps)
        q = rope_apply_gpu(q, seq, model.config.n_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        let k_rope_raw = rope_apply_gpu(k, seq, model.config.n_kv_head, model.config.d_head, model.config.rope_freq_base, model.config.rope_neox)
        let attn_out = attention_gqa_gpu(q, k_rope_raw, v, seq, seq, model.config.n_head, model.config.n_kv_head, model.config.d_head, true, 0)
        let attn_proj = tensor_linear_nobias_gpu(attn_out, layer.o_w_q8, layer.o_w_type, seq, qkv_dim, d)
        x = add_gpu(x, attn_proj, seq * d)

        let normed2 = rms_norm_gpu(x, layer.ffn_norm_w, seq, d, model.config.rms_eps)
        let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, seq, d, model.config.ffn_dim)
        let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, seq, d, model.config.ffn_dim)
        let hidden = swiglu_combine_gpu(gate, up)
        let ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, seq, model.config.ffn_dim, d)
        x = add_gpu(x, ffn_out, seq * d)

        # `k_rope_raw`/`v` already ARE the whole prompt's post-RoPE cache for
        # this layer (seq positions, 0..seq-1) — nothing to grow, and they
        # stay on the device as the resident cache.
        new_layers.push(LayerCache(k_rope_raw, v, [], []))
        l += 1

    # Only the LAST position's logits are ever used (they pick the first
    # generated token), so only the last row goes through the final norm and
    # the vocab-wide output projection — the biggest single matmul in the
    # model (d_model x vocab_size, e.g. 896 x 151936). Running it over all
    # `seq` rows (as this used to) cost `seq`x the work and read back
    # seq*vocab_size floats, ~97% of a 38-token prefill's wall-clock.
    # RMSNorm is row-independent, so the last row's logits are the same
    # math; as a seq=1 projection it also takes fused_linear_gpu's
    # decode-shape (warp-broadcast) kernel.
    let x_last = extract_row(x, seq - 1, d)
    let final_normed = rms_norm_gpu(x_last, model.output_norm_w, 1, d, model.config.rms_eps)
    let logits_raw = tensor_linear_nobias_gpu(final_normed, model.output_w_q8, model.output_w_type, 1, d, model.config.vocab_size)
    # returned inside a tuple below, which — like a struct constructor —
    # doesn't trigger the GPU-result-to-array conversion automatically.
    let last_logits = passthrough(logits_raw)

    (last_logits, GenCache(new_layers, seq, 0))

# Batched cache-append: like prefill_gpu_quantized above, but appends
# `tokens` (a batch of N new tokens, N >= 1) to an EXISTING, possibly
# non-empty cache, instead of always starting from position 0 — the case
# prefill_gpu_quantized doesn't handle (it always builds a brand-new
# GenCache from an implicit empty one). This is what lets a multi-turn
# chat's later turns reuse the KV-cache already computed for earlier turns
# instead of re-prefilling the whole conversation from scratch every turn
# (run_chat in main.br). Kept as a separate function from
# prefill_gpu_quantized, mirroring generate()/generate_kv()'s own existing
# split, rather than unifying them behind an "empty vs non-empty cache"
# branch — same GPU-orchestration code, same reasoning.
pub ([float32], GenCache) prefill_step_gpu_quantized(QuantModel& model, GenCache cache0, [int] tokens) throws:
    if cache0.pos == 0:
        return prefill_gpu_quantized(model, tokens)
    let cache = fold_cache(model, cache0)
    let n = tokens.length
    let base_pos = cache.pos
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let tok_embd_row_bytes = quantized_row_bytes(model.tok_embd_type, d)

    mut [float32] x_host = [0.0 for i in 0..<(n * d)]
    var int p = 0
    while p < n:
        let tok = tokens[p]
        let row_byte_offset = tok * tok_embd_row_bytes
        let row = dequantize_row(model.tok_embd_type, model.tok_embd_q8, row_byte_offset, d)
        var int i = 0
        while i < d:
            x_host[p * d + i] = row[i]
            i += 1
        p += 1

    # Residual stream: uploaded once, then kept on the device across layers.
    var x = upload_floats_gpu(x_host)

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]
        let lc = cache.layers[l]

        let normed = rms_norm_gpu(x, layer.attn_norm_w, n, d, model.config.rms_eps)
        var q = tensor_linear_gpu(normed, layer.q_w_q8, layer.q_w_type, layer.q_b, n, d, qkv_dim)
        var k = tensor_linear_gpu(normed, layer.k_w_q8, layer.k_w_type, layer.k_b, n, d, kv_dim)
        let v = tensor_linear_gpu(normed, layer.v_w_q8, layer.v_w_type, layer.v_b, n, d, kv_dim)
        if model.config.qk_norm:
            q = rms_norm_gpu(q, layer.q_norm_w, n * model.config.n_head, model.config.d_head, model.config.rms_eps)
            k = rms_norm_gpu(k, layer.k_norm_w, n * model.config.n_kv_head, model.config.d_head, model.config.rms_eps)
        # RoPE positions for this batch start at `base_pos` (the number of
        # positions already in the cache), not 0 — same rope_apply_at_gpu
        # forward_step already uses for a single new token, just batched.
        q = rope_apply_at_gpu(q, n, model.config.n_head, model.config.d_head, model.config.rope_freq_base, base_pos, model.config.rope_neox)
        let k_rope_raw = rope_apply_at_gpu(k, n, model.config.n_kv_head, model.config.d_head, model.config.rope_freq_base, base_pos, model.config.rope_neox)
        # Grow the resident cache on the device: old rows then the new ones.
        let full_k = kv_append_gpu(lc.k, k_rope_raw, base_pos * kv_dim, n * kv_dim)
        let full_v = kv_append_gpu(lc.v, v, base_pos * kv_dim, n * kv_dim)

        let seq_k = base_pos + n
        let attn_out = attention_gqa_gpu(q, full_k, full_v, n, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head, true, base_pos)
        let attn_proj = tensor_linear_nobias_gpu(attn_out, layer.o_w_q8, layer.o_w_type, n, qkv_dim, d)
        x = add_gpu(x, attn_proj, n * d)

        let normed2 = rms_norm_gpu(x, layer.ffn_norm_w, n, d, model.config.rms_eps)
        let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, n, d, model.config.ffn_dim)
        let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, n, d, model.config.ffn_dim)
        let hidden = swiglu_combine_gpu(gate, up)
        let ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, n, model.config.ffn_dim, d)
        x = add_gpu(x, ffn_out, n * d)

        new_layers.push(LayerCache(full_k, full_v, [], []))
        l += 1

    # Last row only — see prefill_gpu_quantized's identical tail for why.
    let x_last = extract_row(x, n - 1, d)
    let final_normed = rms_norm_gpu(x_last, model.output_norm_w, 1, d, model.config.rms_eps)
    let logits_raw = tensor_linear_nobias_gpu(final_normed, model.output_w_q8, model.output_w_type, 1, d, model.config.vocab_size)
    let last_logits = passthrough(logits_raw)

    (last_logits, GenCache(new_layers, base_pos + n, 0))

pub GenCache empty_cache(int n_layer):
    mut [LayerCache] layers = []
    var int l = 0
    while l < n_layer:
        layers.push(LayerCache([], [], [], []))
        l += 1
    GenCache(layers, 0, 0)

# The cache with its tail folded into the main buffers (nothing to do when the
# tail is empty): what prefill and the disk snapshots need, one buffer per layer.
pub GenCache fold_cache(QuantModel& model, GenCache cache) throws:
    if cache.tail == 0:
        return cache
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let main_n = cache.pos - cache.tail
    mut [LayerCache] layers = []
    var int l = 0
    while l < model.config.n_layer:
        let lc = cache.layers[l]
        let fk = kv_append_gpu(lc.k, lc.tk, main_n * kv_dim, cache.tail * kv_dim)
        let fv = kv_append_gpu(lc.v, lc.tv, main_n * kv_dim, cache.tail * kv_dim)
        layers.push(LayerCache(fk, fv, [], []))
        l += 1
    GenCache(layers, cache.pos, 0)

# Processes exactly one new token against the existing cache. Returns the
# new token's own logits row (vocab_size long — there's only ever one
# position per call) and the grown cache.
pub ([float32], GenCache) forward_step(QuantModel& model, GenCache cache, int token) throws:
    guard cache.pos > 0 else throw "forward_step needs a prefilled cache"
    set_gpu_batch_limit(8)
    let d = model.config.d_model
    let qkv_dim = model.config.n_head * model.config.d_head
    let kv_dim = model.config.n_kv_head * model.config.d_head
    let tok_embd_row_bytes = quantized_row_bytes(model.tok_embd_type, d)
    let pos = cache.pos

    let row_byte_offset = token * tok_embd_row_bytes
    # Residual stream: uploaded once, then it stays on the device — every
    # `add_gpu` below consumes and produces a resident buffer.
    var x = upload_floats_gpu(dequantize_row(model.tok_embd_type, model.tok_embd_q8, row_byte_offset, d))

    mut [LayerCache] new_layers = []
    var int l = 0
    while l < model.config.n_layer:
        let layer = model.layers[l]
        let lc = cache.layers[l]

        let normed = rms_norm_gpu(x, layer.attn_norm_w, 1, d, model.config.rms_eps)
        let (q0, k0, v_new) = project_qkv_decode_gpu(normed,
            layer.q_w_q8, layer.q_w_type, layer.q_b,
            layer.k_w_q8, layer.k_w_type, layer.k_b,
            layer.v_w_q8, layer.v_w_type, layer.v_b,
            layer.qkv_w_q8, layer.qkv_b, layer.qkv_fused,
            d, qkv_dim, kv_dim)
        var q = q0
        var k_new = k0
        if model.config.qk_norm:
            q = rms_norm_gpu(q, layer.q_norm_w, 1 * model.config.n_head, model.config.d_head, model.config.rms_eps)
            k_new = rms_norm_gpu(k_new, layer.k_norm_w, 1 * model.config.n_kv_head, model.config.d_head, model.config.rms_eps)

        q = rope_apply_at_gpu(q, 1, model.config.n_head, model.config.d_head, model.config.rope_freq_base, pos, model.config.rope_neox)
        let k_rope_raw = rope_apply_at_gpu(k_new, 1, model.config.n_kv_head, model.config.d_head, model.config.rope_freq_base, pos, model.config.rope_neox)

        # The new row goes to the tail (see LayerCache); the tail is folded into
        # the main buffers once it reaches TAIL_MAX rows.
        let seq_k = pos + 1
        let tail_len = cache.tail
        let main_len = pos - tail_len
        let tk_new = kv_tail_push(lc.tk, k_rope_raw, tail_len * kv_dim, kv_dim)
        let tv_new = kv_tail_push(lc.tv, v_new, tail_len * kv_dim, kv_dim)

        # No causal mask: the single new query is always the most recent
        # position, so every key already in the cache (including the one
        # just appended) is a legitimate position to attend to.
        let attn_out = attention_gqa_tail_gpu(q, lc.k, lc.v, tk_new, tv_new, main_len, seq_k, model.config.n_head, model.config.n_kv_head, model.config.d_head)
        let attn_proj = tensor_linear_nobias_gpu(attn_out, layer.o_w_q8, layer.o_w_type, 1, qkv_dim, d)
        x = add_gpu(x, attn_proj, d)

        let normed2 = rms_norm_gpu(x, layer.ffn_norm_w, 1, d, model.config.rms_eps)
        let gate = tensor_linear_nobias_gpu(normed2, layer.gate_w_q8, layer.gate_w_type, 1, d, model.config.ffn_dim)
        let up = tensor_linear_nobias_gpu(normed2, layer.up_w_q8, layer.up_w_type, 1, d, model.config.ffn_dim)
        let hidden = swiglu_combine_gpu(gate, up)
        let ffn_out = tensor_linear_nobias_gpu(hidden, layer.down_w_q8, layer.down_w_type, 1, model.config.ffn_dim, d)
        x = add_gpu(x, ffn_out, d)

        if tail_len + 1 >= TAIL_MAX:
            let full_k = kv_append_gpu(lc.k, tk_new, main_len * kv_dim, (tail_len + 1) * kv_dim)
            let full_v = kv_append_gpu(lc.v, tv_new, main_len * kv_dim, (tail_len + 1) * kv_dim)
            new_layers.push(LayerCache(full_k, full_v, [], []))
        else:
            new_layers.push(LayerCache(lc.k, lc.v, tk_new, tv_new))
        l += 1

    let new_tail = if cache.tail + 1 >= TAIL_MAX: 0 else: cache.tail + 1
    let final_normed = rms_norm_gpu(x, model.output_norm_w, 1, d, model.config.rms_eps)
    let logits_raw = tensor_linear_nobias_gpu(final_normed, model.output_w_q8, model.output_w_type, 1, d, model.config.vocab_size)
    set_gpu_batch_limit(1)
    # returned inside a tuple below, which — like a struct constructor —
    # doesn't trigger the GPU-result-to-array conversion automatically.
    let logits = passthrough(logits_raw)

    (logits, GenCache(new_layers, pos + 1, new_tail))

# Prefill in fixed-size chunks. One big prefill builds, per layer, a
# (n_head x seq_q x seq_k) score matrix — 14 x 8000 x 8000 x 4 B = 3.5 GB for a
# long agent prompt — so a long prompt is fed `PREFILL_CHUNK` tokens at a time,
# each chunk attending over the already-cached keys plus its own (causal offset
# = tokens already cached). Only the last chunk's logits matter and are returned.
# A cache that is still empty is handled by prefill_step_gpu_quantized itself.
let int PREFILL_CHUNK = 512

pub ([float32], GenCache) prefill_chunked(QuantModel& model, GenCache cache0, [int] tokens) throws:
    guard tokens.length > 0 else throw "prefill_chunked: no tokens"
    var cache = cache0
    var [float32] logits = []
    var int start = 0
    while start < tokens.length:
        var int end = start + PREFILL_CHUNK
        if end > tokens.length:
            end = tokens.length
        let (lg, c) = prefill_step_gpu_quantized(model, cache, tokens[start..<end])
        logits = lg
        cache = c
        start = end
    (logits, cache)

pub [int] generate_kv(QuantModel& model, [int] prompt_tokens, int max_new_tokens, int eos_id,
                       SamplingParams params) throws:
    mut [int] tokens = []
    for t in prompt_tokens:
        tokens.push(t)

    let (first_logits, cache0) = prefill_chunked(model, empty_cache(model.config.n_layer), prompt_tokens)
    var logits = first_logits
    var cache = cache0
    var rng = seed_rng(params.seed)

    let vocab = model.config.vocab_size
    var int generated = 0
    while generated < max_new_tokens:
        let (next_tok, new_rng) = sample(rng, logits, vocab, params.temperature, params.top_k, params.top_p, tokens, params.repeat_penalty, params.repeat_last_n)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1
        if next_tok == eos_id:
            return tokens

        let (step_logits2, new_cache2) = forward_step(model, cache, next_tok)
        logits = step_logits2
        cache = new_cache2

    tokens

# Prefill that resumes from a cache built by an EARLIER request: the server
# keeps the previous requests' caches and, since an agent client resends its
# whole history every turn, only the tokens after the shared prefix need a
# forward pass. `reuse` is how many leading positions of `cache` are valid for
# `prompt_tokens` (the caller computed the common prefix; 0 = start fresh).
# The cache's buffers may be longer than `reuse` positions: every append reads
# only the first `pos * kv_dim` floats, so "truncating" is just setting `pos`.
# `reuse` must be < prompt_tokens.length (the last prompt token is always
# processed — its logits pick the first generated token).
#
# Returns those logits and the cache covering the whole prompt. The caller runs
# the decode loop itself (sample, forward_step, ...), which is what lets the
# server stream each token as it is produced. After such a loop the cache covers
# every token that went through a forward pass: all but the last generated one
# when the reply ended on EOS or a stop string (sampled, never fed back), so use
# `cache.pos`, not the token count, as the number of valid cached positions.
pub ([float32], GenCache) prefill_resume(QuantModel& model, GenCache cache, int reuse, [int] prompt_tokens) throws:
    let start_cache = resume_cache(model, cache, reuse, prompt_tokens.length)
    prefill_chunked(model, start_cache, prompt_tokens[reuse..<prompt_tokens.length])

# The cache a resumed prefill starts from: `cache` truncated to its first
# `reuse` positions (0 = a fresh one). `n_prompt` is only used to range-check.
pub GenCache resume_cache(QuantModel& model, GenCache cache, int reuse, int n_prompt) throws:
    guard reuse >= 0 and reuse < n_prompt else throw "prefill_resume: reuse {reuse} out of range for a {n_prompt}-token prompt"
    if reuse == 0:
        return empty_cache(model.config.n_layer)
    let main_n = cache.pos - cache.tail
    if reuse == cache.pos:
        return cache
    if reuse <= main_n:
        # inside the main buffers: the tail is dropped, the rows past `reuse` ignored
        mut [LayerCache] cut = []
        for lc in cache.layers:
            cut.push(LayerCache(lc.k, lc.v, [], []))
        return GenCache(cut, reuse, 0)
    # inside the tail: the first `reuse - main_n` tail rows join the main ones
    let kv_dim = model.config.n_kv_head * model.config.d_head
    mut [LayerCache] joined = []
    for lc in cache.layers:
        let jk = kv_append_gpu(lc.k, lc.tk, main_n * kv_dim, (reuse - main_n) * kv_dim)
        let jv = kv_append_gpu(lc.v, lc.tv, main_n * kv_dim, (reuse - main_n) * kv_dim)
        joined.push(LayerCache(jk, jv, [], []))
    GenCache(joined, reuse, 0)

# Tokens per `prefill_step_gpu_quantized` call in `prefill_chunked`, for a
# caller that drives the chunks itself (the server, to show progress).
pub int prefill_chunk_len():
    PREFILL_CHUNK

# ── Chat mode: KV-cache reuse across turns ───────────────────────────────
# generate_kv() above is single-shot — it always calls prefill_gpu_quantized
# (which always starts from an empty cache) and, on returning, discards the
# cache it built, so it's unusable across separate calls. The two functions
# below let a multi-turn chat (run_chat in main.br) reuse the SAME cache
# across turns: the first turn calls generate_kv_chat_first (full prefill
# from empty, same as generate_kv, but returns the cache instead of
# dropping it); every later turn calls generate_kv_chat_continue (appends
# only the new turn's own tokens to the existing cache via
# prefill_step_gpu_quantized, instead of re-prefilling the whole
# conversation-so-far). Both share this decode loop, which is otherwise
# identical to generate_kv()'s own loop body.
pub ([int], GenCache) generate_kv_chat_first(QuantModel& model, [int] prompt_tokens, int max_new_tokens,
                                              int eos_id, SamplingParams params) throws:
    let (first_logits, cache0) = prefill_chunked(model, empty_cache(model.config.n_layer), prompt_tokens)
    generate_kv_chat_loop(model, first_logits, cache0, prompt_tokens, max_new_tokens, eos_id, params)

pub ([int], GenCache) generate_kv_chat_continue(QuantModel& model, GenCache cache, [int] new_tokens,
                                                 [int] tokens_so_far, int max_new_tokens, int eos_id,
                                                 SamplingParams params) throws:
    let (first_logits, cache1) = prefill_chunked(model, cache, new_tokens)
    mut [int] full_history = []
    for t in tokens_so_far:
        full_history.push(t)
    for t in new_tokens:
        full_history.push(t)
    generate_kv_chat_loop(model, first_logits, cache1, full_history, max_new_tokens, eos_id, params)

([int], GenCache) generate_kv_chat_loop(QuantModel& model, [float32] first_logits, GenCache cache0,
                                         [int] tokens_so_far, int max_new_tokens, int eos_id,
                                         SamplingParams params) throws:
    mut [int] tokens = []
    for t in tokens_so_far:
        tokens.push(t)

    var logits = first_logits
    var cache = cache0
    var rng = seed_rng(params.seed)

    let vocab = model.config.vocab_size
    var int generated = 0
    var bool hit_eos = false
    while generated < max_new_tokens and not hit_eos:
        let (next_tok, new_rng) = sample(rng, logits, vocab, params.temperature, params.top_k, params.top_p, tokens, params.repeat_penalty, params.repeat_last_n)
        rng = new_rng

        tokens.push(next_tok)
        generated += 1

        # Unlike generate_kv() (single-shot, never continued), this ALWAYS
        # runs the just-generated token through forward_step — including
        # the EOS/<|im_end|> that ends the turn — so the returned cache
        # stays in sync with `tokens` (cache.pos == tokens.length). A later
        # chat turn's continuation (generate_kv_chat_continue) needs every
        # token, including this one's closing marker, to actually be part
        # of the KV-cache: it's real conversation history the next turn's
        # attention must be able to see, and its position must be
        # accounted for so the next turn's RoPE offsets land correctly.
        let (step_logits2, new_cache2) = forward_step(model, cache, next_tok)
        logits = step_logits2
        cache = new_cache2

        if next_tok == eos_id:
            hit_eos = true

    if not hit_eos:
        # max_new_tokens reached without the model ever emitting EOS —
        # force-close the turn anyway. A later continuation always assumes
        # the token stream ends right after a real closing special token
        # (main.br's run_chat, tokenizer.br's render_chat_prompt); without
        # this, the next turn's tokens would follow directly after an
        # unterminated reply,
        # a malformed, out-of-distribution context the model was never
        # trained on (confirmed empirically: this exact gap produced
        # visibly wrong/degenerate continuations before this fix).
        tokens.push(eos_id)
        let (_, final_cache) = forward_step(model, cache, eos_id)
        cache = final_cache

    (tokens, cache)
