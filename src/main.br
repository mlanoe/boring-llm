# boring-llm — CLI entry point
#
# Phase 0 usage:
#   boring run src/main.br --gguf weights/model.gguf --dump-metadata
#
# Later phases add --prompt/--max-tokens for real text generation.

use gguf
use gguf_file
use io
use cache_policy
use prompt_cache
use math_gpu
use model
use tokenizer
use sampling
use server
use json
use openai

def print_metadata(GgufFile file):
    print "GGUF version: {file.version}"
    print ""
    print "-- metadata ({file.metadata.length} keys) --"
    for key in file.metadata.keys():
        match file.metadata[key]:
            GgufValue.Str(s): print "  {key} = \"{s}\""
            GgufValue.Bool(b): print "  {key} = {b}"
            GgufValue.F32(v): print "  {key} = {v}"
            GgufValue.F64(v): print "  {key} = {v}"
            GgufValue.U8(v): print "  {key} = {v}"
            GgufValue.I8(v): print "  {key} = {v}"
            GgufValue.U16(v): print "  {key} = {v}"
            GgufValue.I16(v): print "  {key} = {v}"
            GgufValue.U32(v): print "  {key} = {v}"
            GgufValue.I32(v): print "  {key} = {v}"
            GgufValue.U64(v): print "  {key} = {v}"
            GgufValue.I64(v): print "  {key} = {v}"
            GgufValue.Arr(items): print "  {key} = [array of {items.length} items]"
    print ""
    print "-- tensors ({file.tensors.length}) --"
    var bool has_output_weight = false
    for t in file.tensors:
        print "  {t.name}: dims={t.dims} type={ggml_type_name(t.ggml_type)} offset={t.offset}"
        if t.name == "output.weight":
            has_output_weight = true
    print ""
    let vocab = gguf_get_string_array(file.metadata, "tokenizer.ggml.tokens")
    print "vocab size: {vocab.length}"
    print "has separate output.weight (untied embeddings): {has_output_weight}"

int parse_max_tokens(string s) throws:
    guard let n = (s as int) else throw "invalid --max-tokens value: '{s}'"
    n

int parse_int_arg(string name, string s) throws:
    guard let n = (s as int) else throw "invalid {name} value: '{s}'"
    n

bool parse_bool_arg(string name, string s) throws:
    let value = s.trim().lower()
    if value == "1" or value == "true" or value == "on" or value == "enabled": return true
    if value == "0" or value == "false" or value == "off" or value == "disabled": return false
    throw "invalid {name} boolean value: '{s}'"

bool has_cli_arg([string] argv, [string] names):
    for arg in argv:
        if names.contains(arg): return true
    false

string environment_default([string] argv, [string] cli_names, string env_name, string fallback):
    if has_cli_arg(argv, cli_names): return fallback
    environment(env_name) else fallback

float32 parse_float_arg(string name, string s) throws:
    # NOTE: `(s as float32)` directly (not going through `float`/f64 first)
    # mis-transpiles under --target metal — the parsed value comes out
    # f64-typed regardless of the declared `float32` cast/return type
    # (the same general "float32 string-parsing is less reliable than
    # float64 under a GPU target" theme as elsewhere in this project).
    guard let f = (s as float) else throw "invalid {name} value: '{s}'"
    f as float32

[string] parse_sampler_names(string value) throws:
    mut [string] names = []
    for raw in value.split(";"):
        let name = raw.trim()
        guard name != "" else throw "--samplers must not contain an empty entry"
        names.push(name)
    let validation_error = sampler_list_validation_error(names)
    guard validation_error == "" else throw "--samplers: {validation_error}"
    names

[string] parse_sampler_sequence(string value) throws:
    mut [string] names = []
    for ch in value.chars():
        if ch == "e": names.push("penalties")
        elif ch == "d": names.push("dry")
        elif ch == "s": names.push("top_n_sigma")
        elif ch == "k": names.push("top_k")
        elif ch == "y": names.push("typ_p")
        elif ch == "p": names.push("top_p")
        elif ch == "m": names.push("min_p")
        elif ch == "x": names.push("xtc")
        elif ch == "t": names.push("temperature")
        else: throw "--sampler-seq contains unsupported sampler code `{ch}`"
    let validation_error = sampler_list_validation_error(names)
    guard validation_error == "" else throw "--sampler-seq: {validation_error}"
    names

[int] parse_token_ids(string csv) throws:
    mut [int] result = []
    for part in csv.split(","):
        guard let n = (part as int) else throw "invalid token id: '{part}'"
        result.push(n)
    result

# Phase 1 debug mode: run the CPU-only forward pass on a hand-picked token
# ID sequence (bypassing the tokenizer entirely, per the project's own
# README/plan — this decouples tokenizer bugs from transformer-math bugs)
# and print each position's top-5 logits, in the same format
# tools/reference_logits.py prints, for direct diffing against llama.cpp.
def print_top5([float32] logits, [int] tokens, int vocab) throws:
    var int p = 0
    while p < tokens.length:
        mut [int] top_idx = [0, 0, 0, 0, 0]
        mut [float32] top_val = [-1.0e30 as float32, -1.0e30 as float32, -1.0e30 as float32, -1.0e30 as float32, -1.0e30 as float32]
        var int v = 0
        while v < vocab:
            let val = logits[p * vocab + v]
            if val > top_val[4]:
                var int slot = 4
                while slot > 0 and val > top_val[slot - 1]:
                    top_val[slot] = top_val[slot - 1]
                    top_idx[slot] = top_idx[slot - 1]
                    slot -= 1
                top_val[slot] = val
                top_idx[slot] = v
            v += 1
        print "pos {p} (token {tokens[p]}): top5 = [({top_idx[0]}, {top_val[0]}), ({top_idx[1]}, {top_val[1]}), ({top_idx[2]}, {top_val[2]}), ({top_idx[3]}, {top_val[3]}), ({top_idx[4]}, {top_val[4]})]"
        p += 1

def run_forward_debug(GgufFile file, [int] tokens, bool use_gpu) throws:
    print "[diag] loading model weights..."
    let m = load_model(file)
    print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer} n_head={m.config.n_head} n_kv_head={m.config.n_kv_head})"

    let logits = if use_gpu:
        print "[diag] running forward_gpu (Metal kernels)..."
        forward_gpu(m, tokens)
    else:
        print "[diag] running forward (CPU)..."
        forward(m, tokens)
    print_top5(logits, tokens, m.config.vocab_size)

# Phase 2b debug mode: loads each weight tensor as raw packed bytes (no
# CPU-side dequantization) and runs the matching quantized tensor kernel
# per tensor's own ggml type (see tensor_linear_gpu's dispatch in
# math_gpu.br — Q4_0/Q5_0/Q8_0/Q2_K/Q3_K/Q4_K/Q6_K, not just Q8_0).
def run_forward_debug_quantized(GgufFile file, [int] tokens) throws:
    print "[diag] loading model weights (packed bytes, no CPU dequant)..."
    let m = load_model_quantized(file)
    print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer} n_head={m.config.n_head} n_kv_head={m.config.n_kv_head})"
    print "[diag] running forward_gpu_quantized (quantized tensor kernels)..."
    let logits = forward_gpu_quantized(m, tokens)
    print_top5(logits, tokens, m.config.vocab_size)

# Greedy-or-sampled generation from raw token ids through the KV-cache decode path
# (prefill_chunked + forward_step), printing only the generated ids. tools/decode_vs_llamacpp.py
# compares them with llama.cpp's continuation of the same ids: the logits check (--tokens)
# never runs forward_step, so a decode-only bug is invisible to it.
def run_generate_tokens(GgufFile file, [int] prompt_tokens, int max_new_tokens, SamplingParams params) throws:
    let tok = load_tokenizer(file)
    let m = load_model_quantized(file)
    let all_tokens = generate_kv(m, prompt_tokens, max_new_tokens, tok.eos_token_id, params)
    var string ids = ""
    var int i = prompt_tokens.length
    while i < all_tokens.length:
        if ids != "":
            ids = ids + ","
        ids = ids + "{all_tokens[i]}"
        i += 1
    print "generated: {ids}"

# Phase 3: real end-to-end chat generation — tokenize (GGUF-embedded vocab/
# merges, ChatML wrapping), greedy-decode via the quantized tensor forward
# pass, detokenize, print. Also prints tokens/sec for the generation loop
# (model-load time excluded — that's a one-time cost, not decode throughput).
def run_generate(GgufFile file, string system_msg, string user_msg, int max_new_tokens,
                  bool kv_cache, bool quantized, SamplingParams params) throws:
    let tok = load_tokenizer(file)

    if params.temperature > 0.0 as float32:
        print "[diag] sampling: temperature={params.temperature} top_k={params.top_k} top_p={params.top_p} min_p={params.min_p} seed={params.seed} repeat_penalty={params.repeat_penalty} repeat_last_n={params.repeat_last_n}"
    else:
        print "[diag] sampling: greedy, repeat_penalty={params.repeat_penalty} repeat_last_n={params.repeat_last_n}"

    let prompt_tokens = render_chat_prompt(file, tok, system_msg, [user_msg], [], true)
    print "[diag] prompt: {prompt_tokens.length} tokens"

    let all_tokens = if quantized:
        print "[diag] loading model weights (packed bytes, quantized tensor kernels)..."
        let m = load_model_quantized(file)
        print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer})"
        if kv_cache:
            print "[diag] decoding with KV-cache (forward_step, O(1) GEMM/step)..."
            generate_kv(m, prompt_tokens, max_new_tokens, tok.eos_token_id, params)
        else:
            print "[diag] decoding without KV-cache (full re-forward every step)..."
            generate(m, prompt_tokens, max_new_tokens, tok.eos_token_id, params)
    else:
        # Works with ANY ggml tensor format this project supports (F32,
        # F16, Q5_0, Q8_0, Q4_K, Q6_K, ...) — every tensor dequantized to
        # float32 once at load time (see generate_f32's own doc comment),
        # not just a pure-Q8_0 file. No KV-cache variant yet for this path.
        print "[diag] loading model weights (dequantizing every tensor to fp32 at load)..."
        let m = load_model(file)
        print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer})"
        print "[diag] decoding without KV-cache (full re-forward every step)..."
        generate_f32(m, prompt_tokens, max_new_tokens, tok.eos_token_id, params)

    mut [int] new_tokens = []
    var int i = prompt_tokens.length
    while i < all_tokens.length:
        # Don't include the terminating EOS/<|im_end|> marker in the
        # displayed reply text — it's a real generated token (kept in
        # `all_tokens`/counted below), just not part of the human-readable
        # message.
        if all_tokens[i] != tok.eos_token_id:
            new_tokens.push(all_tokens[i])
        i += 1

    let n_generated = all_tokens.length - prompt_tokens.length
    let reply = tok.decode(new_tokens)
    print ""
    print reply
    print ""
    print "[diag] generated {n_generated} tokens (see shell `time` for wall-clock duration / tok/s)"

# Interactive multi-turn chat (llama.cpp's own `-cnv` mode): keeps the full
# conversation (every prior user/assistant turn) and re-renders it as one
# growing prompt each turn via `render_chat_prompt` (the GGUF's own
# embedded chat template, any architecture). The model is loaded once, up
# front, and reused for every turn.
#
# Deliberately NOT carrying the KV-cache across turns — each turn's
# `generate`/`generate_kv` call re-prefills the WHOLE conversation-so-far
# from scratch (the same "correct first, optimize later" tradeoff already
# documented for generate() vs generate_kv() within a single turn). Reusing
# the cache across turns would need forward_step's single-token-append
# machinery generalized to append a whole new turn's worth of tokens against
# an already-nonempty cache — a real, valuable optimization, but a separate
# piece of work from just having multi-turn conversations at all.
def run_chat(GgufFile file, string system_msg, int max_new_tokens, bool kv_cache,
             bool quantized, SamplingParams params) throws:
    let tok = load_tokenizer(file)

    if params.temperature > 0.0 as float32:
        print "[diag] sampling: temperature={params.temperature} top_k={params.top_k} top_p={params.top_p} min_p={params.min_p} seed={params.seed} repeat_penalty={params.repeat_penalty} repeat_last_n={params.repeat_last_n}"
    else:
        print "[diag] sampling: greedy, repeat_penalty={params.repeat_penalty} repeat_last_n={params.repeat_last_n}"

    print ""
    print "[chat] interactive mode — type a message and press enter, empty line or Ctrl-D to quit."

    mut [string] user_msgs = []
    mut [string] assistant_msgs = []

    # Two near-identical branches (not one loop parameterized over "which
    # generate function to call") because QuantModel/Model are
    # different types — `m` below has to resolve to a concrete type for the
    # whole branch, same reason run_generate() above branches on `quantized`
    # around its own single generate call rather than trying to share one
    # model-typed local across both.
    if quantized:
        print "[diag] loading model weights (packed bytes, quantized tensor kernels)..."
        let m = load_model_quantized(file)
        print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer})"

        if kv_cache:
            # Reuses the KV-cache across turns instead of re-prefilling the
            # whole conversation every turn: the first turn calls
            # generate_kv_chat_first (full prefill from empty, same cost as
            # generate_kv), every later turn calls generate_kv_chat_continue
            # with only that turn's own new tokens — see model.br's own doc
            # comment on both for why this needed prefill_step_gpu_quantized
            # (append-to-existing-cache) and a causal_offset on
            # attention_gqa_gpu (math_gpu.br) that plain from-scratch
            # prefill never needed.
            #
            # "Only that turn's own new tokens" is computed generically as
            # full_ids[all_tokens.length..] — a fresh full render+encode of
            # the WHOLE conversation-so-far (any architecture's own chat
            # template, via render_chat_prompt), sliced at wherever the
            # existing KV-cache already leaves off — rather than trying to
            # derive a per-architecture "just this turn's own text" shape
            # (the old Qwen2.5-hardcoded encode_chat_turn did exactly that,
            # and only that). This slice is safe because every turn boundary
            # in a rendered chat template sits right after a special token
            # (`<|im_end|>`, `</s>`, ...), which encode_with_specials always
            # matches atomically — so a prior turn's own token ids can never
            # change just because more text was appended after it.
            print "> "
            var line = readLine()
            var bool first_turn = true
            var cache = empty_cache(m.config.n_layer)
            var [int] all_tokens = []
            while let line:
                if line == "":
                    break
                user_msgs.push(line)

                let full_ids = render_chat_prompt(file, tok, system_msg, user_msgs, assistant_msgs, true)
                let new_tokens = full_ids[all_tokens.length..]

                let (turn_tokens, next_cache) = if first_turn:
                    generate_kv_chat_first(m, full_ids, max_new_tokens, tok.eos_token_id, params)
                else:
                    generate_kv_chat_continue(m, cache, new_tokens, all_tokens, max_new_tokens, tok.eos_token_id, params)

                # `all_tokens` here is still last turn's value (reassigned
                # below) — exactly "history before this turn", so adding
                # this turn's own new prompt tokens gives the index where
                # the reply starts in `turn_tokens`.
                let reply_start = all_tokens.length + new_tokens.length
                all_tokens = turn_tokens
                cache = next_cache
                first_turn = false

                mut [int] reply_tokens = []
                var int i = reply_start
                while i < all_tokens.length:
                    if all_tokens[i] != tok.eos_token_id:
                        reply_tokens.push(all_tokens[i])
                    i += 1
                let reply = tok.decode(reply_tokens)
                assistant_msgs.push(reply)
                print ""
                print reply
                print ""

                print "> "
                line = readLine()
        else:
            print "> "
            var line = readLine()
            while let line:
                if line == "":
                    break
                user_msgs.push(line)
                let prompt_tokens = render_chat_prompt(file, tok, system_msg, user_msgs, assistant_msgs, true)
                let all_tokens = generate(m, prompt_tokens, max_new_tokens, tok.eos_token_id, params)

                mut [int] new_tokens = []
                var int i = prompt_tokens.length
                while i < all_tokens.length:
                    if all_tokens[i] != tok.eos_token_id:
                        new_tokens.push(all_tokens[i])
                    i += 1
                let reply = tok.decode(new_tokens)
                assistant_msgs.push(reply)
                print ""
                print reply
                print ""

                print "> "
                line = readLine()
    else:
        print "[diag] loading model weights (dequantizing every tensor to fp32 at load)..."
        let m = load_model(file)
        print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer})"

        print "> "
        var line = readLine()
        while let line:
            if line == "":
                break
            user_msgs.push(line)
            let prompt_tokens = render_chat_prompt(file, tok, system_msg, user_msgs, assistant_msgs, true)
            let all_tokens = generate_f32(m, prompt_tokens, max_new_tokens, tok.eos_token_id, params)

            mut [int] new_tokens = []
            var int i = prompt_tokens.length
            while i < all_tokens.length:
                if all_tokens[i] != tok.eos_token_id:
                    new_tokens.push(all_tokens[i])
                i += 1
            let reply = tok.decode(new_tokens)
            assistant_msgs.push(reply)
            print ""
            print reply
            print ""

            print "> "
            line = readLine()

# Debug aid for verifying chat-template rendering against an independent
# oracle (jinja2 + llama-cpp-python, see tools/): reads an OpenAI-style request
# body from `path`, renders it exactly the way server.br would, and prints the
# resulting prompt token ids on one line.
# What `--serve` loads: the model (weights end up resident on the GPU), the
# tokenizer and a GgufFile that holds the metadata (chat template, vocabulary)
# and the file's path — tensor data is read from disk tensor by tensor, so the
# file is never held in memory.
(GgufFile, QuantModel, Tokenizer) load_for_serving(string path, string chat_template_override) throws:
    print "[diag] parsing {path}..."
    var GgufFile file = parse_gguf_path(path)
    if chat_template_override != "":
        file.metadata["tokenizer.chat_template"] = GgufValue.Str(chat_template_override)
    print "[diag] parsed ({file.file_size} bytes, {file.tensors.length} tensors, {file.metadata.length} metadata keys)"
    print "[diag] loading model weights (packed bytes, quantized tensor kernels)..."
    let m = load_model_quantized(file)
    print "[diag] model loaded (vocab={m.config.vocab_size} d_model={m.config.d_model} n_layer={m.config.n_layer})"
    let tok = load_tokenizer(file)
    (file, m, tok)

def run_serve(string path, string model_name, [string] model_tags, string chat_template_override, int ctx_size, int max_tokens, int cache_slots, string prompt_cache_dir, string slot_save_dir, int prompt_cache_files, int prompt_cache_max_mb, string host, int port, [string] api_keys, string api_prefix, string cors_origins, string cors_methods, string cors_headers, bool cors_credentials, bool metrics_enabled, bool slots_enabled, bool cache_prompt_default, int sse_ping_interval_default, string reasoning_format_default, string reasoning_effort_default, JValue chat_template_kwargs_default, ServerSamplingDefaults extra_defaults, SamplingParams params) throws:
    guard host != "" else throw "--host must not be empty"
    guard port >= 1 and port <= 65535 else throw "--port must be between 1 and 65535"
    guard ctx_size >= 2 else throw "--ctx-size must be at least 2"
    guard max_tokens >= -1 else throw "--max-tokens must be -1 or greater"
    guard cache_slots >= 1 else throw "--cache-slots must be at least 1"
    guard prompt_cache_files >= 1 else throw "--prompt-cache-files must be at least 1"
    guard prompt_cache_max_mb >= 0 else throw "--prompt-cache-max-mb must not be negative"
    guard sse_ping_interval_default >= -1 else throw "--sse-ping-interval must be -1 or a non-negative integer"
    let prefix_error = api_prefix_validation_error(api_prefix)
    guard prefix_error == "" else throw prefix_error
    let (file, m, tok) = load_for_serving(path, chat_template_override)
    let fallback_name = gguf_get_string(file.metadata, "general.name") else "boring-llm"
    let aliases = model_alias_list(model_name, fallback_name)
    let name = aliases[0]
    var int fp = 0
    var int bpt = 0
    var [DiskSnap] disk = []
    let kv_dim = kv_dim_of(m)
    if prompt_cache_dir != "" or slot_save_dir != "":
        fp = model_fingerprint(file, m.config.n_layer, kv_dim)
        bpt = snapshot_bytes_per_token(m.config.n_layer, kv_dim)
    if prompt_cache_dir != "":
        ensure_dir(prompt_cache_dir)
        disk = scan_snapshots(prompt_cache_dir, fp, m.config.n_layer, kv_dim, prompt_cache_files)
        for d in disk:
            print "[serve] prompt cache: file {d.slot} holds {d.tokens.length} tokens"
        let cap = if prompt_cache_max_mb > 0: "{prompt_cache_max_mb} MB" else: "no size cap"
        print "[serve] prompt cache: {prompt_cache_dir} ({disk.length} snapshot(s), keeping up to {prompt_cache_files} files, {cap})"
    if slot_save_dir != "":
        ensure_dir(slot_save_dir)
        print "[serve] named slot snapshots: {slot_save_dir}"
    let ctx = ServerCtx(file, tok, m, path, name, aliases, model_tags, ctx_size, max_tokens, cache_slots, params, extra_defaults, prompt_cache_dir, fp, prompt_cache_files, prompt_cache_max_mb * 1048576, bpt, metrics_enabled, slot_save_dir, api_keys, api_prefix, slots_enabled, cache_prompt_default, sse_ping_interval_default, reasoning_format_default, reasoning_effort_default, chat_template_kwargs_default, cors_origins, cors_methods, cors_headers, cors_credentials)
    serve(ctx, host, port, disk)

def run_render_request(GgufFile file, string path) throws:
    let tok = load_tokenizer(file)
    let body = json_parse(bytes_to_str(fs.readBytes(path)))
    let messages = normalize_messages(json_get_list(body, "messages"))
    let ids = render_chat_prompt_messages_kw(file, tok, messages, json_get_list(body, "tools"), true, json_get(body, "chat_template_kwargs"))
    var string line = ""
    var int i = 0
    while i < ids.length:
        line = if i == 0: "{ids[i]}" else: "{line},{ids[i]}"
        i += 1
    print "ids: {line}"

# Debug aid: `path` holds a JSON array of strings; prints one `ids: ...` line
# per string — the plain-text tokenization (special-token strings recognized
# atomically), diffed against llama.cpp by tools/oracle_encode.py.
def run_encode_file(GgufFile file, string path) throws:
    let tok = load_tokenizer(file)
    let doc = json_parse(bytes_to_str(fs.readBytes(path)))
    match doc:
        JList(items):
            for it in items:
                match it:
                    JStr(text):
                        let ids = tok.encode_with_specials(text)
                        var string line = ""
                        var int i = 0
                        while i < ids.length:
                            line = if i == 0: "{ids[i]}" else: "{line},{ids[i]}"
                            i += 1
                        print "ids: {line}"
                    _:
                        throw "--encode-file: every array element must be a string"
        _:
            throw "--encode-file: expected a JSON array of strings"

string usage_text():
    "boring-llm — local GGUF inference and OpenAI-compatible server\n\nUsage:\n  main -m MODEL [options]\n\nModel:\n  -m, --model, --gguf PATH        GGUF model file (required)\n  -a, --alias, --model-name NAME  model id reported by the API\n  --tags TAGS                     informational comma-separated model tags\n  -c, --ctx-size N                context size (default: 4096)\n\nServer:\n  --serve                         run the HTTP server\n  --host HOST                     listening host (default: 127.0.0.1)\n  --port N                        listening port (default: 8080)\n  --api-prefix PATH               serve every route below a path prefix\n  --api-key KEY                   require a Bearer key; comma separates keys\n  --api-key-file FILE             read one Bearer key per line\n  --cache-slots N                 in-memory prompt-cache slots (default: 4)\n  --cache-prompt, --no-cache-prompt  default prompt-prefix reuse policy\n  --slots, --no-slots             enable or disable the /slots endpoint\n  --prompt-cache DIR              persistent prompt-cache directory\n  --metrics                       enable GET /metrics\n  --sse-ping-interval N           SSE keep-alive seconds; -1 disables\n  --reasoning-format FORMAT       default reasoning extraction mode\n  -rea, --reasoning [MODE]        thinking default: on, off, or auto\n  --reasoning-preserve, --no-reasoning-preserve\n                                  preserve earlier assistant reasoning\n  --reasoning-effort LEVEL        default effort passed to chat templates\n  --chat-template-kwargs JSON     default chat-template variables\n  --chat-template TEMPLATE       override the embedded Jinja template\n  --chat-template-file FILE      read the Jinja template from a file\n\nGeneration:\n  --prompt TEXT                   generate one chat reply\n  --chat                          interactive terminal chat\n  -n, --predict, --n-predict N    reply-token limit (default: 40)\n  --max-tokens N                  same reply-token limit\n  --temp, --temperature T --top-k K --top-p P --min-p P\n  --typical-p P --top-n-sigma N --dynatemp-range N\n  --dynatemp-exp N --xtc-probability P --xtc-threshold P\n  --min-keep N\n  -s, --seed S --repeat-penalty R --repeat-last-n N\n\nDiagnostics:\n  --dump-metadata                 print GGUF metadata\n  --tokens IDS                    print logits for comma-separated token ids\n  --generate-tokens IDS           generate from comma-separated token ids\n  -h, --help, --usage             print this help and exit\n  --version                       print build identity and exit"

string full_usage_text():
    let cors = usage_text().replace("  --api-key KEY", "  --cors-origins ORIGINS          allowed browser origins (default: *)\n  --cors-methods METHODS          allowed CORS methods\n  --cors-headers HEADERS          allowed CORS headers\n  --cors-credentials, --no-cors-credentials\n                                  allow or deny browser credentials\n  --api-key KEY")
    let parallel = cors.replace("  --cache-prompt, --no-cache-prompt", "  -np, --parallel N               concurrent request slots (only 1 supported)\n  --threads-http N                HTTP worker count (only 1 supported)\n  --jinja                         Jinja chat templates (always enabled)\n  --no-warmup                    skip startup warmup (current behavior)\n  -nocb, --no-cont-batching      serialized serving (current behavior)\n  --no-context-shift             stop when the context is full\n  --no-webui, --no-ui            API-only server (current behavior)\n  --no-mmproj                    text-only mode (current behavior)\n  --cache-prompt, --no-cache-prompt")
    parallel.replace("  -s, --seed S", "  --dry-multiplier N --dry-base N --dry-allowed-length N\n  --dry-penalty-last-n N\n  --presence-penalty N --frequency-penalty N\n  --mirostat N --mirostat-ent N --mirostat-lr N (server)\n  --adaptive-target N --adaptive-decay N (server)\n  --samplers LIST --sampler-seq SEQUENCE\n  --ignore-eos                    suppress the EOS token (server)\n  -s, --seed S")

def main() throws:
    let [string] argv = args()

    var string gguf_path = environment_default(argv, ["--gguf", "--model", "-m"], "LLAMA_ARG_MODEL", "")
    var bool dump_metadata = false
    var string tokens_csv = ""
    var string generate_tokens_csv = ""
    var bool use_gpu = false
    var bool quantized = false
    var string prompt = ""
    var string system_msg = "You are a helpful assistant."
    let max_tokens_env = environment_default(argv, ["--max-tokens", "--predict", "--n-predict", "-n"], "LLAMA_ARG_N_PREDICT", "40")
    var int max_tokens = parse_max_tokens(max_tokens_env)
    var bool kv_cache = false
    var bool chat_mode = false
    let temperature_env = environment_default(argv, ["--temperature", "--temp"], "LLAMA_ARG_TEMPERATURE", "0.0")
    var float32 temperature = parse_float_arg("LLAMA_ARG_TEMPERATURE", temperature_env)
    var float32 dynatemp_range = 0.0 as float32
    var float32 dynatemp_exponent = 1.0 as float32
    var float32 top_n_sigma = -1.0 as float32
    let top_k_env = environment_default(argv, ["--top-k"], "LLAMA_ARG_TOP_K", "0")
    var int top_k = parse_int_arg("LLAMA_ARG_TOP_K", top_k_env)
    var float32 typical_p = 1.0 as float32
    let top_p_env = environment_default(argv, ["--top-p"], "LLAMA_ARG_TOP_P", "1.0")
    var float32 top_p = parse_float_arg("LLAMA_ARG_TOP_P", top_p_env)
    let min_p_env = environment_default(argv, ["--min-p"], "LLAMA_ARG_MIN_P", "0.0")
    var float32 min_p = parse_float_arg("LLAMA_ARG_MIN_P", min_p_env)
    var float32 xtc_probability = 0.0 as float32
    var float32 xtc_threshold = 0.1 as float32
    var int min_keep = 0
    var int seed = 0
    let repeat_penalty_env = environment_default(argv, ["--repeat-penalty"], "LLAMA_ARG_REPEAT_PENALTY", "1.0")
    var float32 repeat_penalty = parse_float_arg("LLAMA_ARG_REPEAT_PENALTY", repeat_penalty_env)
    var int repeat_last_n = 64
    var float32 dry_multiplier = 0.0 as float32
    var float32 dry_base = 1.75 as float32
    var int dry_allowed_length = 2
    var int dry_penalty_last_n = 64
    let presence_penalty_env = environment_default(argv, ["--presence-penalty"], "LLAMA_ARG_PRESENCE_PENALTY", "0.0")
    var float32 presence_penalty = parse_float_arg("LLAMA_ARG_PRESENCE_PENALTY", presence_penalty_env)
    guard presence_penalty >= -2.0 as float32 and presence_penalty <= 2.0 as float32 else throw "LLAMA_ARG_PRESENCE_PENALTY must be between -2 and 2"
    let frequency_penalty_env = environment_default(argv, ["--frequency-penalty"], "LLAMA_ARG_FREQUENCY_PENALTY", "0.0")
    var float32 frequency_penalty = parse_float_arg("LLAMA_ARG_FREQUENCY_PENALTY", frequency_penalty_env)
    guard frequency_penalty >= -2.0 as float32 and frequency_penalty <= 2.0 as float32 else throw "LLAMA_ARG_FREQUENCY_PENALTY must be between -2 and 2"
    var int mirostat = 0
    var float32 mirostat_tau = 5.0 as float32
    var float32 mirostat_eta = 0.1 as float32
    var float32 adaptive_target = -1.0 as float32
    var float32 adaptive_decay = 0.9 as float32
    var [string] samplers = ["penalties", "dry", "top_n_sigma", "top_k", "typ_p", "top_p", "min_p", "xtc", "temperature"]
    var bool ignore_eos = false
    var bool serve_mode = false
    var string render_request_path = ""
    var string encode_file_path = ""
    var string host = environment_default(argv, ["--host"], "LLAMA_ARG_HOST", "127.0.0.1")
    let port_env = environment_default(argv, ["--port"], "LLAMA_ARG_PORT", "8080")
    var int port = parse_int_arg("LLAMA_ARG_PORT", port_env)
    var mut [string] api_keys = []
    let api_key_env = environment_default(argv, ["--api-key", "--api-key-file"], "LLAMA_API_KEY", "")
    if api_key_env != "":
        for key in api_key_env.split(","):
            guard key.trim() != "" else throw "LLAMA_API_KEY must not contain an empty comma-separated key"
            api_keys.push(key.trim())
    let api_key_file_env = environment_default(argv, ["--api-key", "--api-key-file"], "LLAMA_ARG_API_KEY_FILE", "")
    if api_key_file_env != "":
        let key_bytes = fs.readBytes(api_key_file_env)
        guard is_valid_utf8(key_bytes) else throw "LLAMA_ARG_API_KEY_FILE must name a UTF-8 file"
        let file_keys = api_keys_from_file_text(bytes_to_str(key_bytes))
        guard file_keys.length > 0 else throw "LLAMA_ARG_API_KEY_FILE contains no keys"
        for key in file_keys: api_keys.push(key)
    var bool api_keys_from_cli = false
    var string api_prefix = ""
    var string cors_origins = environment_default(argv, ["--cors-origins"], "LLAMA_ARG_CORS_ORIGINS", "*")
    var string cors_methods = environment_default(argv, ["--cors-methods"], "LLAMA_ARG_CORS_METHODS", "GET, POST, DELETE, OPTIONS")
    var string cors_headers = environment_default(argv, ["--cors-headers"], "LLAMA_ARG_CORS_HEADERS", "*")
    var bool cors_credentials = true
    var string model_name = environment_default(argv, ["--model-name", "--alias", "-a"], "LLAMA_ARG_ALIAS", "")
    var mut [string] model_tags = []
    let tags_env = environment_default(argv, ["--tags"], "LLAMA_ARG_TAGS", "")
    if tags_env != "":
        for tag in tags_env.split(","):
            guard tag.trim() != "" else throw "LLAMA_ARG_TAGS must not contain an empty comma-separated tag"
            model_tags.push(tag.trim())
    var bool tags_from_cli = false
    var string chat_template_override = ""
    let ctx_size_env = environment_default(argv, ["--ctx-size", "-c"], "LLAMA_ARG_CTX_SIZE", "4096")
    var int ctx_size = parse_int_arg("LLAMA_ARG_CTX_SIZE", ctx_size_env)
    var int cache_slots = 4
    var string prompt_cache_dir = ""
    var string slot_save_dir = environment_default(argv, ["--slot-save-path"], "LLAMA_ARG_SLOT_SAVE_PATH", "")
    var int prompt_cache_files = 2
    var int prompt_cache_max_mb = 4096
    var int requested_profile_stage = 0
    let metrics_env = environment_default(argv, ["--metrics"], "LLAMA_ARG_ENDPOINT_METRICS", "false")
    var bool metrics_enabled = parse_bool_arg("LLAMA_ARG_ENDPOINT_METRICS", metrics_env)
    let slots_env = environment_default(argv, ["--slots", "--no-slots"], "LLAMA_ARG_ENDPOINT_SLOTS", "true")
    var bool slots_enabled = parse_bool_arg("LLAMA_ARG_ENDPOINT_SLOTS", slots_env)
    let cache_prompt_env = environment_default(argv, ["--cache-prompt", "--no-cache-prompt"], "LLAMA_ARG_CACHE_PROMPT", "true")
    var bool cache_prompt_default = parse_bool_arg("LLAMA_ARG_CACHE_PROMPT", cache_prompt_env)
    let sse_ping_env = environment_default(argv, ["--sse-ping-interval"], "LLAMA_ARG_SSE_PING_INTERVAL", "30")
    var int sse_ping_interval_default = parse_int_arg("LLAMA_ARG_SSE_PING_INTERVAL", sse_ping_env)
    let parallel_env = environment_default(argv, ["--parallel", "-np"], "LLAMA_ARG_N_PARALLEL", "1")
    let parallel_default = parse_int_arg("LLAMA_ARG_N_PARALLEL", parallel_env)
    guard parallel_default == 1 else throw "LLAMA_ARG_N_PARALLEL currently supports only 1 because requests are serialized"
    let threads_http_env = environment_default(argv, ["--threads-http"], "LLAMA_ARG_THREADS_HTTP", "1")
    let threads_http_default = parse_int_arg("LLAMA_ARG_THREADS_HTTP", threads_http_env)
    guard threads_http_default == 1 else throw "LLAMA_ARG_THREADS_HTTP currently supports only 1 because requests are serialized"
    let ui_env = environment_default(argv, ["--ui", "--webui", "--no-ui", "--no-webui"], "LLAMA_ARG_UI", "false")
    guard !parse_bool_arg("LLAMA_ARG_UI", ui_env) else throw "LLAMA_ARG_UI cannot enable the unsupported Web UI"
    let jinja_env = environment_default(argv, ["--jinja", "--no-jinja"], "LLAMA_ARG_JINJA", "true")
    guard parse_bool_arg("LLAMA_ARG_JINJA", jinja_env) else throw "LLAMA_ARG_JINJA cannot disable the chat-template engine"
    let embeddings_env = environment_default(argv, ["--embedding", "--embeddings"], "LLAMA_ARG_EMBEDDINGS", "false")
    guard !parse_bool_arg("LLAMA_ARG_EMBEDDINGS", embeddings_env) else throw "LLAMA_ARG_EMBEDDINGS is not supported; boring-llm serves causal text generation only"
    let reranking_env = environment_default(argv, ["--rerank", "--reranking"], "LLAMA_ARG_RERANKING", "false")
    guard !parse_bool_arg("LLAMA_ARG_RERANKING", reranking_env) else throw "LLAMA_ARG_RERANKING is not supported; boring-llm does not load ranking models"
    let cont_batching_env = environment_default(argv, ["--cont-batching", "-cb", "--no-cont-batching", "-nocb"], "LLAMA_ARG_CONT_BATCHING", "false")
    guard !parse_bool_arg("LLAMA_ARG_CONT_BATCHING", cont_batching_env) else throw "LLAMA_ARG_CONT_BATCHING is not supported because requests are serialized"
    let context_shift_env = environment_default(argv, ["--context-shift", "--no-context-shift"], "LLAMA_ARG_CONTEXT_SHIFT", "false")
    guard !parse_bool_arg("LLAMA_ARG_CONTEXT_SHIFT", context_shift_env) else throw "LLAMA_ARG_CONTEXT_SHIFT is not supported; generation stops at the context limit"
    let mmproj_env = environment_default(argv, ["--mmproj", "-mm", "--mmproj-url", "-mmu", "--mmproj-auto", "--no-mmproj", "--no-mmproj-auto"], "LLAMA_ARG_MMPROJ", "")
    guard mmproj_env == "" else throw "LLAMA_ARG_MMPROJ is not supported because boring-llm is text-only"
    let mmproj_url_env = environment_default(argv, ["--mmproj", "-mm", "--mmproj-url", "-mmu", "--mmproj-auto", "--no-mmproj", "--no-mmproj-auto"], "LLAMA_ARG_MMPROJ_URL", "")
    guard mmproj_url_env == "" else throw "LLAMA_ARG_MMPROJ_URL is not supported because boring-llm is text-only"
    let mmproj_auto_env = environment_default(argv, ["--mmproj", "-mm", "--mmproj-url", "-mmu", "--mmproj-auto", "--no-mmproj", "--no-mmproj-auto"], "LLAMA_ARG_MMPROJ_AUTO", "false")
    guard !parse_bool_arg("LLAMA_ARG_MMPROJ_AUTO", mmproj_auto_env) else throw "LLAMA_ARG_MMPROJ_AUTO cannot enable multimodal projector discovery in text-only mode"
    var string reasoning_format_default = environment_default(argv, ["--reasoning-format"], "LLAMA_ARG_REASONING_FORMAT", "auto")
    guard reasoning_format_default == "auto" or reasoning_format_default == "none" or reasoning_format_default == "deepseek" or reasoning_format_default == "deepseek-legacy" else throw "LLAMA_ARG_REASONING_FORMAT expects auto, none, deepseek, or deepseek-legacy"
    var string reasoning_effort_default = ""
    var string reasoning_default = "auto"
    var string reasoning_preserve_default = "default"
    var JValue chat_template_kwargs_default = JValue.JDict({=}, [])
    let template_kwargs_env = environment_default(argv, ["--chat-template-kwargs"], "LLAMA_ARG_CHAT_TEMPLATE_KWARGS", "")
    if template_kwargs_env != "":
        let parsed_kwargs = json_parse(template_kwargs_env)
        match parsed_kwargs:
            JDict(fields, keys): chat_template_kwargs_default = parsed_kwargs
            _: throw "LLAMA_ARG_CHAT_TEMPLATE_KWARGS expects a JSON object"

    var int i = 1
    while i < argv.length:
        let a = argv[i]
        if a == "-h" or a == "--help" or a == "--usage":
            print full_usage_text()
            return
        elif a == "--version":
            print "boring-llm"
            return
        elif (a == "--gguf" or a == "--model" or a == "-m") and i + 1 < argv.length:
            gguf_path = argv[i + 1]
            i += 2
        elif a == "--dump-metadata":
            dump_metadata = true
            i += 1
        elif a == "--tokens" and i + 1 < argv.length:
            tokens_csv = argv[i + 1]
            i += 2
        elif a == "--generate-tokens" and i + 1 < argv.length:
            generate_tokens_csv = argv[i + 1]
            i += 2
        elif a == "--gpu":
            use_gpu = true
            i += 1
        elif a == "--quantized":
            quantized = true
            i += 1
        elif a == "--prompt" and i + 1 < argv.length:
            prompt = argv[i + 1]
            i += 2
        elif a == "--system" and i + 1 < argv.length:
            system_msg = argv[i + 1]
            i += 2
        elif (a == "--max-tokens" or a == "--predict" or a == "--n-predict" or a == "-n") and i + 1 < argv.length:
            max_tokens = parse_max_tokens(argv[i + 1])
            i += 2
        elif a == "--kv-cache":
            kv_cache = true
            i += 1
        elif a == "--chat":
            chat_mode = true
            i += 1
        elif (a == "--temperature" or a == "--temp") and i + 1 < argv.length:
            temperature = parse_float_arg("--temperature", argv[i + 1])
            i += 2
        elif a == "--dynatemp-range" and i + 1 < argv.length:
            dynatemp_range = parse_float_arg("--dynatemp-range", argv[i + 1])
            guard dynatemp_range >= 0.0 as float32 else throw "--dynatemp-range must be non-negative"
            i += 2
        elif (a == "--dynatemp-exp" or a == "--dynatemp-exponent") and i + 1 < argv.length:
            dynatemp_exponent = parse_float_arg("--dynatemp-exp", argv[i + 1])
            guard dynatemp_exponent > 0.0 as float32 else throw "--dynatemp-exp must be positive"
            i += 2
        elif (a == "--top-nsigma" or a == "--top-n-sigma") and i + 1 < argv.length:
            top_n_sigma = parse_float_arg("--top-n-sigma", argv[i + 1])
            i += 2
        elif a == "--top-k" and i + 1 < argv.length:
            top_k = parse_int_arg("--top-k", argv[i + 1])
            i += 2
        elif (a == "--typical" or a == "--typical-p") and i + 1 < argv.length:
            typical_p = parse_float_arg("--typical-p", argv[i + 1])
            guard typical_p > 0.0 as float32 and typical_p <= 1.0 as float32 else throw "--typical-p must be greater than 0 and at most 1"
            i += 2
        elif a == "--top-p" and i + 1 < argv.length:
            top_p = parse_float_arg("--top-p", argv[i + 1])
            i += 2
        elif a == "--min-p" and i + 1 < argv.length:
            min_p = parse_float_arg("--min-p", argv[i + 1])
            i += 2
        elif a == "--xtc-probability" and i + 1 < argv.length:
            xtc_probability = parse_float_arg("--xtc-probability", argv[i + 1])
            guard xtc_probability >= 0.0 as float32 and xtc_probability <= 1.0 as float32 else throw "--xtc-probability must be between 0 and 1"
            i += 2
        elif a == "--xtc-threshold" and i + 1 < argv.length:
            xtc_threshold = parse_float_arg("--xtc-threshold", argv[i + 1])
            guard xtc_threshold >= 0.0 as float32 and xtc_threshold <= 1.0 as float32 else throw "--xtc-threshold must be between 0 and 1"
            i += 2
        elif a == "--min-keep" and i + 1 < argv.length:
            min_keep = parse_int_arg("--min-keep", argv[i + 1])
            guard min_keep >= 0 else throw "--min-keep must be non-negative"
            i += 2
        elif (a == "--seed" or a == "-s") and i + 1 < argv.length:
            seed = parse_int_arg("--seed", argv[i + 1])
            i += 2
        elif a == "--repeat-penalty" and i + 1 < argv.length:
            repeat_penalty = parse_float_arg("--repeat-penalty", argv[i + 1])
            i += 2
        elif a == "--repeat-last-n" and i + 1 < argv.length:
            repeat_last_n = parse_int_arg("--repeat-last-n", argv[i + 1])
            i += 2
        elif a == "--dry-multiplier" and i + 1 < argv.length:
            dry_multiplier = parse_float_arg("--dry-multiplier", argv[i + 1])
            guard dry_multiplier >= 0.0 as float32 else throw "--dry-multiplier must be non-negative"
            i += 2
        elif a == "--dry-base" and i + 1 < argv.length:
            dry_base = parse_float_arg("--dry-base", argv[i + 1])
            guard dry_base >= 1.0 as float32 else throw "--dry-base must be at least 1"
            i += 2
        elif a == "--dry-allowed-length" and i + 1 < argv.length:
            dry_allowed_length = parse_int_arg("--dry-allowed-length", argv[i + 1])
            guard dry_allowed_length >= 0 else throw "--dry-allowed-length must be non-negative"
            i += 2
        elif a == "--dry-penalty-last-n" and i + 1 < argv.length:
            dry_penalty_last_n = parse_int_arg("--dry-penalty-last-n", argv[i + 1])
            guard dry_penalty_last_n >= 0 else throw "--dry-penalty-last-n must be non-negative"
            i += 2
        elif a == "--presence-penalty" and i + 1 < argv.length:
            presence_penalty = parse_float_arg("--presence-penalty", argv[i + 1])
            guard presence_penalty >= -2.0 as float32 and presence_penalty <= 2.0 as float32 else throw "--presence-penalty must be between -2 and 2"
            i += 2
        elif a == "--frequency-penalty" and i + 1 < argv.length:
            frequency_penalty = parse_float_arg("--frequency-penalty", argv[i + 1])
            guard frequency_penalty >= -2.0 as float32 and frequency_penalty <= 2.0 as float32 else throw "--frequency-penalty must be between -2 and 2"
            i += 2
        elif a == "--mirostat" and i + 1 < argv.length:
            mirostat = parse_int_arg("--mirostat", argv[i + 1])
            guard mirostat >= 0 and mirostat <= 2 else throw "--mirostat must be 0, 1, or 2"
            i += 2
        elif (a == "--mirostat-ent" or a == "--mirostat-tau") and i + 1 < argv.length:
            mirostat_tau = parse_float_arg("--mirostat-ent", argv[i + 1])
            guard mirostat_tau > 0.0 as float32 else throw "--mirostat-ent must be positive"
            i += 2
        elif (a == "--mirostat-lr" or a == "--mirostat-eta") and i + 1 < argv.length:
            mirostat_eta = parse_float_arg("--mirostat-lr", argv[i + 1])
            guard mirostat_eta > 0.0 as float32 else throw "--mirostat-lr must be positive"
            i += 2
        elif a == "--adaptive-target" and i + 1 < argv.length:
            adaptive_target = parse_float_arg("--adaptive-target", argv[i + 1])
            guard adaptive_target <= 1.0 as float32 else throw "--adaptive-target must be at most 1"
            i += 2
        elif a == "--adaptive-decay" and i + 1 < argv.length:
            adaptive_decay = parse_float_arg("--adaptive-decay", argv[i + 1])
            guard adaptive_decay >= 0.0 as float32 and adaptive_decay <= 0.99 as float32 else throw "--adaptive-decay must be between 0 and 0.99"
            i += 2
        elif a == "--samplers" and i + 1 < argv.length:
            samplers = parse_sampler_names(argv[i + 1])
            i += 2
        elif (a == "--sampler-seq" or a == "--sampling-seq") and i + 1 < argv.length:
            samplers = parse_sampler_sequence(argv[i + 1])
            i += 2
        elif a == "--ignore-eos":
            ignore_eos = true
            i += 1
        elif a == "--jinja":
            # Chat templates always use boring-llm's Jinja interpreter.
            i += 1
        elif a == "--no-jinja":
            throw "--no-jinja is not supported because chat templates require Jinja evaluation"
        elif a == "--no-warmup":
            # boring-llm does not run a startup inference warmup.
            i += 1
        elif a == "--warmup":
            throw "--warmup is not supported; boring-llm starts without an inference warmup"
        elif a == "--no-cont-batching" or a == "-nocb":
            # Requests are serialized, so continuous batching is already off.
            i += 1
        elif a == "--cont-batching" or a == "-cb":
            throw "--cont-batching is not supported because requests are serialized"
        elif a == "--no-context-shift":
            # Generation already stops when the configured context is full.
            i += 1
        elif a == "--context-shift":
            throw "--context-shift is not supported; generation stops at the context limit"
        elif a == "--threads-http" and i + 1 < argv.length:
            let threads_http = parse_int_arg("--threads-http", argv[i + 1])
            guard threads_http == 1 else throw "--threads-http currently supports only 1 because requests are serialized"
            i += 2
        elif a == "--no-webui" or a == "--no-ui":
            # boring-llm exposes API routes only and has no embedded Web UI.
            i += 1
        elif a == "--webui" or a == "--ui":
            throw "--webui is not supported; boring-llm serves API routes only"
        elif a == "--no-mmproj" or a == "--no-mmproj-auto":
            # No multimodal projector is loaded by boring-llm.
            i += 1
        elif a == "--mmproj-auto":
            throw "--mmproj-auto is not supported because boring-llm is text-only"
        elif (a == "--mmproj" or a == "-mm" or a == "--mmproj-url" or a == "-mmu") and i + 1 < argv.length:
            throw "{a} is not supported because boring-llm is text-only"
        elif a == "--embedding" or a == "--embeddings":
            throw "{a} is not supported; boring-llm currently serves causal text generation only"
        elif a == "--rerank" or a == "--reranking":
            throw "{a} is not supported; boring-llm does not load ranking models"
        elif a == "--serve":
            serve_mode = true
            i += 1
        elif a == "--encode-file" and i + 1 < argv.length:
            encode_file_path = argv[i + 1]
            i += 2
        elif a == "--render-request" and i + 1 < argv.length:
            render_request_path = argv[i + 1]
            i += 2
        elif a == "--port" and i + 1 < argv.length:
            port = parse_int_arg("--port", argv[i + 1])
            i += 2
        elif a == "--host" and i + 1 < argv.length:
            host = argv[i + 1]
            i += 2
        elif a == "--api-key" and i + 1 < argv.length:
            if !api_keys_from_cli:
                api_keys = []
                api_keys_from_cli = true
            let supplied_keys = argv[i + 1]
            guard supplied_keys.trim() != "" else throw "--api-key expects a non-empty key"
            for key in supplied_keys.split(","):
                guard key.trim() != "" else throw "--api-key must not contain an empty comma-separated key"
                api_keys.push(key.trim())
            i += 2
        elif a == "--api-key-file" and i + 1 < argv.length:
            if !api_keys_from_cli:
                api_keys = []
                api_keys_from_cli = true
            let key_bytes = fs.readBytes(argv[i + 1])
            guard is_valid_utf8(key_bytes) else throw "--api-key-file must be UTF-8"
            let file_keys = api_keys_from_file_text(bytes_to_str(key_bytes))
            guard file_keys.length > 0 else throw "--api-key-file contains no keys"
            for key in file_keys:
                api_keys.push(key)
            i += 2
        elif a == "--api-prefix" and i + 1 < argv.length:
            api_prefix = argv[i + 1]
            i += 2
        elif a == "--cors-origins" and i + 1 < argv.length:
            cors_origins = argv[i + 1]
            guard cors_origins.trim() != "" else throw "--cors-origins expects a non-empty value"
            i += 2
        elif a == "--cors-methods" and i + 1 < argv.length:
            cors_methods = argv[i + 1]
            guard cors_methods.trim() != "" else throw "--cors-methods expects a non-empty value"
            i += 2
        elif a == "--cors-headers" and i + 1 < argv.length:
            cors_headers = argv[i + 1]
            guard cors_headers.trim() != "" else throw "--cors-headers expects a non-empty value"
            i += 2
        elif a == "--cors-credentials":
            cors_credentials = true
            i += 1
        elif a == "--no-cors-credentials":
            cors_credentials = false
            i += 1
        elif (a == "--model-name" or a == "--alias" or a == "-a") and i + 1 < argv.length:
            let supplied_aliases = argv[i + 1]
            guard supplied_aliases.trim() != "" else throw "--alias expects a non-empty name"
            for alias in supplied_aliases.split(","):
                guard alias.trim() != "" else throw "--alias must not contain an empty comma-separated name"
            model_name = supplied_aliases
            i += 2
        elif a == "--tags" and i + 1 < argv.length:
            if !tags_from_cli:
                model_tags = []
                tags_from_cli = true
            for tag in argv[i + 1].split(","):
                guard tag.trim() != "" else throw "--tags must not contain an empty comma-separated tag"
                model_tags.push(tag.trim())
            i += 2
        elif a == "--chat-template" and i + 1 < argv.length:
            chat_template_override = argv[i + 1]
            guard chat_template_override != "" else throw "--chat-template expects a non-empty template"
            i += 2
        elif a == "--chat-template-file" and i + 1 < argv.length:
            let template_bytes = fs.readBytes(argv[i + 1])
            guard is_valid_utf8(template_bytes) else throw "--chat-template-file must be UTF-8"
            chat_template_override = bytes_to_str(template_bytes)
            guard chat_template_override != "" else throw "--chat-template-file must not be empty"
            i += 2
        elif (a == "--ctx-size" or a == "-c") and i + 1 < argv.length:
            ctx_size = parse_int_arg("--ctx-size", argv[i + 1])
            i += 2
        elif a == "--kquant-prefill" and i + 1 < argv.length:
            guard argv[i + 1] == "tensor" or argv[i + 1] == "handwritten" else throw "--kquant-prefill expects `tensor` or `handwritten`"
            set_kquant_prefill_handwritten(argv[i + 1] == "handwritten")
            i += 2
        elif a == "--prompt-cache" and i + 1 < argv.length:
            prompt_cache_dir = argv[i + 1]
            i += 2
        elif a == "--prompt-cache-files" and i + 1 < argv.length:
            prompt_cache_files = parse_int_arg("--prompt-cache-files", argv[i + 1])
            i += 2
        elif a == "--slot-save-path" and i + 1 < argv.length:
            slot_save_dir = argv[i + 1]
            i += 2
        elif a == "--prompt-cache-max-mb" and i + 1 < argv.length:
            prompt_cache_max_mb = parse_int_arg("--prompt-cache-max-mb", argv[i + 1])
            i += 2
        elif a == "--cache-slots" and i + 1 < argv.length:
            cache_slots = parse_int_arg("--cache-slots", argv[i + 1])
            i += 2
        elif (a == "--parallel" or a == "-np") and i + 1 < argv.length:
            let parallel = parse_int_arg("--parallel", argv[i + 1])
            guard parallel == 1 else throw "--parallel currently supports only 1 because requests are serialized"
            i += 2
        elif a == "--metrics":
            metrics_enabled = true
            i += 1
        elif a == "--slots":
            slots_enabled = true
            i += 1
        elif a == "--no-slots":
            slots_enabled = false
            i += 1
        elif a == "--cache-prompt":
            cache_prompt_default = true
            i += 1
        elif a == "--no-cache-prompt":
            cache_prompt_default = false
            i += 1
        elif a == "--sse-ping-interval" and i + 1 < argv.length:
            sse_ping_interval_default = parse_int_arg("--sse-ping-interval", argv[i + 1])
            guard sse_ping_interval_default >= -1 else throw "--sse-ping-interval must be -1 or a non-negative integer"
            i += 2
        elif a == "--reasoning-format" and i + 1 < argv.length:
            reasoning_format_default = argv[i + 1]
            guard reasoning_format_default == "auto" or reasoning_format_default == "none" or reasoning_format_default == "deepseek" or reasoning_format_default == "deepseek-legacy" else throw "--reasoning-format expects auto, none, deepseek, or deepseek-legacy"
            i += 2
        elif a == "--reasoning-effort" and i + 1 < argv.length:
            reasoning_effort_default = argv[i + 1]
            guard reasoning_effort_default == "default" or reasoning_effort_default == "none" or reasoning_effort_default == "minimal" or reasoning_effort_default == "low" or reasoning_effort_default == "medium" or reasoning_effort_default == "high" or reasoning_effort_default == "xhigh" or reasoning_effort_default == "max" else throw "--reasoning-effort expects default, none, minimal, low, medium, high, xhigh, or max"
            i += 2
        elif a == "--reasoning" or a == "-rea":
            if i + 1 < argv.length and (argv[i + 1] == "on" or argv[i + 1] == "off" or argv[i + 1] == "auto"):
                reasoning_default = argv[i + 1]
                i += 2
            elif i + 1 < argv.length and not argv[i + 1].startsWith("-"):
                throw "--reasoning expects on, off, or auto"
            else:
                reasoning_default = "on"
                i += 1
        elif a == "--reasoning-preserve":
            reasoning_preserve_default = "on"
            i += 1
        elif a == "--no-reasoning-preserve":
            reasoning_preserve_default = "off"
            i += 1
        elif a == "--chat-template-kwargs" and i + 1 < argv.length:
            let parsed_kwargs = json_parse(argv[i + 1])
            match parsed_kwargs:
                JDict(fields, keys): chat_template_kwargs_default = parsed_kwargs
                _: throw "--chat-template-kwargs expects a JSON object"
            i += 2
        elif a == "--decode-profile-stage" and i + 1 < argv.length:
            let stage = argv[i + 1]
            if stage == "qkv": requested_profile_stage = 1
            elif stage == "attention": requested_profile_stage = 2
            elif stage == "attn-proj": requested_profile_stage = 3
            elif stage == "residual-norm": requested_profile_stage = 4
            elif stage == "ffn": requested_profile_stage = 5
            elif stage == "output-head": requested_profile_stage = 6
            elif stage == "ffn-gate": requested_profile_stage = 7
            elif stage == "ffn-up": requested_profile_stage = 8
            elif stage == "swiglu": requested_profile_stage = 9
            elif stage == "ffn-down": requested_profile_stage = 10
            else: throw "--decode-profile-stage expects qkv, attention, attn-proj, residual-norm, ffn, output-head, ffn-gate, ffn-up, swiglu, or ffn-down"
            i += 2
        else:
            throw "unknown or incomplete argument `{a}`"

    guard gguf_path != "" else throw full_usage_text()
    guard repeat_last_n >= -1 else throw "--repeat-last-n must be -1 or greater"
    guard mirostat == 0 or adaptive_target < 0.0 as float32 else throw "--mirostat and --adaptive-target cannot be enabled together"
    guard serve_mode or (presence_penalty == 0.0 as float32 and frequency_penalty == 0.0 as float32 and mirostat == 0 and adaptive_target < 0.0 as float32 and not ignore_eos) else throw "presence/frequency penalties, stateful sampling, and --ignore-eos currently require --serve"
    if reasoning_default == "on" or reasoning_default == "off":
        chat_template_kwargs_default = jv_set(chat_template_kwargs_default, "enable_thinking", JValue.JBool(reasoning_default == "on"))
    if reasoning_preserve_default == "on" or reasoning_preserve_default == "off":
        chat_template_kwargs_default = jv_set(chat_template_kwargs_default, "preserve_reasoning", JValue.JBool(reasoning_preserve_default == "on"))

    set_decode_profile_stage(requested_profile_stage)

    if serve_mode:
        # OpenAI-compatible HTTP server (see server.br) — always the packed-
        # weight quantized GPU path, with the model loaded once up front and
        # kept resident for every request. Handled before the generic parse
        # below (which would also be fine now: no mode holds the file in memory).
        let extra_defaults = ServerSamplingDefaults(presence_penalty, frequency_penalty, mirostat, mirostat_tau, mirostat_eta, adaptive_target, adaptive_decay, samplers, ignore_eos)
        run_serve(gguf_path, model_name, model_tags, chat_template_override, ctx_size, max_tokens, cache_slots, prompt_cache_dir, slot_save_dir, prompt_cache_files, prompt_cache_max_mb, host, port, api_keys, api_prefix, cors_origins, cors_methods, cors_headers, cors_credentials, metrics_enabled, slots_enabled, cache_prompt_default, sse_ping_interval_default, reasoning_format_default, reasoning_effort_default, chat_template_kwargs_default, extra_defaults, SamplingParams(temperature, dynatemp_range, dynatemp_exponent, top_n_sigma, top_k, typical_p, top_p, min_p, xtc_probability, xtc_threshold, min_keep, seed, repeat_penalty, repeat_last_n, dry_multiplier, dry_base, dry_allowed_length, dry_penalty_last_n, []))
        return

    print "[diag] parsing {gguf_path}..."
    let file = parse_gguf_path(gguf_path)
    print "[diag] parsed ({file.file_size} bytes, {file.tensors.length} tensors, {file.metadata.length} metadata keys)"

    if dump_metadata:
        print_metadata(file)

    if tokens_csv != "":
        if quantized:
            run_forward_debug_quantized(file, parse_token_ids(tokens_csv))
        else:
            run_forward_debug(file, parse_token_ids(tokens_csv), use_gpu)

    if generate_tokens_csv != "":
        run_generate_tokens(file, parse_token_ids(generate_tokens_csv), max_tokens, SamplingParams(temperature, dynatemp_range, dynatemp_exponent, top_n_sigma, top_k, typical_p, top_p, min_p, xtc_probability, xtc_threshold, min_keep, seed, repeat_penalty, repeat_last_n, dry_multiplier, dry_base, dry_allowed_length, dry_penalty_last_n, []))

    if encode_file_path != "":
        run_encode_file(file, encode_file_path)
    if render_request_path != "":
        run_render_request(file, render_request_path)
    if chat_mode:
        let params = SamplingParams(temperature, dynatemp_range, dynatemp_exponent, top_n_sigma, top_k, typical_p, top_p, min_p, xtc_probability, xtc_threshold, min_keep, seed, repeat_penalty, repeat_last_n, dry_multiplier, dry_base, dry_allowed_length, dry_penalty_last_n, [])
        run_chat(file, system_msg, max_tokens, kv_cache, quantized, params)
    elif prompt != "":
        let params = SamplingParams(temperature, dynatemp_range, dynatemp_exponent, top_n_sigma, top_k, typical_p, top_p, min_p, xtc_probability, xtc_threshold, min_keep, seed, repeat_penalty, repeat_last_n, dry_multiplier, dry_base, dry_allowed_length, dry_penalty_last_n, [])
        run_generate(file, system_msg, prompt, max_tokens, kv_cache, quantized, params)
