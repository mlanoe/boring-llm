# Pure compatibility-option parsing kept separate from main so the accepted
# llama.cpp spellings can be checked without loading a model.

pub string parse_cache_type_arg(string name, string s) throws:
    let value = s.trim().lower()
    guard value == "f32" or value == "f16" else throw "{name} supports f32 or f16"
    value

pub string parse_flash_attention_arg(string name, string s) throws:
    let value = s.trim().lower()
    guard value == "on" or value == "auto" else throw "{name} expects on or auto; boring-llm always uses its fused attention kernels"
    value

pub int parse_gpu_layers_arg(string name, string s) throws:
    let value = s.trim().lower()
    if value == "auto" or value == "all": return -1
    guard let count = (value as int) else throw "invalid {name} value: '{s}' (expected auto, all, or a non-negative integer)"
    guard count >= 0 else throw "{name} expects auto, all, or a non-negative integer"
    count

pub def validate_gpu_layers(int requested, int actual) throws:
    guard requested == -1 or requested >= actual else throw "--gpu-layers {requested} requests partial GPU offload, but boring-llm requires all {actual} transformer layers on the GPU"

pub int effective_prefill_chunk(int batch_size, int ubatch_size):
    if batch_size < ubatch_size: batch_size else: ubatch_size

pub string parse_split_mode_arg(string name, string s) throws:
    let value = s.trim().lower()
    guard value == "none" else throw "{name} currently supports only none because boring-llm uses one GPU"
    value

pub int parse_main_gpu_arg(string name, string s) throws:
    guard let index = (s as int) else throw "invalid {name} value: '{s}'"
    guard index == 0 else throw "{name} currently supports only GPU index 0"
    index

# llama.cpp uses -1 for automatic CPU thread selection. boring-llm's model
# execution is GPU-resident, so the value is accepted for launcher
# compatibility but does not alter kernel scheduling.
pub int parse_thread_count_arg(string name, string s) throws:
    guard let count = (s as int) else throw "invalid {name} value: '{s}'"
    guard count == -1 or count > 0 else throw "{name} expects -1 or a positive integer"
    count

pub int parse_bounded_int_arg(string name, string s, int minimum, int maximum) throws:
    guard let value = (s as int) else throw "invalid {name} value: '{s}'"
    guard value >= minimum and value <= maximum else throw "{name} must be between {minimum} and {maximum}"
    value

pub string parse_cpu_mask_arg(string name, string s) throws:
    let value = s.trim()
    var string digits = value
    if value.lower().startsWith("0x"):
        digits = ""
        let chars = value.chars()
        var int i = 2
        while i < chars.length:
            digits = "{digits}{chars[i]}"
            i += 1
    guard digits != "" else throw "{name} expects a non-empty hexadecimal mask"
    for ch in digits.chars():
        guard (ch >= "0" and ch <= "9") or (ch >= "a" and ch <= "f") or (ch >= "A" and ch <= "F") else throw "{name} expects a hexadecimal mask"
    value

pub string parse_cpu_range_arg(string name, string s) throws:
    let value = s.trim()
    let parts = value.split("-")
    guard parts.length == 2 else throw "{name} expects a range formatted lo-hi"
    guard let first = (parts[0] as int) else throw "{name} expects a range formatted lo-hi"
    guard let last = (parts[1] as int) else throw "{name} expects a range formatted lo-hi"
    guard first >= 0 and last >= first else throw "{name} expects 0 <= lo <= hi"
    value
