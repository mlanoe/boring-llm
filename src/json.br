# boring-llm — JSON parser (feeds the OpenAI-compatible server in server.br)
#
# Parses a JSON document into jinja.br's own `JValue` tree rather than a
# separate JSON type: the request's `messages`/`tools` arrays are handed
# straight to the GGUF's own chat template as the Jinja environment, so one
# shared value type means no conversion step at all. Object key order is
# preserved (`JDict`'s `keys`), so serializing a parsed value back out with
# `jv_to_json` reproduces the request's own field order — a prompt rendered
# twice from the same JSON must be byte-identical for a prefix KV-cache to
# ever hit across requests.
#
# JSON `null` maps to `JUndefined` (jinja's own "no value" — falsy, and
# `jv_to_json` writes it back as `null`).

use jinja

bool is_json_ws(string ch):
    ch == " " or ch == "\n" or ch == "\t" or ch == "\r"

int json_skip_ws([string] cs, int pos):
    var int p = pos
    while p < cs.length and is_json_ws(cs[p]):
        p += 1
    p

int json_hex_val(string ch) throws:
    if ch >= "0" and ch <= "9":
        ord(ch) - ord("0")
    elif ch >= "a" and ch <= "f":
        ord(ch) - ord("a") + 10
    elif ch >= "A" and ch <= "F":
        ord(ch) - ord("A") + 10
    else:
        throw "json: invalid hex digit '{ch}' in \\u escape"

int json_hex4([string] cs, int pos) throws:
    guard pos + 4 <= cs.length else throw "json: truncated \\u escape"
    var int v = 0
    var int i = 0
    while i < 4:
        v = v * 16 + json_hex_val(cs[pos + i])
        i += 1
    v

# `pos` points at the opening quote; returns (decoded string, index just past
# the closing quote). Handles every JSON escape, including \uXXXX and
# surrogate pairs (an emoji arrives as two consecutive \u escapes).
(string, int) json_parse_string([string] cs, int pos) throws:
    var string out = ""
    var int p = pos + 1
    while true:
        guard p < cs.length else throw "json: unterminated string"
        let ch = cs[p]
        if ch == "\"":
            return (out, p + 1)
        elif ch == "\\":
            guard p + 1 < cs.length else throw "json: truncated escape"
            let e = cs[p + 1]
            if e == "n":
                out = "{out}\n"
                p += 2
            elif e == "t":
                out = "{out}\t"
                p += 2
            elif e == "r":
                out = "{out}\r"
                p += 2
            elif e == "b":
                out = "{out}{chr(8)}"
                p += 2
            elif e == "f":
                out = "{out}{chr(12)}"
                p += 2
            elif e == "u":
                var int cp = json_hex4(cs, p + 2)
                p += 6
                if cp >= 0xD800 and cp <= 0xDBFF:
                    guard p + 1 < cs.length and cs[p] == "\\" and cs[p + 1] == "u" else throw "json: high surrogate without a low surrogate"
                    let lo = json_hex4(cs, p + 2)
                    guard lo >= 0xDC00 and lo <= 0xDFFF else throw "json: invalid low surrogate"
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                    p += 6
                elif cp >= 0xDC00 and cp <= 0xDFFF:
                    throw "json: low surrogate without a high surrogate"
                out = "{out}{chr(cp)}"
            elif e == "\"" or e == "\\" or e == "/":
                out = "{out}{e}"
                p += 2
            else:
                throw "json: invalid escape '\\{e}'"
        else:
            guard ord(ch) >= 0x20 else throw "json: unescaped control character in string"
            out = "{out}{ch}"
            p += 1
    ("", p)

(JValue, int) json_parse_number([string] cs, int pos) throws:
    var bool is_float = false
    var int p = pos

    if p < cs.length and cs[p] == "-":
        p += 1
    guard p < cs.length else throw "json: truncated number"
    if cs[p] == "0":
        p += 1
    elif cs[p] >= "1" and cs[p] <= "9":
        p += 1
        while p < cs.length and cs[p] >= "0" and cs[p] <= "9":
            p += 1
    else:
        throw "json: invalid number at {pos}"

    if p < cs.length and cs[p] == ".":
        is_float = true
        p += 1
        guard p < cs.length and cs[p] >= "0" and cs[p] <= "9" else throw "json: expected digit after decimal point"
        while p < cs.length and cs[p] >= "0" and cs[p] <= "9":
            p += 1

    if p < cs.length and (cs[p] == "e" or cs[p] == "E"):
        is_float = true
        p += 1
        if p < cs.length and (cs[p] == "+" or cs[p] == "-"):
            p += 1
        guard p < cs.length and cs[p] >= "0" and cs[p] <= "9" else throw "json: expected exponent digits"
        while p < cs.length and cs[p] >= "0" and cs[p] <= "9":
            p += 1

    var string text = ""
    var int i = pos
    while i < p:
        text = "{text}{cs[i]}"
        i += 1
    if not is_float:
        # An integer too large for int64 falls through to a float below.
        if let n = (text as int):
            return (JValue.JInt(n), p)
    guard let f = (text as float) else throw "json: invalid number '{text}'"
    (JValue.JFloat(f), p)

bool json_has_literal([string] cs, int pos, string lit):
    let lc = lit.chars()
    if pos + lc.length > cs.length:
        return false
    var int i = 0
    while i < lc.length:
        if cs[pos + i] != lc[i]:
            return false
        i += 1
    true

(JValue, int) json_parse_value([string] cs, int pos) throws:
    let p = json_skip_ws(cs, pos)
    guard p < cs.length else throw "json: unexpected end of input"
    let ch = cs[p]
    if ch == "{{":
        var {string=JValue} fields = {=}
        var [string] keys = []
        var int q = json_skip_ws(cs, p + 1)
        if q < cs.length and cs[q] == "}}":
            return (JValue.JDict(fields, keys), q + 1)
        while true:
            q = json_skip_ws(cs, q)
            guard q < cs.length and cs[q] == "\"" else throw "json: expected object key at {q}"
            let (key, after_key) = json_parse_string(cs, q)
            q = json_skip_ws(cs, after_key)
            guard q < cs.length and cs[q] == ":" else throw "json: expected ':' after key '{key}'"
            let (child, after_val) = json_parse_value(cs, q + 1)
            if not fields.contains(key):
                keys.push(key.clone())
            fields[key] = child
            q = json_skip_ws(cs, after_val)
            guard q < cs.length else throw "json: unterminated object"
            if cs[q] == ",":
                q += 1
            elif cs[q] == "}}":
                return (JValue.JDict(fields, keys), q + 1)
            else:
                throw "json: expected ',' or '}}' at {q}"
        (JValue.JUndefined, q)
    elif ch == "[":
        var [JValue] items = []
        var int q = json_skip_ws(cs, p + 1)
        if q < cs.length and cs[q] == "]":
            return (JValue.JList(items), q + 1)
        while true:
            let (child, after_val) = json_parse_value(cs, q)
            items.push(child)
            q = json_skip_ws(cs, after_val)
            guard q < cs.length else throw "json: unterminated array"
            if cs[q] == ",":
                q += 1
            elif cs[q] == "]":
                return (JValue.JList(items), q + 1)
            else:
                throw "json: expected ',' or ']' at {q}"
        (JValue.JUndefined, q)
    elif ch == "\"":
        let (s, np) = json_parse_string(cs, p)
        (JValue.JStr(s), np)
    elif json_has_literal(cs, p, "true"):
        (JValue.JBool(true), p + 4)
    elif json_has_literal(cs, p, "false"):
        (JValue.JBool(false), p + 5)
    elif json_has_literal(cs, p, "null"):
        (JValue.JUndefined, p + 4)
    else:
        json_parse_number(cs, p)

pub JValue json_parse(string src) throws:
    let cs = src.chars()
    let (v, end) = json_parse_value(cs, 0)
    let tail = json_skip_ws(cs, end)
    guard tail == cs.length else throw "json: trailing characters at {tail}"
    v

# Classifies a JSON prefix without throwing: -1 is irrecoverably invalid, 0 can
# still become one valid document by appending characters, and 1 is already a
# complete document (optionally followed by whitespace). This is deliberately
# syntax-only; schema constraints are layered on top by the decoder.
pub int json_prefix_state(string src):
    let cs = src.chars()
    # 0 root value, 1 object key/end, 2 colon, 3 object value,
    # 4 object comma/end, 5 array value/end, 6 array comma/end, 7 root done.
    mut [int] states = [0]
    var int p = 0
    while p < cs.length:
        let state = states[states.length - 1]
        let ch = cs[p]
        if is_json_ws(ch):
            p += 1
        elif state == 7:
            return -1
        elif state == 2:
            if ch != ":": return -1
            let top = states.length - 1
            states[top] = 3
            p += 1
        elif state == 4:
            if ch == ",":
                let top = states.length - 1
                states[top] = 1
                p += 1
            elif ch == "}}":
                states.pop()
                p += 1
            else:
                return -1
        elif state == 6:
            if ch == ",":
                let top = states.length - 1
                states[top] = 5
                p += 1
            elif ch == "]":
                states.pop()
                p += 1
            else:
                return -1
        elif state == 1:
            if ch == "}}":
                states.pop()
                p += 1
            elif ch != "\"":
                return -1
            else:
                p += 1
                var bool closed = false
                while p < cs.length and not closed:
                    let c = cs[p]
                    if c == "\"":
                        closed = true
                        p += 1
                    elif c == "\\":
                        p += 1
                        if p >= cs.length: return 0
                        let e = cs[p]
                        if e == "u":
                            var int h = 0
                            while h < 4:
                                p += 1
                                if p >= cs.length: return 0
                                let x = cs[p]
                                if not ((x >= "0" and x <= "9") or (x >= "a" and x <= "f") or (x >= "A" and x <= "F")): return -1
                                h += 1
                            p += 1
                        elif e == "\"" or e == "\\" or e == "/" or e == "b" or e == "f" or e == "n" or e == "r" or e == "t":
                            p += 1
                        else:
                            return -1
                    elif ord(c) < 0x20:
                        return -1
                    else:
                        p += 1
                if not closed: return 0
                let top = states.length - 1
                states[top] = 2
        else:
            # A value is expected at the root, after an object colon, or at an
            # array element. Mark its parent complete before pushing a nested
            # container; the parent is hidden until that container closes.
            if state != 0 and state != 3 and state != 5: return -1
            if ch == "]" and state == 5:
                states.pop()
                p += 1
            else:
                let after = if state == 0: 7 elif state == 3: 4 else: 6
                let top = states.length - 1
                states[top] = after
                if ch == "{{":
                    states.push(1)
                    p += 1
                elif ch == "[":
                    states.push(5)
                    p += 1
                elif ch == "\"":
                    p += 1
                    var bool closed = false
                    while p < cs.length and not closed:
                        let c = cs[p]
                        if c == "\"":
                            closed = true
                            p += 1
                        elif c == "\\":
                            p += 1
                            if p >= cs.length: return 0
                            let e = cs[p]
                            if e == "u":
                                var int h = 0
                                while h < 4:
                                    p += 1
                                    if p >= cs.length: return 0
                                    let x = cs[p]
                                    if not ((x >= "0" and x <= "9") or (x >= "a" and x <= "f") or (x >= "A" and x <= "F")): return -1
                                    h += 1
                                p += 1
                            elif e == "\"" or e == "\\" or e == "/" or e == "b" or e == "f" or e == "n" or e == "r" or e == "t":
                                p += 1
                            else:
                                return -1
                        elif ord(c) < 0x20:
                            return -1
                        else:
                            p += 1
                    if not closed: return 0
                elif ch == "t" or ch == "f" or ch == "n":
                    let word = if ch == "t": "true" elif ch == "f": "false" else: "null"
                    let wc = word.chars()
                    var int i = 0
                    while i < wc.length:
                        if p + i >= cs.length: return 0
                        if cs[p + i] != wc[i]: return -1
                        i += 1
                    p += wc.length
                else:
                    var int q = p
                    if cs[q] == "-":
                        q += 1
                        if q >= cs.length: return 0
                    if cs[q] == "0":
                        q += 1
                    elif cs[q] >= "1" and cs[q] <= "9":
                        q += 1
                        while q < cs.length and cs[q] >= "0" and cs[q] <= "9": q += 1
                    else:
                        return -1
                    if q < cs.length and cs[q] == ".":
                        q += 1
                        if q >= cs.length: return 0
                        if cs[q] < "0" or cs[q] > "9": return -1
                        while q < cs.length and cs[q] >= "0" and cs[q] <= "9": q += 1
                    if q < cs.length and (cs[q] == "e" or cs[q] == "E"):
                        q += 1
                        if q >= cs.length: return 0
                        if cs[q] == "+" or cs[q] == "-":
                            q += 1
                            if q >= cs.length: return 0
                        if cs[q] < "0" or cs[q] > "9": return -1
                        while q < cs.length and cs[q] >= "0" and cs[q] <= "9": q += 1
                    p = q
        if states.length == 0:
            # A closed top-level container is a complete root value.
            states.push(7)
    if states.length == 1 and states[0] == 7: 1 else: 0

# `response_format: {type: json_object}` is stricter than generic JSON: a
# scalar or top-level array is not a valid result. Leading whitespace remains
# legal, matching the JSON grammar and llama.cpp's grammar-constrained output.
pub int json_object_prefix_state(string src):
    let cs = src.chars()
    var int p = 0
    while p < cs.length and is_json_ws(cs[p]):
        p += 1
    if p == cs.length:
        return 0
    if cs[p] != "{{":
        return -1
    json_prefix_state(src)

# Pure candidate policy used by the future constrained sampler. A normal token
# is allowed when appending its piece keeps the prefix viable. EOS is allowed
# only after a complete object, so truncation can never masquerade as success.
pub bool json_object_candidate_allowed(string prefix, string piece, bool is_eos):
    let before = json_object_prefix_state(prefix)
    if before < 0:
        false
    elif is_eos:
        before == 1
    else:
        json_object_prefix_state("{prefix}{piece}") >= 0

# ── Typed accessors for pulling request fields out of a parsed object ─────

pub JValue json_get(JValue v, string key):
    match v:
        JDict(fields, keys): fields[key] else JValue.JUndefined
        _: JValue.JUndefined

pub string json_get_str(JValue v, string key, string fallback):
    match json_get(v, key):
        JStr(s): s
        _: fallback

pub int json_get_int(JValue v, string key, int fallback):
    match json_get(v, key):
        JInt(n): n
        JFloat(f): f as int
        _: fallback

pub float json_get_float(JValue v, string key, float fallback):
    match json_get(v, key):
        JFloat(f): f
        JInt(n): n as float
        _: fallback

pub bool json_get_bool(JValue v, string key, bool fallback):
    match json_get(v, key):
        JBool(b): b
        _: fallback

pub [JValue] json_get_list(JValue v, string key):
    match json_get(v, key):
        JList(items): items
        _: []
