# boring-llm — OpenAI-compatible HTTP server (`--serve`)
#
# Exposes the loaded model as `GET /v1/models` and
# `POST /v1/chat/completions` (JSON, or SSE when the request says
# `"stream": true`), so any OpenAI-compatible client — OpenCode, the Vercel AI
# SDK, `curl` — can drive it. Plain `std::net` (no extra crate): one blocking
# accept loop, one request at a time, which is also exactly the serialization a
# single GPU needs. Every response is `Connection: close`; a streamed reply
# (`"stream": true`) is written token by token as the model produces it.
#
# The pure parts (message normalization, `<tool_call>` parsing, JSON/SSE
# bodies) live in openai.br and are unit-tested there; this file is the socket
# + model glue.

use gguf
use io
use jinja
use json
use openai
use tokenizer
use cache_policy
use model
use prompt_cache
use sampling
use std.net.TcpListener, TcpStream
use std.io.Read, Write
use std.time.Instant

pub struct ServerCtx:
    GgufFile file
    Tokenizer tok
    QuantModel model
    string model_path
    string model_name
    int max_ctx             # prompt + generated tokens must fit in this
    int default_max_tokens  # used when a request sets no max_tokens
    int cache_slots         # how many prompt KV caches to keep (LRU)
    SamplingParams defaults
    string cache_dir        # prompt caches kept on disk across restarts; "" = off
    int cache_fp            # fingerprint of the loaded model (see prompt_cache.br)
    int cache_files         # how many snapshots to keep on disk
    int cache_max_bytes     # cap on all snapshots together; 0 = none
    int cache_bpt           # bytes one token adds to a snapshot
    bool metrics_enabled    # expose Prometheus counters at GET /metrics

# A finished request's KV cache and the token ids it covers. A later prompt
# starts from the slot sharing the longest prefix with it (an agent client
# resends its whole history every turn, and interleaves unrelated small
# requests such as title generation, which must not evict the main one).
pub struct CacheSlot:
    GenCache cache
    [int] tokens
    int used        # request counter when last touched; smallest = least recently used

# 0 = nothing written for the current request yet, 1 = an SSE stream is open
# (a failure then must not write a second HTTP response into it), 2 = a complete
# response was written.
static var int response_state = 0

# Process-wide counters are sufficient because the server deliberately owns
# one model and handles one connection at a time.
static var int metric_prompt_tokens = 0
static var int metric_prompt_ms = 0
static var int metric_predicted_tokens = 0
static var int metric_predicted_ms = 0
static var int metric_n_tokens_max = 0

pub struct HttpRequest:
    string method
    string path
    string body

# llama_model_n_params() is the sum of the element counts of the tensors
# actually stored in the GGUF (shared/tied weights therefore stay shared).
int gguf_parameter_count(GgufFile file):
    var int total = 0
    for tensor in file.tensors:
        var int count = 1
        for dim in tensor.dims:
            count *= dim
        total += count
    total

({int=float32}, int) request_logit_bias(JValue body, int vocab):
    mut {int=float32} out = {=}
    match json_get(body, "logit_bias"):
        JDict(fields, keys):
            for key in keys:
                if let token = (key as int):
                    if token >= vocab:
                        return (out, token)
                    let value = fields[key] else JValue.JUndefined
                    match value:
                        JInt(n): out[token] = n as float32
                        JFloat(f): out[token] = f as float32
                        _: true
        _: true
    (out, -1)

string tokens_with_pieces_json(Tokenizer tok, [int] ids):
    var string out = "["
    var int i = 0
    while i < ids.length:
        if i > 0: out = "{out}, "
        let bytes = tok.piece_bytes(ids[i])
        var string piece = ""
        if is_valid_utf8(bytes):
            piece = "\"{json_escape(bytes_to_str(bytes))}\""
        else:
            piece = "["
            var int j = 0
            while j < bytes.length:
                if j > 0: piece = "{piece}, "
                piece = "{piece}{int(bytes[j])}"
                j += 1
            piece = "{piece}]"
        out = "{out}{{\"id\": {ids[i]}, \"piece\": {piece}}}"
        i += 1
    "{{\"tokens\": {out}]}}"

# ── Socket helpers ───────────────────────────────────────────────────────

# Applies the JSON-object grammar after top-k ranking and before top-p/min-p.
# If the current top-k has no viable token, progressively widen it: a grammar
# must not fail merely because every unconstrained favourite is invalid.
pub (int, Rng) sample_json_token(Tokenizer tok, Rng rng, [float32] logits,
                                  int vocab, [int] history, [int] reply_tokens,
                                  SamplingParams params, JValue schema) throws:
    let decoded_before = tok.decode(reply_tokens)
    if json_object_prefix_state(decoded_before) == 1 and (request_value_is_undefined(schema) or json_schema_decoded_candidate_allowed(schema, decoded_before, "", true)):
        return (tok.eos_token_id, rng)

    let penalized = apply_repeat_penalty(logits, history, params.repeat_penalty, params.repeat_last_n)
    var int k = if params.top_k > 0: params.top_k else: 50
    if k > vocab: k = vocab
    while true:
        let (ranked_values, ranked_ids) = top_k_select(penalized, vocab, k)
        mut [float32] allowed_values = []
        mut [int] allowed_ids = []
        var int i = 0
        while i < ranked_ids.length:
            let candidate = ranked_ids[i]
            var bool allowed = false
            if candidate == tok.eos_token_id:
                allowed = if request_value_is_undefined(schema): json_object_decoded_candidate_allowed(decoded_before, "", true) else: json_schema_decoded_candidate_allowed(schema, decoded_before, "", true)
            else:
                mut [int] candidate_reply = []
                for id in reply_tokens:
                    candidate_reply.push(id)
                candidate_reply.push(candidate)
                let decoded_after = tok.decode(candidate_reply)
                allowed = if request_value_is_undefined(schema): json_object_decoded_candidate_allowed(decoded_before, decoded_after, false) else: json_schema_decoded_candidate_allowed(schema, decoded_before, decoded_after, false)
            if allowed:
                allowed_values.push(ranked_values[i])
                allowed_ids.push(candidate)
            i += 1
        if allowed_ids.length > 0:
            return sample_candidates(rng, allowed_values, allowed_ids, params.temperature, params.top_p, params.min_p)
        guard k < vocab else throw "JSON response grammar rejected every vocabulary token"
        k = if k * 4 < vocab: k * 4 else: vocab

# Constrained compact tool-call form. Named choices generate only their
# arguments object; `required` generates {name, arguments}. openai.br turns
# either form back into the model-independent OpenAI tool_calls response.
pub (int, Rng) sample_tool_choice_token(Tokenizer tok, Rng rng, [float32] logits,
                                         int vocab, [int] history, [int] reply_tokens,
                                         SamplingParams params, JValue body,
                                         [JValue] tools) throws:
    let decoded_before = tok.decode(reply_tokens)
    if tool_choice_decoded_candidate_allowed(body, tools, decoded_before, "", true):
        return (tok.eos_token_id, rng)

    let penalized = apply_repeat_penalty(logits, history, params.repeat_penalty, params.repeat_last_n)
    var int k = if params.top_k > 0: params.top_k else: 50
    if k > vocab: k = vocab
    while true:
        let (ranked_values, ranked_ids) = top_k_select(penalized, vocab, k)
        mut [float32] allowed_values = []
        mut [int] allowed_ids = []
        var int i = 0
        while i < ranked_ids.length:
            let candidate = ranked_ids[i]
            var bool allowed = false
            if candidate == tok.eos_token_id:
                allowed = tool_choice_decoded_candidate_allowed(body, tools, decoded_before, "", true)
            else:
                mut [int] candidate_reply = []
                for id in reply_tokens:
                    candidate_reply.push(id)
                candidate_reply.push(candidate)
                allowed = tool_choice_decoded_candidate_allowed(body, tools, decoded_before, tok.decode(candidate_reply), false)
            if allowed:
                allowed_values.push(ranked_values[i])
                allowed_ids.push(candidate)
            i += 1
        if allowed_ids.length > 0:
            return sample_candidates(rng, allowed_values, allowed_ids, params.temperature, params.top_p, params.min_p)
        guard k < vocab else throw "tool_choice grammar rejected every vocabulary token"
        k = if k * 4 < vocab: k * 4 else: vocab

# RFC 3986 path-segment encoding used by `GET /v1/models/{model}`. Work on
# UTF-8 bytes so non-ASCII ids round-trip through ordinary OpenAI SDKs too.
string url_path_segment(string text):
    let hex = "0123456789ABCDEF".chars()
    var string out = ""
    let bytes = text.asBytes()
    var int i = 0
    while i < bytes.length:
        let b = int(bytes[i])
        if (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 46 or b == 95 or b == 126:
            out = "{out}{chr(b)}"
        else:
            out = "{out}%{hex[b / 16]}{hex[b % 16]}"
        i += 1
    out

int read_some(var TcpStream sock, mut [uint8] b) throws:
    let n = try? sock.read(b)
    guard let n else throw "socket read failed"
    n as int

def write_text(var TcpStream sock, string text) throws:
    let w = try? sock.writeAll(text.asBytes())
    guard let w else throw "socket write failed"

def respond(var TcpStream sock, int status, string reason, string content_type, string body) throws:
    let body_len = body.asBytes().length
    let head = "HTTP/1.1 {status} {reason}\r\nContent-Type: {content_type}\r\nContent-Length: {body_len}\r\nConnection: close\r\nCache-Control: no-cache\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: *\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\n\r\n"
    write_text(sock, head)
    write_text(sock, body)
    response_state = 2

# Headers of a streamed reply: no Content-Length, the body ends when the
# connection closes. Events follow as the model produces them.
def respond_stream_head(var TcpStream sock) throws:
    response_state = 1
    write_text(sock, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: close\r\nX-Accel-Buffering: no\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: *\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\n\r\n")

def respond_json(var TcpStream sock, int status, string reason, string body) throws:
    respond(sock, status, reason, "application/json", body)

int parse_content_length(string head) throws:
    var int found = 0
    var int value = 0
    for line in head.split("\r\n"):
        let low = line.toLower()
        if low.startsWith("content-length:"):
            found += 1
            if found > 1:
                throw "http_400:multiple Content-Length headers are not supported"
            let v = low.replace("content-length:", "").trim()
            guard let n = (v as int) else throw "http_400:invalid Content-Length"
            guard n >= 0 else throw "http_400:invalid Content-Length"
            value = n
    value

bool has_transfer_encoding(string head):
    for line in head.split("\r\n"):
        let low = line.toLower()
        if low.startsWith("transfer-encoding:"):
            return true
    false

# Reads one HTTP request: accumulates raw bytes until the blank line ending
# the headers, then until `Content-Length` body bytes have arrived. Decoded as
# UTF-8 only once complete (a multi-byte character can straddle two reads).
HttpRequest read_http_request(var TcpStream sock) throws:
    let max_header_bytes = 65536
    let max_body_bytes = 16 * 1024 * 1024
    mut [uint8] chunk = [0 as uint8 for i in 0..<65536]
    mut [uint8] data = []
    var int scan = 0
    var int header_end = -1
    var int content_length = 0
    var string head = ""
    while true:
        let n = read_some(sock, chunk)
        if n == 0:
            break
        var int k = 0
        while k < n:
            data.push(chunk[k])
            k += 1
        if header_end < 0:
            if data.length > max_header_bytes:
                throw "http_431:request headers are too large"
            while scan + 3 < data.length:
                if int(data[scan]) == 13 and int(data[scan + 1]) == 10 and int(data[scan + 2]) == 13 and int(data[scan + 3]) == 10:
                    header_end = scan + 4
                    break
                scan += 1
            if header_end >= 0:
                let head_bytes = read_bytes(data, 0, header_end)
                if not is_valid_utf8(head_bytes):
                    throw "http_400:request headers are not valid UTF-8"
                head = bytes_to_str(head_bytes)
                if has_transfer_encoding(head):
                    throw "http_400:Transfer-Encoding request bodies are not supported"
                content_length = parse_content_length(head)
                if content_length > max_body_bytes:
                    throw "http_413:request body is too large"
        if header_end >= 0 and data.length >= header_end + content_length:
            break
    guard header_end >= 0 else throw "http_400:request has no complete header section"
    if data.length < header_end + content_length:
        throw "http_400:request body is shorter than Content-Length"
    if data.length > header_end + content_length:
        throw "http_400:request contains bytes after the declared body"
    let request_line = head.split("\r\n")[0].split(" ")
    guard request_line.length == 3 else throw "http_400:malformed HTTP request line"
    guard request_line[0] != "" and request_line[1].startsWith("/") else throw "http_400:malformed HTTP request line"
    guard request_line[2] == "HTTP/1.1" or request_line[2] == "HTTP/1.0" else throw "http_400:unsupported HTTP version"
    let body_bytes = read_bytes(data, header_end, content_length)
    if not is_valid_utf8(body_bytes):
        throw "http_400:request body is not valid UTF-8"
    let body = bytes_to_str(body_bytes)
    HttpRequest(request_line[0], request_line[1].split("?")[0], body)

# ── Chat completions ─────────────────────────────────────────────────────

[string] stop_list(JValue body):
    match json_get(body, "stop"):
        JStr(s): [s]
        JList(items):
            mut [string] out = []
            for it in items:
                match it:
                    JStr(s): out.push(s)
                    _: out.push("")
            out
        _: []

# `slots` are the KV caches left by earlier requests; the returned list
# replaces them. A new prompt only pays for the tokens after its longest common
# prefix with the best slot.
[CacheSlot] handle_completion(ServerCtx& ctx, var TcpStream sock, string body_text, int counter,
                              [CacheSlot] slots, [DiskSnap] disk, bool is_chat, bool is_native) throws:
    let parsed = try? json_parse(body_text)
    guard let body = parsed else:
        respond_json(sock, 400, "Bad Request", error_json("request body is not valid JSON", "invalid_request_error", "invalid_json"))
        return slots
    let invalid = request_validation_error(body)
    if invalid != "":
        respond_json(sock, 400, "Bad Request", error_json(invalid, "invalid_request_error", "invalid_parameter"))
        return slots
    mut [JValue] messages = []
    mut [JValue] tools = []
    mut [int] prompt_tokens = []
    if is_chat:
        let invalid_shape = request_shape_error(body)
        if invalid_shape != "":
            let code = if invalid_shape.startsWith("`messages` is required"): "missing_messages" else: "invalid_request"
            respond_json(sock, 400, "Bad Request", error_json(invalid_shape, "invalid_request_error", code))
            return slots
        let raw_tools = json_get_list(body, "tools")
        let invalid_choice = tool_choice_validation_error(body, raw_tools)
        if invalid_choice != "":
            respond_json(sock, 400, "Bad Request", error_json(invalid_choice, "invalid_request_error", "invalid_tool_choice"))
            return slots
        messages = normalize_messages(json_get_list(body, "messages"))
        tools = tools_for_request(body, raw_tools)
        prompt_tokens = render_chat_prompt_messages_kw(ctx.file, ctx.tok, messages, tools, true, chat_template_variables(body))
    else:
        let prompt_value = json_get(body, "prompt")
        match prompt_value:
            JStr(prompt):
                if prompt.chars().length > 0:
                    prompt_tokens = ctx.tok.encode_completion_prompt(prompt)
            JList(items):
                var bool first_item = true
                for item in items:
                    match item:
                        JInt(id):
                            if id < 0 or id >= ctx.model.config.vocab_size:
                                respond_json(sock, 400, "Bad Request", error_json("prompt token id {id} is outside the vocabulary", "invalid_request_error", "invalid_prompt_token"))
                                return slots
                            prompt_tokens.push(id)
                        JStr(fragment):
                            if not is_native:
                                respond_json(sock, 400, "Bad Request", error_json("OpenAI `prompt` token arrays must contain only integer token ids", "invalid_request_error", "invalid_prompt"))
                                return slots
                            let fragment_tokens = if first_item: ctx.tok.encode_completion_prompt(fragment) else: ctx.tok.encode_with_specials(fragment)
                            for id in fragment_tokens:
                                prompt_tokens.push(id)
                        _:
                            let expected = if is_native: "integer token ids or string fragments" else: "integer token ids"
                            respond_json(sock, 400, "Bad Request", error_json("`prompt` arrays must contain only {expected}", "invalid_request_error", "invalid_prompt"))
                            return slots
                    first_item = false
            JDict(fields, keys):
                if not is_native:
                    respond_json(sock, 400, "Bad Request", error_json("OpenAI `prompt` must be a string or an array of token ids", "invalid_request_error", "invalid_prompt"))
                    return slots
                let media = json_get(prompt_value, "multimodal_data")
                if not request_value_is_undefined(media):
                    match media:
                        JList(items):
                            if items.length > 0:
                                respond_json(sock, 400, "Bad Request", error_json("multimodal completion prompts are not supported", "invalid_request_error", "unsupported_multimodal_prompt"))
                                return slots
                        _:
                            respond_json(sock, 400, "Bad Request", error_json("`prompt.multimodal_data` must be an array", "invalid_request_error", "invalid_prompt"))
                            return slots
                let prompt_string = json_get(prompt_value, "prompt_string")
                if not jv_is_str(prompt_string):
                    respond_json(sock, 400, "Bad Request", error_json("native prompt objects require a string `prompt_string`", "invalid_request_error", "invalid_prompt"))
                    return slots
                let text = json_get_str(prompt_value, "prompt_string", "")
                if text.chars().length > 0:
                    prompt_tokens = ctx.tok.encode_completion_prompt(text)
            _:
                respond_json(sock, 400, "Bad Request", error_json("`prompt` is required and must be a string, token array, or native prompt object", "invalid_request_error", "missing_prompt"))
                return slots
        if prompt_tokens.length == 0:
            respond_json(sock, 400, "Bad Request", error_json("`prompt` must not be empty", "invalid_request_error", "missing_prompt"))
            return slots

    let room = ctx.max_ctx - prompt_tokens.length
    if room <= 0:
        respond_json(sock, 400, "Bad Request", context_exceeded_json(prompt_tokens.length, ctx.max_ctx))
        return slots
    let default_asked = if is_native: json_get_int(body, "n_predict", ctx.default_max_tokens) else: json_get_int(body, "max_completion_tokens", ctx.default_max_tokens)
    let asked = json_get_int(body, "max_tokens", default_asked)
    # llama-server uses -1 for unbounded native completion. With context shift
    # disabled, "unbounded" means all positions still available in this context.
    let max_new = if asked < 0 or asked > room: room else: asked

    let temperature = json_get_float(body, "temperature", ctx.defaults.temperature as float)
    let top_p = json_get_float(body, "top_p", ctx.defaults.top_p as float)
    let min_p = json_get_float(body, "min_p", ctx.defaults.min_p as float)
    let seed = json_get_int(body, "seed", ctx.defaults.seed)
    let top_k = json_get_int(body, "top_k", ctx.defaults.top_k)
    let repeat_penalty = json_get_float(body, "repeat_penalty", ctx.defaults.repeat_penalty as float)
    let frequency_penalty = json_get_float(body, "frequency_penalty", 0.0) as float32
    let presence_penalty = json_get_float(body, "presence_penalty", 0.0) as float32
    let params = SamplingParams(temperature as float32, top_k, top_p as float32, min_p as float32, seed, repeat_penalty as float32, ctx.defaults.repeat_last_n)
    let (logit_bias, invalid_bias_token) = request_logit_bias(body, ctx.model.config.vocab_size)
    if invalid_bias_token >= 0:
        respond_json(sock, 400, "Bad Request", error_json("logit_bias token id {invalid_bias_token} is outside the vocabulary", "invalid_request_error", "invalid_logit_bias"))
        return slots

    let started = Instant.now()
    let created = unix_timestamp()
    let stops = stop_list(body)
    let streaming = json_get_bool(body, "stream", false)
    let json_object_mode = json_get_str(json_get(body, "response_format"), "type", "") == "json_object"
    let json_schema = response_json_schema(body)
    let json_mode = json_object_mode or not request_value_is_undefined(json_schema)
    let constrained_tool_choice = is_chat and tool_choice_required(body)
    let wants_chat_logprobs = is_chat and json_get_bool(body, "logprobs", false)
    var bool wants_completion_logprobs = false
    var int completion_top_logprobs = 0
    if not is_chat and not is_native:
        match json_get(body, "logprobs"):
            JInt(count):
                wants_completion_logprobs = true
                completion_top_logprobs = count
            _: true
    let requested_native_logprobs = if is_native: json_get_int(body, "n_probs", 0) else: 0
    let wants_native_logprobs = requested_native_logprobs > 0
    let wants_logprobs = wants_chat_logprobs or wants_completion_logprobs or wants_native_logprobs
    let requested_top_logprobs = if wants_chat_logprobs:
        json_get_int(body, "top_logprobs", 0)
    elif wants_native_logprobs:
        requested_native_logprobs
    else:
        completion_top_logprobs
    let include_usage = json_get_bool(json_get(body, "stream_options"), "include_usage", false)
    let id = "{counter}"
    # The last prompt token always goes through the model (its logits pick the
    # first reply token), so at most `length - 1` cached positions are reusable.
    mut [[int]] slot_tokens = []
    for sl in slots:
        slot_tokens.push(sl.tokens)
    let (mem_best, common) = best_prefix_slot(slot_tokens, prompt_tokens)
    let mem_reuse = if common < prompt_tokens.length: common else: prompt_tokens.length - 1
    mut [[int]] disk_tokens = []
    for d in disk:
        disk_tokens.push(d.tokens)
    let (disk_best, disk_common) = best_prefix_slot(disk_tokens, prompt_tokens)
    let disk_reuse = if disk_common < prompt_tokens.length: disk_common else: prompt_tokens.length - 1
    let from_disk = restore_from_disk(mem_reuse, disk_best, disk_reuse)
    let best = if from_disk: -1 else: mem_best
    var int reuse = if from_disk: disk_reuse else: mem_reuse
    # A streamed reply opens before the prompt is processed: a cold agent prompt
    # takes minutes on a large model, and clients give up on a response whose
    # headers (OpenCode: `headerTimeout`) or body (`chunkTimeout`) stay silent for
    # 5 minutes by default. An SSE comment line follows each prefill chunk; clients
    # ignore it, but the connection is not idle. A client that has gone away is
    # noticed by the failing write, so its prefill stops early.
    if streaming:
        respond_stream_head(sock)
        if is_chat:
            write_text(sock, sse_role_event(id, ctx.model_name, created))
    var base_cache = empty_cache(ctx.model.config.n_layer)
    var bool restored = false
    if from_disk:
        let loaded = try? load_snapshot(ctx.cache_dir, disk[disk_best], ctx.model, reuse)
        if let c = loaded:
            base_cache = c
            restored = true
        else:
            print "[serve] prompt cache: could not restore file {disk[disk_best].slot}, prefilling from scratch"
            reuse = 0
    elif best >= 0 and reuse > 0:
        base_cache = slots[best].cache
    let start_cache = resume_cache(ctx.model, base_cache, reuse, prompt_tokens.length)
    let pending = prompt_tokens[reuse..<prompt_tokens.length]
    let chunk_len = prefill_chunk_len()
    var cache_p = start_cache
    var [float32] first_logits = []
    var done = 0
    while done < pending.length:
        let upto = if done + chunk_len < pending.length: done + chunk_len else: pending.length
        let (lg, c) = prefill_step_gpu_quantized(ctx.model, cache_p, pending[done..<upto])
        first_logits = lg
        cache_p = c
        done = upto
        if streaming and done < pending.length:
            write_text(sock, ": prefill {done}/{pending.length}\n\n")
    let cache0 = cache_p
    let prefill_ms = started.elapsed().asMillis() as int

    # Decode loop, here rather than in model.br so each token can be sent as it
    # is produced. `text` is the visible reply so far, decoded incrementally from
    # a small window of tokens (a character can span several byte-level tokens:
    # nothing is taken from the window until it ends on a complete character).
    mut [int] tokens = []
    for pt in prompt_tokens:
        tokens.push(pt)
    mut [int] reply_tokens = []
    mut [string] reply_logprob_tokens = []
    mut [[uint8]] reply_logprob_bytes = []
    mut [float32] reply_logprobs = []
    mut [[TokenLogprobAlternative]] reply_top_logprobs = []
    var logits = first_logits
    var cur = cache0
    var rng = seed_rng(params.seed)
    let vocab = ctx.model.config.vocab_size
    var string text = ""
    var int prefix_off = 0
    var int read_off = 0
    var int emitted = 0
    var int emitted_r = 0
    var int emitted_tokens = 0
    var bool hit_eos = false
    var bool stopped = false
    var int generated = 0
    var int first_token_ms = -1
    while generated < max_new and not hit_eos and not stopped:
        let biased = apply_logit_bias(logits, logit_bias)
        let penalized = apply_presence_frequency_penalty(biased, reply_tokens, frequency_penalty, presence_penalty)
        let effective_logits = if wants_logprobs:
            sampling_logits(penalized, tokens, params.repeat_penalty, params.repeat_last_n)
        else:
            []
        let (next_tok, new_rng) = if constrained_tool_choice:
            sample_tool_choice_token(ctx.tok, rng, penalized, vocab, tokens, reply_tokens, params, body, tools)
        elif json_mode:
            sample_json_token(ctx.tok, rng, penalized, vocab, tokens, reply_tokens, params, json_schema)
        else:
            sample(rng, penalized, vocab, params.temperature, params.top_k, params.top_p, params.min_p, tokens, params.repeat_penalty, params.repeat_last_n)
        rng = new_rng
        tokens.push(next_tok)
        generated += 1
        if first_token_ms < 0:
            first_token_ms = started.elapsed().asMillis() as int
        if next_tok == ctx.tok.eos_token_id:
            hit_eos = true
        else:
            if wants_logprobs:
                let (lp_maximum, lp_sum) = logprob_normalizer(effective_logits, vocab)
                reply_logprob_tokens.push(ctx.tok.decode([next_tok]))
                reply_logprob_bytes.push(ctx.tok.piece_bytes(next_tok))
                reply_logprobs.push(normalized_token_logprob(effective_logits, next_tok, lp_maximum, lp_sum))
                mut [TokenLogprobAlternative] alternatives = []
                if requested_top_logprobs > 0:
                    let (top_values, top_ids) = top_k_select(effective_logits, vocab, requested_top_logprobs)
                    var int top_index = 0
                    while top_index < top_ids.length:
                        let top_id = top_ids[top_index]
                        alternatives.push(TokenLogprobAlternative(top_id, ctx.tok.decode([top_id]), ctx.tok.piece_bytes(top_id), normalized_token_logprob(effective_logits, top_id, lp_maximum, lp_sum)))
                        top_index += 1
                reply_top_logprobs.push(alternatives)
            reply_tokens.push(next_tok)
            let n_reply = reply_tokens.length
            let window_before = ctx.tok.decode(reply_tokens[prefix_off..<read_off])
            let window_now = ctx.tok.decode(reply_tokens[prefix_off..<n_reply])
            let before_len = window_before.chars().length
            let now_chars = window_now.chars()
            if now_chars.length > before_len and not window_now.endsWith(chr(65533)):
                var string piece = ""
                var int q = before_len
                while q < now_chars.length:
                    piece = "{piece}{now_chars[q]}"
                    q += 1
                text = "{text}{piece}"
                prefix_off = read_off
                read_off = n_reply
                let (cut, hit) = apply_stop(text, stops)
                if hit:
                    text = cut
                    stopped = true
            if streaming:
                let (split_reasoning_now, split_content_now) = stream_split(text)
                let reasoning_now = if is_chat: split_reasoning_now else: ""
                let content_now = if is_chat: split_content_now else: text
                let n_reasoning = reasoning_now.chars().length
                if n_reasoning > emitted_r:
                    write_text(sock, sse_reasoning_event(id, ctx.model_name, chars_from(reasoning_now, emitted_r), created))
                    emitted_r = n_reasoning
                let (chat_vs, chat_vl) = stream_bounds(content_now, stops)
                let vs = if is_chat: chat_vs else: 0
                let vl = if is_chat: chat_vl else: text_stream_limit(content_now, stops)
                if vl > vs + emitted:
                    let tcs = content_now.chars()
                    var string delta = ""
                    var int q2 = vs + emitted
                    while q2 < vl:
                        delta = "{delta}{tcs[q2]}"
                        q2 += 1
                    if is_chat:
                        write_text(sock, sse_content_event(id, ctx.model_name, delta, created))
                    elif is_native:
                        write_text(sock, native_completion_sse_event(delta, reply_tokens[emitted_tokens..<reply_tokens.length], false))
                        emitted_tokens = reply_tokens.length
                    else:
                        write_text(sock, text_completion_sse_event(id, ctx.model_name, delta, "", created))
                    emitted = vl - vs
            if not stopped:
                let (step_logits, step_cache) = forward_step(ctx.model, cur, next_tok)
                logits = step_logits
                cur = step_cache
    let gen_ms = started.elapsed().asMillis() as int

    # Authoritative text and tool calls: one full decode of the whole reply
    # (what a non-streaming reply is built from; the incremental text above is
    # only a prefix-safe preview of it).
    let (final_text, stopped_full) = apply_stop(ctx.tok.decode(reply_tokens), stops)
    let (chat_reasoning, chat_rest) = split_reasoning(final_text)
    let final_reasoning = if is_chat: chat_reasoning else: ""
    let final_rest = if is_chat: chat_rest else: final_text
    let reply = if not is_chat: ParsedReply(final_rest, []) elif tools_disabled(body): ParsedReply(final_rest.trim(), []) else: parse_reply_for_tools(final_rest, body, tools)
    let finish = if reply.calls.length > 0: "tool_calls" elif hit_eos or stopped or stopped_full: "stop" else: "length"
    let completion_tokens = generated

    if ctx.metrics_enabled:
        metric_prompt_tokens += pending.length
        metric_prompt_ms += prefill_ms
        metric_predicted_tokens += completion_tokens
        let decode_ms = gen_ms - prefill_ms
        if decode_ms > 0:
            metric_predicted_ms += decode_ms
        let occupied = prompt_tokens.length + completion_tokens
        if occupied > metric_n_tokens_max:
            metric_n_tokens_max = occupied

    let mode = if streaming: "streamed" else: "buffered"
    let reuse_src = if restored: "disk" else: "cache"
    let request_kind = if is_chat: "chat" elif is_native: "native completion" else: "completion"
    print "[serve] {request_kind}: {messages.length} messages, {tools.length} tools, prompt {prompt_tokens.length} tokens ({reuse} reused from {reuse_src}), generated {completion_tokens}, finish={finish}, {gen_ms} ms total (prefill {prefill_ms} ms, first token {first_token_ms} ms, {mode})"
    if streaming:
        # whatever of the final content was held back (or arrived after the last
        # preview), then the tool calls, finish reason, usage and end marker
        if final_reasoning.chars().length > emitted_r:
            write_text(sock, sse_reasoning_event(id, ctx.model_name, chars_from(final_reasoning, emitted_r), created))
        let content_chars = reply.content.chars()
        var string tail = ""
        var int q3 = emitted
        while q3 < content_chars.length:
            tail = "{tail}{content_chars[q3]}"
            q3 += 1
        if tail != "":
            if is_chat:
                write_text(sock, sse_content_event(id, ctx.model_name, tail, created))
            elif is_native:
                write_text(sock, native_completion_sse_event(tail, reply_tokens[emitted_tokens..<reply_tokens.length], false))
                emitted_tokens = reply_tokens.length
            else:
                write_text(sock, text_completion_sse_event(id, ctx.model_name, tail, "", created))
        if is_chat and reply.calls.length > 0:
            write_text(sock, sse_tool_calls_event(id, ctx.model_name, reply.calls, created))
        if is_chat:
            write_text(sock, sse_finish_event(id, ctx.model_name, finish, created))
        elif is_native:
            write_text(sock, native_completion_sse_event("", [], true))
        else:
            write_text(sock, text_completion_sse_event(id, ctx.model_name, "", finish, created))
        if include_usage and not is_native:
            if is_chat:
                write_text(sock, sse_usage_event(id, ctx.model_name, prompt_tokens.length, completion_tokens, created))
            else:
                write_text(sock, text_completion_usage_sse_event(id, ctx.model_name, prompt_tokens.length, completion_tokens, created))
        if not is_native:
            write_text(sock, sse_done_event())
        response_state = 2
    else:
        if is_chat:
            if wants_chat_logprobs:
                respond_json(sock, 200, "OK", completion_json_r_logprobs(id, ctx.model_name, reply, final_reasoning, finish, prompt_tokens.length, completion_tokens, created, reply_logprob_tokens, reply_logprob_bytes, reply_logprobs, reply_top_logprobs))
            else:
                respond_json(sock, 200, "OK", completion_json_r(id, ctx.model_name, reply, final_reasoning, finish, prompt_tokens.length, completion_tokens, created))
        elif is_native:
            let native_stop_type = if hit_eos: "eos" elif stopped or stopped_full: "word" else: "limit"
            if wants_native_logprobs:
                respond_json(sock, 200, "OK", native_completion_json_logprobs(ctx.model_name, reply.content, reply_tokens, true, native_stop_type, prompt_tokens.length, completion_tokens, reuse, reply_logprob_tokens, reply_logprobs, reply_logprob_bytes, reply_top_logprobs))
            else:
                respond_json(sock, 200, "OK", native_completion_json(ctx.model_name, reply.content, reply_tokens, true, native_stop_type, prompt_tokens.length, completion_tokens, reuse))
        else:
            if wants_completion_logprobs:
                respond_json(sock, 200, "OK", text_completion_json_logprobs(id, ctx.model_name, reply.content, finish, prompt_tokens.length, completion_tokens, created, reply_logprob_tokens, reply_logprobs, reply_top_logprobs))
            else:
                respond_json(sock, 200, "OK", text_completion_json(id, ctx.model_name, reply.content, finish, prompt_tokens.length, completion_tokens, created))
    # `cur` covers cur.pos tokens: every token that was fed through the model
    # (the final EOS, or the token that completed a stop string, is sampled but
    # never fed back).
    let covered = tokens[0..<cur.pos]
    let fresh = CacheSlot(cur, covered, counter)
    mut [CacheSlot] out = []
    for sl in slots:
        out.push(sl)
    # Placement: a slot that is a prefix of this conversation is extended in
    # place; one that already covers it is kept as is; a diverging prompt gets
    # its own slot (the old branch may come back), evicting the least recently
    # used one when all slots are taken.
    if best >= 0 and reuse > 0:
        let shared = common_prefix_len(slots[best].tokens, covered)
        if shared == slots[best].tokens.length:
            out[best] = fresh
            return out
        if shared == covered.length:
            out[best] = CacheSlot(slots[best].cache, slots[best].tokens, counter)
            return out
    if out.length < ctx.cache_slots:
        out.push(fresh)
    else:
        var int lru = 0
        var int k = 1
        while k < out.length:
            if out[k].used < out[lru].used:
                lru = k
            k += 1
        out[lru] = fresh
    out

# llama-server exposes this lightweight companion to chat completions.  It
# runs the exact same normalization and embedded chat template as generation,
# but never touches the GPU or the prompt cache.
[CacheSlot] handle_input_tokens(ServerCtx& ctx, var TcpStream sock, string body_text, [CacheSlot] slots) throws:
    let parsed = try? json_parse(body_text)
    guard let body = parsed else:
        respond_json(sock, 400, "Bad Request", error_json("request body is not valid JSON", "invalid_request_error", "invalid_json"))
        return slots
    let invalid_shape = request_shape_error(body)
    if invalid_shape != "":
        let code = if invalid_shape.startsWith("`messages` is required"): "missing_messages" else: "invalid_request"
        respond_json(sock, 400, "Bad Request", error_json(invalid_shape, "invalid_request_error", code))
        return slots
    let raw_tools = json_get_list(body, "tools")
    let invalid_choice = tool_choice_validation_error(body, raw_tools)
    if invalid_choice != "":
        respond_json(sock, 400, "Bad Request", error_json(invalid_choice, "invalid_request_error", "invalid_tool_choice"))
        return slots
    let messages = normalize_messages(json_get_list(body, "messages"))
    if messages.length == 0:
        respond_json(sock, 400, "Bad Request", error_json("`messages` is required and must be a non-empty array", "invalid_request_error", "missing_messages"))
        return slots
    let tools = tools_for_request(body, raw_tools)
    let prompt_tokens = render_chat_prompt_messages_kw(ctx.file, ctx.tok, messages, tools, true, chat_template_variables(body))
    respond_json(sock, 200, "OK", input_tokens_json(prompt_tokens.length))
    slots

[CacheSlot] handle_tokenize(ServerCtx& ctx, var TcpStream sock, string body_text, [CacheSlot] slots) throws:
    let parsed = try? json_parse(body_text)
    guard let body = parsed else:
        respond_json(sock, 400, "Bad Request", error_json("request body is not valid JSON", "invalid_request_error", "invalid_json"))
        return slots
    let content_value = json_get(body, "content")
    guard jv_is_str(content_value) else:
        respond_json(sock, 400, "Bad Request", error_json("`content` is required and must be a string", "invalid_request_error", "missing_content"))
        return slots
    let content = json_get_str(body, "content", "")
    let parse_special = json_get_bool(body, "parse_special", true)
    mut [int] ids = if parse_special: ctx.tok.encode_with_specials(content) else: ctx.tok.encode(content)
    if json_get_bool(body, "add_special", false):
        mut [int] with_bos = [ctx.tok.bos_token_id]
        for id in ids:
            with_bos.push(id)
        ids = with_bos
    if json_get_bool(body, "with_pieces", false):
        respond_json(sock, 200, "OK", tokens_with_pieces_json(ctx.tok, ids))
    else:
        respond_json(sock, 200, "OK", tokens_json(ids))
    slots

[CacheSlot] handle_detokenize(ServerCtx& ctx, var TcpStream sock, string body_text, [CacheSlot] slots) throws:
    let parsed = try? json_parse(body_text)
    guard let body = parsed else:
        respond_json(sock, 400, "Bad Request", error_json("request body is not valid JSON", "invalid_request_error", "invalid_json"))
        return slots
    mut [int] ids = []
    let raw = json_get(body, "tokens")
    match raw:
        JList(items):
            for item in items:
                match item:
                    JInt(id):
                        if id < 0 or id >= ctx.model.config.vocab_size:
                            respond_json(sock, 400, "Bad Request", error_json("token id {id} is outside the vocabulary", "invalid_request_error", "invalid_token"))
                            return slots
                        ids.push(id)
                    _:
                        respond_json(sock, 400, "Bad Request", error_json("`tokens` must contain only integer token ids", "invalid_request_error", "invalid_tokens"))
                        return slots
        _:
            respond_json(sock, 400, "Bad Request", error_json("`tokens` is required and must be an array", "invalid_request_error", "missing_tokens"))
            return slots
    respond_json(sock, 200, "OK", content_json(ctx.tok.decode(ids)))
    slots

[CacheSlot] handle_apply_template(ServerCtx& ctx, var TcpStream sock, string body_text, [CacheSlot] slots) throws:
    let parsed = try? json_parse(body_text)
    guard let body = parsed else:
        respond_json(sock, 400, "Bad Request", error_json("request body is not valid JSON", "invalid_request_error", "invalid_json"))
        return slots
    let invalid_shape = request_shape_error(body)
    if invalid_shape != "":
        let code = if invalid_shape.startsWith("`messages` is required"): "missing_messages" else: "invalid_request"
        respond_json(sock, 400, "Bad Request", error_json(invalid_shape, "invalid_request_error", code))
        return slots
    let raw_tools = json_get_list(body, "tools")
    let invalid_choice = tool_choice_validation_error(body, raw_tools)
    if invalid_choice != "":
        respond_json(sock, 400, "Bad Request", error_json(invalid_choice, "invalid_request_error", "invalid_tool_choice"))
        return slots
    let messages = normalize_messages(json_get_list(body, "messages"))
    if messages.length == 0:
        respond_json(sock, 400, "Bad Request", error_json("`messages` is required and must be a non-empty array", "invalid_request_error", "missing_messages"))
        return slots
    let tools = tools_for_request(body, raw_tools)
    let add_generation_prompt = json_get_bool(body, "add_generation_prompt", true)
    let prompt = render_chat_prompt_text_messages_kw(ctx.file, ctx.tok, messages, tools, add_generation_prompt, chat_template_variables(body))
    respond_json(sock, 200, "OK", prompt_json(prompt))
    slots

[CacheSlot] handle_request(ServerCtx& ctx, var TcpStream sock, int counter, [CacheSlot] slots, [DiskSnap] disk) throws:
    let r = read_http_request(sock)
    print "[serve] {r.method} {r.path}"
    let path = r.path.split("?")[0]
    if r.method == "OPTIONS":
        respond(sock, 204, "No Content", "text/plain", "")
    elif r.method == "GET" and (path == "/v1/models" or path == "/models"):
        let arch = gguf_get_string(ctx.file.metadata, "general.architecture") else ""
        let n_ctx_train = gguf_get_int(ctx.file.metadata, "{arch}.context_length") else 0
        let vocab_type = if ctx.tok.is_spm: 1 else: 2
        respond_json(sock, 200, "OK", models_json_meta(ctx.model_name, vocab_type,
                     ctx.model.config.vocab_size, ctx.max_ctx, n_ctx_train,
                     ctx.model.config.d_model, gguf_parameter_count(ctx.file), ctx.file.file_size, unix_timestamp()))
    elif r.method == "GET" and (path == "/v1/models/{url_path_segment(ctx.model_name)}" or path == "/v1/models/{ctx.model_name}"):
        let arch = gguf_get_string(ctx.file.metadata, "general.architecture") else ""
        let n_ctx_train = gguf_get_int(ctx.file.metadata, "{arch}.context_length") else 0
        let vocab_type = if ctx.tok.is_spm: 1 else: 2
        respond_json(sock, 200, "OK", model_json_meta(ctx.model_name, vocab_type,
                     ctx.model.config.vocab_size, ctx.max_ctx, n_ctx_train,
                     ctx.model.config.d_model, gguf_parameter_count(ctx.file), ctx.file.file_size, unix_timestamp()))
    elif r.method == "GET" and (path == "/health" or path == "/v1/health" or path == "/"):
        respond_json(sock, 200, "OK", "{{\"status\": \"ok\"}}")
    elif r.method == "GET" and path == "/props":
        let template = gguf_get_string(ctx.file.metadata, "tokenizer.chat_template") else ""
        respond_json(sock, 200, "OK", props_json(ctx.model_path, template, ctx.max_ctx, ctx.cache_slots, ctx.default_max_tokens,
                     ctx.defaults.temperature, ctx.defaults.top_k, ctx.defaults.top_p, ctx.defaults.min_p, ctx.defaults.seed,
                     ctx.defaults.repeat_penalty, ctx.defaults.repeat_last_n))
    elif r.method == "POST" and path == "/props":
        respond_json(sock, 501, "Not Implemented", endpoint_not_supported_json("props"))
    elif r.method == "GET" and path == "/metrics":
        if ctx.metrics_enabled:
            respond(sock, 200, "OK", "text/plain; version=0.0.4", metrics_text(metric_prompt_tokens, metric_prompt_ms,
                    metric_predicted_tokens, metric_predicted_ms, metric_n_tokens_max))
        else:
            respond_json(sock, 501, "Not Implemented", endpoint_not_supported_json("metrics"))
    elif r.method == "GET" and path == "/slots":
        respond_json(sock, 200, "OK", slots_json(ctx.cache_slots, ctx.max_ctx))
    elif r.method == "POST" and (path == "/v1/chat/completions" or path == "/chat/completions"):
        return handle_completion(ctx, sock, r.body, counter, slots, disk, true, false)
    elif r.method == "POST" and path == "/v1/completions":
        return handle_completion(ctx, sock, r.body, counter, slots, disk, false, false)
    elif r.method == "POST" and (path == "/completion" or path == "/completions"):
        return handle_completion(ctx, sock, r.body, counter, slots, disk, false, true)
    elif r.method == "POST" and (path == "/v1/chat/completions/input_tokens" or path == "/chat/completions/input_tokens"):
        return handle_input_tokens(ctx, sock, r.body, slots)
    elif r.method == "POST" and path == "/tokenize":
        return handle_tokenize(ctx, sock, r.body, slots)
    elif r.method == "POST" and path == "/detokenize":
        return handle_detokenize(ctx, sock, r.body, slots)
    elif r.method == "POST" and path == "/apply-template":
        return handle_apply_template(ctx, sock, r.body, slots)
    else:
        respond_json(sock, 404, "Not Found", error_json("no route for {r.method} {r.path}", "invalid_request_error", "not_found"))
    slots

# After a request: write the cache it left to disk when cache_policy.br says so
# (enough new tokens, inside the size cap). Files the plan drops are deleted
# first. A failed save is logged, its half-written file removed, and the
# snapshot left out of the index.
[DiskSnap] maybe_save(ServerCtx& ctx, [CacheSlot] slots, int counter, [DiskSnap] disk):
    var int idx = -1
    var int i = 0
    while i < slots.length:
        if slots[i].used == counter:
            idx = i
        i += 1
    if idx < 0:
        return disk
    let s = slots[idx]
    let plan = plan_save(disk, s.tokens, ctx.cache_files, ctx.cache_bpt, ctx.cache_max_bytes)
    if not plan.save:
        return disk
    mut [DiskSnap] kept = []
    for d in disk:
        var bool dropped = d.slot == plan.slot
        for x in plan.drop:
            if d.slot == x:
                dropped = true
        if not dropped:
            kept.push(d)
    for x in plan.drop:
        delete_snapshot(ctx.cache_dir, x)
        print "[serve] prompt cache: dropped file {x} (size cap)"
    let started = Instant.now()
    try:
        save_snapshot(ctx.cache_dir, ctx.cache_fp, plan.slot, plan.seq, ctx.model, s.cache, s.tokens)
        kept.push(DiskSnap(plan.slot, plan.seq, s.tokens))
        let ms = started.elapsed().asMillis() as int
        print "[serve] prompt cache: saved {s.tokens.length} tokens to file {plan.slot} ({ms} ms)"
    catch:
        print "[serve] prompt cache: save failed: {error}"
        delete_snapshot(ctx.cache_dir, plan.slot)
    kept

# One connection, start to finish. The socket belongs to this function, so it
# is closed when it returns — before the caller spends time writing a snapshot.
[CacheSlot] serve_conn(ServerCtx& ctx, var TcpStream sock, int counter, [CacheSlot] slots, [DiskSnap] disk) throws:
    var [CacheSlot] out = slots
    try:
        out = handle_request(ctx, sock, counter, slots, disk)
    catch:
        print "[serve] request {counter} failed: {error}"
        if response_state == 0:
            let error_text = "{error}"
            if error_text.startsWith("http_400:"):
                let message = error_text.replace("http_400:", "")
                let sent = try? respond_json(sock, 400, "Bad Request", error_json(message, "invalid_request_error", "malformed_http_request"))
            elif error_text.startsWith("http_413:"):
                let message = error_text.replace("http_413:", "")
                let sent = try? respond_json(sock, 413, "Content Too Large", error_json(message, "invalid_request_error", "request_too_large"))
            elif error_text.startsWith("http_431:"):
                let message = error_text.replace("http_431:", "")
                let sent = try? respond_json(sock, 431, "Request Header Fields Too Large", error_json(message, "invalid_request_error", "headers_too_large"))
            else:
                let sent = try? respond_json(sock, 500, "Internal Server Error", error_json(error_text, "server_error", "internal_error"))
        elif response_state == 1:
            # a stream is open (or the client left): end it with an error event
            let sent = try? write_text(sock, "{sse_error_event(error)}{sse_done_event()}")
    out

# One request at a time, forever. A failure inside a request (bad socket,
# generation error) is reported to the client when possible and logged, but
# never takes the server down. `disk0` is what the prompt cache directory held
# at startup.
pub def serve(ServerCtx& ctx, int port, [DiskSnap] disk0) throws:
    let listener = try? TcpListener.bind("127.0.0.1:{port}")
    guard let listener else throw "could not bind 127.0.0.1:{port} (port already in use?)"
    print "[serve] model '{ctx.model_name}' ready — listening on http://127.0.0.1:{port}/v1 (context {ctx.max_ctx} tokens, {ctx.cache_slots} prompt-cache slots)"
    var int counter = 0
    var [CacheSlot] slots = []
    var [DiskSnap] disk = disk0
    metric_prompt_tokens = 0
    metric_prompt_ms = 0
    metric_predicted_tokens = 0
    metric_predicted_ms = 0
    metric_n_tokens_max = 0
    for conn in listener.incoming():
        let c = try? conn
        guard let c else:
            print "[serve] accept failed"
            continue
        var sock = c
        counter += 1
        response_state = 0
        slots = serve_conn(ctx, sock, counter, slots, disk)
        if ctx.cache_dir != "":
            disk = maybe_save(ctx, slots, counter, disk)
