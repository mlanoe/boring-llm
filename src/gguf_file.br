# boring-llm — reading a GGUF from disk without holding it in memory.
#
# parse_gguf (gguf.br) takes the whole file as one `[uint8]`. For a real model
# that meant 2-3 copies of the file alive at once (the buffer read from disk,
# the copy stored in GgufFile, transient clones during parsing): a 2.1 GB 3B
# model peaked at ~13 GB of physical memory on a 16 GB machine, which swaps and
# freezes it, and a 7B model could not have loaded at all. Here only the header
# (metadata + tensor table, ~7 MB for Qwen2.5) is read and parsed; each tensor's
# bytes are then read straight from the file when the loader asks for them, so
# the peak is one tensor, not the model.
#
# Kept apart from gguf.br because it calls Rust's `std::fs` (`File`): gguf.br
# and io.br are also run by the interpreter tests, which cannot call external
# Rust types.

use gguf
use io
use std.fs.File
use std.io.Read
use std.io.Seek
use std.io.SeekFrom

# `n` bytes at absolute offset `off`, read from the file into a fresh exact-size buffer.
pub [uint8] read_at(string path, int off, int n) throws:
    guard off >= 0 and n >= 0 else throw "invalid read: {n} bytes at offset {off} of {path}"
    let opened = try? File.open(path)
    guard let opened else throw "cannot open {path}"
    mut f = opened
    let sought = try? f.seek(SeekFrom.Start(off as uint64))
    guard let sought else throw "cannot seek to {off} in {path}"
    mut [uint8] buf = [0 as uint8 for i in 0..<n]
    let r = try? f.read_exact(buf)
    guard let r else throw "short read: {n} bytes at offset {off} of {path}"
    buf

pub int file_len(string path) throws:
    let f = try? File.open(path)
    guard let f else throw "cannot open {path}"
    let m = try? f.metadata()
    guard let m else throw "cannot stat {path}"
    m.len() as int

# A header (metadata + tensor table) larger than this is not a model: stop
# rather than read a multi-gigabyte file into memory looking for its end.
let int GGUF_MAX_HEADER_BYTES = 1073741824

# Parses the header of the GGUF at `path`. The header is read as a prefix of the
# file, grown (x4) only while parse_gguf reports that the prefix was cut short:
# any other error (bad magic, corrupt table) is final at the first read.
GgufFile parse_gguf_single_path(string path) throws:
    let size = file_len(path)
    var int prefix = 16777216
    while true:
        let n = if prefix < size: prefix else: size
        let head = read_at(path, 0, n)
        var string failure = ""
        var [GgufFile] parsed = []
        try:
            parsed.push(parse_gguf(head))
        catch:
            failure = "{error}"
        if parsed.length > 0:
            let g = parsed[0]
            return GgufFile(g.version, g.metadata, g.tensors, g.data_offset, [], path, size, [], [])
        guard n < size and gguf_error_is_truncation(failure) else throw "{failure}"
        guard n < GGUF_MAX_HEADER_BYTES else throw "GGUF: header of {path} is larger than {GGUF_MAX_HEADER_BYTES} bytes"
        prefix = prefix * 4
    throw "unreachable"

pub GgufFile parse_gguf_path(string path) throws:
    let first = parse_gguf_single_path(path)
    let split_count = gguf_get_int(first.metadata, "split.count") else 1
    if split_count <= 1:
        return first
    guard let supplied_no = gguf_get_int(first.metadata, "split.no") else throw "GGUF split: missing split.no"
    guard supplied_no >= 0 and supplied_no < split_count else throw "GGUF split: invalid split.no {supplied_no} for {split_count} files"
    let first_path = split_shard_path(path, 0)
    guard first_path != "" else throw "GGUF split: expected a name like model-00001-of-00002.gguf"
    mut [string] paths = []
    mut [GgufFile] parts = []
    var int shard = 0
    while shard < split_count:
        let shard_path = split_shard_path(path, shard)
        let part = if shard == supplied_no: first else: parse_gguf_single_path(shard_path)
        guard let part_no = gguf_get_int(part.metadata, "split.no") else throw "GGUF split: {shard_path} has no split.no"
        guard let part_count = gguf_get_int(part.metadata, "split.count") else throw "GGUF split: {shard_path} has no split.count"
        guard part_no == shard and part_count == split_count else throw "GGUF split: inconsistent metadata in {shard_path}"
        paths.push(shard_path)
        parts.push(part)
        shard += 1
    merge_gguf_shards(parts, paths)

# `n` bytes of tensor data at absolute file offset `start`: from disk when the
# file was opened by path, from the in-memory copy otherwise.
pub [uint8] file_bytes(GgufFile file, int start, int n) throws:
    # a tensor table is only as trustworthy as its file: never allocate or read past the end
    guard n >= 0 and start >= 0 and n <= file.file_size and start <= file.file_size - n else throw "GGUF: tensor data ({n} bytes at offset {start}) lies outside the file ({file.file_size} bytes)"
    if file.shard_paths.length > 0:
        mut [uint8] out = []
        var int position = start
        var int remaining = n
        while remaining > 0:
            let shard = virtual_shard_index(file.shard_starts, position)
            guard shard >= 0 else throw "GGUF split: read starts before the first shard"
            let shard_end = if shard + 1 < file.shard_paths.length: file.shard_starts[shard + 1] else: file.file_size
            let available = shard_end - position
            let take = if remaining < available: remaining else: available
            let chunk = read_at(file.shard_paths[shard], position - file.shard_starts[shard], take)
            for byte in chunk:
                out.push(byte)
            position += take
            remaining -= take
        out
    elif file.path != "":
        read_at(file.path, start, n)
    else:
        read_bytes(file.bytes, start, n)
