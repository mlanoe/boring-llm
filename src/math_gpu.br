# IQ4_XS and IQ4_NL (codebook formats): same kernel shapes as the Q4_x / Q5_x ones above.

kernel IQ4XSLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_byte = (flat_idx / 256) * 136
                let off = flat_idx % 256
                let ib = off / 32
                let within = off % 32
                let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
                let sh = int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8)
                let low = (int(w_packed[block_byte + 4 + ib / 2]) >> (4 * (ib % 2))) & 0xF
                let high = (sh >> (2 * ib)) & 3
                let dl = w_d * (((low | (high << 4)) - 32) as float32)
                let q = int(w_packed[block_byte + 8 + ib * 16 + (within % 16)])
                let nib = if within < 16: q & 0xF else: (q >> 4) & 0xF
                let wv = dl * (iq4nl_value(nib) as float32)
                tile_w[width = tx, height = ty] = wv
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified iq4xs_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "iq4xs_linear_gpu: d_in ({d_in}) must be a multiple of 256"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = IQ4XSLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

kernel IQ4XSLinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            let n_units = d_in / 32
            var int unit = lane
            while unit < n_units:
                # one lane per 32-element sub-block of a 256-element superblock
                let blocks_per_row = d_in / 256
                let ib = unit % 8
                let bb = (col * blocks_per_row + unit / 8) * 136
                let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
                let sh = int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8)
                let low = (int(w_packed[bb + 4 + ib / 2]) >> (4 * (ib % 2))) & 0xF
                let high = (sh >> (2 * ib)) & 3
                let dl = w_d * (((low | (high << 4)) - 32) as float32)
                let xb = row * d_in + unit * 32
                var float32 dot = 0.0
                for j in 0..<16:
                    let q = int(w_packed[bb + 8 + ib * 16 + j])
                    dot += x[xb + j] * (iq4nl_value(q & 0xF) as float32) + x[xb + 16 + j] * (iq4nl_value((q >> 4) & 0xF) as float32)
                partial += dl * dot
                unit += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified iq4xs_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "iq4xs_linear_warp_gpu: d_in ({d_in}) must be a multiple of 256"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = IQ4XSLinearWarpKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

kernel IQ4NLULinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            let n_units = d_in / 32
            var int unit = lane
            while unit < n_units:
                # one lane per 32-element block (layout of Q4_0, codebook values)
                let bb = (col * n_units + unit) * 18
                let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
                let xb = row * d_in + unit * 32
                var float32 dot = 0.0
                for j in 0..<16:
                    let byte_val = int(w_packed[bb + 2 + j])
                    dot += x[xb + j] * (iq4nl_value(byte_val & 0xF) as float32) + x[xb + 16 + j] * (iq4nl_value((byte_val >> 4) & 0xF) as float32)
                partial += w_d * dot
                unit += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified iq4nlu_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "iq4nlu_linear_warp_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
