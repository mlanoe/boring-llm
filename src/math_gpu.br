# src/math_gpu.br — GPU-accelerated transformer math (Phase 2a): tiled GEMM,
# RMSNorm, RoPE, GQA attention, SwiGLU — fp32 throughout (dequantization
# still happens on the CPU at load time in this phase; Phase 2b fuses it
# into the GEMM kernel itself instead).
#
# Adapted from whisper-boring/src/math_gpu.br's kernel-design pattern
# (transpose/LinearKernel/MatMulBTHeadsKernel/SoftmaxRowsKernel/
# MatMulHeadsKernel), generalized in two ways that project didn't need:
#   - float32 instead of float64 throughout (real GPUs are far faster at
#     fp32, and quantized-weight inference is a fp32-native domain in
#     practice — whisper-boring's f64 choice was inherited from its CPU
#     math.br default, not a deliberate GPU-precision decision).
#   - grouped-query attention: n_head query heads share n_kv_head key/value
#     heads (kv_h = h / (n_head / n_kv_head)), since Qwen2 (like most modern
#     GGUF-family models) uses GQA, unlike whisper-boring's plain MHA.
#
# Build targets:
#   boring build --target metal   # primary, actively verified
#   boring build --target cuda / rocm / wgpu   # same qualified source, unverified
#
# Interpreter simulation (sequential, for development):
#   boring run test/test_math_gpu.br
# NOTE: The inline RoPE kernel's `.powf()` call is currently NOT verifiable this way
# — a real boring interpreter bug (kernel-body `.powf()` errors under
# simulation but is correct in a real compiled build, filed as
# task_cc223e5c) — so RoPE is verified via a real `--target metal` build
# instead (see test/test_forward_gpu.br's doc comment).

use math
use io

# Identity function used purely as a workaround for a real boring transpiler
# bug (filed as task_63a8da7f): a GPU host-function parameter passed
# directly to a `kernel` struct constructor needs an explicit `'global`
# qualifier or its Rust element type gets silently mis-inferred as f64
# instead of f32 — but once a parameter IS `'global`-qualified, chaining
# another GPU call's `[float32]'kernel'unified` result straight into it emits
# an extra, wrongly-typed `&` at the call site (`expected Vec<f32>, found
# &Vec<f32>`). Routing the value through this ordinary (non-kernel-touching)
# function first forces the correct by-value host materialization — the
# same "one level of indirection infers correctly" pattern that already
# made `linear_nobias_gpu` (which never constructs a kernel directly) work
# without needing this at all. Every kernel-chaining call site in
# model.br's `forward_gpu` uses this on its GPU-resident argument.
[float32] passthrough([float32] x):
    x

# ── Kernel: matrix transpose ──────────────────────────────────────────────
# Same as whisper-boring's transpose kernel (see its doc comment for the
# memory-coalescing rationale), float32 instead of float64.

pub req [float32]'kernel'unified transpose_gpu([float32]'kernel'global src, int rows, int cols) throws:
    let int n_cells = rows * cols
    let int blocks  = (n_cells + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [float32, col, row]'unified dst = [0.0 for col = rows, row = cols]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let cell = .thread.x + block_idx * .block_dim.x
        if cell < rows * cols:
            let i = cell / cols
            let j = cell % cols
            dst[col = i, row = j] = src[cell]
        dst

# ── Kernel: linear layer (y = x·Wᵀ + b) ────────────────────────────────────
# `w` is read in GGUF's own native (d_out × d_in) tensor layout directly —
# each output row is a contiguous d_in-length dot-product vector, matching
# math.br's CPU `linear`/`linear_bias` exactly, so no pre-transpose step is
# needed at load time (unlike whisper-boring's LinearKernel, which requires
# a caller-side pre-transpose to (d_in × d_out) for a coalesced tile load —
# a real perf difference deferred here in favor of matching GGUF's layout
# directly, since Phase 2b's fused-dequant kernel will need its own
# tile-loading logic over raw quantized bytes regardless, making the
# pre-transpose optimization moot for that kernel anyway). Bias is always
# present here (callers with no real bias pass a zero-filled array —
# linear_nobias_gpu below does this for them) rather than a second no-bias
# kernel variant.

kernel LinearKernel:
    let [float32]'global  x         # (seq × d_in)
    let [float32]'global  w         # (d_out × d_in) — GGUF's native layout
    let [float32]'global  bv        # (d_out,)
    mut [float32]'unified y         # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [float32]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x     = xi
        w     = wi
        bv    = bi
        seq   = s
        d_in  = din
        d_out = dout
        y     = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                tile_w[width = tx, height = ty] = w[col * d_in + w_row]
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified linear_gpu([float32]'kernel'global x, [float32]'kernel'global w, [float32]'kernel'global bv,
                       int seq, int d_in, int d_out) throws:
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = LinearKernel(x, w, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified linear_nobias_gpu([float32] x, [float32] w,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    linear_gpu(x, w, zero_bias, seq, d_in, d_out)

# ── Kernel: linear layer, warp-shuffle reduction (Phase 4 stretch) ───────
# `LinearKernel` above (and `Q8LinearKernel`) reduce over `d_in` through
# `'actor` shared-memory tiles plus a full BLOCK barrier (`sync`) at every
# 16-wide step — correct, but every one of those barriers is block-wide
# even for the parts of the reduction that are, in this design, actually
# confined to far fewer threads (see boring/docs/warp-level-primitives.md's
# own "Problem Statement", which names this exact kernel shape as the
# motivating case for `.warp.*`).
#
# This kernel takes a genuinely different approach instead of retrofitting
# the tiled design: ONE WARP computes ONE output cell — each of the warp's
# `.warp.size` lanes strides over `d_in` (stride = warp size) computing
# a partial dot-product sum, then a standard warp-shuffle butterfly
# reduction (`shuffle_xor` at descending powers-of-two offsets, the classic
# warp-reduce idiom) combines all lanes' partial sums with ZERO shared
# memory and ZERO block-wide barriers — only `.warp.*`'s own implicit
# lockstep guarantee, which needs no barrier instruction at all on real
# hardware. Verified against `linear_gpu`'s own (tiled, shared-memory)
# output — see test/test_math_gpu_real.br.
#
# Not a wholesale replacement for `linear_gpu`/`q8_linear_gpu` in this
# project's own model.br (that would be a separate, riskier change to
# every call site in an already fully-verified pipeline) — added
# alongside them as a second, independently-verified implementation of the
# same operation, which is what this Phase 4 stretch item's own plan entry
# asked for: demonstrate + verify the primitive on this project's real
# GEMM shape, not necessarily migrate the whole project to it.
#
# HONEST PERFORMANCE RESULT (test/bench_linear_warp.br, real Metal
# hardware, this model's actual dimensions): this kernel is SLOWER than
# `linear_gpu`, not faster — at d_in=896/d_out=896/seq=26 (~1.5x slower),
# and the gap widens at LM-head scale, d_in=896/d_out=8192/seq=26 (~2.4x
# slower). Root cause: removing the barrier was never this workload's
# bottleneck — `linear_gpu`'s shared-memory tile is a genuine DATA-REUSE
# mechanism (each `x`/`w` element loaded from global memory once, reused
# by every thread in the 16x16 block), which this kernel has none of —
# every warp independently re-reads its own full `x` row and `w` row from
# global memory with zero cross-warp sharing, so far more redundant global
# memory bandwidth is spent than barriers were ever costing. Same lesson
# already learned the hard way with this project's own KV-cache work
# (model.br's `prefill_gpu_quantized`): always measure wall-clock at this
# project's real sizes before assuming an optimization helps — algorithmic
# "fewer barriers" doesn't automatically mean "faster" once memory reuse
# is the actual bottleneck. A design that keeps the tiled shared-memory
# structure AND uses `.warp.*` only for the final in-tile reduction
# (rather than replacing tiling outright) would need a tile shape aligned
# to warp boundaries — this kernel's simpler "one warp, one output, no
# shared memory at all" approach was chosen to unambiguously demonstrate
# and verify the primitive itself first; a properly warp-aligned tiled
# hybrid is a real, distinct follow-up, not attempted here.

kernel LinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [float32]'global  w                # (d_out × d_in) — GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [float32]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w               = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                partial += x[row * d_in + i] * w[col * d_in + i]
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified linear_warp_gpu([float32]'kernel'global x, [float32]'kernel'global w,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = LinearWarpKernel(x, w, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Kernel: linear layer, warp-shuffle reduction + shared x-row cache
# (Phase 4 stretch, follow-up to LinearWarpKernel above) ────────────────
# `LinearWarpKernel`'s own doc comment diagnosed its actual bottleneck:
# not the barriers it removed, but that every warp independently re-reads
# its full `x` row and `w` row from global memory with zero cross-warp
# sharing — and named "a design that keeps the tiled shared-memory
# structure AND uses .warp.* only for the final in-tile reduction" as
# the real, distinct follow-up. This kernel is that follow-up, scoped to
# the axis of reuse that's actually free to exploit here: within one grid
# block, every warp computes a DIFFERENT output COLUMN for the SAME output
# ROW (one block = one fixed `row`, `warps_per_block` columns) — so `x`'s
# row is identical across all warps in a block and is read from global
# memory into a shared `'actor` cache ONCE per block (a single cooperative
# load + one `sync`), instead of once per warp. `w` has no equivalent
# reuse to exploit here (each warp's column is a distinct `w` row) and
# stays a plain global read, same as `LinearWarpKernel`.
#
# `cached_x`'s size is a fixed compile-time constant (`[float32, 8192]'actor`, MSL
# `threadgroup` memory must be sized at kernel-authoring time here, same
# as `LinearKernel`'s own fixed 16x16 tiles) — large enough to cover every
# real `d_in` this project's own models actually use (Qwen2.5:
# d_model=896/ffn=4864; TinyLlama: d_model=2048/ffn=5632); `linear_warp_shared_gpu`
# below throws rather than silently truncating if a future model exceeds it.
#
# HONEST PERFORMANCE RESULT (test/bench_linear_warp.br, real Metal
# hardware, 4 shapes x 3 kernels): the explicit shared x-row cache this
# kernel adds over plain `linear_warp_gpu` never wins — tied at best
# (d_out=896, seq=1: both ~0.31s/200 iters) and measurably WORSE at every
# other shape tried (d_out=896 seq=26: 1.21s vs. warp's 1.17s; d_out=8192
# seq=26: 3.72s vs. 3.73s, a wash; d_out=8192 seq=1: 1.49s vs. warp's
# 1.34s, ~11% worse). Confirms the hypothesis in this kernel's own header
# comment: the cooperative load + extra `sync` this design adds is pure
# overhead here — Apple Silicon's L1/L2 already absorbs the cross-warp
# same-row reuse `LinearWarpKernel` was "missing" (`x`'s row is at most
# ~22KB for this project's real `d_in` values, comfortably cache-resident),
# so there was nothing left for explicit shared-memory caching to win.
# **Not adopted** — same conclusion as `LinearWarpKernel` itself, added
# purely as a second, honestly-benchmarked data point.
#
# The benchmark expansion this kernel motivated (adding the seq=1
# decode-step shape, previously untested) surfaced a real, separate,
# useful finding about the EXISTING `linear_warp_gpu`, though: it beats
# plain `linear_gpu` at seq=1 by a real margin (d_out=896: 0.31s vs.
# 0.55s, ~1.8x faster; d_out=8192: 1.34s vs. 1.84s, ~1.4x faster) — the
# opposite of the seq=26 prefill-shape conclusion `LinearWarpKernel`'s own
# header comment already documents. Since seq=1 (single-token decode) is
# this project's actual dominant workload once `--kv-cache` is in use,
# this is a genuine, real optimization opportunity for `model.br`'s hot
# path — not pursued in this pass (it would need a Q8_0-fused warp-shuffle
# variant, since real generation runs on quantized weights, not plain
# fp32 `linear_warp_gpu`) but worth flagging as a concrete follow-up.

let int LINEAR_WARP_SHARED_MAX_D_IN = 8192

kernel LinearWarpSharedKernel:
    let [float32]'global  x                # (seq × d_in)
    let [float32]'global  w                # (d_out × d_in) — GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block
    mut [float32, 8192]'actor cached_x

    init([float32]'global xi, [float32]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w               = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let row = .block.y
        let col = .block.x * warps_per_block + warp_in_block

        let tid_in_block = .thread.x + .thread.y * .block_dim.x
        let threads_per_block = .block_dim.x * .block_dim.y
        if row < seq:
            var int i = tid_in_block
            while i < d_in:
                cached_x[i] = x[row * d_in + i]
                i += threads_per_block
        sync

        if row < seq and col < d_out:
            var float32 partial = 0.0
            var int k = lane
            while k < d_in:
                partial += cached_x[k] * w[col * d_in + k]
                k += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified linear_warp_shared_gpu([float32]'kernel'global x, [float32]'kernel'global w,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in <= LINEAR_WARP_SHARED_MAX_D_IN else throw "linear_warp_shared_gpu: d_in {d_in} exceeds the fixed shared-cache size {LINEAR_WARP_SHARED_MAX_D_IN}"
    let int warps_per_block = 8
    let int gx = (d_out + warps_per_block - 1) / warps_per_block
    let int gy = seq
    mut k = LinearWarpSharedKernel(x, w, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Kernel: Q8_0 fused-dequant linear layer (Phase 2b) ───────────────────
# Same 16x16-tiled GEMM as LinearKernel, but `w` arrives as RAW Q8_0-packed
# bytes (GGUF's block_q8_0: 2-byte f16 scale + 32 signed int8 values per
# block, 34 bytes/block, QK8_0=32 — see quant.br's CPU dequantize_q8_0,
# which this mirrors) instead of an already-dequantized `[float32]` array.
# Each thread's tile-load step dequantizes its own (row, col) weight element
# on the fly instead of the caller ever materializing a full fp32 copy of
# the weight matrix — the whole point of fusing dequant into the kernel:
# for the LM head alone (151936 x 896), a pre-dequantized fp32 copy would
# be ~544MB versus the packed Q8_0 bytes' ~146MB.
#
# Requires d_in % 32 == 0 (every real GGUF Q8_0 tensor's row length is a
# multiple of the block size in practice — Qwen2.5-0.5B's every relevant
# dimension, 896/128/4864, divides evenly).
#
# The dequantization logic below is inlined directly into the kernel's
# `def ()` body (its tile-load step) rather than factored into a helper —
# two independent real Metal-backend bugs (both filed as tasks) block every
# other way of factoring it out: a kernel struct's own HELPER method (`def
# <T> name(...)`) mis-emits both bare and `self.`-prefixed field reads
# (task — generated MSL never dereferences the field's pointer parameter,
# unlike the main `def ()` body, where the identical access pattern works
# correctly); and a plain FREE function taking a `[T]'global`-qualified
# array parameter, called from a kernel body, emits an MSL pointer
# parameter with no address-space qualifier (task_25840979 — a real MSL
# shader-compile error, not a `cargo build` error). Only scalar-only free
# functions (e.g. `f16_bits_to_f32`, no array params) are safe to factor
# out and call from a kernel body today.

kernel Q8LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q8_0-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                # Dequantize element (col, w_row) of the (d_out × d_in)
                # logical weight matrix directly from the packed Q8_0
                # bytes — col*d_in+w_row is the same flat index the F32
                # case would use, just block-quantized in place.
                let flat_idx = col * d_in + w_row
                let block_idx = flat_idx / 32
                let offset_in_block = flat_idx % 32
                let block_byte = block_idx * 34
                let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                let w_scale = f16_bits_to_f32(scale_bits)
                let raw = int(w_packed[block_byte + 2 + offset_in_block])
                # Split across three statements — see math_gpu.br's earlier
                # note on task_bd2c95ab / task_1b6aa1d3, the two real parser/
                # cast bugs this dodges.
                let q = if raw > 127: raw - 256 else: raw
                let qf = q as float32
                tile_w[width = tx, height = ty] = qf * w_scale
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q8_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q8_linear_gpu: d_in ({d_in}) must be a multiple of 32"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q8LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q8_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q8_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: Q8_0 fused-dequant linear layer, warp-shuffle reduction ──────
# The real follow-up flagged in `linear_warp_shared_gpu`'s own doc comment
# above: `bench_linear_warp.br`'s expansion to the seq=1 decode-step shape
# found plain `linear_warp_gpu` beats the tiled `linear_gpu` by ~1.4-1.8x
# there, but real generation never calls either of those fp32 kernels —
# `model.br`'s actual per-token decode path runs on quantized weights via
# `Q8LinearKernel`/`fused_linear_gpu`. This kernel is the fused-dequant
# analogue of `LinearWarpKernel`: one warp per output cell, each lane
# strides over `d_in` by `.warp.size` (32) accumulating its own partial
# dot product, then a shuffle_xor butterfly combines the warp's partials —
# same as `LinearWarpKernel`, except each lane's own stride element is
# dequantized on the fly straight from the packed Q8_0 bytes (identical
# per-element dequant math to `Q8LinearKernel`'s tile-load step) instead
# of being read from a pre-dequantized fp32 array.
#
# A convenient alignment, not a coincidence to design around: Q8_0's own
# block size (32 values) equals the warp size (32) this project's target
# hardware uses, so every stride round has all 32 lanes of a warp jointly
# decoding EXACTLY one shared Q8_0 block (each lane its own element,
# `offset_in_block == lane`) — no lane ever spans a block boundary
# mid-round, and no cross-lane dependency beyond the final reduction.
#
# Same dequant-inlining constraint as `Q8LinearKernel` (see its own doc
# comment) — the two real Metal-backend bugs blocking a factored-out
# helper apply here identically, so the block/scale/dequant arithmetic is
# inlined directly in the loop body again rather than shared via a call.
#
# HONEST PERFORMANCE RESULT (test/bench_linear_warp.br, real Metal
# hardware): the OPPOSITE of the fp32 case this kernel was built to
# follow up on — `linear_warp_gpu` beat `linear_gpu` at seq=1, but
# `q8_linear_warp_gpu` LOSES to `q8_linear_gpu` at every shape tried,
# including seq=1 (d_out=896: 0.99s vs. 0.90s/200 iters, ~10% slower;
# d_out=8192: 4.13s vs. 3.67s, ~12% slower), and dramatically so at
# seq=26 (d_out=8192: 30.2s vs. 4.6s — ~6.6x slower). The per-element
# dequant work (reading a byte-granular global load per lane, plus every
# lane in a warp redundantly re-reading the SAME 2-byte scale header) is
# real extra cost this kernel pays every stride round that the fp32
# `LinearWarpKernel` never had to, and it outweighs the barrier-removal
# benefit that won in the fp32 case — likely made worse by Metal's byte-
# granular global loads coalescing far less efficiently than `Q8LinearKernel`'s
# cooperative, shared-memory tile load of the same bytes. **Not adopted**:
# `model.br`'s real decode path keeps using `Q8LinearKernel`/`fused_linear_gpu`.
# Verified correct regardless (`test/test_math_gpu_real.br`) — kept as a
# third honestly-benchmarked kernel variant, same spirit as
# `LinearWarpKernel`/`LinearWarpSharedKernel` above.

kernel Q8LinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in) Q8_0-packed, GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                let flat_idx = col * d_in + i
                let q8_block = flat_idx / 32
                let offset_in_block = flat_idx % 32
                let block_byte = q8_block * 34
                let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                let w_scale = f16_bits_to_f32(scale_bits)
                let raw = int(w_packed[block_byte + 2 + offset_in_block])
                let q = if raw > 127: raw - 256 else: raw
                let qf = q as float32
                partial += x[row * d_in + i] * (qf * w_scale)
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q8_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q8_linear_warp_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q8LinearWarpKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Kernel: Q8_0 fused-dequant linear layer, warp-shuffle reduction +
# scale-broadcast (follow-up to Q8LinearWarpKernel above) ────────────────
# `Q8LinearWarpKernel`'s own doc comment diagnosed its actual bottleneck:
# a byte-granular global load per lane every stride round, PLUS every lane
# in the warp redundantly re-reading the SAME 2-byte f16 scale header —
# real, wasted memory traffic `Q8LinearKernel`'s cooperative shared-memory
# tile load never pays. This kernel targets exactly that second cost,
# leaving the first (the per-element byte-granular quantized-value load,
# inherent to reading packed sub-byte data at all) untouched: since Q8_0's
# block size (32) equals this hardware's warp size, every stride round has
# all 32 lanes decoding one shared block (`offset_in_block == lane`,
# `block_idx` identical across the whole warp — the same alignment
# `Q8LinearWarpKernel`'s own comment already names), so only ONE lane
# needs to actually read+decode the block's scale header — lane 0 does it,
# then `.warp.shuffle(w_scale, 0)` broadcasts the decoded f32 value to
# every other lane in the warp via a register-to-register shuffle instead
# of 31 redundant global-memory reads. The quantized-value read itself is
# unavoidably per-lane (each lane needs its own distinct byte) and stays
# unchanged from `Q8LinearWarpKernel`.
#
# HONEST PERFORMANCE RESULT (test/bench_linear_warp.br, real Metal
# hardware): the first warp-shuffle variant in this project's whole
# investigation to actually beat the tiled kernel it was built to
# challenge — at seq=1 (decode-step shape), ~20-33% faster than
# `q8_linear_gpu` (d_out=896: ~0.6-0.9s vs. ~0.9-1.4s/200 iters; d_out=8192:
# ~3.1s vs. ~4.6-5.0s), consistent across repeated runs. Still loses badly
# at prefill shapes (seq=26) — d_out=8192: ~17-18s vs. `q8_linear_gpu`'s
# ~5-6s — the tiled kernel's shared-memory data reuse across many rows
# still dominates once seq>1, same conclusion every earlier warp-shuffle
# variant reached for that shape. **Adopted for the decode case only**:
# `fused_linear_gpu` below dispatches Q8_0 to this kernel when `seq == 1`
# and to `q8_linear_gpu` otherwise, so `model.br`'s real per-token decode
# path (every call after the initial prompt prefill) now runs measurably
# faster while prefill is unaffected.
kernel Q8LinearWarpBroadcastKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in) Q8_0-packed, GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                # flat_idx = col*d_in + i is the same flat index every other
                # fused kernel uses. d_in % 32 == 0 and i steps by warp size
                # (32) starting at `lane`, so col*d_in + i is always a
                # multiple of 32 plus `lane` — flat_idx/32 (this row's own
                # block within this round) is the SAME value for every lane
                # in the warp, and flat_idx%32 == lane always.
                let flat_idx = col * d_in + i
                let q8_block = flat_idx / 32
                let block_byte = q8_block * 34
                var float32 w_scale = 0.0
                if lane == 0:
                    let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                    w_scale = f16_bits_to_f32(scale_bits)
                w_scale = .warp.shuffle(w_scale, 0)
                let raw = int(w_packed[block_byte + 2 + lane])
                let q = if raw > 127: raw - 256 else: raw
                let qf = q as float32
                partial += x[row * d_in + i] * (qf * w_scale)
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q8_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q8_linear_warp_broadcast_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q8LinearWarpBroadcastKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Kernel: Q5_0 fused-dequant linear layer ──────────────────────────────
# Same 16x16-tiled GEMM shape as Q8LinearKernel, weight arrives as raw
# Q5_0-packed bytes (GGUF's block_q5_0: 2-byte f16 scale `d` + 4-byte `qh`
# high-bit field + 16 bytes `qs` 4-bit-nibble low bits, 22 bytes/block,
# QK5_0=32 — mirrors quant.br's CPU dequantize_q5_0 element-for-element).
# Dequant logic inlined directly in the tile-load step, same reason as
# Q8LinearKernel's own comment: a kernel-body helper method or a
# free-function call taking an array parameter both mis-emit on the Metal
# backend (tasks filed for both) — only scalar-only free functions are
# safe to factor out from a kernel body.
kernel Q5LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q5_0-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_idx = flat_idx / 32
                let offset_in_block = flat_idx % 32
                let block_byte = block_idx * 22
                let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                let w_scale = f16_bits_to_f32(scale_bits)
                let qh_base = block_byte + 2
                let qh = int(w_packed[qh_base]) | (int(w_packed[qh_base + 1]) << 8) | (int(w_packed[qh_base + 2]) << 16) | (int(w_packed[qh_base + 3]) << 24)
                let qs_base = block_byte + 6
                let j = if offset_in_block < 16: offset_in_block else: offset_in_block - 16
                let byte_val = int(w_packed[qs_base + j])
                let nib = if offset_in_block < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let hbit_shift = if offset_in_block < 16: j else: j + 16
                let hbit = (qh >> hbit_shift) & 1
                let qv = (nib | (hbit << 4)) - 16
                let qf = qv as float32
                tile_w[width = tx, height = ty] = qf * w_scale
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q5_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q5_linear_gpu: d_in ({d_in}) must be a multiple of 32"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q5LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q5_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q5_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: Q5_0 fused-dequant linear layer, warp-shuffle + scale/qh
# broadcast (same follow-up idea as Q8LinearWarpBroadcastKernel above) ────
# Q5_0's block size (32) equals this hardware's warp size, same alignment
# `Q8LinearWarpBroadcastKernel`'s own doc comment relies on: every stride
# round has all 32 lanes jointly decoding one shared block. Q5_0 has TWO
# per-block fields every lane would otherwise redundantly re-read — the
# 2-byte f16 scale AND the 4-byte `qh` high-bit field — so lane 0 reads and
# decodes both, then broadcasts each via its own `.warp.shuffle(_, 0)`
# call. `qh`'s broadcast depends on a real `boring` Metal-backend fix
# (`task_a374ff68`: `.warp.shuffle` on a boring `int` used to fail to
# compile — Metal's `simd_shuffle` intrinsic rejects 64-bit integer types,
# which is what boring's `int` transpiles to on Metal — fixed upstream by
# round-tripping the shuffled value through `int32_t` internally; verified
# fixed and reinstalled before restoring this). The per-lane `qs` nibble
# read (and the bit-shift picking this lane's own bit out of the broadcast
# `qh`) stays per-lane, same reasoning as Q8_0's unavoidable per-lane
# quantized-value read.
##
# Also verified on `--target wgpu`: shuffling two differently-typed values
# (`w_scale`, a `float32`, and `qh`, an `int`) in the same kernel body used
# to break wgpu's warp-shuffle emulation (its one scratch buffer per kernel
# was typed from only the first shuffled value) — fixed upstream (`boring`
# commit `3823ed77`) by tracking each shuffled local's own real type
# instead of defaulting to the first one seen; verified fixed and
# reinstalled before confirming both `w_scale` and `qh` round-trip
# correctly on real wgpu hardware too.
kernel Q5LinearWarpBroadcastKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in) Q5_0-packed, GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                let flat_idx = col * d_in + i
                let q5_block = flat_idx / 32
                let block_byte = q5_block * 22
                var float32 w_scale = 0.0
                var int qh = 0
                if lane == 0:
                    let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                    w_scale = f16_bits_to_f32(scale_bits)
                    let qh_base = block_byte + 2
                    qh = int(w_packed[qh_base]) | (int(w_packed[qh_base + 1]) << 8) | (int(w_packed[qh_base + 2]) << 16) | (int(w_packed[qh_base + 3]) << 24)
                w_scale = .warp.shuffle(w_scale, 0)
                qh = .warp.shuffle(qh, 0)
                let qs_base = block_byte + 6
                let j = if lane < 16: lane else: lane - 16
                let byte_val = int(w_packed[qs_base + j])
                let nib = if lane < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let hbit_shift = if lane < 16: j else: j + 16
                let hbit = (qh >> hbit_shift) & 1
                let qv = (nib | (hbit << 4)) - 16
                let qf = qv as float32
                partial += x[row * d_in + i] * (qf * w_scale)
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q5_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q5_linear_warp_broadcast_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q5LinearWarpBroadcastKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Kernel: Q6_K fused-dequant linear layer ──────────────────────────────
# Same 16x16-tiled GEMM shape as Q8LinearKernel/Q5LinearKernel, weight
# arrives as raw Q6_K-packed bytes (GGUF's block_q6_K superblock: 256
# elements/superblock, 210 bytes — 128 bytes `ql` low-nibbles + 64 bytes
# `qh` high-2-bits + 16 bytes signed int8 `scales` (one per 16-element
# sub-block) + 2-byte f16 super-block scale `d`). Re-derives, for a single
# arbitrary flat element index, exactly which sub-block/nibble/high-bits it
# falls in — the inverse of quant.br's CPU dequantize_q6_k, which instead
# walks every element of a superblock in its own nested-loop order. Both
# must agree element-for-element (verified in test/test_math_gpu_real.br).
# Dequant inlined directly in the tile-load step, same reason as
# Q8LinearKernel's/Q5LinearKernel's own comments (kernel-body helper
# methods and array-param free functions both mis-emit on the Metal
# backend today).
kernel Q6KLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q6_K-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let sb = flat_idx / 256
                let pos = flat_idx % 256
                let sb_start = sb * 210
                let n_iter = pos / 128
                let pos_in_iter = pos % 128
                let which4 = pos_in_iter / 32
                let l = pos_in_iter % 32
                let is0 = l / 16

                let ql_base = sb_start + n_iter * 64
                let qh_base = sb_start + 128 + n_iter * 32
                let sc_base = sb_start + 192 + n_iter * 8
                let d_bits = int(w_packed[sb_start + 208]) | (int(w_packed[sb_start + 209]) << 8)
                let d_scale = f16_bits_to_f32(d_bits)

                let qh_val = int(w_packed[qh_base + l])
                let ql_byte0 = int(w_packed[ql_base + l])
                let ql_byte32 = int(w_packed[ql_base + l + 32])

                let nib = if which4 == 0:
                    ql_byte0 & 0xF
                elif which4 == 1:
                    ql_byte32 & 0xF
                elif which4 == 2:
                    (ql_byte0 >> 4) & 0xF
                else:
                    (ql_byte32 >> 4) & 0xF
                let hi2 = if which4 == 0:
                    (qh_val >> 0) & 3
                elif which4 == 1:
                    (qh_val >> 2) & 3
                elif which4 == 2:
                    (qh_val >> 4) & 3
                else:
                    (qh_val >> 6) & 3
                let sc_off = which4 * 2
                let sc_raw = int(w_packed[sc_base + is0 + sc_off])
                let sc = if sc_raw > 127: sc_raw - 256 else: sc_raw
                let qv = (nib | (hi2 << 4)) - 32
                let wf = d_scale * (sc as float32) * (qv as float32)
                tile_w[width = tx, height = ty] = wf
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q6k_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "q6k_linear_gpu: d_in ({d_in}) must be a multiple of 256"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q6KLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q6k_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q6k_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: Q4_K fused-dequant linear layer ──────────────────────────────
# Same 16x16-tiled GEMM shape as the other fused kernels above, weight
# arrives as raw Q4_K-packed bytes (GGUF's block_q4_K superblock: 256
# elements/superblock, 144 bytes — 2-byte f16 super-block scale `d` +
# 2-byte f16 super-block min `dmin` + 12 bytes `scales` (8 sub-block
# scales + 8 sub-block mins, 6 bits each, ggml's own packed encoding) +
# 128 bytes `qs` 4-bit nibbles). Unlike Q6_K, every element needs BOTH a
# per-sub-block scale AND min (`d*scale*nibble - dmin*min` — the min is
# what lets a 4-bit *unsigned* nibble represent a range not centered on
# zero). The `sc`/`mn` extraction below re-derives quant.br's
# `get_scale_min_k4` bit-for-bit for a single arbitrary sub-block index
# `j` (0..7) — inlined rather than called as a helper, same reason as
# every other fused kernel here (array-param free functions and
# kernel-body helper methods both mis-emit on the Metal backend today).
kernel Q4KLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q4_K-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let sb = flat_idx / 256
                let pos = flat_idx % 256
                let sb_start = sb * 144
                let chunk = pos / 64
                let pos_in_chunk = pos % 64
                let half = pos_in_chunk / 32
                let l = pos_in_chunk % 32
                let j = chunk * 2 + half

                let d_bits = int(w_packed[sb_start]) | (int(w_packed[sb_start + 1]) << 8)
                let d_scale = f16_bits_to_f32(d_bits)
                let dmin_bits = int(w_packed[sb_start + 2]) | (int(w_packed[sb_start + 3]) << 8)
                let d_min = f16_bits_to_f32(dmin_bits)
                let scales_base = sb_start + 4
                let qs_base = sb_start + 16 + chunk * 32

                let sc = if j < 4:
                    int(w_packed[scales_base + j]) & 63
                else:
                    (int(w_packed[scales_base + j + 4]) & 0xF) | ((int(w_packed[scales_base + j - 4]) >> 6) << 4)
                let mn = if j < 4:
                    int(w_packed[scales_base + j + 4]) & 63
                else:
                    (int(w_packed[scales_base + j + 4]) >> 4) | ((int(w_packed[scales_base + j]) >> 6) << 4)

                let byte_val = int(w_packed[qs_base + l])
                let nib = if half == 0:
                    byte_val & 0xF
                else:
                    (byte_val >> 4) & 0xF

                let wf = d_scale * (sc as float32) * (nib as float32) - d_min * (mn as float32)
                tile_w[width = tx, height = ty] = wf
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q4k_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "q4k_linear_gpu: d_in ({d_in}) must be a multiple of 256"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q4KLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q4k_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q4k_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: Q4_0 fused-dequant linear layer ──────────────────────────────
# Same 16x16-tiled GEMM shape as the other fused kernels above, weight
# arrives as raw Q4_0-packed bytes (GGUF's block_q4_0: 2-byte f16 scale `d`
# + 16 bytes `qs` 4-bit unsigned nibbles, 2 values/byte, low nibble first,
# 18 bytes/block, QK4_0=32 — mirrors quant.br's CPU dequantize_q4_0
# element-for-element). Reconstructed value is the nibble offset by -8
# (symmetric around 0, no separate min) then scaled by `d` — the simplest
# of the fused kernels here, same shape as Q5LinearKernel's own but with no
# `qh` high-bit field to unpack. Dequant inlined directly in the tile-load
# step, same reason as every other fused kernel here (kernel-body helper
# methods and array-param free functions both mis-emit on the Metal
# backend today).
kernel Q4LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q4_0-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_idx = flat_idx / 32
                let offset_in_block = flat_idx % 32
                let block_byte = block_idx * 18
                let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                let w_scale = f16_bits_to_f32(scale_bits)
                let qs_base = block_byte + 2
                let j = if offset_in_block < 16: offset_in_block else: offset_in_block - 16
                let byte_val = int(w_packed[qs_base + j])
                let nib = if offset_in_block < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let qv = nib - 8
                let qf = qv as float32
                tile_w[width = tx, height = ty] = qf * w_scale
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q4_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q4_linear_gpu: d_in ({d_in}) must be a multiple of 32"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q4LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q4_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q4_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: Q4_0 fused-dequant linear layer, warp-shuffle + scale
# broadcast (same follow-up idea as Q8LinearWarpBroadcastKernel above) ────
# Q4_0's block size (32) equals this hardware's warp size, same alignment
# every other warp-broadcast kernel here relies on. Simplest of the three
# broadcast variants: Q4_0 has only the one per-block field (the 2-byte f16
# scale, no `qh`/codebook to also broadcast), so lane 0 reads+decodes it
# and broadcasts via `.warp.shuffle`; the per-lane nibble read stays
# per-lane, same reasoning as every other fused kernel's unavoidable
# per-lane quantized-value read.
kernel Q4LinearWarpBroadcastKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in) Q4_0-packed, GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                let flat_idx = col * d_in + i
                let q4_block = flat_idx / 32
                let block_byte = q4_block * 18
                var float32 w_scale = 0.0
                if lane == 0:
                    let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                    w_scale = f16_bits_to_f32(scale_bits)
                w_scale = .warp.shuffle(w_scale, 0)
                let qs_base = block_byte + 2
                let j = if lane < 16: lane else: lane - 16
                let byte_val = int(w_packed[qs_base + j])
                let nib = if lane < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let qv = nib - 8
                let qf = qv as float32
                partial += x[row * d_in + i] * (qf * w_scale)
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q4_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q4_linear_warp_broadcast_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q4LinearWarpBroadcastKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Kernel: Q2_K fused-dequant linear layer ──────────────────────────────
# Same 16x16-tiled GEMM shape as Q4K/Q6K above, weight arrives as raw
# Q2_K-packed bytes (GGUF's block_q2_K superblock: 256 elements/superblock,
# 84 bytes — 16 bytes `scales` (one byte per 16-element sub-block, low
# nibble = 4-bit scale, high nibble = 4-bit min) + 64 bytes `qs` (2-bit
# values, 4/byte) + 2-byte f16 super-block scale `d` + 2-byte f16
# super-block min `dmin`). For a single arbitrary flat element index, this
# re-derives which of the 16 sub-blocks (and which bit-shift within its
# packed 2-bit `qs` byte) it falls in — the inverse of quant.br's CPU
# dequantize_q2_k, which instead walks every element of a superblock in its
# own nested-loop order (2 halves × 4 sub-block-pairs × 16 elements); both
# must agree element-for-element (verified in test/test_math_gpu_real.br).
# Dequant inlined directly in the tile-load step, same reason as every
# other fused kernel here.
kernel Q2KLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q2_K-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let sb = flat_idx / 256
                let pos = flat_idx % 256
                let sb_start = sb * 84
                # (outer, j, sub, l) is the inverse of the CPU loop's
                # half/j/sub0-or-sub1/l nesting: pos == outer*128 + j*32 +
                # sub*16 + l.
                let outer = pos / 128
                let rem = pos % 128
                let j = rem / 32
                let l32 = rem % 32
                let sub = l32 / 16
                let l = l32 % 16

                let scales_base = sb_start
                let qs_base = sb_start + 16
                let d_bits = int(w_packed[sb_start + 80]) | (int(w_packed[sb_start + 81]) << 8)
                let d_scale = f16_bits_to_f32(d_bits)
                let dmin_bits = int(w_packed[sb_start + 82]) | (int(w_packed[sb_start + 83]) << 8)
                let d_min = f16_bits_to_f32(dmin_bits)

                let scale_idx = outer * 8 + j * 2 + sub
                let sc_byte = int(w_packed[scales_base + scale_idx])
                let dl = d_scale * ((sc_byte & 0xF) as float32)
                let ml = d_min * ((sc_byte >> 4) as float32)

                let q_base = qs_base + outer * 32
                let shift = j * 2
                let byte_pos = q_base + sub * 16 + l
                let qv = (int(w_packed[byte_pos]) >> shift) & 3

                let wf = dl * (qv as float32) - ml
                tile_w[width = tx, height = ty] = wf
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q2k_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "q2k_linear_gpu: d_in ({d_in}) must be a multiple of 256"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q2KLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q2k_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q2k_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: Q3_K fused-dequant linear layer ──────────────────────────────
# Same 16x16-tiled GEMM shape as the other superblock kernels above, weight
# arrives as raw Q3_K-packed bytes (GGUF's block_q3_K superblock: 256
# elements/superblock, 110 bytes — 32 bytes `hmask` (high 3rd bit, 1
# bit/element) + 64 bytes `qs` (low 2 bits, 4/byte) + 12 bytes packed
# `scales` (16 signed 6-bit sub-block scales) + 2-byte f16 super-block
# scale `d`). Uses the same (outer, j, sub, l) flat-index decomposition as
# Q2KLinearKernel above for the `qs`/`hmask` bit position and sub-block
# index, and re-derives quant.br's `q3k_unpack_scales` bit-twiddling
# (`kmask1`/`kmask2`) inline for the single scale index this element needs
# — kernel bodies can't call the array-param/array-return helper directly
# (same constraint as every other fused kernel here), so all 12 scale bytes
# are re-read and re-decoded per element rather than cached. Verified
# element-for-element against quant.br's CPU dequantize_q3_k in
# test/test_math_gpu_real.br.
kernel Q3KLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) Q3_K-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let sb = flat_idx / 256
                let pos = flat_idx % 256
                let sb_start = sb * 110
                let outer = pos / 128
                let rem = pos % 128
                let j = rem / 32
                let l32 = rem % 32
                let sub = l32 / 16
                let l = l32 % 16

                let hmask_base = sb_start
                let qs_base = sb_start + 32
                let scales_base = sb_start + 96
                let d_bits = int(w_packed[sb_start + 108]) | (int(w_packed[sb_start + 109]) << 8)
                let d_all = f16_bits_to_f32(d_bits)

                let a0 = int(w_packed[scales_base])
                let a1 = int(w_packed[scales_base + 1])
                let a2 = int(w_packed[scales_base + 2])
                let a3 = int(w_packed[scales_base + 3])
                let aux0_in = a0 | (a1 << 8) | (a2 << 16) | (a3 << 24)
                let b0 = int(w_packed[scales_base + 4])
                let b1 = int(w_packed[scales_base + 5])
                let b2 = int(w_packed[scales_base + 6])
                let b3 = int(w_packed[scales_base + 7])
                let aux1_in = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
                let c0 = int(w_packed[scales_base + 8])
                let c1 = int(w_packed[scales_base + 9])
                let c2 = int(w_packed[scales_base + 10])
                let c3 = int(w_packed[scales_base + 11])
                let tmp = c0 | (c1 << 8) | (c2 << 16) | (c3 << 24)
                let kmask1 = 0x03030303
                let kmask2 = 0x0f0f0f0f

                let scale_idx = outer * 8 + j * 2 + sub
                let sw = scale_idx / 4
                let sbp = scale_idx % 4
                let word = if sw == 0:
                    (aux0_in & kmask2) | (((tmp >> 0) & kmask1) << 4)
                elif sw == 1:
                    (aux1_in & kmask2) | (((tmp >> 2) & kmask1) << 4)
                elif sw == 2:
                    ((aux0_in >> 4) & kmask2) | (((tmp >> 4) & kmask1) << 4)
                else:
                    ((aux1_in >> 4) & kmask2) | (((tmp >> 6) & kmask1) << 4)
                let raw = (word >> (8 * sbp)) & 0xFF
                let sc = if raw > 127: raw - 256 else: raw
                let dl = d_all * ((sc - 32) as float32)

                let q_base = qs_base + outer * 32
                let shift = j * 2
                let byte_pos = q_base + sub * 16 + l
                let qv = (int(w_packed[byte_pos]) >> shift) & 3

                # Routed through a `let int one = 1` rather than written
                # inline (`1 << ...`) — a real wgpu-backend quirk: WGSL's
                # abstract-int literal type inference can't concretize a
                # bare `1` as the left operand of a variable left-shift
                # (even after the shift-amount-to-u32 auto-cast lands);
                # binding it to an `int`-typed local first forces
                # concretization before the shift. Harmless on Metal/CUDA/
                # ROCm. Not yet filed as its own task — narrower than
                # task_23fdd781 and not yet hit by anything else in this
                # file, worth revisiting if it turns up again elsewhere.
                let int one = 1
                let m = one << (outer * 4 + j)
                let hmask_byte_pos = hmask_base + sub * 16 + l
                let hbit = int(w_packed[hmask_byte_pos]) & m
                let hi_off = if hbit != 0: 0 else: 4

                let wf = dl * ((qv - hi_off) as float32)
                tile_w[width = tx, height = ty] = wf
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q3k_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "q3k_linear_gpu: d_in ({d_in}) must be a multiple of 256"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q3KLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q3k_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q3k_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: IQ4_NL fused-dequant linear layer ────────────────────────────
# Same 16x16-tiled GEMM shape and block size as Q4LinearKernel above (GGUF's
# block_iq4_nl: 2-byte f16 scale `d` + 16 bytes `qs` 4-bit nibbles, 18
# bytes/block, QK4_NL=32 — mirrors quant.br's CPU dequantize_iq4_nl
# element-for-element), but the 4-bit value is a CODEBOOK INDEX rather than
# a linear offset — it looks up one of 16 fixed, non-linearly-spaced
# values (ggml's own `kvalues_iq4nl` table) instead of computing
# `nibble - 8`. `dequantize_iq4_nl`'s CPU version holds that table as a
# `let [int]` local array, but this kernel inlines it as a 16-way
# if/elif chain instead of indexing a local array from inside the kernel
# body — an untested pattern here, unlike every other fused kernel's
# inline scalar arithmetic (already known-safe); the if/elif chain stays
# within the same "scalar-only logic inlined in the tile-load step"
# territory the other kernels already rely on.
kernel Q4NLLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in) IQ4_NL-packed, GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_idx = flat_idx / 32
                let offset_in_block = flat_idx % 32
                let block_byte = block_idx * 18
                let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                let w_scale = f16_bits_to_f32(scale_bits)
                let qs_base = block_byte + 2
                let j = if offset_in_block < 16: offset_in_block else: offset_in_block - 16
                let byte_val = int(w_packed[qs_base + j])
                let nib = if offset_in_block < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let cv = if nib == 0:
                    -127
                elif nib == 1:
                    -104
                elif nib == 2:
                    -83
                elif nib == 3:
                    -65
                elif nib == 4:
                    -49
                elif nib == 5:
                    -35
                elif nib == 6:
                    -22
                elif nib == 7:
                    -10
                elif nib == 8:
                    1
                elif nib == 9:
                    13
                elif nib == 10:
                    25
                elif nib == 11:
                    38
                elif nib == 12:
                    53
                elif nib == 13:
                    69
                elif nib == 14:
                    89
                else:
                    113
                let cf = cv as float32
                tile_w[width = tx, height = ty] = cf * w_scale
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q4nl_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q4nl_linear_gpu: d_in ({d_in}) must be a multiple of 32"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q4NLLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

pub req [float32]'kernel'unified q4nl_linear_nobias_gpu([float32] x, [uint8] w_packed,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    q4nl_linear_gpu(x, w_packed, zero_bias, seq, d_in, d_out)

# ── Kernel: IQ4_NL fused-dequant linear layer, warp-shuffle + scale
# broadcast (same follow-up idea as Q8LinearWarpBroadcastKernel above) ────
# IQ4_NL's block size (32) equals this hardware's warp size, same
# alignment every other warp-broadcast kernel here relies on. Same shape
# as `Q4LinearWarpBroadcastKernel` (one per-block field, the f16 scale, to
# broadcast) but with the codebook lookup in place of `nibble - 8` — same
# inline 16-way if/elif chain `Q4NLLinearKernel` above uses, for the same
# reason (indexing a local array from inside a kernel body is untested
# territory here, unlike inline scalar arithmetic).
kernel Q4NLLinearWarpBroadcastKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in) IQ4_NL-packed, GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                let flat_idx = col * d_in + i
                let q4nl_block = flat_idx / 32
                let block_byte = q4nl_block * 18
                var float32 w_scale = 0.0
                if lane == 0:
                    let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                    w_scale = f16_bits_to_f32(scale_bits)
                w_scale = .warp.shuffle(w_scale, 0)
                let qs_base = block_byte + 2
                let j = if lane < 16: lane else: lane - 16
                let byte_val = int(w_packed[qs_base + j])
                let nib = if lane < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let cv = if nib == 0:
                    -127
                elif nib == 1:
                    -104
                elif nib == 2:
                    -83
                elif nib == 3:
                    -65
                elif nib == 4:
                    -49
                elif nib == 5:
                    -35
                elif nib == 6:
                    -22
                elif nib == 7:
                    -10
                elif nib == 8:
                    1
                elif nib == 9:
                    13
                elif nib == 10:
                    25
                elif nib == 11:
                    38
                elif nib == 12:
                    53
                elif nib == 13:
                    69
                elif nib == 14:
                    89
                else:
                    113
                let cf = cv as float32
                partial += x[row * d_in + i] * (cf * w_scale)
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q4nl_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q4nl_linear_warp_broadcast_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q4NLLinearWarpBroadcastKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# ── Fused-dequant linear dispatch, by ggml type ──────────────────────────
# A real quantized GGUF file mixes formats across tensors (e.g. a typical
# "Q4_K_M" file: attention/FFN-gate/FFN-up projections in Q5_0, attn_v in
# Q8_0, ffn_down alternating Q4_K/Q6_K by layer — verified directly against
# a real downloaded Qwen2.5-0.5B-Instruct Q4_K_M file), so model.br's
# QuantLayer/QuantModel carry each weight's own ggml type tag alongside its
# packed bytes, and every linear-layer call site goes through this
# dispatcher instead of hardcoding q8_linear_gpu. ggml type ids match
# gguf.br's ggml_type_name (2=Q4_0, 6=Q5_0, 8=Q8_0, 10=Q2_K, 11=Q3_K,
# 12=Q4_K, 14=Q6_K, 20=IQ4_NL).
#
# Q8_0/Q5_0/Q4_0/IQ4_NL are additionally SHAPE-aware: each has a
# warp-shuffle-plus-broadcast counterpart (`q8_linear_warp_broadcast_gpu`
# was the first warp-shuffle GEMM variant in this project's whole
# investigation to actually beat the tiled kernel it was built to
# challenge — see its own doc comment above for why; the other three share
# the identical alignment, one warp decoding one shared block per stride
# round, since all four formats use a 32-element block matching this
# hardware's warp size) that wins at seq=1 (single-token decode, the
# dominant real workload once `--kv-cache` is in use) but still loses
# badly to the tiled kernel at prefill shapes (seq>1) — see
# test/bench_linear_warp.br's own real measurements. Q2_K/Q3_K/Q4_K/Q6_K's
# 256-element superblocks don't share this alignment (a 256-wide block
# spans 8 warps, not 1), so no analogous broadcast variant exists for them
# yet. Every real call site in model.br already passes its own true `seq`
# (1 for a decode step, the prompt/turn length for a prefill), so this
# dispatch needs no new parameter or a decode-specific entry point — it
# reads `seq` off the same call every other format's branch below ignores.
# ── Hand-written tiled linear kernels for Q4_1, Q5_1, Q5_K and unquantized F16 / BF16
# weights: one weight element decoded per thread per tile, the same shape as Q5LinearKernel.
# These formats have no native tensor schedule (see tensor_linear_gpu), so every
# row count, decode included, takes these kernels.

kernel Q41LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_byte = (flat_idx / 32) * 20
                let off = flat_idx % 32
                let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
                let w_m = f16_bits_to_f32_fast(int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8))
                let j = if off < 16: off else: off - 16
                let byte_val = int(w_packed[block_byte + 4 + j])
                let nib = if off < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let wv = (nib as float32) * w_d + w_m
                tile_w[width = tx, height = ty] = wv
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q41_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q41_linear_gpu: d_in ({d_in}) must be a multiple of 32"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q41LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

kernel Q51LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_byte = (flat_idx / 32) * 24
                let off = flat_idx % 32
                let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
                let w_m = f16_bits_to_f32_fast(int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8))
                let qh = int(w_packed[block_byte + 4]) | (int(w_packed[block_byte + 5]) << 8) | (int(w_packed[block_byte + 6]) << 16) | (int(w_packed[block_byte + 7]) << 24)
                let j = if off < 16: off else: off - 16
                let byte_val = int(w_packed[block_byte + 8 + j])
                let nib = if off < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
                let hbit = (qh >> off) & 1
                let wv = (((nib | (hbit << 4))) as float32) * w_d + w_m
                tile_w[width = tx, height = ty] = wv
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q51_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q51_linear_gpu: d_in ({d_in}) must be a multiple of 32"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q51LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

kernel Q5KLinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let block_byte = (flat_idx / 256) * 176
                let off = flat_idx % 256
                let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
                let w_dmin = f16_bits_to_f32_fast(int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8))
                let chunk = off / 64
                let within = off % 64
                let high_half = if within >= 32: 1 else: 0
                let l = within % 32
                let sub = chunk * 2 + high_half
                let sc_base = block_byte + 4
                var int sc = 0
                var int mn = 0
                if sub < 4:
                    sc = int(w_packed[sc_base + sub]) & 63
                    mn = int(w_packed[sc_base + sub + 4]) & 63
                else:
                    sc = (int(w_packed[sc_base + sub + 4]) & 0xF) | ((int(w_packed[sc_base + sub - 4]) >> 6) << 4)
                    mn = (int(w_packed[sc_base + sub + 4]) >> 4) | ((int(w_packed[sc_base + sub]) >> 6) << 4)
                let q = int(w_packed[block_byte + 48 + chunk * 32 + l])
                let nib = if high_half == 1: (q >> 4) & 0xF else: q & 0xF
                let hbit = (int(w_packed[block_byte + 16 + l]) >> sub) & 1
                let wv = w_d * (sc as float32) * ((nib + (hbit << 4)) as float32) - w_dmin * (mn as float32)
                tile_w[width = tx, height = ty] = wv
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified q5k_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "q5k_linear_gpu: d_in ({d_in}) must be a multiple of 256"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = Q5KLinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

kernel F16LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let wv = f16_bits_to_f32(int(w_packed[flat_idx * 2]) | (int(w_packed[flat_idx * 2 + 1]) << 8))
                tile_w[width = tx, height = ty] = wv
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified f16_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 1 == 0 else throw "f16_linear_gpu: d_in ({d_in}) must be a multiple of 1"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = F16LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

kernel BF16LinearKernel:
    let [float32]'global  x           # (seq × d_in)
    let [uint8]'global    w_packed    # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv          # (d_out,)
    mut [float32]'unified y           # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    mut [float32, width = 16, height = 16]'actor tile_x
    mut [float32, width = 16, height = 16]'actor tile_w

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout):
        x        = xi
        w_packed = wi
        bv       = bi
        seq      = s
        d_in     = din
        d_out    = dout
        y        = [0.0 for ..<s * dout]

    def ():
        let tx = .thread.x
        let ty = .thread.y
        let row = .block.y * .block_dim.y + ty
        let col = .block.x * .block_dim.x + tx
        var float32 acc = 0.0
        let num_tiles = (d_in + 15) / 16
        for t in 0..<num_tiles:
            let x_col = t * 16 + tx
            let w_row = t * 16 + ty
            if row < seq and x_col < d_in:
                tile_x[width = tx, height = ty] = x[row * d_in + x_col]
            else:
                tile_x[width = tx, height = ty] = 0.0
            if w_row < d_in and col < d_out:
                let flat_idx = col * d_in + w_row
                let wv = bf16_bits_to_f32(int(w_packed[flat_idx * 2]) | (int(w_packed[flat_idx * 2 + 1]) << 8))
                tile_w[width = tx, height = ty] = wv
            else:
                tile_w[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                acc += tile_x[width = kk, height = ty] * tile_w[width = tx, height = kk]
            sync
        if row < seq and col < d_out:
            y[row * d_out + col] = acc + bv[col]

pub req [float32]'kernel'unified bf16_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 1 == 0 else throw "bf16_linear_gpu: d_in ({d_in}) must be a multiple of 1"
    let int gx = (d_out + 15) / 16
    let int gy = (seq + 15) / 16
    mut k = BF16LinearKernel(x, w_packed, bv, seq, d_in, d_out)
    kernel:
        k(block = (16, 16), grid = (gx, gy))
    k.y

# Single-row (decode) variants: one warp per output cell, its lanes striding over d_in and
# reducing with shuffles; each lane decodes its own weight element (the tiled kernels above
# would leave 15 of 16 rows idle at seq == 1).

kernel F16LinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                let flat_idx = col * d_in + i
                let wv = f16_bits_to_f32(int(w_packed[flat_idx * 2]) | (int(w_packed[flat_idx * 2 + 1]) << 8))
                partial += x[row * d_in + i] * wv
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified f16_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 1 == 0 else throw "f16_linear_warp_gpu: d_in ({d_in}) must be a multiple of 1"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = F16LinearWarpKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

