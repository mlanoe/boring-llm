kernel Q50DequantKernel:
    let [uint8]'global    w_packed
    mut [float32]'unified out
    let int               n

    init([uint8]'global wi, int count):
        w_packed = wi
        n        = count
        out      = [0.0 for ..<count]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let flat_idx = .thread.x + block_idx * .block_dim.x
        if flat_idx < n:
            let block_byte = (flat_idx / 32) * 22
            let off = flat_idx % 32
            let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
            let qh = int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8) | (int(w_packed[block_byte + 4]) << 16) | (int(w_packed[block_byte + 5]) << 24)
            let j = if off < 16: off else: off - 16
            let byte_val = int(w_packed[block_byte + 6 + j])
            let nib = if off < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
            let hbit = (qh >> off) & 1
            let wv = (((nib | (hbit << 4)) - 16) as float32) * w_d
            out[flat_idx] = wv

pub req [float32]'kernel'unified q50_dequantize_gpu([uint8]'kernel'global w_packed, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q50DequantKernel(w_packed, n)
    kernel:
        k(block = 256, grid = (gx, gy))
