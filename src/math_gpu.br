# Q4_1 / Q5_1 / Q5_K single-row (decode) kernels: one warp per output cell, each lane owning whole
# 32-element blocks (Q5_K: sub-blocks), so a lane's loads are independent of the other lanes'. Scale and
# minimum are applied once per block: sum(w*x) = d * sum(q*x) + m * sum(x). (A version where all
# lanes decode one block jointly and lane 0 broadcasts its header was ~4x slower.)

kernel Q41LinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            let n_units = d_in / 32
            var int unit = lane
            while unit < n_units:
                # one lane per 32-element block: no shuffles, independent loads
                let bb = (col * n_units + unit) * 20
                let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
                let w_m = f16_bits_to_f32_fast(int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8))
                let xb = row * d_in + unit * 32
                var float32 dot = 0.0
                var float32 sx = 0.0
                for j in 0..<16:
                    let byte_val = int(w_packed[bb + 4 + j])
                    let xl = x[xb + j]
                    let xh = x[xb + 16 + j]
                    dot += xl * ((byte_val & 0xF) as float32) + xh * (((byte_val >> 4) & 0xF) as float32)
                    sx += xl + xh
                partial += w_d * dot + w_m * sx
                unit += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q41_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q41_linear_warp_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q41LinearWarpKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

kernel Q51LinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            let n_units = d_in / 32
            var int unit = lane
            while unit < n_units:
                # one lane per 32-element block: no shuffles, independent loads
                let bb = (col * n_units + unit) * 24
                let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
                let w_m = f16_bits_to_f32_fast(int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8))
                let qh = int(w_packed[bb + 4]) | (int(w_packed[bb + 5]) << 8) | (int(w_packed[bb + 6]) << 16) | (int(w_packed[bb + 7]) << 24)
                let xb = row * d_in + unit * 32
                var float32 dot = 0.0
                var float32 sx = 0.0
                for j in 0..<16:
                    let byte_val = int(w_packed[bb + 8 + j])
                    let xl = x[xb + j]
                    let xh = x[xb + 16 + j]
                    let lo = (byte_val & 0xF) | (((qh >> j) & 1) << 4)
                    let hi = ((byte_val >> 4) & 0xF) | (((qh >> (j + 16)) & 1) << 4)
                    dot += xl * (lo as float32) + xh * (hi as float32)
                    sx += xl + xh
                partial += w_d * dot + w_m * sx
                unit += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q51_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "q51_linear_warp_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q51LinearWarpKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

kernel Q5KLinearWarpKernel:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            let n_units = d_in / 32
            var int unit = lane
            while unit < n_units:
                # one lane per 32-element sub-block of a 256-element superblock
                let blocks_per_row = d_in / 256
                let sblock = unit / 8
                let sub = unit % 8
                let chunk = sub / 2
                let high_half = sub % 2
                let bb = (col * blocks_per_row + sblock) * 176
                let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
                let w_dmin = f16_bits_to_f32_fast(int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8))
                let sc_base = bb + 4
                var int sc = 0
                var int mn = 0
                if sub < 4:
                    sc = int(w_packed[sc_base + sub]) & 63
                    mn = int(w_packed[sc_base + sub + 4]) & 63
                else:
                    sc = (int(w_packed[sc_base + sub + 4]) & 0xF) | ((int(w_packed[sc_base + sub - 4]) >> 6) << 4)
                    mn = (int(w_packed[sc_base + sub + 4]) >> 4) | ((int(w_packed[sc_base + sub]) >> 6) << 4)
                let xb = row * d_in + unit * 32
                var float32 dot = 0.0
                var float32 sx = 0.0
                for l in 0..<32:
                    let q = int(w_packed[bb + 48 + chunk * 32 + l])
                    let nib = if high_half == 1: (q >> 4) & 0xF else: q & 0xF
                    let hbit = (int(w_packed[bb + 16 + l]) >> sub) & 1
                    let xv = x[xb + l]
                    dot += xv * ((nib + (hbit << 4)) as float32)
                    sx += xv
                partial += w_d * (sc as float32) * dot - w_dmin * (mn as float32) * sx
                unit += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified q5k_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % 256 == 0 else throw "q5k_linear_warp_gpu: d_in ({d_in}) must be a multiple of 256"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q5KLinearWarpKernel(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
    kernel:
        k(block = (32, warps_per_block), grid = (gx, gy))
    k.y

# Prefill for these formats: dequantize the matrix once into a float32 buffer, then run the
# float32 tiled matmul. Decoding inside the matmul's tile loads re-decodes every weight once per
# 16-row tile of the prompt (39x for a 613-token prompt).

kernel Q41DequantKernel:
    let [uint8]'global    w_packed
    mut [float32]'unified out
    let int               n

    init([uint8]'global wi, int count):
        w_packed = wi
        n        = count
        out      = [0.0 for ..<count]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let flat_idx = .thread.x + block_idx * .block_dim.x
        if flat_idx < n:
            let block_byte = (flat_idx / 32) * 20
            let off = flat_idx % 32
            let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
            let w_m = f16_bits_to_f32_fast(int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8))
            let j = if off < 16: off else: off - 16
            let byte_val = int(w_packed[block_byte + 4 + j])
            let nib = if off < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
            let wv = (nib as float32) * w_d + w_m
            out[flat_idx] = wv

pub req [float32]'kernel'unified q41_dequantize_gpu([uint8]'kernel'global w_packed, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q41DequantKernel(w_packed, n)
    kernel:
        k(block = 256, grid = (gx, gy))
    k.out

kernel Q51DequantKernel:
    let [uint8]'global    w_packed
    mut [float32]'unified out
    let int               n

    init([uint8]'global wi, int count):
        w_packed = wi
        n        = count
        out      = [0.0 for ..<count]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let flat_idx = .thread.x + block_idx * .block_dim.x
        if flat_idx < n:
            let block_byte = (flat_idx / 32) * 24
            let off = flat_idx % 32
            let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
            let w_m = f16_bits_to_f32_fast(int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8))
            let qh = int(w_packed[block_byte + 4]) | (int(w_packed[block_byte + 5]) << 8) | (int(w_packed[block_byte + 6]) << 16) | (int(w_packed[block_byte + 7]) << 24)
            let j = if off < 16: off else: off - 16
            let byte_val = int(w_packed[block_byte + 8 + j])
            let nib = if off < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
            let hbit = (qh >> off) & 1
            let wv = (((nib | (hbit << 4))) as float32) * w_d + w_m
            out[flat_idx] = wv

pub req [float32]'kernel'unified q51_dequantize_gpu([uint8]'kernel'global w_packed, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q51DequantKernel(w_packed, n)
    kernel:
        k(block = 256, grid = (gx, gy))
    k.out

kernel Q5KDequantKernel:
    let [uint8]'global    w_packed
    mut [float32]'unified out
    let int               n

    init([uint8]'global wi, int count):
        w_packed = wi
        n        = count
        out      = [0.0 for ..<count]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let flat_idx = .thread.x + block_idx * .block_dim.x
        if flat_idx < n:
            let block_byte = (flat_idx / 256) * 176
            let off = flat_idx % 256
            let w_d = f16_bits_to_f32_fast(int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8))
            let w_dmin = f16_bits_to_f32_fast(int(w_packed[block_byte + 2]) | (int(w_packed[block_byte + 3]) << 8))
            let chunk = off / 64
            let within = off % 64
            let high_half = if within >= 32: 1 else: 0
            let l = within % 32
            let sub = chunk * 2 + high_half
            let sc_base = block_byte + 4
            var int sc = 0
            var int mn = 0
            if sub < 4:
                sc = int(w_packed[sc_base + sub]) & 63
                mn = int(w_packed[sc_base + sub + 4]) & 63
            else:
                sc = (int(w_packed[sc_base + sub + 4]) & 0xF) | ((int(w_packed[sc_base + sub - 4]) >> 6) << 4)
                mn = (int(w_packed[sc_base + sub + 4]) >> 4) | ((int(w_packed[sc_base + sub]) >> 6) << 4)
            let q = int(w_packed[block_byte + 48 + chunk * 32 + l])
            let nib = if high_half == 1: (q >> 4) & 0xF else: q & 0xF
            let hbit = (int(w_packed[block_byte + 16 + l]) >> sub) & 1
            let wv = w_d * (sc as float32) * ((nib + (hbit << 4)) as float32) - w_dmin * (mn as float32)
            out[flat_idx] = wv

pub req [float32]'kernel'unified q5k_dequantize_gpu([uint8]'kernel'global w_packed, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    mut k = Q5KDequantKernel(w_packed, n)
    kernel:
        k(block = 256, grid = (gx, gy))
    k.out

