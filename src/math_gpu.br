                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    tiled_linear_gpu(x, w_packed, 23, bv, seq, d_in, d_out)

# ── Kernel: Q8_0 fused-dequant linear layer, warp-shuffle reduction ──────
# The real follow-up flagged in `linear_warp_shared_gpu`'s own doc comment
# above: `bench_linear_warp.br`'s expansion to the seq=1 decode-step shape
# found plain `linear_warp_gpu` beats the tiled `linear_gpu` by ~1.4-1.8x
# there, but real generation never calls either of those fp32 kernels —
# `model.br`'s actual per-token decode path runs on quantized weights via
# `Q8LinearKernel`/`fused_linear_gpu`. This kernel is the fused-dequant
# analogue of `LinearWarpKernel`: one warp per output cell, each lane
# strides over `d_in` by `.warp.size` (32) accumulating its own partial
# dot product, then a shuffle_xor butterfly combines the warp's partials —
# same as `LinearWarpKernel`, except each lane's own stride element is
# dequantized on the fly straight from the packed Q8_0 bytes (identical
# per-element dequant math to `Q8LinearKernel`'s tile-load step) instead
# of being read from a pre-dequantized fp32 array.
#
# A convenient alignment, not a coincidence to design around: Q8_0's own
# block size (32 values) equals the warp size (32) this project's target
# hardware uses, so every stride round has all 32 lanes of a warp jointly
# decoding EXACTLY one shared Q8_0 block (each lane its own element,
# `offset_in_block == lane`) — no lane ever spans a block boundary
# mid-round, and no cross-lane dependency beyond the final reduction.
#
# HONEST PERFORMANCE RESULT (test/bench_linear_warp.br, real Metal
# hardware): the OPPOSITE of the fp32 case this kernel was built to
# follow up on — `linear_warp_gpu` beat `linear_gpu` at seq=1, but
# `q8_linear_warp_gpu` LOSES to `q8_linear_gpu` at every shape tried,
# including seq=1 (d_out=896: 0.99s vs. 0.90s/200 iters, ~10% slower;
# d_out=8192: 4.13s vs. 3.67s, ~12% slower), and dramatically so at
# seq=26 (d_out=8192: 30.2s vs. 4.6s — ~6.6x slower). The per-element
# dequant work (reading a byte-granular global load per lane, plus every
# lane in a warp redundantly re-reading the SAME 2-byte scale header) is
# real extra cost this kernel pays every stride round that the fp32
# `LinearWarpKernel` never had to, and it outweighs the barrier-removal
# benefit that won in the fp32 case — likely made worse by Metal's byte-
# granular global loads coalescing far less efficiently than `Q8LinearKernel`'s
# cooperative, shared-memory tile load of the same bytes. **Not adopted**:
# `model.br`'s real decode path keeps using `Q8LinearKernel`/`fused_linear_gpu`.
# Verified correct regardless (`test/test_math_gpu_real.br`) — kept as a
# third honestly-benchmarked kernel variant, same spirit as
# `LinearWarpKernel`/`LinearWarpSharedKernel` above.

# One kernel for the warp-broadcast variants of the 32-element, f16-scale formats (Q8_0 = 8,
# Q5_0 = 6, Q4_0 = 2, IQ4_NL = 20; `FMT` is the GGUF type id and folds away at compile time). The
# block size equals the warp size, so every stride round has all 32 lanes decoding one shared
# block: lane 0 alone reads the f16 scale (and Q5_0's 4-byte `qh`) and broadcasts them with
# `.warp.shuffle`, instead of 32 redundant global reads. The per-lane quantized-value read is
# unavoidable and stays per-lane. Decode-step (seq = 1) kernel: ~20-33% faster than the tiled
# kernel there, much slower at prefill shapes (see `fused_linear_gpu`).
int bcast_block_bytes(int fmt):
    if fmt == 8:
        34
    elif fmt == 6:
        22
    else:
        18

# The unscaled value of this lane's element within the block starting at `block_byte`; `qh` is the
# broadcast Q5_0 high-bit field (unused by the other formats).
float32 bcast_unscaled([uint8]'global w_packed, int fmt, int block_byte, int lane, int qh):
    if fmt == 8:
        let raw = int(w_packed[block_byte + 2 + lane])
        let q = if raw > 127: raw - 256 else: raw
        q as float32
    else:
        let qs_base = block_byte + (if fmt == 6: 6 else: 2)
        let j = if lane < 16: lane else: lane - 16
        let byte_val = int(w_packed[qs_base + j])
        let nib = if lane < 16: byte_val & 0xF else: (byte_val >> 4) & 0xF
        if fmt == 6:
            let hbit_shift = if lane < 16: j else: j + 16
            let hbit = (qh >> hbit_shift) & 1
            ((nib | (hbit << 4)) - 16) as float32
        elif fmt == 2:
            (nib - 8) as float32
        else:
            iq4nl_value(nib) as float32

kernel WarpBroadcastKernel<int FMT>:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            var int i = lane
            while i < d_in:
                # d_in % 32 == 0 and i steps by the warp size from `lane`, so col*d_in + i is a
                # multiple of 32 plus `lane`: the block index is the same for the whole warp.
                let flat_idx = col * d_in + i
                let block_byte = (flat_idx / 32) * bcast_block_bytes(FMT)
                var float32 w_scale = 0.0
                var int qh = 0
                if lane == 0:
                    let scale_bits = int(w_packed[block_byte]) | (int(w_packed[block_byte + 1]) << 8)
                    w_scale = f16_bits_to_f32(scale_bits)
                    if FMT == 6:
                        let qh_base = block_byte + 2
                        qh = int(w_packed[qh_base]) | (int(w_packed[qh_base + 1]) << 8) | (int(w_packed[qh_base + 2]) << 16) | (int(w_packed[qh_base + 3]) << 24)
                w_scale = .warp.shuffle(w_scale, 0)
                if FMT == 6:
                    qh = .warp.shuffle(qh, 0)
                partial += x[row * d_in + i] * (bcast_unscaled(w_packed, FMT, block_byte, lane, qh) * w_scale)
                i += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

req [float32]'kernel'unified warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int fmt, int seq, int d_in, int d_out) throws:
    guard d_in % 32 == 0 else throw "warp_broadcast_gpu: d_in ({d_in}) must be a multiple of 32"
    let int warps_per_block = 8
    let int blocks = (seq * d_out + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    dispatch fmt in [8, 6, 2, 20]:
        mut k = WarpBroadcastKernel<fmt>(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
        kernel:
            k(block = (32, warps_per_block), grid = (gx, gy))
        return k.y

# Public wrappers (the decode-step kernels `fused_linear_gpu` dispatches to). `q8_linear_warp_gpu`
# was the benchmarked-and-rejected variant without the scale broadcast; it is numerically the same
# computation, so it now shares the broadcast kernel.
pub req [float32]'kernel'unified q8_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_broadcast_gpu(x, w_packed, bv, 8, seq, d_in, d_out)

pub req [float32]'kernel'unified q8_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_broadcast_gpu(x, w_packed, bv, 8, seq, d_in, d_out)

pub req [float32]'kernel'unified q5_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_broadcast_gpu(x, w_packed, bv, 6, seq, d_in, d_out)

pub req [float32]'kernel'unified q4_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_broadcast_gpu(x, w_packed, bv, 2, seq, d_in, d_out)

pub req [float32]'kernel'unified q4nl_linear_warp_broadcast_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_broadcast_gpu(x, w_packed, bv, 20, seq, d_in, d_out)

# ── Fused-dequant linear dispatch, by ggml type ──────────────────────────
# A real quantized GGUF file mixes formats across tensors (e.g. a typical
# "Q4_K_M" file: attention/FFN-gate/FFN-up projections in Q5_0, attn_v in
# Q8_0, ffn_down alternating Q4_K/Q6_K by layer — verified directly against
# a real downloaded Qwen2.5-0.5B-Instruct Q4_K_M file), so model.br's
# QuantLayer/QuantModel carry each weight's own ggml type tag alongside its
# packed bytes, and every linear-layer call site goes through this
# dispatcher instead of hardcoding q8_linear_gpu. ggml type ids match
# gguf.br's ggml_type_name (2=Q4_0, 6=Q5_0, 8=Q8_0, 10=Q2_K, 11=Q3_K,
# 12=Q4_K, 14=Q6_K, 20=IQ4_NL).
#
# Q8_0/Q5_0/Q4_0/IQ4_NL are additionally SHAPE-aware: each has a
# warp-shuffle-plus-broadcast counterpart (`q8_linear_warp_broadcast_gpu`
# was the first warp-shuffle GEMM variant in this project's whole
# investigation to actually beat the tiled kernel it was built to
# challenge — see its own doc comment above for why; the other three share
# the identical alignment, one warp decoding one shared block per stride
# round, since all four formats use a 32-element block matching this
# hardware's warp size) that wins at seq=1 (single-token decode, the
# dominant real workload once `--kv-cache` is in use) but still loses
# badly to the tiled kernel at prefill shapes (seq>1) — see
# test/bench_linear_warp.br's own real measurements. Q2_K/Q3_K/Q4_K/Q6_K's
# 256-element superblocks don't share this alignment (a 256-wide block
# spans 8 warps, not 1), so no analogous broadcast variant exists for them
# yet. Every real call site in model.br already passes its own true `seq`
# (1 for a decode step, the prompt/turn length for a prefill), so this
# dispatch needs no new parameter or a decode-specific entry point — it
# reads `seq` off the same call every other format's branch below ignores.
# ── Hand-written tiled linear kernels for Q4_1, Q5_1, Q5_K and unquantized F16 / BF16
# weights: one weight element decoded per thread per tile, the same shape as Q5LinearKernel.
# These formats have no native tensor schedule (see tensor_linear_gpu), so every
# row count, decode included, takes these kernels.

# Single-row (decode) variants: one warp per output cell, its lanes striding over d_in and
# reducing with shuffles; each lane decodes its own weight element (the tiled kernels above
# would leave 15 of 16 rows idle at seq == 1).

# ── Single-row (decode) linear layer, one kernel for every packed format ──
# One warp per output cell: its lanes stride over the row in units (a 32-element block, or one
# element for F16/BF16) and reduce their partial dot products with shuffles. `unit_dot` is the
# per-format part, a plain function of the packed bytes (`wdot_*`, documented below); the scale
# and minimum of a block are applied once per block: sum(w*x) = d * sum(q*x) + m * sum(x).
# (A version where all lanes decode one block jointly and lane 0 broadcasts its header was ~4x
# slower.)

float32 wdot_f16([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    let flat_idx = col * d_in + unit
    x[row * d_in + unit] * f16_bits_to_f32(int(w_packed[flat_idx * 2]) | (int(w_packed[flat_idx * 2 + 1]) << 8))

float32 wdot_bf16([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    let flat_idx = col * d_in + unit
    x[row * d_in + unit] * bf16_bits_to_f32(int(w_packed[flat_idx * 2]) | (int(w_packed[flat_idx * 2 + 1]) << 8))

float32 wdot_q41([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element block: no shuffles, independent loads
    let bb = (col * n_units + unit) * 20
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let w_m = f16_bits_to_f32_fast(int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8))
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    var float32 sx = 0.0
    for j in 0..<16:
        let byte_val = int(w_packed[bb + 4 + j])
        let xl = x[xb + j]
        let xh = x[xb + 16 + j]
        dot += xl * ((byte_val & 0xF) as float32) + xh * (((byte_val >> 4) & 0xF) as float32)
        sx += xl + xh
    w_d * dot + w_m * sx

float32 wdot_q51([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element block: no shuffles, independent loads
    let bb = (col * n_units + unit) * 24
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let w_m = f16_bits_to_f32_fast(int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8))
    let qh = int(w_packed[bb + 4]) | (int(w_packed[bb + 5]) << 8) | (int(w_packed[bb + 6]) << 16) | (int(w_packed[bb + 7]) << 24)
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    var float32 sx = 0.0
    for j in 0..<16:
        let byte_val = int(w_packed[bb + 8 + j])
        let xl = x[xb + j]
        let xh = x[xb + 16 + j]
        let lo = (byte_val & 0xF) | (((qh >> j) & 1) << 4)
        let hi = ((byte_val >> 4) & 0xF) | (((qh >> (j + 16)) & 1) << 4)
        dot += xl * (lo as float32) + xh * (hi as float32)
        sx += xl + xh
    w_d * dot + w_m * sx

float32 wdot_q5k([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element sub-block of a 256-element superblock
    let blocks_per_row = (d_in >> 8)
    let sblock = (unit >> 3)
    let sub = (unit & 7)
    let chunk = (sub >> 1)
    let high_half = (sub & 1)
    let bb = (col * blocks_per_row + sblock) * 176
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let w_dmin = f16_bits_to_f32_fast(int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8))
    let sc_base = bb + 4
    var int sc = 0
    var int mn = 0
    if sub < 4:
        sc = int(w_packed[sc_base + sub]) & 63
        mn = int(w_packed[sc_base + sub + 4]) & 63
    else:
        sc = (int(w_packed[sc_base + sub + 4]) & 0xF) | ((int(w_packed[sc_base + sub - 4]) >> 6) << 4)
        mn = (int(w_packed[sc_base + sub + 4]) >> 4) | ((int(w_packed[sc_base + sub]) >> 6) << 4)
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    var float32 sx = 0.0
    for l in 0..<32:
        let q = int(w_packed[bb + 48 + chunk * 32 + l])
        let nib = if high_half == 1: (q >> 4) & 0xF else: q & 0xF
        let hbit = (int(w_packed[bb + 16 + l]) >> sub) & 1
        let xv = x[xb + l]
        dot += xv * ((nib + (hbit << 4)) as float32)
        sx += xv
    w_d * (sc as float32) * dot - w_dmin * (mn as float32) * sx

float32 wdot_q40([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element block (see the Q4_1 kernel above)
    let bb = (col * n_units + unit) * 18
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    var float32 sx = 0.0
    for j in 0..<16:
        let byte_val = int(w_packed[bb + 2 + j])
        let xl = x[xb + j]
        let xh = x[xb + 16 + j]
        dot += xl * ((byte_val & 0xF) as float32) + xh * (((byte_val >> 4) & 0xF) as float32)
        sx += xl + xh
    w_d * (dot - 8.0 * sx)

float32 wdot_q50([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element block (see the Q4_1 kernel above)
    let bb = (col * n_units + unit) * 22
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let qh = int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8) | (int(w_packed[bb + 4]) << 16) | (int(w_packed[bb + 5]) << 24)
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    var float32 sx = 0.0
    for j in 0..<16:
        let byte_val = int(w_packed[bb + 6 + j])
        let xl = x[xb + j]
        let xh = x[xb + 16 + j]
        let lo = (byte_val & 0xF) | (((qh >> j) & 1) << 4)
        let hi = ((byte_val >> 4) & 0xF) | (((qh >> (j + 16)) & 1) << 4)
        dot += xl * (lo as float32) + xh * (hi as float32)
        sx += xl + xh
    w_d * (dot - 16.0 * sx)

float32 wdot_iq4nlu([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element block (layout of Q4_0, codebook values)
    let bb = (col * n_units + unit) * 18
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    for j in 0..<16:
        let byte_val = int(w_packed[bb + 2 + j])
        dot += x[xb + j] * (iq4nl_value(byte_val & 0xF) as float32) + x[xb + 16 + j] * (iq4nl_value((byte_val >> 4) & 0xF) as float32)
    w_d * dot

float32 wdot_iq4xs([uint8]'global w_packed, [float32]'global x, int col, int row, int d_in, int n_units, int unit):
    # one lane per 32-element sub-block of a 256-element superblock
    let blocks_per_row = (d_in >> 8)
    let ib = (unit & 7)
    let bb = (col * blocks_per_row + (unit >> 3)) * 136
    let w_d = f16_bits_to_f32_fast(int(w_packed[bb]) | (int(w_packed[bb + 1]) << 8))
    let sh = int(w_packed[bb + 2]) | (int(w_packed[bb + 3]) << 8)
    let low = (int(w_packed[bb + 4 + (ib >> 1)]) >> (4 * ((ib & 1)))) & 0xF
    let high = (sh >> (2 * ib)) & 3
    let dl = w_d * (((low | (high << 4)) - 32) as float32)
    let xb = row * d_in + unit * 32
    var float32 dot = 0.0
    for j in 0..<16:
        let q = int(w_packed[bb + 8 + ib * 16 + j])
        dot += x[xb + j] * (iq4nl_value(q & 0xF) as float32) + x[xb + 16 + j] * (iq4nl_value((q >> 4) & 0xF) as float32)
    dl * dot

# Elements per unit of a lane's work.
int warp_unit_elems(int fmt):
    if fmt == 1 or fmt == 30:
        1
    else:
        32

# Dot product of one unit of row `row` of `x` with the matching weights of output `col`.
float32 unit_dot([uint8]'global w_packed, [float32]'global x, int fmt, int col, int row, int d_in, int n_units, int unit):
    if fmt == 1:
        wdot_f16(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 30:
        wdot_bf16(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 3:
        wdot_q41(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 7:
        wdot_q51(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 13:
        wdot_q5k(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 2:
        wdot_q40(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 6:
        wdot_q50(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 20:
        wdot_iq4nlu(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 23:
        wdot_iq4xs(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 120:
        wdot_iq4nl_t(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 123:
        wdot_iq4xs_t(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 16:
        wdot_iq2xxs(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 17:
        wdot_iq2xs(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 22:
        wdot_iq2s(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 18:
        wdot_iq3xxs(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 21:
        wdot_iq3s(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 19:
        wdot_iq1s(w_packed, x, col, row, d_in, n_units, unit)
    elif fmt == 29:
        wdot_iq1m(w_packed, x, col, row, d_in, n_units, unit)
    else:
        0.0

kernel WarpLinearKernel<int FMT>:
    let [float32]'global  x                # (seq × d_in)
    let [uint8]'global    w_packed         # (d_out × d_in), GGUF's native layout
    let [float32]'global  bv               # (d_out,)
    mut [float32]'unified y                # output: seq × d_out
    let int               seq
    let int               d_in
    let int               d_out
    let int               warps_per_block

    init([float32]'global xi, [uint8]'global wi, [float32]'global bi,
         int s, int din, int dout, int wpb):
        x               = xi
        w_packed        = wi
        bv              = bi
        seq             = s
        d_in            = din
        d_out           = dout
        warps_per_block = wpb
        y               = [0.0 for ..<s * dout]

    def ():
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let block_idx = .block.x + .block.y * .grid_dim.x
        let global_warp = block_idx * warps_per_block + warp_in_block
        let total = seq * d_out
        if global_warp < total:
            let row = global_warp / d_out
            let col = global_warp % d_out
            var float32 partial = 0.0
            let n_units = d_in / warp_unit_elems(FMT)
            var int unit = lane
            while unit < n_units:
                partial += unit_dot(w_packed, x, FMT, col, row, d_in, n_units, unit)
                unit += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                partial += .warp.shuffle_xor(partial, offset)
                offset = offset / 2
            if lane == 0:
                y[row * d_out + col] = partial + bv[col]

pub req [float32]'kernel'unified warp_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed, int fmt,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard d_in % weight_block_elems(fmt) == 0 else throw "warp_linear_gpu: d_in ({d_in}) must be a multiple of {weight_block_elems(fmt)} for ggml type {fmt}"
    let int warps_per_block = 8
    let int total_warps = seq * d_out
    let int blocks = (total_warps + warps_per_block - 1) / warps_per_block
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    dispatch fmt in [1, 30, 3, 7, 13, 2, 6, 20, 23, 16, 17, 22, 18, 21, 19, 29, 120, 123]:
        mut k = WarpLinearKernel<fmt>(x, w_packed, bv, seq, d_in, d_out, warps_per_block)
        kernel:
            k(block = (32, warps_per_block), grid = (gx, gy))
        return k.y
    else:
        throw "warp_linear_gpu: unsupported ggml type id {fmt}"

pub req [float32]'kernel'unified f16_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 1, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified bf16_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 30, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified q41_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 3, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified q51_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 7, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified q5k_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 13, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified q40_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 2, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified q50_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 6, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified iq4nlu_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 20, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified iq4xs_linear_warp_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    warp_linear_gpu(x, w_packed, 23, bv, seq, d_in, d_out)

# Q4_1 / Q5_1 / Q5_K single-row (decode) kernels: one warp per output cell, each lane owning whole
# 32-element blocks (Q5_K: sub-blocks), so a lane's loads are independent of the other lanes'. Scale and
# minimum are applied once per block: sum(w*x) = d * sum(q*x) + m * sum(x). (A version where all
# lanes decode one block jointly and lane 0 broadcasts its header was ~4x slower.)

# Prefill for these formats: dequantize the matrix once into a float32 buffer, then run the
# float32 tiled matmul. Decoding inside the matmul's tile loads re-decodes every weight once per
# 16-row tile of the prompt (39x for a 613-token prompt).

# ── Dequantization into a float32 matrix, one kernel for every packed format ──
# Same per-element decoders as the tiled GEMM (`weight_at`), written out to a plain buffer.

kernel DequantKernel<int FMT>:
    let [uint8]'global    w_packed
    mut [float32]'unified out
    let int               n

    init([uint8]'global wi, int count):
        w_packed = wi
        n        = count
        out      = [0.0 for ..<count]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let flat_idx = .thread.x + block_idx * .block_dim.x
        if flat_idx < n:
            out[flat_idx] = weight_at(w_packed, FMT, flat_idx)

pub req [float32]'kernel'unified dequantize_gpu([uint8]'kernel'global w_packed, int fmt, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    dispatch fmt in [3, 7, 13, 1, 30, 2, 6, 20, 23, 16, 17, 22, 18, 21, 19, 29, 120, 123]:
        mut k = DequantKernel<fmt>(w_packed, n)
        kernel:
            k(block = 256, grid = (gx, gy))
        return k.out
    else:
        throw "dequantize_gpu: unsupported ggml type id {fmt}"

# The IEEE binary16 bit pattern nearest to `v` (ties to even, overflow to infinity), by arithmetic
# only (no bit casts in kernels): the exponent is found by a binary search over exact powers of two,
# every scaling below is by a power of two and therefore exact, and the one rounding is done by hand.
# Agrees with numpy's float16 cast on test/fixtures/quant-tof16.* (see test_iq_kernels_real.br).
pub int half_bits_of(float32 v):
    let neg = v < 0.0
    let a = if neg: 0.0 - v else: v
    let sign = if neg: 32768 else: 0
    var int result = sign
    if a >= 65520.0:
        result = sign | 31744
    elif a >= 6.103515625e-05:
        var int e = -14
        var float32 p = 6.103515625e-05
        if p * 65536.0 <= a:
            p = p * 65536.0
            e += 16
        if p * 256.0 <= a:
            p = p * 256.0
            e += 8
        if p * 16.0 <= a:
            p = p * 16.0
            e += 4
        if p * 4.0 <= a:
            p = p * 4.0
            e += 2
        if p * 2.0 <= a:
            p = p * 2.0
            e += 1
        let mant = ((a / p) - 1.0) * 1024.0
        let f = mant.floor()
        let d = mant - f
        var int m = f as int
        if d > 0.5 or (d == 0.5 and (m & 1) == 1):
            m += 1
        var int ex = e + 15
        if m == 1024:
            m = 0
            ex += 1
        result = sign | (ex << 10) | m
    elif a > 2.9802322387695312e-08:
        # subnormal: a multiple of 2^-24 (a quotient of 1024 is the smallest normal, bit-exact)
        let scaled = a * 16777216.0
        let f = scaled.floor()
        let d = scaled - f
        var int q = f as int
        if d > 0.5 or (d == 0.5 and (q & 1) == 1):
            q += 1
        result = sign | q
    result

# Dequantization into binary16 bytes (two per value, little endian: the layout of the `f16` tensor
# format), for the formats whose prefill runs on the compiler's native f16 kernel.
kernel DequantF16Kernel<int FMT>:
    let [uint8]'global    w_packed
    mut [uint8]'unified   out
    let int               n

    init([uint8]'global wi, int count):
        w_packed = wi
        n        = count
        out      = [0 as uint8 for ..<count * 2]

    def ():
        let block_idx = .block.x + .block.y * .grid_dim.x
        let flat_idx = .thread.x + block_idx * .block_dim.x
        if flat_idx < n:
            let bits = half_bits_of(weight_at(w_packed, FMT, flat_idx))
            out[flat_idx * 2] = (bits & 255) as uint8
            out[flat_idx * 2 + 1] = (bits >> 8) as uint8

pub req [uint8]'kernel'unified dequantize_f16_gpu([uint8]'kernel'global w_packed, int fmt, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    dispatch fmt in [20, 23, 16, 17, 22, 18, 21, 19, 29, 120, 123]:
        mut k = DequantF16Kernel<fmt>(w_packed, n)
        kernel:
            k(block = 256, grid = (gx, gy))
        return k.out
    else:
        throw "dequantize_f16_gpu: unsupported ggml type id {fmt}"

# IQ4_XS and IQ4_NL (codebook formats): same kernel shapes as the Q4_x / Q5_x ones above.

# `linear_gpu` over a freshly dequantized weight matrix, for prompts of at least this many rows.
let int DEQUANT_PREFILL_MIN_ROWS = 16

# Q4_0 / Q5_0 single-row kernels in the same lane-per-block shape (the older warp-broadcast kernels
# above are ~6x slower at decode shapes, see test/bench_decode_formats.br).

pub req [float32]'kernel'unified fused_linear_gpu([float32]'kernel'global x, [uint8]'kernel'global w_packed, int w_type,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    guard w_type == 1 or w_type == 2 or w_type == 3 or w_type == 6 or w_type == 7 or w_type == 8 or w_type == 10 or w_type == 11 or w_type == 12 or w_type == 13 or w_type == 14 or w_type == 20 or w_type == 23 or w_type == 30 or is_iq_grid_type(w_type) or w_type == 120 or w_type == 123 else throw "fused_linear_gpu: unsupported ggml type id {w_type} (supported: F16=1, Q4_0=2, Q4_1=3, Q5_0=6, Q5_1=7, Q8_0=8, Q2_K=10, Q3_K=11, Q4_K=12, Q5_K=13, Q6_K=14, IQ4_NL=20, IQ4_XS=23, BF16=30, IQ2_XXS=16, IQ2_XS=17, IQ3_XXS=18, IQ1_S=19, IQ3_S=21, IQ2_S=22, IQ1_M=29)"
    # Formats with a single-row warp kernel and a dequantize-once prefill path; the others (Q8_0 and
    # the K-quants) use the tiled kernel for every prompt length.
    let bool has_warp = w_type == 1 or w_type == 2 or w_type == 3 or w_type == 6 or w_type == 7 or w_type == 13 or w_type == 20 or w_type == 23 or w_type == 30 or is_iq_grid_type(w_type) or w_type == 120 or w_type == 123
    if seq == 1 and w_type == 8:
        q8_linear_warp_broadcast_gpu(x, w_packed, bv, seq, d_in, d_out)
    elif seq == 1 and has_warp:
        warp_linear_gpu(x, w_packed, w_type, bv, seq, d_in, d_out)
    elif seq >= DEQUANT_PREFILL_MIN_ROWS and has_warp and prefill_via_f16(w_type):
        # decode once to binary16 bytes, then the compiler's native f16 matrix kernel
        let w_f16 = dequantize_f16_gpu(w_packed, w_type, d_out * d_in)
        tensor_linear_schedule_gpu(x, w_f16, 1, bv, seq, d_in, d_out)
    elif seq >= DEQUANT_PREFILL_MIN_ROWS and has_warp:
        let [float32]'kernel'unified w_f32 = dequantize_gpu(w_packed, w_type, d_out * d_in)
        linear_gpu(x, w_f32, bv, seq, d_in, d_out)
    else:
        tiled_linear_gpu(x, w_packed, w_type, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified fused_linear_nobias_gpu([float32] x, [uint8] w_packed, int w_type,
                       int seq, int d_in, int d_out) throws:
    let [float32] zero_bias = [0.0 for i in 0..<d_out]
    fused_linear_gpu(x, w_packed, w_type, zero_bias, seq, d_in, d_out)

# Tensor-backed equivalent of fused_linear_gpu. Keep the hand-written kernels
# above as the performance baseline while migration and shape-specific tensor
# scheduling are measured. Literal format names deliberately keep each packed
# layout explicit to Boring's tensor checker and generated kernel.
req [float32]'kernel'unified tensor_linear_schedule_gpu([float32]'kernel'global x,
                       [uint8]'kernel'global w_packed, int w_type,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<seq * d_out]
    if w_type == 8:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q8_0")
    elif w_type == 6:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q5_0")
    elif w_type == 12:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q4_k")
    elif w_type == 14:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q6_k")
    elif w_type == 2:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q4_0")
    elif w_type == 10:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q2_k")
    elif w_type == 11:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q3_k")
    elif w_type == 20:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "iq4_nl")
    elif w_type == 3:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q4_1")
    elif w_type == 7:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q5_1")
    elif w_type == 13:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "q5_k")
    elif w_type == 1:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "f16")
    elif w_type == 30:
        kernel.tensors.linear(x, w_packed, bv, y, m = seq, n = d_out, k = d_in, format = "bf16")
    else:
        throw "tensor_linear_schedule_gpu: unsupported ggml type id {w_type} (supported: F16=1, Q4_0=2, Q4_1=3, Q5_0=6, Q5_1=7, Q8_0=8, Q2_K=10, Q3_K=11, Q4_K=12, Q5_K=13, Q6_K=14, IQ4_NL=20, BF16=30)"
    y

# Shape-aware entry points model.br actually calls. `kernel.tensors.linear` (the
# compiler's tensor schedule, used for single-row decode where its warp-
# broadcast schedule wins) only has a scalar prefill schedule today — one
# thread per output cell, no weight reuse across the `seq` rows — which on a
# real 0.5B model measured ~0.5 s per layer of FFN matmul at seq=28
# (~1-2 GFLOP/s). The hand-written tiled kernels behind `fused_linear_gpu`
# (16x16 shared-memory tiles, reuse each weight tile across rows) are the
# project's measured prefill baseline (see test/bench_linear_warp.br), so any
# `seq > 1` call goes there; `seq == 1` keeps the tensor schedule. Drop this
# split once `boring` grows a tiled/simdgroup tensor schedule (see
# boring/docs/tensor-core-primitives.md's own "add tiled shared-memory
# fallbacks" note) that beats the hand-written kernel at prefill shapes.
# Q8_0 prefill (seq > 1) goes through `kernel.tensors.linear` too: on Metal
# `boring.toml`'s `[tensor.linear.prefill] q8_0 = "native"` lowers it to a
# simdgroup_matrix kernel (~6x faster than the hand-written tiled kernel), and
# on wgpu the portable tiled Q8 schedule is on par with it. Q4_K and Q6_K (the
# formats of every Q4_K_M file) have native Metal kernels as well (`q4_k` /
# `q6_k = "native"` in boring.toml; ~3-10x faster than the hand-written ones and
# the reason a 3B Q4_K_M model prefills at ~16-20 ms/token instead of ~177), but
# NO portable schedule: on wgpu the tensor path is a scalar kernel ~3x slower
# than the hand-written one, so `--kquant-prefill handwritten` keeps those two
# on `fused_linear_gpu`. Other formats always take the tiled `fused_linear_gpu`
# for seq > 1.
static var bool kquant_prefill_handwritten = false

# Metal batches consecutive launches into one command buffer during decode.
# Other GPU backends provide a no-op implementation of this native hook.
pub def set_gpu_batch_limit(int limit): native

pub def set_kquant_prefill_handwritten(bool v):
    kquant_prefill_handwritten = v

# Formats that take the compiler's `kernel.tensors.linear` schedule. Q4_0 and Q5_0 had left this list
# (the compiler's schedule was ~6x slower than the lane-per-block kernels) until `boring.toml` enabled
# their native Metal kernels (`q4_0 = "native"`, ... under `[tensor.linear.prefill]`); with those, and the
# native Q4_1/Q5_1/Q5_K/F16/BF16 ones, every format below decodes at Q8_0 speed on Metal
# (test/bench_decode_formats.br). F16/BF16 need d_in % 32 == 0 (the kernels' K tile).
bool has_tensor_schedule(int w_type, int d_in):
    w_type == 2 or w_type == 3 or w_type == 6 or w_type == 7 or w_type == 8 or w_type == 10 or w_type == 11 or w_type == 12 or w_type == 13 or w_type == 14 or ((w_type == 1 or w_type == 30) and d_in % 32 == 0)

# Prefill (seq > 1) on the compiler's SIMD-group kernels: Q8_0, Q4_0/Q4_1/Q5_0/Q5_1, F16/BF16 always (3-5x
# faster than the hand-written tiled kernels on Metal); the K-quants unless `--kquant-prefill handwritten`.
# Q2_K/Q3_K/IQ4_NL prefill stays on `fused_linear_gpu`.
bool tensor_prefill(int w_type):
    w_type == 8 or w_type == 2 or w_type == 3 or w_type == 6 or w_type == 7 or w_type == 1 or w_type == 30 or ((w_type == 12 or w_type == 13 or w_type == 14) and not kquant_prefill_handwritten)

pub req [float32]'kernel'unified tensor_linear_gpu([float32]'kernel'global x,
                       [uint8]'kernel'global w_packed, int w_type,
                       [float32]'kernel'global bv, int seq, int d_in, int d_out) throws:
    if has_tensor_schedule(w_type, d_in) and (seq == 1 or tensor_prefill(w_type)):
        tensor_linear_schedule_gpu(x, w_packed, w_type, bv, seq, d_in, d_out)
    else:
        fused_linear_gpu(x, w_packed, w_type, bv, seq, d_in, d_out)

pub req [float32]'kernel'unified tensor_linear_nobias_gpu([float32]'kernel'global x,
                       [uint8]'kernel'global w_packed, int w_type,
                       int seq, int d_in, int d_out) throws:
    if has_tensor_schedule(w_type, d_in) and (seq == 1 or tensor_prefill(w_type)):
        tensor_linear_nobias_schedule_gpu(x, w_packed, w_type, seq, d_in, d_out)
    else:
        let [float32] zero_bias = [0.0 for i in 0..<d_out]
        fused_linear_gpu(x, w_packed, w_type, zero_bias, seq, d_in, d_out)

req [float32]'kernel'unified tensor_linear_nobias_schedule_gpu([float32]'kernel'global x,
                       [uint8]'kernel'global w_packed, int w_type,
                       int seq, int d_in, int d_out) throws:
    mut [float32]'kernel'unified y = [0.0 as float32 for ..<seq * d_out]
    if w_type == 8:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q8_0")
    elif w_type == 6:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q5_0")
    elif w_type == 12:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q4_k")
    elif w_type == 14:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q6_k")
    elif w_type == 2:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q4_0")
    elif w_type == 10:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q2_k")
    elif w_type == 11:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q3_k")
    elif w_type == 20:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "iq4_nl")
    elif w_type == 3:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q4_1")
    elif w_type == 7:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q5_1")
    elif w_type == 13:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "q5_k")
    elif w_type == 1:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "f16")
    elif w_type == 30:
        kernel.tensors.linear(x, w_packed, y, m = seq, n = d_out, k = d_in, format = "bf16")
    else:
        throw "tensor_linear_nobias_schedule_gpu: unsupported ggml type id {w_type} (supported: F16=1, Q4_0=2, Q4_1=3, Q5_0=6, Q5_1=7, Q8_0=8, Q2_K=10, Q3_K=11, Q4_K=12, Q5_K=13, Q6_K=14, IQ4_NL=20, BF16=30)"
    y

# ── Kernel: RMSNorm (row-wise) ───────────────────────────────────────────
# One SIMD group per row (position) — no bias, no mean subtraction. Each
# lane accumulates a strided slice of the row, then a shuffle reduction
# computes the shared RMS. The previous implementation assigned a whole row
# to one thread and therefore serialized all d elements (896-4096 in the
# models used here), which made this small-looking kernel disproportionately
# expensive during single-token decode.

pub req [float32]'kernel'unified rms_norm_gpu([float32]'kernel'global x, [float32]'kernel'global w,
                       int seq, int d, float32 eps) throws:
    let int blocks = (seq + 7) / 8
    kernel(block = (32, 8), grid = blocks):
        mut [float32]'unified out = [0.0 for ..<seq * d]
        let lane = .warp.lane
        let warp_in_block = .thread.y
        let row = .block.x * 8 + warp_in_block
        if row < seq:
            let base = row * d
            var float32 ss = 0.0
            var int j = lane
            while j < d:
                let v = x[base + j]
                ss += v * v
                j += .warp.size
            var int offset = .warp.size / 2
            while offset > 0:
                ss += .warp.shuffle_xor(ss, offset)
                offset = offset / 2
            let mean_sq = ss / (d as float32)
            let inv_rms = 1.0 / (mean_sq + eps).sqrt()
            j = lane
            while j < d:
                out[base + j] = x[base + j] * inv_rms * w[j]
                j += .warp.size
        out

# ── Kernel: RoPE (NEOX "rotate-half" or NORM "interleaved") ──────────────
# One thread per (position, head, half-dim-pair) cell — see math.br's
# rope_apply doc comment for the rotation itself (identical math, just
# flattened into a 1D grid instead of math.br's nested loops) and for which
# architecture needs `neox = 1` vs `neox = 0`.

pub req [float32]'kernel'unified rope_apply_gpu([float32]'kernel'global x, int seq, int n_heads,
                       int d_head, [float32]'kernel'global rope_freqs, int neox) throws:
    rope_apply_at_gpu(x, seq, n_heads, d_head, rope_freqs, 0, neox)

pub req [float32]'kernel'unified rope_apply_at_gpu([float32]'kernel'global x, int seq, int n_heads,
                       int d_head, [float32]'kernel'global rope_freqs, int start_pos, int neox) throws:
    rope_apply_slice_at_gpu(x, 0, seq, n_heads, d_head, rope_freqs, start_pos, neox)

# Applies RoPE to a compact logical tensor starting at `input_offset` in a
# larger resident buffer. Decode uses this to consume Q and K directly from a
# concatenated QKV projection, without first launching a split/copy kernel.
pub req [float32]'kernel'unified rope_apply_slice_at_gpu([float32]'kernel'global x, int input_offset,
                       int seq, int n_heads, int d_head, [float32]'kernel'global rope_freqs,
                       int start_pos, int neox) throws:
    let int half_dim = d_head / 2
    let int total = seq * n_heads * half_dim
    let int blocks = (total + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<seq * n_heads * d_head]
        let cell = .thread.x + .block.x * .block_dim.x
        if cell < total:
            let p = cell / (n_heads * half_dim)
            let rem = cell % (n_heads * half_dim)
            let h = rem / half_dim
            let j = rem % half_dim
            let base_idx = p * n_heads * d_head + h * d_head
            let abs_pos = p + start_pos
            let angle = (abs_pos as float32) * rope_freqs[j]
            let cos_a = angle.cos() * rope_freqs[half_dim]
            let sin_a = angle.sin() * rope_freqs[half_dim]
            var int idx0 = base_idx + j
            var int idx1 = base_idx + j + half_dim
            if neox == 0:
                idx0 = base_idx + 2 * j
                idx1 = base_idx + 2 * j + 1
            let x0 = x[input_offset + idx0]
            let x1 = x[input_offset + idx1]
            out[idx0] = x0 * cos_a - x1 * sin_a
            out[idx1] = x0 * sin_a + x1 * cos_a
        out

# ── One-time upload: host array -> GPU-resident buffer ───────────────────
# Model weights are uploaded ONCE at load time (model.br's load_model_quantized)
# and kept resident in `QuantLayer`/`QuantModel` fields, instead of every
# matmul of every token re-cloning the host bytes and re-uploading them
# (`BoringGpuArg::Host`, which uploads lazily at each kernel use). A kernel
# `'global` input is what makes `boring` upload; copying it into a `'unified`
# output yields a value that stays on the device across calls.
#
# Each thread copies 16 consecutive bytes (a multiple of 4): on `--target
# wgpu`, byte arrays are packed into `array<u32>`, and two threads writing
# different bytes of one u32 would race — 16-byte, 4-aligned runs never share
# a word. 16 bytes/thread also keeps even a ~140 MB tensor under wgpu's
# 65535-workgroup-per-dimension dispatch limit (256 threads x 16 B = 4096 B
# per workgroup, i.e. up to ~268 MB per tensor in one dimension); larger
# tensors (a 7B model's 447 MB Q6_K token embedding) spill into a second grid
# dimension.

pub req [uint8]'kernel'unified upload_bytes_gpu([uint8]'kernel'global src) throws:
    let int n = src.length
    let int blocks = (n + 4095) / 4096
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [uint8]'unified out = [0 as uint8 for ..<n]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        let base = i * 16
        var int k = 0
        while k < 16:
            if base + k < n:
                out[base + k] = src[base + k]
            k += 1
        out

# A (gx, gy) grid: a buffer over 65535 x 256 floats (a long context's KV rows
# restored from disk) does not fit one grid dimension.
pub req [float32]'kernel'unified upload_floats_gpu([float32]'kernel'global src) throws:
    let int n = src.length
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [float32]'unified out = [0.0 for ..<n]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        if i < n:
            out[i] = src[i]
        out

# Split one decode-only concatenated Q/K/V projection into the three resident
# buffers expected by the existing RoPE, cache and attention code.
pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) split_qkv_gpu(
        [float32]'kernel'global src, int q_size, int kv_size) throws:
    let n = q_size + 2 * kv_size
    kernel(block = 256, grid = (n + 255) / 256):
        mut [float32]'unified q = [0.0 as float32 for ..<q_size]
        mut [float32]'unified k = [0.0 as float32 for ..<kv_size]
        mut [float32]'unified v = [0.0 as float32 for ..<kv_size]
        let i = .thread.x + .block.x * .block_dim.x
        if i < q_size + 2 * kv_size:
            if i < q_size:
                q[i] = src[i]
            elif i < q_size + kv_size:
                k[i - q_size] = src[i]
            else:
                v[i - q_size - kv_size] = src[i]
        (q, k, v)

pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) project_qkv_decode_gpu(
        [float32]'kernel'global x,
        [uint8]'kernel'global qw, int qt, [float32]'kernel'global qb,
        [uint8]'kernel'global kw, int kt, [float32]'kernel'global kb,
        [uint8]'kernel'global vw, int vt, [float32]'kernel'global vb,
        [uint8]'kernel'global qkvw, [float32]'kernel'global qkvb, bool fused,
        int d_in, int q_dim, int kv_dim) throws:
    if fused:
        let joined = tensor_linear_gpu(x, qkvw, 8, qkvb, 1, d_in, q_dim + 2 * kv_dim)
        split_qkv_gpu(joined, q_dim, kv_dim)
    else:
        let q = tensor_linear_gpu(x, qw, qt, qb, 1, d_in, q_dim)
        let k = tensor_linear_gpu(x, kw, kt, kb, 1, d_in, kv_dim)
        let v = tensor_linear_gpu(x, vw, vt, vb, 1, d_in, kv_dim)
        (q, k, v)

# Decode projection plus the transformations needed immediately before
# attention. For the fused Q8_0 path, Q and K are read as slices of the joined
# projection and V is appended to the cache from its slice. This removes the
# QKV split dispatch and its three transient output buffers.
pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) project_qkv_attention_decode_gpu(
        [float32]'kernel'global x,
        [uint8]'kernel'global qw, int qt, [float32]'kernel'global qb,
        [uint8]'kernel'global kw, int kt, [float32]'kernel'global kb,
        [uint8]'kernel'global vw, int vt, [float32]'kernel'global vb,
        [uint8]'kernel'global qkvw, [float32]'kernel'global qkvb, bool fused,
        [float32]'kernel'global q_norm_w, [float32]'kernel'global k_norm_w, bool qk_norm,
        [float32]'kernel'global prev_tk, [float32]'kernel'global prev_tv, int tail_len,
        int d_in, int q_dim, int kv_dim, int n_head, int n_kv_head, int d_head,
        float32 eps, [float32]'kernel'global rope_freqs, int pos, int neox) throws:
    if fused and not qk_norm:
        let joined = tensor_linear_gpu(x, qkvw, 8, qkvb, 1, d_in, q_dim + 2 * kv_dim)
        if tail_len == 0:
            # An empty tail has no buffer to bind (wgpu rejects a zero-size binding); the kernel
            # copies nothing from it, so any non-empty buffer stands in.
            prepare_qkv_decode_slice(joined, joined, joined, 0,
                n_head, n_kv_head, d_head, rope_freqs, pos, neox)
        else:
            prepare_qkv_decode_slice(prev_tk, prev_tv, joined, tail_len * kv_dim,
                n_head, n_kv_head, d_head, rope_freqs, pos, neox)
    else:
        let ([float32]'kernel'unified q0, [float32]'kernel'unified k0, [float32]'kernel'unified v) = project_qkv_decode_gpu(x,
            qw, qt, qb, kw, kt, kb, vw, vt, vb, qkvw, qkvb, fused,
            d_in, q_dim, kv_dim)
        var q = q0
        var k = k0
        if qk_norm:
            q = rms_norm_gpu(q, q_norm_w, n_head, d_head, eps)
            k = rms_norm_gpu(k, k_norm_w, n_kv_head, d_head, eps)
        q = rope_apply_at_gpu(q, 1, n_head, d_head, rope_freqs, pos, neox)
        k = rope_apply_at_gpu(k, 1, n_kv_head, d_head, rope_freqs, pos, neox)
        let tk = kv_tail_push(prev_tk, k, tail_len * kv_dim, kv_dim)
        let tv = kv_tail_push(prev_tv, v, tail_len * kv_dim, kv_dim)
        (q, tk, tv)

# The first `n` floats of a device-resident buffer, read back to the host (the
# KV cache saved to disk; a `'kernel'unified` struct field cannot be handed to
# `passthrough`, which takes a host array).
pub [float32] download_floats_gpu([float32]'global src, int n) throws:
    let int blocks = (n + 255) / 256
    let int gx = if blocks > 65535: 65535 else: blocks
    let int gy = (blocks + gx - 1) / gx
    kernel(block = 256, grid = (gx, gy)):
        mut [float32]'unified out = [0.0 for ..<n]
        let block_idx = .block.x + .block.y * .grid_dim.x
        let i = .thread.x + block_idx * .block_dim.x
        if i < n:
            out[i] = src[i]
        out

# ── Kernel: SwiGLU combine (elementwise silu(gate) * up) ─────────────────

pub req [float32]'kernel'unified swiglu_combine_gpu([float32]'kernel'global gate, [float32]'kernel'global up) throws:
    let int n = gate.length
    let int blocks = (n + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<n]
        let i = .thread.x + .block.x * .block_dim.x
        if i < n:
            let g = gate[i]
            let silu_g = g / (1.0 + (0.0 - g).exp())
            out[i] = silu_g * up[i]
        out

# Gated-FFN combine with a selectable activation: `act` 0 = silu (SwiGLU),
# 1 = gelu, tanh approximation (GeGLU, Gemma). Same shape as swiglu_combine_gpu.
pub req [float32]'kernel'unified glu_combine_gpu([float32]'kernel'global gate, [float32]'kernel'global up, int act) throws:
    let int n = gate.length
    let int blocks = (n + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<n]
        let i = .thread.x + .block.x * .block_dim.x
        if i < n:
            let g = gate[i]
            var float32 activated = g / (1.0 + (0.0 - g).exp())
            if act == 1:
                let inner = 0.7978845608 * (g + 0.044715 * g * g * g)
                activated = 0.5 * g * (1.0 + inner.tanh())
            out[i] = activated * up[i]
        out

# x * factor, elementwise (Granite's residual scale).
pub req [float32]'kernel'unified scale_gpu([float32]'kernel'global x, float32 factor, int n) throws:
    let int blocks = (n + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<n]
        let i = .thread.x + .block.x * .block_dim.x
        if i < n:
            out[i] = x[i] * factor
        out

# ── Mixture-of-experts helpers ─────────────────────────────────────────────
# Rows of `x` (d floats each) picked by `idx` (row numbers stored as floats, exact up to 2^24).
pub req [float32]'kernel'unified gather_rows_gpu([float32]'kernel'global x, [float32]'kernel'global idx, int m, int d) throws:
    let int total = m * d
    let int blocks = (total + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<total]
        let cell = .thread.x + .block.x * .block_dim.x
        if cell < total:
            let r = cell / d
            let j = cell % d
            let src = idx[r] as int
            out[cell] = x[src * d + j]
        out

# acc + routing weight * expert output, for the rows an expert handled: `pos[r]` is row r's index in
# the expert's batch (-1 when the expert did not get that row), `wts` the weight of each batched row.
pub req [float32]'kernel'unified moe_accumulate_gpu([float32]'kernel'global acc, [float32]'kernel'global y,
                       [float32]'kernel'global pos, [float32]'kernel'global wts, int n, int d) throws:
    let int total = n * d
    let int blocks = (total + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<total]
        let cell = .thread.x + .block.x * .block_dim.x
        if cell < total:
            let r = cell / d
            let j = cell % d
            let p = pos[r] as int
            var float32 value = acc[cell]
            if p >= 0:
                value = value + wts[p] * y[p * d + j]
            out[cell] = value
        out

# ── Kernel: elementwise add (residual connection) ────────────────────────
# Keeps the residual stream on the device: `vec_add` (math.br) is a host
# function, so every `x = vec_add(x, branch)` forced a device-to-host copy of
# the branch output — a full GPU sync twice per layer per token.

pub req [float32]'kernel'unified add_gpu([float32]'kernel'global a, [float32]'kernel'global b, int n) throws:
    let int blocks = (n + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<n]
        let i = .thread.x + .block.x * .block_dim.x
        if i < n:
            out[i] = a[i] + b[i]
        out

# Decode-only residual add followed by RMSNorm. Both the residual stream and
# its normalized FFN input are needed by the caller, so one SIMD-group pass
# emits both and avoids launching/readback through a separate add kernel.
pub req ([float32]'kernel'unified, [float32]'kernel'unified) add_rms_norm_decode_gpu(
        [float32]'kernel'global a, [float32]'kernel'global b,
        [float32]'kernel'global w, int d, float32 eps) throws:
    kernel(block = 32, grid = 1):
        mut [float32]'unified residual = [0.0 for ..<d]
        mut [float32]'unified normed = [0.0 for ..<d]
        let lane = .warp.lane
        var float32 ss = 0.0
        var int j = lane
        while j < d:
            let v = a[j] + b[j]
            ss += v * v
            j += .warp.size
        var int offset = .warp.size / 2
        while offset > 0:
            ss += .warp.shuffle_xor(ss, offset)
            offset = offset / 2
        let inv_rms = 1.0 / (ss / (d as float32) + eps).sqrt()
        j = lane
        while j < d:
            let v = a[j] + b[j]
            residual[j] = v
            normed[j] = v * inv_rms * w[j]
            j += .warp.size
        (residual, normed)

# ── Kernel: KV-cache append ──────────────────────────────────────────────
# New cache = old cache's `old_n` floats followed by `new_n` floats of fresh
# K (or V) rows. Entirely on the device: the cache never visits the host
# between decode steps (it used to be read back, extended by a host loop and
# re-uploaded for every layer of every token).

# `old_n`/`new_n` are element counts (rows * kv_dim). `old_n` must be > 0:
# an empty `prev` has nothing to bind as a buffer — callers use `fresh`
# itself as the first cache.
pub req [float32]'kernel'unified kv_append_gpu([float32]'kernel'global prev, [float32]'kernel'global fresh,
                                            int old_n, int new_n) throws:
    let int total = old_n + new_n
    let int blocks = (total + 255) / 256
    kernel(block = 256, grid = blocks):
        mut [float32]'unified out = [0.0 for ..<total]
        let i = .thread.x + .block.x * .block_dim.x
        if i < total:
            if i < old_n:
                out[i] = prev[i]
            else:
                out[i] = fresh[i - old_n]
        out

# Attention for one layer of a prefill chunk. Plain models take the fused fast
# paths; Gemma 2/3 (`general`) need the explicit scale, score soft-capping and
# per-layer sliding window, which only the general path implements.
pub req [float32]'kernel'unified attention_layer_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head, int d_head, int causal_offset,
                          bool general, float32 scale, float32 softcap, int window) throws:
    if general:
        attention_gqa_ext_gpu(q, k, v, seq_q, seq_k, n_head, n_kv_head, d_head, true, causal_offset, scale, softcap, window)
    else:
        attention_gqa_gpu(q, k, v, seq_q, seq_k, n_head, n_kv_head, d_head, true, causal_offset)

# ── Kernel: attention scores, ALL HEADS in one dispatch, GQA-aware ───────
# `q` is (seq_q × n_head*d_head); `k` (pre-transposed by attention_gqa_gpu)
# is (n_kv_head*d_head × seq_k). grid.z selects the QUERY head `h`; the key
# read maps it down to its shared KV head via `kv_h = h / group`
# (group = n_head / n_kv_head) — the one real structural change from
# whisper-boring's MatMulBTHeadsKernel (which assumed n_head == n_kv_head).

kernel MatMulBTHeadsKernel:
    let  [float32, col, row]'global   q          # (seq_q × n_head*d_head)
    let  [float32, col, row]'global   k          # (n_kv_head*d_head × seq_k) — pre-transposed
    mut  [float32, j, i, h]'unified   c          # output: (n_head × seq_q × seq_k)
    let int             seq_q
    let int             seq_k
    let int             d_head
    let int             n_head
    let int             group      # n_head / n_kv_head
    let float32         scale
    let int             causal     # 0 = off, 1 = causal mask
    let int             causal_offset  # absolute key position of query row 0 — 0 for a
                                        # from-scratch prefill (seq_q == seq_k), or an
                                        # existing KV-cache's length when appending new
                                        # queries to it (seq_q < seq_k)
    let float32         softcap    # > 0: scores become softcap * tanh(scores / softcap) (Gemma 2)
    let int             window     # > 0: a query also cannot see keys `window` or more positions back (sliding window)
    mut [float32, width = 16, height = 16]'actor tile_q
    mut [float32, width = 16, height = 16]'actor tile_k

    init([float32]'global qi, [float32]'global ki,
         int sq, int sk, int d_q, int d_kv, int dh, int nh, int grp, float32 sc, int caus, int caus_off,
         float32 cap, int win):
        q      = qi.reshape(col = d_q, row = sq)
        k      = ki.reshape(col = sk, row = d_kv)
        seq_q  = sq
        seq_k  = sk
        d_head = dh
        n_head = nh
        group  = grp
        scale  = sc
        causal = caus
        causal_offset = caus_off
        softcap = cap
        window = win
        c      = [0.0 for j = sk, i = sq, h = nh]

    def ():
        let tx  = .thread.x
        let ty  = .thread.y
        let h   = .block.z
        let i   = .block.y * .block_dim.y + ty
        let j   = .block.x * .block_dim.x + tx
        let q_off = h * d_head
        let kv_h = h / group
        let k_off = kv_h * d_head
        var float32 s = 0.0
        let num_tiles = (d_head + 15) / 16
        for t in 0..<num_tiles:
            let p = t * 16
            if i < seq_q and (p + tx) < d_head:
                tile_q[width = tx, height = ty] = q[col = q_off + p + tx, row = i]
            else:
                tile_q[width = tx, height = ty] = 0.0
            if j < seq_k and (p + ty) < d_head:
                tile_k[width = tx, height = ty] = k[col = j, row = k_off + p + ty]
            else:
                tile_k[width = tx, height = ty] = 0.0
            sync
            for kk in 0..<16:
                s += tile_q[width = kk, height = ty] * tile_k[width = tx, height = kk]
            sync
        s = s * scale
        if softcap > 0.0:
            s = softcap * (s / softcap).tanh()
        if causal == 1 and j > i + causal_offset:
            s = -1.0e9 as float32
        if causal == 1 and window > 0 and j + window <= i + causal_offset:
            s = -1.0e9 as float32
        if i < seq_q and j < seq_k:
            c[j = j, i = i, h = h] = s

# ── Kernel: row-wise softmax — identical to whisper-boring's, float32 ────

kernel SoftmaxRowsKernel:
    let  [float32, col, row]'global   scores_in
    mut  [float32, col, row]'unified  probs

    init([float32]'global s, int r, int c):
        scores_in = s.reshape(col = c, row = r)
        probs     = [0.0 for col = c, row = r]

    def ():
        let i = .thread.x + .block.x * .block_dim.x
        if i < probs.row:
            var float32 mx = scores_in[col = 0, row = i]
            for j in 0..<probs.col:
                if scores_in[col = j, row = i] > mx: mx = scores_in[col = j, row = i]
            var float32 total = 0.0
            for j in 0..<probs.col:
                let e = (scores_in[col = j, row = i] - mx).exp()
                probs[col = j, row = i] = e
                total += e
            for j in 0..<probs.col:
                probs[col = j, row = i] = probs[col = j, row = i] / total

# ── Kernel: attention output, ALL HEADS in one dispatch, GQA-aware ───────
# `v` is (seq_k × n_kv_head*d_head) — narrower than `probs`' n_head, so the
# same `kv_h = h / group` mapping applies here too.

kernel MatMulHeadsKernel:
    let  [float32, p, i, h]'global   probs      # (n_head × seq_q × seq_k)
    let  [float32, col, row]'global  v          # (seq_k × n_kv_head*d_head)
    mut  [float32, col, row]'unified c          # output: (seq_q × n_head*d_head)
    let int             d_head
    let int             n_head
    let int             group

    init([float32]'global pi, [float32]'global vi,
         int sq, int sk, int d_q, int d_kv, int dh, int nh, int grp):
        probs  = pi.reshape(p = sk, i = sq, h = nh)
        v      = vi.reshape(col = d_kv, row = sk)
        c      = [0.0 for col = d_q, row = sq]
        d_head = dh
        n_head = nh
        group  = grp

    def ():
        let cell = .thread.x + .block.x * .block_dim.x
        if cell < c.row * c.col:
            let i   = cell / c.col
            let col = cell % c.col
            let h   = col / d_head
            let jl  = col % d_head
            let kv_h = h / group
            var float32 s = 0.0
            for p in 0..<v.row:
                s += probs[p = p, i = i, h = h] * v[col = kv_h * d_head + jl, row = p]
            c[col = col, row = i] = s

# ── Kernel: fused (flash-style) attention, d_head = 64 or 128 ───────────
# The three-kernel path below materializes an (n_head x seq_q x seq_k) score
# matrix and re-reads it twice — at a 512-token prefill chunk over a 5.6k-token
# cache that is ~160 MB per layer and about half of a cold prefill. These
# kernels never build it: one 16x16 workgroup per (head, block of 16 query rows)
# walks the keys 16 at a time, keeping a running max / sum / output per row
# (online softmax), reading K and V straight from the cache layout (no
# transpose) and skipping key tiles that are entirely masked by causality.
# Thread (tx, ty) owns query row `ty`; during the P*V step it accumulates the
# output dims tx, tx+16, tx+32, ... in the thread-private array `acc` (4 entries
# for d_head 64, 8 for 128). One source per head size (tile width and
# accumulator count are compile-time sizes); any other d_head, and single-query
# decode, keep the three-kernel path.
kernel FlashAttnKernel<int D>:
    let  [float32, col, row]'global   q          # (seq_q × n_head*64)
    let  [float32, col, row]'global   k          # (seq_k × n_kv_head*64), cache layout
    let  [float32, col, row]'global   v          # (seq_k × n_kv_head*64)
    mut  [float32, col, row]'unified  o          # (seq_q × n_head*64)
    let int             seq_q
    let int             seq_k
    let int             group
    let float32         scale
    let int             causal
    let int             causal_offset
    mut [float32, width = D, height = 16]'actor q_tile
    mut [float32, width = D, height = 16]'actor k_tile
    mut [float32, width = D, height = 16]'actor v_tile
    mut [float32, width = 16, height = 16]'actor p_tile
    mut [float32, D / 16] acc        # thread-private: this thread's 4 output dims

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         int sq, int sk, int d_q, int d_kv, int grp, float32 sc, int caus, int caus_off):
        q      = qi.reshape(col = d_q, row = sq)
        k      = ki.reshape(col = d_kv, row = sk)
        v      = vi.reshape(col = d_kv, row = sk)
        o      = [0.0 for col = d_q, row = sq]
        seq_q  = sq
        seq_k  = sk
        group  = grp
        scale  = sc
        causal = caus
        causal_offset = caus_off

    def ():
        let tx   = .thread.x
        let ty   = .thread.y
        let h    = .block.z
        let row0 = .block.y * 16
        let i    = row0 + ty
        let q_off = h * D
        let k_off = (h / group) * D
        for r in 0..<(D / 16):
            let idx = ty * 16 + tx + r * 256
            let rr = idx / D
            let cc = idx % D
            if row0 + rr < seq_q:
                q_tile[width = cc, height = rr] = q[col = q_off + cc, row = row0 + rr]
            else:
                q_tile[width = cc, height = rr] = 0.0
        for e in 0..<(D / 16):
            acc[e] = 0.0
        var float32 m = -1.0e30
        var float32 l = 0.0
        var int kmax = seq_k
        if causal == 1:
            let lim = causal_offset + row0 + 16
            if lim < kmax:
                kmax = lim
        let ntiles = (kmax + 15) / 16
        for t in 0..<ntiles:
            let j0 = t * 16
            sync
            for r in 0..<(D / 16):
                let idx = ty * 16 + tx + r * 256
                let rr = idx / D
                let cc = idx % D
                if j0 + rr < seq_k:
                    k_tile[width = cc, height = rr] = k[col = k_off + cc, row = j0 + rr]
                    v_tile[width = cc, height = rr] = v[col = k_off + cc, row = j0 + rr]
                else:
                    k_tile[width = cc, height = rr] = 0.0
                    v_tile[width = cc, height = rr] = 0.0
            sync
            var float32 s = 0.0
            for d in 0..<D:
                s += q_tile[width = d, height = ty] * k_tile[width = d, height = tx]
            s = s * scale
            let jg = j0 + tx
            var int ok = 1
            if jg >= seq_k:
                ok = 0
            if causal == 1 and jg > i + causal_offset:
                ok = 0
            if ok == 0:
                s = -1.0e30 as float32
            p_tile[width = tx, height = ty] = s
            sync
            var float32 mx = m
            for j in 0..<16:
                let sv = p_tile[width = j, height = ty]
                if sv > mx:
                    mx = sv
            let alpha = (m - mx).exp()
            var float32 pv = 0.0
            if ok == 1:
                pv = (s - mx).exp()
            sync
            p_tile[width = tx, height = ty] = pv
            sync
            for e in 0..<(D / 16):
                acc[e] = acc[e] * alpha
            var float32 psum = 0.0
            for j in 0..<16:
                let pj = p_tile[width = j, height = ty]
                psum += pj
                for e in 0..<(D / 16):
                    acc[e] += pj * v_tile[width = tx + 16 * e, height = j]
            l = l * alpha + psum
            m = mx
        if i < seq_q:
            var float32 inv = 0.0
            if l > 0.0:
                inv = 1.0 / l
            for e in 0..<(D / 16):
                o[col = q_off + tx + 16 * e, row = i] = acc[e] * inv

pub req [float32]'kernel'unified attention_flash64_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head,
                          bool causal, int causal_offset) throws:
    let int d_q   = n_head * 64
    let int d_kv  = n_kv_head * 64
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (64.0 as float32).sqrt()
    let int causal_i = if causal: 1 else: 0
    mut kf = FlashAttnKernel<64>(q, k, v, seq_q, seq_k, d_q, d_kv, group, scale, causal_i, causal_offset)
    kernel:
        kf(block = (16, 16), grid = (1, (seq_q + 15) / 16, n_head))
    kf.o

# Prefill attention for d_head D (64 or 128) with register blocking. One block handles 32 query rows of one
# head against all the keys the causal mask allows, 64 keys per step; each thread owns a micro-tile
# of 2 query rows x 4 keys of scores and 2 rows x 8 output dimensions, so the score loop does 6
# shared reads per 8 multiply-adds (the 16 x 16 kernel above does 2 per 1) and the value loop 10 per
# 16. The 16 threads sharing a query row combine their row maxima with warp shuffles and keep a
# partial row sum that is reduced once at the end. Tiles are padded by one column to avoid bank
# conflicts. Same interface and masking as FlashAttnKernel<D>.
kernel FlashAttnRegKernel<int D>:
    let  [float32, col, row]'global   q          # (seq_q x n_head*D)
    let  [float32, col, row]'global   k          # (seq_k x n_kv_head*D), cache layout
    let  [float32, col, row]'global   v          # (seq_k x n_kv_head*D)
    mut  [float32, col, row]'unified  o          # (seq_q x n_head*D)
    let int             seq_q
    let int             seq_k
    let int             group
    let float32         scale
    let int             causal
    let int             causal_offset
    mut [float32, width = 33, height = 32]'actor rq_s     # query chunk: 32 rows x 32 dimensions
    mut [float32, width = 33, height = 64]'actor rk_s     # key chunk: 64 keys x 32 dimensions
    mut [float32, width = 65, height = 32]'actor rp_s     # probabilities: 32 rows x 64 keys
    mut [float32, width = D + 1, height = 16]'actor rv_s    # value sub-tile: 16 keys x D dimensions
    mut [float32, 8] rs         # thread-private: scores of 2 rows x 4 keys
    mut [float32, D / 8] racc   # thread-private: 2 rows x D/16 output dimensions
    mut [float32, 2] rm         # running row maxima
    mut [float32, 2] rl         # partial row sums (this thread's keys only)

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         int sq, int sk, int d_q, int d_kv, int grp, float32 sc, int caus, int caus_off):
        q      = qi.reshape(col = d_q, row = sq)
        k      = ki.reshape(col = d_kv, row = sk)
        v      = vi.reshape(col = d_kv, row = sk)
        o      = [0.0 for col = d_q, row = sq]
        seq_q  = sq
        seq_k  = sk
        group  = grp
        scale  = sc
        causal = caus
        causal_offset = caus_off

    def ():
        let tx   = .thread.x
        let ty   = .thread.y
        let h    = .block.z
        let row0 = .block.y * 32
        let q_off = h * D
        let k_off = (h / group) * D
        let lin  = ty * 16 + tx
        for e in 0..<D / 8:
            racc[e] = 0.0
        for i in 0..<2:
            rm[i] = -1.0e30
            rl[i] = 0.0
        var int kmax = seq_k
        if causal == 1:
            let lim = causal_offset + row0 + 32
            if lim < kmax:
                kmax = lim
        let ntiles = (kmax + 63) / 64
        for t in 0..<ntiles:
            let j0 = t * 64
            for e in 0..<8:
                rs[e] = 0.0
            for dc in 0..<D / 32:
                sync
                for r in 0..<4:
                    let idx = lin + r * 256
                    let rr = idx / 32
                    let cc = idx % 32
                    if row0 + rr < seq_q:
                        rq_s[width = cc, height = rr] = q[col = q_off + dc * 32 + cc, row = row0 + rr]
                    else:
                        rq_s[width = cc, height = rr] = 0.0
                for r in 0..<8:
                    let idx = lin + r * 256
                    let rr = idx / 32
                    let cc = idx % 32
                    if j0 + rr < seq_k:
                        rk_s[width = cc, height = rr] = k[col = k_off + dc * 32 + cc, row = j0 + rr]
                    else:
                        rk_s[width = cc, height = rr] = 0.0
                sync
                for d in 0..<32:
                    let qa0 = rq_s[width = d, height = ty]
                    let qa1 = rq_s[width = d, height = ty + 16]
                    for j in 0..<4:
                        let kb = rk_s[width = d, height = tx + 16 * j]
                        rs[j] = rs[j] + qa0 * kb
                        rs[4 + j] = rs[4 + j] + qa1 * kb
            for i in 0..<2:
                let row = row0 + ty + 16 * i
                var float32 lmax = -1.0e30
                for j in 0..<4:
                    let key = j0 + tx + 16 * j
                    var float32 sv = rs[i * 4 + j] * scale
                    var int ok = 1
                    if key >= seq_k:
                        ok = 0
                    if causal == 1 and key > row + causal_offset:
                        ok = 0
                    if ok == 0:
                        sv = -1.0e30 as float32
                    rs[i * 4 + j] = sv
                    if sv > lmax:
                        lmax = sv
                var int off = 8
                while off > 0:
                    let other = .warp.shuffle_xor(lmax, off)
                    if other > lmax:
                        lmax = other
                    off = off / 2
                var float32 mx = rm[i]
                if lmax > mx:
                    mx = lmax
                let alpha = (rm[i] - mx).exp()
                var float32 psum = 0.0
                for j in 0..<4:
                    var float32 pv = 0.0
                    if rs[i * 4 + j] > -1.0e29:
                        pv = (rs[i * 4 + j] - mx).exp()
                    psum += pv
                    rp_s[width = tx + 16 * j, height = ty + 16 * i] = pv
                rl[i] = rl[i] * alpha + psum
                rm[i] = mx
                for e in 0..<D / 16:
                    racc[i * (D / 16) + e] = racc[i * (D / 16) + e] * alpha
            for vs in 0..<4:
                sync
                for r in 0..<D / 16:
                    let idx = lin + r * 256
                    let rr = idx / D
                    let cc = idx % D
                    if j0 + vs * 16 + rr < seq_k:
                        rv_s[width = cc, height = rr] = v[col = k_off + cc, row = j0 + vs * 16 + rr]
                    else:
                        rv_s[width = cc, height = rr] = 0.0
                sync
                for jl in 0..<16:
                    let pj0 = rp_s[width = vs * 16 + jl, height = ty]
                    let pj1 = rp_s[width = vs * 16 + jl, height = ty + 16]
                    for e in 0..<D / 16:
                        let ve = rv_s[width = tx + 16 * e, height = jl]
                        racc[e] = racc[e] + pj0 * ve
                        racc[D / 16 + e] = racc[D / 16 + e] + pj1 * ve
        for i in 0..<2:
            var float32 lt = rl[i]
            var int off = 8
            while off > 0:
                lt += .warp.shuffle_xor(lt, off)
                off = off / 2
            var float32 inv = 0.0
            if lt > 0.0:
                inv = 1.0 / lt
            let row = row0 + ty + 16 * i
            if row < seq_q:
                for e in 0..<D / 16:
                    o[col = q_off + tx + 16 * e, row = row] = racc[i * (D / 16) + e] * inv


pub req [float32]'kernel'unified attention_flash64reg_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head,
                          bool causal, int causal_offset) throws:
    let int d_q   = n_head * 64
    let int d_kv  = n_kv_head * 64
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (64.0 as float32).sqrt()
    let int causal_i = if causal: 1 else: 0
    mut kf = FlashAttnRegKernel<64>(q, k, v, seq_q, seq_k, d_q, d_kv, group, scale, causal_i, causal_offset)
    kernel:
        kf(block = (16, 16), grid = (1, (seq_q + 31) / 32, n_head))
    kf.o

pub req [float32]'kernel'unified attention_flash128reg_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head,
                          bool causal, int causal_offset) throws:
    let int d_q   = n_head * 128
    let int d_kv  = n_kv_head * 128
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (128.0 as float32).sqrt()
    let int causal_i = if causal: 1 else: 0
    mut kf = FlashAttnRegKernel<128>(q, k, v, seq_q, seq_k, d_q, d_kv, group, scale, causal_i, causal_offset)
    kernel:
        kf(block = (16, 16), grid = (1, (seq_q + 31) / 32, n_head))
    kf.o

pub req [float32]'kernel'unified attention_flash128_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head,
                          bool causal, int causal_offset) throws:
    let int d_q   = n_head * 128
    let int d_kv  = n_kv_head * 128
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (128.0 as float32).sqrt()
    let int causal_i = if causal: 1 else: 0
    mut kf = FlashAttnKernel<128>(q, k, v, seq_q, seq_k, d_q, d_kv, group, scale, causal_i, causal_offset)
    kernel:
        kf(block = (16, 16), grid = (1, (seq_q + 15) / 16, n_head))
    kf.o

# ── Kernels: split-K decode attention (one query row), d_head = 64 or 128 ──
kernel FlashDecodeKernel<int D>:
    let  [float32]'global   q          # (n_head*D), the single query row
    let  [float32]'global   k          # (seq_k * d_kv), cache layout, flat
    let  [float32]'global   v          # (seq_k * d_kv)
    mut  [float32]'unified  part       # per (head, split): m, l, then D partial output dims
    let int             seq_k
    let int             d_kv
    let int             group
    let int             nsplit
    let int             chunk
    let float32         scale
    mut [float32, width = D, height = 1]'actor q_s
    mut [float32, width = D, height = 1]'actor p_s

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         int sk, int dkv, int grp, int ns, int ch, float32 sc, int nparts):
        q      = qi
        k      = ki
        v      = vi
        seq_k  = sk
        d_kv   = dkv
        group  = grp
        nsplit = ns
        chunk  = ch
        scale  = sc
        part   = [0.0 for ..<nparts]

    def ():
        let t     = .thread.x
        let split = .block.x
        let h     = .block.y
        let k_off = (h / group) * D
        let start = split * chunk
        var int stop = start + chunk
        if stop > seq_k:
            stop = seq_k
        q_s[width = t, height = 0] = q[h * D + t]
        var float32 m = -1.0e30
        var float32 l = 0.0
        var float32 acc = 0.0
        var int ntiles = 0
        if stop > start:
            ntiles = (stop - start + D - 1) / D
        for ti in 0..<ntiles:
            let j0 = start + ti * D
            let jg = j0 + t
            sync
            var float32 s = -1.0e30
            if jg < stop:
                var float32 dot = 0.0
                for d in 0..<D:
                    dot += q_s[width = d, height = 0] * k[jg * d_kv + k_off + d]
                s = dot * scale
            p_s[width = t, height = 0] = s
            sync
            var float32 mx = m
            for j in 0..<D:
                let sv = p_s[width = j, height = 0]
                if sv > mx:
                    mx = sv
            let alpha = (m - mx).exp()
            var float32 pv = 0.0
            if jg < stop:
                pv = (s - mx).exp()
            sync
            p_s[width = t, height = 0] = pv
            sync
            var float32 psum = 0.0
            var float32 nacc = 0.0
            for j in 0..<D:
                let pj = p_s[width = j, height = 0]
                psum += pj
                if j0 + j < stop:
                    nacc += pj * v[(j0 + j) * d_kv + k_off + t]
            l = l * alpha + psum
            acc = acc * alpha + nacc
            m = mx
        let base = (h * nsplit + split) * (D + 2)
        part[base + 2 + t] = acc
        if t == 0:
            part[base] = m
            part[base + 1] = l

kernel FlashDecodeCombineKernel<int D>:
    let  [float32]'global   part
    mut  [float32]'unified  o          # (n_head*D)
    let int             nsplit

    init([float32]'global pi, int ns, int n):
        part   = pi
        nsplit = ns
        o      = [0.0 for ..<n]

    def ():
        let t = .thread.x
        let h = .block.x
        var float32 big = -1.0e30
        for s in 0..<nsplit:
            let ms = part[(h * nsplit + s) * (D + 2)]
            if ms > big:
                big = ms
        var float32 total = 0.0
        var float32 a = 0.0
        for s in 0..<nsplit:
            let base = (h * nsplit + s) * (D + 2)
            let w = (part[base] - big).exp()
            total += part[base + 1] * w
            a += part[base + 2 + t] * w
        var float32 res = 0.0
        if total > 0.0:
            res = a / total
        o[h * D + t] = res

# One query row against the whole cache, split over keys: `nsplit` workgroups per
# head each run an online softmax over a contiguous key range and write a partial
# (max, sum, output); the combine kernel merges them. Replaces the three-kernel
# path for single-query decode, which transposed the entire K cache and
# materialized an n_head x seq_k score matrix for every layer of every token.
pub req [float32]'kernel'unified attention_decode64_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_k, int n_head, int n_kv_head) throws:
    let int d_kv  = n_kv_head * 64
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (64.0 as float32).sqrt()
    var int nsplit = (seq_k + 127) / 128
    if nsplit < 1:
        nsplit = 1
    if nsplit > 64:
        nsplit = 64
    let int chunk = (seq_k + nsplit - 1) / nsplit
    mut kd = FlashDecodeKernel<64>(q, k, v, seq_k, d_kv, group, nsplit, chunk, scale, n_head * nsplit * (64 + 2))
    kernel:
        kd(block = 64, grid = (nsplit, n_head))
    mut kc = FlashDecodeCombineKernel<64>(kd.part, nsplit, n_head * 64)
    kernel:
        kc(block = 64, grid = n_head)
    kc.o

# One query row against the whole cache, split over keys: `nsplit` workgroups per
# head each run an online softmax over a contiguous key range and write a partial
# (max, sum, output); the combine kernel merges them. Replaces the three-kernel
# path for single-query decode, which transposed the entire K cache and
# materialized an n_head x seq_k score matrix for every layer of every token.
pub req [float32]'kernel'unified attention_decode128_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_k, int n_head, int n_kv_head) throws:
    let int d_kv  = n_kv_head * 128
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (128.0 as float32).sqrt()
    var int nsplit = (seq_k + 127) / 128
    if nsplit < 1:
        nsplit = 1
    if nsplit > 64:
        nsplit = 64
    let int chunk = (seq_k + nsplit - 1) / nsplit
    mut kd = FlashDecodeKernel<128>(q, k, v, seq_k, d_kv, group, nsplit, chunk, scale, n_head * nsplit * (128 + 2))
    kernel:
        kd(block = 128, grid = (nsplit, n_head))
    mut kc = FlashDecodeCombineKernel<128>(kd.part, nsplit, n_head * 128)
    kernel:
        kc(block = 128, grid = n_head)
    kc.o

# ── Decode attention over a cache split in two buffers ───────────────────
# The cache is a main buffer (positions 0..main_len) plus a short tail buffer
# holding the newest rows. Appending one token's K/V then copies only the tail
# (a few dozen rows) instead of the whole cache, which `boring` has to copy
# because a kernel cannot grow a device buffer in place; the tail is folded into
# the main buffer every TAIL_MAX tokens. Same kernels as FlashDecode64/128 above,
# each key/value row read from the main or the tail buffer by its position.

kernel FlashDecodeTailKernel<int D>:
    let  [float32]'global   q          # (n_head*D), the single query row
    let  [float32]'global   k          # (seq_k * d_kv), cache layout, flat
    let  [float32]'global   v          # (main_len * d_kv)
    let  [float32]'global   tk         # the newest (seq_k - main_len) rows of K
    let  [float32]'global   tv
    let int             main_len
    mut  [float32]'unified  part       # per (head, split): m, l, then D partial output dims
    let int             seq_k
    let int             d_kv
    let int             group
    let int             nsplit
    let int             chunk
    let float32         scale
    mut [float32, width = D, height = 1]'actor q_s
    mut [float32, width = D, height = 1]'actor p_s

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         [float32]'global tki, [float32]'global tvi, int ml,
         int sk, int dkv, int grp, int ns, int ch, float32 sc, int nparts):
        q      = qi
        k      = ki
        v      = vi
        tk     = tki
        tv     = tvi
        main_len = ml
        seq_k  = sk
        d_kv   = dkv
        group  = grp
        nsplit = ns
        chunk  = ch
        scale  = sc
        part   = [0.0 for ..<nparts]

    def ():
        let t     = .thread.x
        let split = .block.x
        let h     = .block.y
        let k_off = (h / group) * D
        let start = split * chunk
        var int stop = start + chunk
        if stop > seq_k:
            stop = seq_k
        q_s[width = t, height = 0] = q[h * D + t]
        var float32 m = -1.0e30
        var float32 l = 0.0
        var float32 acc = 0.0
        var int ntiles = 0
        if stop > start:
            ntiles = (stop - start + D - 1) / D
        for ti in 0..<ntiles:
            let j0 = start + ti * D
            let jg = j0 + t
            sync
            var float32 s = -1.0e30
            if jg < stop:
                var float32 dot = 0.0
                if jg < main_len:
                    for d in 0..<D:
                        dot += q_s[width = d, height = 0] * k[jg * d_kv + k_off + d]
                else:
                    for d in 0..<D:
                        dot += q_s[width = d, height = 0] * tk[(jg - main_len) * d_kv + k_off + d]
                s = dot * scale
            p_s[width = t, height = 0] = s
            sync
            var float32 mx = m
            for j in 0..<D:
                let sv = p_s[width = j, height = 0]
                if sv > mx:
                    mx = sv
            let alpha = (m - mx).exp()
            var float32 pv = 0.0
            if jg < stop:
                pv = (s - mx).exp()
            sync
            p_s[width = t, height = 0] = pv
            sync
            var float32 psum = 0.0
            var float32 nacc = 0.0
            for j in 0..<D:
                let pj = p_s[width = j, height = 0]
                psum += pj
                if j0 + j < stop:
                    if j0 + j < main_len:
                        nacc += pj * v[(j0 + j) * d_kv + k_off + t]
                    else:
                        nacc += pj * tv[(j0 + j - main_len) * d_kv + k_off + t]
            l = l * alpha + psum
            acc = acc * alpha + nacc
            m = mx
        let base = (h * nsplit + split) * (D + 2)
        part[base + 2 + t] = acc
        if t == 0:
            part[base] = m
            part[base + 1] = l

# Single-query decode attention for a main + tail cache, one simdgroup (32 threads) per
# (key split, KV head). Every query head of the group (at most 8) is handled by the same
# simdgroup, so each K and V row is read once per group; lane `l` owns dimensions l, l+32,
# l+64 and l+96, which makes every row read fully coalesced, keeps the query slice and the
# output accumulators in registers, and reduces the dot products with warp shuffles (no
# shared memory, no barriers). The partial results keep the head-major layout of
# FlashDecodeTail128Kernel, so FlashDecodeCombine128Kernel merges them unchanged.
kernel FlashDecodeWarpTail128Kernel:
    let  [float32]'global   q          # (n_head*128), the single query row
    let  [float32]'global   k          # (main_len * d_kv)
    let  [float32]'global   v
    let  [float32]'global   tk         # the newest (seq_k - main_len) rows of K
    let  [float32]'global   tv
    let int             main_len
    mut  [float32]'unified  part       # per (head, split): m, l, then 128 partial output dims
    let int             seq_k
    let int             d_kv
    let int             group
    let int             nsplit
    let int             chunk
    let float32         scale
    mut [float32, 32] wq        # thread-private: 4 query values per head of the group
    mut [float32, 32] wa        # 4 output accumulators per head
    mut [float32, 8] wm
    mut [float32, 8] wl
    mut [float32, 8] ws

    init([float32]'global qi, [float32]'global ki, [float32]'global vi,
         [float32]'global tki, [float32]'global tvi, int ml,
         int sk, int dkv, int grp, int ns, int ch, float32 sc, int nparts):
        q      = qi
        k      = ki
        v      = vi
        tk     = tki
        tv     = tvi
        main_len = ml
        seq_k  = sk
        d_kv   = dkv
        group  = grp
        nsplit = ns
        chunk  = ch
        scale  = sc
        part   = [0.0 for ..<nparts]

    def ():
        let lane  = .thread.x
        let split = .block.x
        let kvh   = .block.y
        let k_off = kvh * 128
        let start = split * chunk
        var int stop = start + chunk
        if stop > seq_k:
            stop = seq_k
        for g in 0..<8:
            for i in 0..<4:
                if g < group:
                    wq[g * 4 + i] = q[(kvh * group + g) * 128 + lane + 32 * i] * scale
                else:
                    wq[g * 4 + i] = 0.0
                wa[g * 4 + i] = 0.0
            wm[g] = -1.0e30
            wl[g] = 0.0
        var int j = start
        while j < stop:
            var float32 k0 = 0.0
            var float32 k1 = 0.0
            var float32 k2 = 0.0
            var float32 k3 = 0.0
            var float32 v0 = 0.0
            var float32 v1 = 0.0
            var float32 v2 = 0.0
            var float32 v3 = 0.0
            if j < main_len:
                let o = j * d_kv + k_off + lane
                k0 = k[o]
                k1 = k[o + 32]
                k2 = k[o + 64]
                k3 = k[o + 96]
                v0 = v[o]
                v1 = v[o + 32]
                v2 = v[o + 64]
                v3 = v[o + 96]
            else:
                let o = (j - main_len) * d_kv + k_off + lane
                k0 = tk[o]
                k1 = tk[o + 32]
                k2 = tk[o + 64]
                k3 = tk[o + 96]
                v0 = tv[o]
                v1 = tv[o + 32]
                v2 = tv[o + 64]
                v3 = tv[o + 96]
            for g in 0..<8:
                var float32 s = wq[g * 4] * k0 + wq[g * 4 + 1] * k1 + wq[g * 4 + 2] * k2 + wq[g * 4 + 3] * k3
                var int offset = 16
                while offset > 0:
                    s += .warp.shuffle_xor(s, offset)
                    offset = offset / 2
                ws[g] = s
            for g in 0..<8:
                var float32 mn = wm[g]
                if ws[g] > mn:
                    mn = ws[g]
                let alpha = (wm[g] - mn).exp()
                let p = (ws[g] - mn).exp()
                wl[g] = wl[g] * alpha + p
                wa[g * 4] = wa[g * 4] * alpha + p * v0
                wa[g * 4 + 1] = wa[g * 4 + 1] * alpha + p * v1
                wa[g * 4 + 2] = wa[g * 4 + 2] * alpha + p * v2
                wa[g * 4 + 3] = wa[g * 4 + 3] * alpha + p * v3
                wm[g] = mn
            j += 1
        for g in 0..<8:
            if g < group:
                let base = ((kvh * group + g) * nsplit + split) * (128 + 2)
                for i in 0..<4:
                    part[base + 2 + lane + 32 * i] = wa[g * 4 + i]
                if lane == 0:
                    part[base] = wm[g]
                    part[base + 1] = wl[g]

pub req [float32]'kernel'unified attention_decode128_group_tail_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          [float32]'kernel'global tk, [float32]'kernel'global tv, int main_len,
                          int seq_k, int n_head, int n_kv_head) throws:
    let int d_kv  = n_kv_head * 128
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (128.0 as float32).sqrt()
    var int nsplit = (seq_k + 63) / 64
    if nsplit < 1:
        nsplit = 1
    if nsplit > 64:
        nsplit = 64
    let int chunk = (seq_k + nsplit - 1) / nsplit
    mut kd = FlashDecodeWarpTail128Kernel(q, k, v, tk, tv, main_len, seq_k, d_kv, group, nsplit, chunk, scale, n_head * nsplit * (128 + 2))
    kernel:
        kd(block = 32, grid = (nsplit, n_kv_head))
    mut kc = FlashDecodeCombineKernel<128>(kd.part, nsplit, n_head * 128)
    kernel:
        kc(block = 128, grid = n_head)
    kc.o

pub req [float32]'kernel'unified attention_decode64_tail_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          [float32]'kernel'global tk, [float32]'kernel'global tv, int main_len,
                          int seq_k, int n_head, int n_kv_head) throws:
    let int d_kv  = n_kv_head * 64
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (64.0 as float32).sqrt()
    var int nsplit = (seq_k + 127) / 128
    if nsplit < 1:
        nsplit = 1
    if nsplit > 64:
        nsplit = 64
    let int chunk = (seq_k + nsplit - 1) / nsplit
    mut kd = FlashDecodeTailKernel<64>(q, k, v, tk, tv, main_len, seq_k, d_kv, group, nsplit, chunk, scale, n_head * nsplit * (64 + 2))
    kernel:
        kd(block = 64, grid = (nsplit, n_head))
    mut kc = FlashDecodeCombineKernel<64>(kd.part, nsplit, n_head * 64)
    kernel:
        kc(block = 64, grid = n_head)
    kc.o

pub req [float32]'kernel'unified attention_decode128_tail_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          [float32]'kernel'global tk, [float32]'kernel'global tv, int main_len,
                          int seq_k, int n_head, int n_kv_head) throws:
    let int d_kv  = n_kv_head * 128
    let int group = n_head / n_kv_head
    let float32 scale = 1.0 / (128.0 as float32).sqrt()
    var int nsplit = (seq_k + 127) / 128
    if nsplit < 1:
        nsplit = 1
    if nsplit > 64:
        nsplit = 64
    let int chunk = (seq_k + nsplit - 1) / nsplit
    mut kd = FlashDecodeTailKernel<128>(q, k, v, tk, tv, main_len, seq_k, d_kv, group, nsplit, chunk, scale, n_head * nsplit * (128 + 2))
    kernel:
        kd(block = 128, grid = (nsplit, n_head))
    mut kc = FlashDecodeCombineKernel<128>(kd.part, nsplit, n_head * 128)
    kernel:
        kc(block = 128, grid = n_head)
    kc.o

# Single-query attention for a cache split in main and tail buffers
# (d_head 64 or 128; the model code folds the tail first for any other width).
pub req [float32]'kernel'unified attention_gqa_tail_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          [float32]'kernel'global tk, [float32]'kernel'global tv, int main_len,
                          int seq_k, int n_head, int n_kv_head, int d_head) throws:
    if d_head == 64:
        attention_decode64_tail_gpu(q, k, v, tk, tv, main_len, seq_k, n_head, n_kv_head)
    elif d_head == 128 and n_head / n_kv_head <= 8:
        attention_decode128_group_tail_gpu(q, k, v, tk, tv, main_len, seq_k, n_head, n_kv_head)
    elif d_head == 128:
        attention_decode128_tail_gpu(q, k, v, tk, tv, main_len, seq_k, n_head, n_kv_head)
    else:
        let kv_dim = n_kv_head * d_head
        let full_k = kv_append_gpu(k, tk, main_len * kv_dim, (seq_k - main_len) * kv_dim)
        let full_v = kv_append_gpu(v, tv, main_len * kv_dim, (seq_k - main_len) * kv_dim)
        attention_gqa_three_kernel_gpu(q, full_k, full_v, 1, seq_k, n_head, n_kv_head, d_head, false, 0)

# Single-query attention over a main + tail cache for Gemma 2/3: joins the tail
# into a full cache, then runs the general path with the layer's scale, score
# soft-cap and sliding window (the query sits at position seq_k - 1).
pub req [float32]'kernel'unified attention_tail_ext_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          [float32]'kernel'global tk, [float32]'kernel'global tv, int main_len,
                          int seq_k, int n_head, int n_kv_head, int d_head,
                          float32 scale, float32 softcap, int window) throws:
    let kv_dim = n_kv_head * d_head
    let full_k = kv_append_gpu(k, tk, main_len * kv_dim, (seq_k - main_len) * kv_dim)
    let full_v = kv_append_gpu(v, tv, main_len * kv_dim, (seq_k - main_len) * kv_dim)
    attention_gqa_ext_gpu(q, full_k, full_v, 1, seq_k, n_head, n_kv_head, d_head, true, seq_k - 1, scale, softcap, window)

# Appends `fresh` (new_n floats) to a tail buffer holding `old_n` floats; an
# empty tail (`old_n` = 0) has nothing to bind, so the result is a copy of `fresh`.
pub req [float32]'kernel'unified kv_tail_push([float32]'kernel'global prev, [float32]'kernel'global fresh,
                                           int old_n, int new_n) throws:
    if old_n == 0:
        upload_floats_gpu(fresh)
    else:
        kv_append_gpu(prev, fresh, old_n, new_n)

# Produces the rotated Q row and both updated cache tails in one dispatch from
# a joined QKV projection. This is the complete decode epilogue for fused
# Q8_0 projections: after the matvec, attention-ready buffers cost one launch.
pub req ([float32]'kernel'unified, [float32]'kernel'unified, [float32]'kernel'unified) prepare_qkv_decode_slice(
        [float32]'kernel'global prev_k, [float32]'kernel'global prev_v,
        [float32]'kernel'global qkv, int old_n, int n_head, int n_kv_head,
        int d_head, [float32]'kernel'global rope_freqs, int pos, int neox) throws:
    let int q_dim = n_head * d_head
    let int kv_dim = n_kv_head * d_head
    let int tail_n = old_n + kv_dim
    let int half_dim = d_head / 2
    let int q_pairs = n_head * half_dim
    let int kv_pairs = n_kv_head * half_dim
    var int work_n = old_n
    if q_pairs > work_n:
        work_n = q_pairs
    if kv_pairs > work_n:
        work_n = kv_pairs
    kernel(block = 256, grid = (work_n + 255) / 256):
        mut [float32]'unified out_q = [0.0 for ..<q_dim]
        mut [float32]'unified out_k = [0.0 for ..<tail_n]
        mut [float32]'unified out_v = [0.0 for ..<tail_n]
        let i = .thread.x + .block.x * .block_dim.x
        # Preserve the existing cache prefix. The same thread can also rotate
        # a Q/K pair below; these writes target disjoint output positions.
        if i < old_n:
            out_k[i] = prev_k[i]
            out_v[i] = prev_v[i]
        # One thread owns both elements of a Q pair, so angle/sin/cos are
        # evaluated once rather than once per output element.
        if i < q_pairs:
            let h = i / half_dim
            let pair = i % half_dim
            let head_base = h * d_head
            var int first = head_base + pair
            var int second = first + half_dim
            if neox == 1:
                first = head_base + pair
                second = first + half_dim
            else:
                first = head_base + 2 * pair
                second = first + 1
            let angle = (pos as float32) * rope_freqs[pair]
            let cos_a = angle.cos() * rope_freqs[half_dim]
            let sin_a = angle.sin() * rope_freqs[half_dim]
            let x0 = qkv[first]
            let x1 = qkv[second]
            out_q[first] = x0 * cos_a - x1 * sin_a
            out_q[second] = x0 * sin_a + x1 * cos_a
        # K uses the same pair-wise rotation. V has no RoPE, so the owner of
        # the pair copies its two adjacent/logically-paired values as well.
        if i < kv_pairs:
            let h = i / half_dim
            let pair = i % half_dim
            let head_base = h * d_head
            var int first = head_base + pair
            var int second = first + half_dim
            if neox == 1:
                first = head_base + pair
                second = first + half_dim
            else:
                first = head_base + 2 * pair
                second = first + 1
            let angle = (pos as float32) * rope_freqs[pair]
            let cos_a = angle.cos() * rope_freqs[half_dim]
            let sin_a = angle.sin() * rope_freqs[half_dim]
            let x0 = qkv[q_dim + first]
            let x1 = qkv[q_dim + second]
            out_k[old_n + first] = x0 * cos_a - x1 * sin_a
            out_k[old_n + second] = x0 * sin_a + x1 * cos_a
            out_v[old_n + first] = qkv[q_dim + kv_dim + first]
            out_v[old_n + second] = qkv[q_dim + kv_dim + second]
        (out_q, out_k, out_v)

# Grouped-query multi-head attention (GPU), all heads in one dispatch per
# stage. `q` is (seq_q × n_head*d_head); `k`/`v` are (seq_k × n_kv_head*d_head).
pub req [float32]'kernel'unified attention_gqa_three_kernel_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head, int d_head,
                          bool causal, int causal_offset) throws:
    attention_gqa_ext_gpu(q, k, v, seq_q, seq_k, n_head, n_kv_head, d_head, causal, causal_offset,
                          1.0 / (d_head as float32).sqrt(), 0.0, 0)

# The general attention path (any head size): explicit score `scale`, optional
# Gemma-2 score soft-capping (`softcap` > 0) and sliding window (`window` > 0).
pub req [float32]'kernel'unified attention_gqa_ext_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head, int d_head,
                          bool causal, int causal_offset, float32 scale, float32 softcap, int window) throws:
    let int d_q     = n_head * d_head
    let int d_kv    = n_kv_head * d_head
    let int group   = n_head / n_kv_head
    let int causal_i = if causal: 1 else: 0

    let [float32]'kernel'unified k_t = transpose_gpu(k, seq_k, d_kv)

    let int score_gx = (seq_k + 15) / 16
    let int score_gy = (seq_q + 15) / 16
    mut k_scores = MatMulBTHeadsKernel(q, k_t, seq_q, seq_k, d_q, d_kv, d_head, n_head, group, scale, causal_i, causal_offset, softcap, window)
    kernel:
        k_scores(block = (16, 16), grid = (score_gx, score_gy, n_head))

    let int soft_rows  = n_head * seq_q
    let int row_blocks = (soft_rows + 255) / 256
    mut k_soft = SoftmaxRowsKernel(k_scores.c, soft_rows, seq_k)
    kernel:
        k_soft(block = 256, grid = row_blocks)

    let int out_cells  = seq_q * d_q
    let int out_blocks = (out_cells + 255) / 256
    mut k_ctx = MatMulHeadsKernel(k_soft.probs, v, seq_q, seq_k, d_q, d_kv, d_head, n_head, group)
    kernel:
        k_ctx(block = 256, grid = out_blocks)
    k_ctx.c

# Grouped-query attention entry point. Prefill shapes (seq_q > 1) take the fused
# kernels for d_head 64 / 128; a single query row that sees the whole cache
# (decode: `causal` off, or the causal offset puts it at the last position) takes
# the split-K decode kernels; anything else keeps the three-kernel path.
pub req [float32]'kernel'unified attention_gqa_gpu([float32]'kernel'global q, [float32]'kernel'global k, [float32]'kernel'global v,
                          int seq_q, int seq_k, int n_head, int n_kv_head, int d_head,
                          bool causal, int causal_offset) throws:
    let bool sees_all = (not causal) or (causal_offset + 1 >= seq_k)
    if d_head == 64 and seq_q > 1:
        attention_flash64reg_gpu(q, k, v, seq_q, seq_k, n_head, n_kv_head, causal, causal_offset)
    elif d_head == 128 and seq_q > 1:
        attention_flash128reg_gpu(q, k, v, seq_q, seq_k, n_head, n_kv_head, causal, causal_offset)
    elif d_head == 64 and seq_q == 1 and sees_all:
        attention_decode64_gpu(q, k, v, seq_k, n_head, n_kv_head)
    elif d_head == 128 and seq_q == 1 and sees_all:
        attention_decode128_gpu(q, k, v, seq_k, n_head, n_kv_head)
    else:
        attention_gqa_three_kernel_gpu(q, k, v, seq_q, seq_k, n_head, n_kv_head, d_head, causal, causal_offset)
