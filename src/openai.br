# boring-llm — OpenAI-compatible API plumbing (pure, no sockets, no GPU)
#
# Everything server.br needs that doesn't touch a socket or the model:
# normalizing an OpenAI-style `messages` array into what a GGUF chat template
# expects, pulling Hermes-style `<tool_call>` blocks (the format Qwen2.5 and
# many other instruct models emit) back out of generated text, and building
# the JSON / SSE response bodies. Kept separate so all of it can be unit-tested
# under `boring run` (test/test_openai.br) without a model or a port.
#
# Literal `{`/`}` in the JSON-building strings below are written doubled
# (`{{`/`}}`) — Boring's own interpolation syntax otherwise.

use jinja
use json_pattern
use json
use std.time.SystemTime
use std.time.UNIX_EPOCH

# ── JValue helpers ───────────────────────────────────────────────────────

bool jv_is_list(JValue v):
    match v:
        JList(items): true
        _: false

bool jv_is_dict(JValue v):
    match v:
        JDict(fields, keys): true
        _: false

bool jv_is_str(JValue v):
    match v:
        JStr(s): true
        _: false

pub int sampler_order_rank(string name):
    if name == "penalties": 0
    elif name == "dry": 1
    elif name == "top_n_sigma": 2
    elif name == "top_k": 3
    elif name == "typ_p" or name == "typical_p": 4
    elif name == "top_p": 5
    elif name == "min_p": 6
    elif name == "xtc": 7
    elif name == "temperature" or name == "temp": 8
    else: -1

pub string sampler_list_validation_error([string] names):
    var int previous_rank = -1
    for name in names:
        let rank = sampler_order_rank(name)
        if rank < 0: return "unsupported sampler `{name}`"
        if rank <= previous_rank: return "samplers must follow llama.cpp's canonical order without duplicates"
        previous_rank = rank
    ""

pub [string] request_samplers(JValue body, [string] defaults):
    var [string] names = defaults
    match json_get(body, "samplers"):
        JList(items):
            names = []
            for item in items:
                match item:
                    JStr(name): names.push(name)
                    _: true
        _: true
    names

pub bool sampler_enabled([string] names, string wanted):
    let wanted_rank = sampler_order_rank(wanted)
    for name in names:
        if sampler_order_rank(name) == wanted_rank: return true
    false

bool jv_is_bool(JValue v):
    match v:
        JBool(b): true
        _: false

bool jv_is_number(JValue v):
    match v:
        JInt(n): true
        JFloat(f): true
        _: false

bool request_value_is_undefined(JValue v):
    match v:
        JUndefined: true
        _: false

# JSON Schema equality is structural: object key order is irrelevant and the
# mathematical numbers 1 and 1.0 compare equal even if the parser stored them
# in different variants.
pub bool json_values_equal(JValue a, JValue b):
    match a:
        JUndefined:
            match b:
                JUndefined: true
                _: false
        JBool(av):
            match b:
                JBool(bv): av == bv
                _: false
        JInt(av):
            match b:
                JInt(bv): av == bv
                JFloat(bv): av as float == bv
                _: false
        JFloat(av):
            match b:
                JInt(bv): av == bv as float
                JFloat(bv): av == bv
                _: false
        JStr(av):
            match b:
                JStr(bv): av == bv
                _: false
        JList(a_items):
            match b:
                JList(b_items):
                    if a_items.length != b_items.length: return false
                    var int i = 0
                    while i < a_items.length:
                        if not json_values_equal(a_items[i], b_items[i]): return false
                        i += 1
                    true
                _: false
        JDict(a_fields, a_keys):
            match b:
                JDict(b_fields, b_keys):
                    if a_keys.length != b_keys.length: return false
                    for key in a_keys:
                        if not b_fields.contains(key): return false
                        let av = a_fields[key] else JValue.JUndefined
                        let bv = b_fields[key] else JValue.JUndefined
                        if not json_values_equal(av, bv): return false
                    true
                _: false

# Returns `d` with `key` set to `value` (appended to the key order if new).
pub JValue jv_set(JValue d, string key, JValue value):
    match d:
        JDict(fields, keys):
            mut {string=JValue} nf = fields.clone()
            mut [string] nk = keys.clone()
            if not fields.contains(key):
                nk.push(key)
            nf[key] = value
            JValue.JDict(nf, nk)
        _: d

# llama-server's native `response_fields` projects a completion response onto
# a caller-selected set of fields. Slash-separated paths are looked up in
# nested objects and flattened under their final component at the root.
pub string native_response_fields_json(string response, JValue requested) throws:
    match requested:
        JList(items):
            let source = json_parse(response)
            var JValue out = JValue.JDict({=}, [])
            for item in items:
                match item:
                    JStr(path):
                        let parts = path.split("/")
                        var JValue value = source.clone()
                        for part in parts:
                            value = json_get(value, part)
                        if not request_value_is_undefined(value):
                            out = jv_set(out, parts[parts.length - 1], value)
                    _: true
            jv_to_json(out)
        _: response

# Template variables derived from the OpenAI request. llama-server exposes
# `reasoning_effort` directly to the Jinja template. Qwen3 templates predate
# that name and read `enable_thinking`, so effort `none` also supplies false
# unless the caller explicitly set that lower-level variable.
pub JValue chat_template_variables_with_defaults(JValue body, JValue defaults):
    var JValue out = match defaults:
        JDict(fields, keys): defaults.clone()
        _: JValue.JDict({=}, [])
    let raw = json_get(body, "chat_template_kwargs")
    match raw:
        JDict(fields, keys):
            for key in keys:
                out = jv_set(out, key, fields[key])
        _: true
    let effort = json_get(body, "reasoning_effort")
    if jv_is_str(effort):
        out = jv_set(out, "reasoning_effort", effort)
        if json_get_str(body, "reasoning_effort", "") == "none" and request_value_is_undefined(json_get(out, "enable_thinking")):
            out = jv_set(out, "enable_thinking", JValue.JBool(false))
    let parallel = json_get(body, "parallel_tool_calls")
    match parallel:
        JBool(enabled): out = jv_set(out, "parallel_tool_calls", JValue.JBool(enabled))
        _: true
    out

pub JValue chat_template_variables(JValue body):
    chat_template_variables_with_defaults(body, JValue.JDict({=}, []))

pub JValue chat_template_variables_default(JValue body, string server_default):
    chat_template_variables_server_default(body, JValue.JDict({=}, []), server_default)

pub JValue chat_template_variables_server_default(JValue body, JValue server_kwargs, string server_default):
    if server_default == "" or server_default == "default" or not request_value_is_undefined(json_get(body, "reasoning_effort")):
        return chat_template_variables_with_defaults(body, server_kwargs)
    var JValue defaults = server_kwargs.clone()
    defaults = jv_set(defaults, "reasoning_effort", JValue.JStr(server_default))
    if server_default == "none" and request_value_is_undefined(json_get(defaults, "enable_thinking")):
        defaults = jv_set(defaults, "enable_thinking", JValue.JBool(false))
    chat_template_variables_with_defaults(body, defaults)

# ── Prompt-prefix reuse ──────────────────────────────────────────────────

# Length of the longest common prefix of two token sequences — how many
# positions of a previous request's KV cache are still valid for this one.
pub int common_prefix_len([int] a, [int] b):
    let n = if a.length < b.length: a.length else: b.length
    var int i = 0
    while i < n and a[i] == b[i]:
        i += 1
    i

# Which cached sequence shares the longest prefix with `prompt`: (slot index,
# shared length), or (-1, 0) when none shares even one token. Ties keep the
# earliest slot.
pub (int, int) best_prefix_slot([[int]] slots, [int] prompt):
    var int best = -1
    var int best_len = 0
    var int i = 0
    while i < slots.length:
        let c = common_prefix_len(slots[i], prompt)
        if c > best_len:
            best_len = c
            best = i
        i += 1
    (best, best_len)

# ── Message normalization ────────────────────────────────────────────────

# `content` may be a plain string, null, or an array of typed parts
# (`[{"type": "text", "text": "..."}]` — what the AI SDK sends); chat
# templates only understand a string.
pub string content_to_text(JValue c):
    match c:
        JStr(s): s
        JList(parts):
            var string out = ""
            for p in parts:
                let t = json_get_str(p, "text", "")
                out = "{out}{t}"
            out
        _: ""

# OpenAI sends an assistant `tool_calls[i].function.arguments` as a JSON
# *string*; chat templates (Qwen's, ...) apply `| tojson` to it and expect an
# object — parse it once here. A string that isn't valid JSON is left alone.
JValue normalize_tool_call(JValue call):
    let func = json_get(call, "function")
    if not jv_is_str(json_get(func, "arguments")):
        return call
    let parsed = try? json_parse(json_get_str(func, "arguments", ""))
    if let pv = parsed:
        return jv_set(call, "function", jv_set(func, "arguments", pv))
    call

pub [JValue] normalize_messages([JValue] messages) throws:
    mut [JValue] out = []
    for m in messages:
        var JValue nm = m.clone()
        # llama.cpp maps the modern OpenAI `developer` role to `system` for
        # templates other than GPT-OSS. boring-llm currently supports Qwen/Llama
        # layouts, whose embedded templates likewise expect `system`.
        if json_get_str(m, "role", "") == "developer":
            nm = jv_set(nm, "role", JValue.JStr("system"))
        if jv_is_list(json_get(m, "content")):
            nm = jv_set(nm, "content", JValue.JStr(content_to_text(json_get(m, "content"))))
        elif not jv_is_str(json_get(m, "content")):
            # `content: null` (an assistant message that only carries tool calls) or no
            # content at all: templates do string operations on it (Qwen3's tests
            # `'</think>' in message.content`), which fail on a null.
            nm = jv_set(nm, "content", JValue.JStr(""))
        if jv_is_list(json_get(m, "tool_calls")):
            mut [JValue] calls = []
            for c in json_get_list(m, "tool_calls"):
                calls.push(normalize_tool_call(c))
            nm = jv_set(nm, "tool_calls", JValue.JList(calls))
        out.push(nm)
    out

JValue text_message(string role, string content):
    var JValue message = JValue.JDict({=}, [])
    message = jv_set(message, "role", JValue.JStr(role))
    jv_set(message, "content", JValue.JStr(content))

string anthropic_text_content(JValue content):
    match content:
        JStr(text): text
        JList(parts):
            var string out = ""
            for part in parts:
                out = "{out}{json_get_str(part, "text", "")}"
            out
        _: ""

string anthropic_tool_result_text(JValue content):
    match content:
        JStr(text): text
        JList(parts): anthropic_text_content(content)
        _: ""

pub string anthropic_input_validation_error(JValue body):
    let extra_params = json_get(body, "extra_params")
    if not request_value_is_undefined(extra_params) and not jv_is_dict(extra_params):
        return "Anthropic `extra_params` must be an object"
    let system = json_get(body, "system")
    if not request_value_is_undefined(system):
        match system:
            JStr(text): true
            JList(parts):
                for part in parts:
                    if json_get_str(part, "type", "") != "text" or not jv_is_str(json_get(part, "text")):
                        return "Anthropic `system` only supports text blocks"
            _: return "Anthropic `system` must be a string or an array of text blocks"
    match json_get(body, "messages"):
        JList(messages):
            if messages.length == 0: return "Anthropic `messages` must not be empty"
            mut [string] tool_ids = []
            for message in messages:
                let role = json_get_str(message, "role", "")
                if role != "user" and role != "assistant": return "Anthropic message role `{role}` is not supported"
                match json_get(message, "content"):
                    JStr(text): true
                    JList(parts):
                        for part in parts:
                            let kind = json_get_str(part, "type", "")
                            if kind == "text":
                                if not jv_is_str(json_get(part, "text")): return "an Anthropic text block must contain string `text`"
                            elif kind == "thinking" and role == "assistant":
                                if not jv_is_str(json_get(part, "thinking")): return "an Anthropic thinking block must contain string `thinking`"
                                let signature = json_get(part, "signature")
                                if not request_value_is_undefined(signature) and not jv_is_str(signature): return "an Anthropic thinking block `signature` must be a string"
                            elif kind == "tool_use" and role == "assistant":
                                let id = json_get_str(part, "id", "")
                                if id == "": return "an Anthropic tool_use block must have a non-empty `id`"
                                if tool_ids.contains(id): return "Anthropic tool_use ids must be unique"
                                if json_get_str(part, "name", "") == "": return "an Anthropic tool_use block must have a non-empty `name`"
                                if not jv_is_dict(json_get(part, "input")): return "an Anthropic tool_use block must contain object `input`"
                                tool_ids.push(id)
                            elif kind == "tool_result" and role == "user":
                                let id = json_get_str(part, "tool_use_id", "")
                                if id == "" or not tool_ids.contains(id): return "an Anthropic tool_result must reference a preceding tool_use id"
                                let is_error = json_get(part, "is_error")
                                if not request_value_is_undefined(is_error) and not jv_is_bool(is_error): return "Anthropic tool_result `is_error` must be a boolean"
                                match json_get(part, "content"):
                                    JStr(text): true
                                    JList(result_parts):
                                        for result_part in result_parts:
                                            if json_get_str(result_part, "type", "") != "text" or not jv_is_str(json_get(result_part, "text")):
                                                return "Anthropic tool_result content currently supports only text blocks"
                                    _: return "Anthropic tool_result `content` must be a string or an array of text blocks"
                            else: return "Anthropic `{kind}` content is not supported for role `{role}`"
                    _: return "Anthropic message `content` must be a string or an array of text blocks"
        _: return "Anthropic `messages` is required and must be an array"
    match json_get(body, "tools"):
        JUndefined: true
        JList(tools):
            for tool in tools:
                if json_get_str(tool, "name", "") == "": return "every Anthropic tool must have a non-empty `name`"
                if request_value_is_undefined(json_get(tool, "input_schema")): return "every Anthropic tool must have an `input_schema`"
        _: return "Anthropic `tools` must be an array"
    let choice = json_get(body, "tool_choice")
    if not request_value_is_undefined(choice):
        match choice:
            JDict(fields, keys):
                let kind = json_get_str(choice, "type", "")
                if kind != "auto" and kind != "any" and kind != "none" and kind != "tool": return "Anthropic `tool_choice.type` must be auto, any, none, or tool"
                if kind == "tool" and json_get_str(choice, "name", "") == "": return "Anthropic named tool choice requires a non-empty `name`"
                let disable_parallel = json_get(choice, "disable_parallel_tool_use")
                if not request_value_is_undefined(disable_parallel) and not jv_is_bool(disable_parallel):
                    return "Anthropic `tool_choice.disable_parallel_tool_use` must be a boolean"
            _: return "Anthropic `tool_choice` must be an object"
    let thinking = json_get(body, "thinking")
    if not request_value_is_undefined(thinking):
        match thinking:
            JDict(fields, keys):
                if json_get_str(thinking, "type", "") != "enabled": return "Anthropic `thinking.type` must be enabled"
                match json_get(thinking, "budget_tokens"):
                    JInt(budget):
                        if budget <= 0: return "Anthropic `thinking.budget_tokens` must be positive"
                    _: return "Anthropic `thinking.budget_tokens` must be an integer"
            _: return "Anthropic `thinking` must be an object"
    ""

pub JValue anthropic_chat_body(JValue body):
    var JValue out = body.clone()
    # Match llama-server's Anthropic extension: sampling and other completion
    # parameters unavailable in the Anthropic schema can be forwarded here.
    # Structural Anthropic fields are converted below and therefore cannot be
    # replaced accidentally through extra_params.
    match json_get(body, "extra_params"):
        JDict(fields, keys):
            for key in keys:
                out = jv_set(out, key, fields[key])
        _: true
    mut [JValue] messages = []
    let system_text = anthropic_text_content(json_get(body, "system"))
    if system_text != "": messages.push(text_message("system", system_text))
    for message in json_get_list(body, "messages"):
        let role = json_get_str(message, "role", "")
        let content = json_get(message, "content")
        if role == "assistant" and jv_is_list(content):
            var JValue converted = text_message("assistant", anthropic_text_content(content))
            mut [JValue] calls = []
            var string reasoning = ""
            for part in json_get_list(message, "content"):
                let kind = json_get_str(part, "type", "")
                if kind == "thinking":
                    reasoning = "{reasoning}{json_get_str(part, "thinking", "")}"
                elif kind == "tool_use":
                    var JValue function = JValue.JDict({=}, [])
                    function = jv_set(function, "name", json_get(part, "name"))
                    function = jv_set(function, "arguments", json_get(part, "input"))
                    var JValue call = JValue.JDict({=}, [])
                    call = jv_set(call, "id", json_get(part, "id"))
                    call = jv_set(call, "type", JValue.JStr("function"))
                    calls.push(jv_set(call, "function", function))
            if reasoning != "": converted = jv_set(converted, "reasoning_content", JValue.JStr(reasoning))
            if calls.length > 0: converted = jv_set(converted, "tool_calls", JValue.JList(calls))
            messages.push(converted)
        elif role == "user" and jv_is_list(content):
            let text = anthropic_text_content(content)
            if text != "": messages.push(text_message("user", text))
            var bool had_result = false
            for part in json_get_list(message, "content"):
                if json_get_str(part, "type", "") == "tool_result":
                    var JValue result = text_message("tool", anthropic_tool_result_text(json_get(part, "content")))
                    result = jv_set(result, "tool_call_id", json_get(part, "tool_use_id"))
                    if not request_value_is_undefined(json_get(part, "is_error")):
                        result = jv_set(result, "is_error", json_get(part, "is_error"))
                    messages.push(result)
                    had_result = true
            if text == "" and not had_result: messages.push(text_message("user", ""))
        else:
            messages.push(text_message(role, anthropic_text_content(content)))
    out = jv_set(out, "messages", JValue.JList(messages))
    mut [JValue] tools = []
    for tool in json_get_list(body, "tools"):
        var JValue function = JValue.JDict({=}, [])
        function = jv_set(function, "name", json_get(tool, "name"))
        if not request_value_is_undefined(json_get(tool, "description")):
            function = jv_set(function, "description", json_get(tool, "description"))
        function = jv_set(function, "parameters", json_get(tool, "input_schema"))
        var JValue wrapped = JValue.JDict({=}, [])
        wrapped = jv_set(wrapped, "type", JValue.JStr("function"))
        tools.push(jv_set(wrapped, "function", function))
    out = jv_set(out, "tools", JValue.JList(tools))
    let choice = json_get(body, "tool_choice")
    if not request_value_is_undefined(choice):
        let kind = json_get_str(choice, "type", "")
        if kind == "any": out = jv_set(out, "tool_choice", JValue.JStr("required"))
        elif kind == "auto": out = jv_set(out, "tool_choice", JValue.JStr("auto"))
        elif kind == "none": out = jv_set(out, "tool_choice", JValue.JStr("none"))
        elif kind == "tool":
            var JValue function = JValue.JDict({=}, [])
            function = jv_set(function, "name", json_get(choice, "name"))
            var JValue named = JValue.JDict({=}, [])
            named = jv_set(named, "type", JValue.JStr("function"))
            out = jv_set(out, "tool_choice", jv_set(named, "function", function))
        if json_get_bool(choice, "disable_parallel_tool_use", false):
            out = jv_set(out, "parallel_tool_calls", JValue.JBool(false))
    if not request_value_is_undefined(json_get(body, "thinking")):
        var JValue kwargs = JValue.JDict({=}, [])
        kwargs = jv_set(kwargs, "enable_thinking", JValue.JBool(true))
        out = jv_set(out, "chat_template_kwargs", kwargs)
    out

pub string responses_input_validation_error(JValue body):
    let instructions = json_get(body, "instructions")
    if not request_value_is_undefined(instructions) and not jv_is_str(instructions):
        return "`instructions` must be a string"
    let store = json_get(body, "store")
    if not request_value_is_undefined(store):
        match store:
            JBool(enabled):
                if enabled: return "stored Responses are not supported; use `store: false`"
            _: return "`store` must be a boolean"
    let background = json_get(body, "background")
    if not request_value_is_undefined(background):
        match background:
            JBool(enabled):
                if enabled: return "background Responses are not supported"
            _: return "`background` must be a boolean"
    if not request_value_is_undefined(json_get(body, "previous_response_id")):
        return "`previous_response_id` is not supported because Responses are not stored"
    if not request_value_is_undefined(json_get(body, "conversation")):
        return "stored Responses conversations are not supported"
    let truncation = json_get(body, "truncation")
    if not request_value_is_undefined(truncation):
        match truncation:
            JStr(mode):
                if mode == "auto":
                    return "automatic Responses truncation is not supported; use `truncation: disabled`"
                if mode != "disabled":
                    return "`truncation` must be auto or disabled"
            _: return "`truncation` must be a string"
    let prompt_cache_key = json_get(body, "prompt_cache_key")
    if not request_value_is_undefined(prompt_cache_key) and not jv_is_str(prompt_cache_key):
        return "`prompt_cache_key` must be a string"
    let metadata = json_get(body, "metadata")
    if not request_value_is_undefined(metadata):
        match metadata:
            JDict(fields, keys):
                if keys.length > 16:
                    return "`metadata` must not contain more than 16 entries"
                for key in keys:
                    if key.chars().length > 64:
                        return "`metadata` keys must not exceed 64 characters"
                    let value = fields[key] else JValue.JUndefined
                    match value:
                        JStr(text):
                            if text.chars().length > 512:
                                return "`metadata` values must not exceed 512 characters"
                        _: return "`metadata` values must be strings"
            _: return "`metadata` must be an object"
    let include = json_get(body, "include")
    if not request_value_is_undefined(include):
        match include:
            JList(items):
                for item in items:
                    if not jv_is_str(item): return "`include` must contain only strings"
            _: return "`include` must be an array"
    let reasoning = json_get(body, "reasoning")
    if not request_value_is_undefined(reasoning):
        match reasoning:
            JDict(fields, keys):
                let effort = json_get(reasoning, "effort")
                if not request_value_is_undefined(effort) and not jv_is_str(effort):
                    return "`reasoning.effort` must be a string"
                let summary = json_get(reasoning, "summary")
                if not request_value_is_undefined(summary) and not jv_is_str(summary):
                    return "`reasoning.summary` must be a string"
            _: return "`reasoning` must be an object"
    let text = json_get(body, "text")
    if not request_value_is_undefined(text):
        match text:
            JDict(fields, keys):
                let verbosity = json_get(text, "verbosity")
                if not request_value_is_undefined(verbosity):
                    match verbosity:
                        JStr(level):
                            if level != "low" and level != "medium" and level != "high":
                                return "`text.verbosity` must be low, medium, or high"
                        _: return "`text.verbosity` must be a string"
                let format = json_get(text, "format")
                if not request_value_is_undefined(format) and not jv_is_dict(format):
                    return "`text.format` must be an object"
            _: return "`text` must be an object"
    match json_get(body, "input"):
        JStr(text): true
        JList(items):
            if items.length == 0: return "`input` must not be empty"
            mut [string] call_ids = []
            for item in items:
                match item:
                    JDict(fields, keys):
                        let item_type = json_get_str(item, "type", "message")
                        if item_type == "message":
                            let role = json_get_str(item, "role", "")
                            if role != "system" and role != "developer" and role != "user" and role != "assistant":
                                return "Responses message role `{role}` is not supported"
                            match json_get(item, "content"):
                                JStr(text): true
                                JList(parts):
                                    for part in parts:
                                        let part_type = json_get_str(part, "type", "")
                                        if part_type != "input_text" and part_type != "output_text" and part_type != "text":
                                            return "Responses content part type `{part_type}` is not supported"
                                        if not jv_is_str(json_get(part, "text")):
                                            return "a Responses text content part must contain a string `text`"
                                _: return "Responses message `content` must be a string or an array of text parts"
                        elif item_type == "function_call":
                            let call_id = json_get_str(item, "call_id", "")
                            if call_id == "":
                                return "a Responses function call must have a non-empty `call_id`"
                            if call_ids.contains(call_id):
                                return "Responses function call ids must be unique"
                            if json_get_str(item, "name", "") == "":
                                return "a Responses function call must have a non-empty `name`"
                            if not jv_is_str(json_get(item, "arguments")):
                                return "Responses function call `arguments` must be a JSON string"
                            call_ids.push(call_id)
                        elif item_type == "function_call_output":
                            let call_id = json_get_str(item, "call_id", "")
                            if call_id == "":
                                return "a Responses function output must have a non-empty `call_id`"
                            if not call_ids.contains(call_id):
                                return "Responses function output must reference a preceding function call"
                            match json_get(item, "output"):
                                JStr(text): true
                                JList(parts):
                                    for part in parts:
                                        if json_get_str(part, "type", "") != "input_text":
                                            return "Responses function output content only supports `input_text`"
                                        if not jv_is_str(json_get(part, "text")):
                                            return "a Responses function output text part must contain a string `text`"
                                _: return "Responses function call `output` must be a string or an array of text parts"
                        else:
                            return "Responses input item type `{item_type}` is not supported"
                    _: return "Responses `input` items must be message objects"
        _: return "`input` is required and must be a string or an array of messages"
    let tools = json_get(body, "tools")
    if not request_value_is_undefined(tools):
        match tools:
            JList(items):
                for tool in items:
                    if json_get_str(tool, "type", "") != "function":
                        return "only Responses function tools are supported"
                    if json_get_str(tool, "name", "") == "":
                        return "every Responses function tool must have a non-empty `name`"
                    let parameters = json_get(tool, "parameters")
                    if not request_value_is_undefined(parameters):
                        let invalid = tool_schema_validation_error(parameters)
                        if invalid != "": return invalid
            _: return "`tools` must be an array"
    let choice = json_get(body, "tool_choice")
    if not request_value_is_undefined(choice):
        match choice:
            JStr(name):
                if name != "auto" and name != "none" and name != "required":
                    return "Responses `tool_choice` must be auto, none, required, or a named function"
            JDict(fields, keys):
                if json_get_str(choice, "type", "") != "function" or json_get_str(choice, "name", "") == "":
                    return "a named Responses `tool_choice` requires type function and a non-empty name"
                var bool found = false
                for tool in json_get_list(body, "tools"):
                    if json_get_str(tool, "name", "") == json_get_str(choice, "name", ""): found = true
                if not found: return "named Responses `tool_choice` does not match a supplied function"
            _: return "Responses `tool_choice` must be a string or object"
    ""

pub [JValue] responses_input_messages(JValue body):
    mut [JValue] messages = []
    let instructions = json_get_str(body, "instructions", "")
    if instructions != "": messages.push(text_message("system", instructions))
    match json_get(body, "input"):
        JStr(text): messages.push(text_message("user", text))
        JList(items):
            for item in items:
                let item_type = json_get_str(item, "type", "message")
                if item_type == "function_call":
                    var JValue function = JValue.JDict({=}, [])
                    function = jv_set(function, "name", JValue.JStr(json_get_str(item, "name", "")))
                    function = jv_set(function, "arguments", JValue.JStr(json_get_str(item, "arguments", "")))
                    var JValue call = JValue.JDict({=}, [])
                    call = jv_set(call, "id", JValue.JStr(json_get_str(item, "call_id", "")))
                    call = jv_set(call, "type", JValue.JStr("function"))
                    call = jv_set(call, "function", function)
                    var JValue message = text_message("assistant", "")
                    message = jv_set(message, "tool_calls", JValue.JList([call]))
                    messages.push(message)
                elif item_type == "function_call_output":
                    var JValue message = text_message("tool", content_to_text(json_get(item, "output")))
                    message = jv_set(message, "tool_call_id", JValue.JStr(json_get_str(item, "call_id", "")))
                    messages.push(message)
                else:
                    messages.push(text_message(json_get_str(item, "role", "user"), content_to_text(json_get(item, "content"))))
        _: true
    messages

pub [JValue] responses_input_tools(JValue body):
    mut [JValue] tools = []
    let choice = json_get(body, "tool_choice")
    if json_get_str(body, "tool_choice", "") == "none": return tools
    let selected = if jv_is_str(json_get(choice, "name")): json_get_str(choice, "name", "") else: ""
    for tool in json_get_list(body, "tools"):
        if selected != "" and json_get_str(tool, "name", "") != selected:
            continue
        var JValue function = JValue.JDict({=}, [])
        function = jv_set(function, "name", JValue.JStr(json_get_str(tool, "name", "")))
        let description = json_get(tool, "description")
        if jv_is_str(description): function = jv_set(function, "description", description)
        let parameters = json_get(tool, "parameters")
        if not request_value_is_undefined(parameters): function = jv_set(function, "parameters", parameters)
        var JValue wrapped = JValue.JDict({=}, [])
        wrapped = jv_set(wrapped, "type", JValue.JStr("function"))
        wrapped = jv_set(wrapped, "function", function)
        tools.push(wrapped)
    tools

# Normalize the overlapping Responses generation fields to the Chat
# Completions dialect used by the inference path. The original fields remain
# present as harmless forward-compatible extras; the canonical fields below
# are the ones generation consumes.
pub JValue responses_chat_body(JValue body):
    var JValue out = body.clone()
    # Preserve the public Responses spelling before replacing these fields
    # with the wrapped Chat Completions representation used by generation.
    out = jv_set(out, "responses_tools", json_get(body, "tools"))
    out = jv_set(out, "responses_tool_choice", json_get(body, "tool_choice"))
    out = jv_set(out, "messages", JValue.JList(responses_input_messages(body)))
    out = jv_set(out, "tools", JValue.JList(responses_input_tools(body)))
    let max_output = json_get(body, "max_output_tokens")
    if not request_value_is_undefined(max_output):
        out = jv_set(out, "max_completion_tokens", max_output)
    let effort = json_get(json_get(body, "reasoning"), "effort")
    if jv_is_str(effort):
        out = jv_set(out, "reasoning_effort", effort)
    let format = json_get(json_get(body, "text"), "format")
    if not request_value_is_undefined(format):
        if json_get_str(format, "type", "") == "json_schema":
            var JValue response_format = JValue.JDict({=}, [])
            response_format = jv_set(response_format, "type", JValue.JStr("json_schema"))
            response_format = jv_set(response_format, "json_schema", format)
            out = jv_set(out, "response_format", response_format)
        else:
            out = jv_set(out, "response_format", format)
    let choice = json_get(body, "tool_choice")
    match choice:
        JDict(fields, keys):
            if json_get_str(choice, "type", "") == "function":
                var JValue function = JValue.JDict({=}, [])
                function = jv_set(function, "name", JValue.JStr(json_get_str(choice, "name", "")))
                var JValue chat_choice = JValue.JDict({=}, [])
                chat_choice = jv_set(chat_choice, "type", JValue.JStr("function"))
                chat_choice = jv_set(chat_choice, "function", function)
                out = jv_set(out, "tool_choice", chat_choice)
        _: true
    out

# Resolve a JSON Pointer inside one schema document.  Tool contracts are data,
# not URLs: only local references are supported, so validation and generation
# never perform I/O for a `$ref`.
JValue json_schema_local_ref(JValue root, string reference):
    if reference == "#":
        return root
    if not reference.startsWith("#/"):
        return JValue.JUndefined
    var JValue current = root
    for encoded in reference.split("#/")[1].split("/"):
        let key = encoded.replace("~1", "/").replace("~0", "~")
        match current:
            JDict(fields, keys):
                current = fields[key] else JValue.JUndefined
            JList(items):
                if let index = (key as int):
                    if index < 0 or index >= items.length:
                        return JValue.JUndefined
                    current = items[index]
                else:
                    return JValue.JUndefined
            _:
                return JValue.JUndefined
        if request_value_is_undefined(current):
            return current
    current

# Checks the JSON Schema subset enforced later by `tool_schema_matches`.
# Rejecting malformed recognized keywords avoids silently weakening a tool's
# argument contract while leaving unknown keywords forward-compatible.
pub string tool_schema_validation_error(JValue schema):
    tool_schema_validation_error_root(schema, schema)

string tool_schema_validation_error_root(JValue root, JValue schema):
    match schema:
        JBool(allowed):
            return ""
        JDict(fields, keys):
            let reference = json_get(schema, "$ref")
            if fields.contains("$ref"):
                match reference:
                    JStr(text):
                        if not text.startsWith("#"):
                            return "JSON Schema `$ref` must be a local reference"
                        if request_value_is_undefined(json_schema_local_ref(root, text)):
                            return "JSON Schema `$ref` does not resolve"
                    _: return "JSON Schema `$ref` must be a string"
            for definitions_key in ["$defs", "definitions"]:
                let definitions = json_get(schema, definitions_key)
                if fields.contains(definitions_key):
                    match definitions:
                        JDict(def_fields, def_keys):
                            for key in def_keys:
                                let invalid = tool_schema_validation_error_root(root, def_fields[key] else JValue.JUndefined)
                                if invalid != "": return invalid
                        _: return "JSON Schema `{definitions_key}` must be an object"
            let schema_type = json_get(schema, "type")
            match schema_type:
                JUndefined:
                    if fields.contains("type"): return "JSON Schema `type` must not be null"
                JStr(name):
                    if name != "object" and name != "array" and name != "string" and name != "integer" and name != "number" and name != "boolean" and name != "null":
                        return "JSON Schema `type` `{name}` is not supported"
                JList(types):
                    if types.length == 0:
                        return "JSON Schema `type` array must not be empty"
                    for item in types:
                        match item:
                            JStr(name):
                                if name != "object" and name != "array" and name != "string" and name != "integer" and name != "number" and name != "boolean" and name != "null":
                                    return "JSON Schema `type` `{name}` is not supported"
                            _: return "JSON Schema `type` array must contain only strings"
                _: return "JSON Schema `type` must be a string or array of strings"

            let properties = json_get(schema, "properties")
            if fields.contains("properties"):
                match properties:
                    JDict(prop_fields, prop_keys):
                        for key in prop_keys:
                            let child = prop_fields[key] else JValue.JUndefined
                            let invalid = tool_schema_validation_error_root(root, child)
                            if invalid != "": return invalid
                    _: return "JSON Schema `properties` must be an object"
            let required = json_get(schema, "required")
            if fields.contains("required"):
                match required:
                    JList(items):
                        for item in items:
                            if not jv_is_str(item): return "JSON Schema `required` must contain only strings"
                    _: return "JSON Schema `required` must be an array"
            let dependent_required = json_get(schema, "dependentRequired")
            if fields.contains("dependentRequired"):
                match dependent_required:
                    JDict(deps, dep_keys):
                        for key in dep_keys:
                            match deps[key] else JValue.JUndefined:
                                JList(names):
                                    for name in names:
                                        if not jv_is_str(name): return "JSON Schema `dependentRequired` values must contain only strings"
                                _: return "JSON Schema `dependentRequired` values must be arrays"
                    _: return "JSON Schema `dependentRequired` must be an object"
            let dependent_schemas = json_get(schema, "dependentSchemas")
            if fields.contains("dependentSchemas"):
                match dependent_schemas:
                    JDict(deps, dep_keys):
                        for key in dep_keys:
                            let invalid = tool_schema_validation_error_root(root, deps[key] else JValue.JUndefined)
                            if invalid != "": return invalid
                    _: return "JSON Schema `dependentSchemas` must be an object"
            let property_names = json_get(schema, "propertyNames")
            if fields.contains("propertyNames"):
                let invalid = tool_schema_validation_error_root(root, property_names)
                if invalid != "": return invalid
            let additional = json_get(schema, "additionalProperties")
            if fields.contains("additionalProperties"):
                match additional:
                    JBool(allowed): true
                    JDict(extra_fields, extra_keys):
                        let invalid = tool_schema_validation_error_root(root, additional)
                        if invalid != "": return invalid
                    _: return "JSON Schema `additionalProperties` must be a boolean or object"
            let items_schema = json_get(schema, "items")
            if fields.contains("items"):
                let invalid = tool_schema_validation_error_root(root, items_schema)
                if invalid != "": return invalid
            let prefix_items = json_get(schema, "prefixItems")
            if fields.contains("prefixItems"):
                match prefix_items:
                    JList(items):
                        for item in items:
                            let invalid = tool_schema_validation_error_root(root, item)
                            if invalid != "": return invalid
                    _: return "JSON Schema `prefixItems` must be an array"
            let contains_schema = json_get(schema, "contains")
            if fields.contains("contains"):
                let invalid = tool_schema_validation_error_root(root, contains_schema)
                if invalid != "": return invalid
            for key in ["minContains", "maxContains"]:
                let limit = json_get(schema, key)
                if fields.contains(key):
                    match limit:
                        JInt(n):
                            if n < 0: return "JSON Schema `{key}` must not be negative"
                        _: return "JSON Schema `{key}` must be an integer"
            for key in ["anyOf", "oneOf", "allOf"]:
                let composition = json_get(schema, key)
                if fields.contains(key):
                    match composition:
                        JList(alternatives):
                            if alternatives.length == 0: return "JSON Schema `{key}` must not be empty"
                            for alternative in alternatives:
                                let invalid = tool_schema_validation_error_root(root, alternative)
                                if invalid != "": return invalid
                        _: return "JSON Schema `{key}` must be an array"
            for key in ["if", "then", "else"]:
                if fields.contains(key):
                    let invalid = tool_schema_validation_error_root(root, json_get(schema, key))
                    if invalid != "": return invalid
            if fields.contains("not"):
                let invalid = tool_schema_validation_error_root(root, json_get(schema, "not"))
                if invalid != "": return invalid
            let enum_value = json_get(schema, "enum")
            if fields.contains("enum"):
                match enum_value:
                    JList(items):
                        if items.length == 0: return "JSON Schema `enum` must not be empty"
                    _: return "JSON Schema `enum` must be an array"
            for key in ["minLength", "maxLength", "minItems", "maxItems", "minProperties", "maxProperties"]:
                let limit = json_get(schema, key)
                if fields.contains(key):
                    match limit:
                        JInt(n):
                            if n < 0: return "JSON Schema `{key}` must not be negative"
                        _: return "JSON Schema `{key}` must be an integer"
            for key in ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum"]:
                let bound = json_get(schema, key)
                if fields.contains(key) and not jv_is_number(bound):
                    return "JSON Schema `{key}` must be a number"
            let multiple_of = json_get(schema, "multipleOf")
            if fields.contains("multipleOf"):
                if not jv_is_number(multiple_of) or json_get_float(schema, "multipleOf", 0.0) <= 0.0:
                    return "JSON Schema `multipleOf` must be a number greater than 0"
            let unique_items = json_get(schema, "uniqueItems")
            if fields.contains("uniqueItems"):
                match unique_items:
                    JBool(enabled): true
                    _: return "JSON Schema `uniqueItems` must be a boolean"
            if fields.contains("pattern"):
                match json_get(schema, "pattern"):
                    JStr(source):
                        let invalid_pattern = json_pattern_validation_error(source)
                        if invalid_pattern != "": return invalid_pattern
                    _: return "JSON Schema `pattern` must be a string"
        _: return "tool function `parameters` must be a JSON Schema object or boolean"
    ""

# Structural validation before a request reaches a model-specific Jinja
# template. This keeps malformed or unsupported client input as a stable 400
# instead of surfacing a template exception as a 500.
pub string request_shape_error(JValue body):
    let raw_messages = json_get(body, "messages")
    match raw_messages:
        JList(messages):
            if messages.length == 0:
                return "`messages` is required and must be a non-empty array"
            for message in messages:
                match message:
                    JDict(fields, keys):
                        let role = json_get_str(message, "role", "")
                        if role == "":
                            return "every message must have a non-empty string `role`"
                        if role != "system" and role != "developer" and role != "user" and role != "assistant" and role != "tool":
                            return "message role `{role}` is not supported"
                        if role == "tool" and json_get_str(message, "tool_call_id", "") == "":
                            return "a tool message must have a non-empty string `tool_call_id`"
                        let content = json_get(message, "content")
                        match content:
                            JStr(s): true
                            JUndefined: true
                            JList(parts):
                                for part in parts:
                                    let kind = json_get_str(part, "type", "")
                                    if kind != "text":
                                        return "only text message content parts are supported"
                                    if not jv_is_str(json_get(part, "text")):
                                        return "a text content part must contain a string `text`"
                            _: return "message `content` must be a string, null, or an array of text parts"
                        let raw_calls = json_get(message, "tool_calls")
                        if not request_value_is_undefined(raw_calls):
                            if role != "assistant":
                                return "only assistant messages may contain `tool_calls`"
                            match raw_calls:
                                JList(calls):
                                    if calls.length == 0:
                                        return "message `tool_calls` must not be empty"
                                    var int call_index = 0
                                    while call_index < calls.length:
                                        let call = calls[call_index]
                                        if json_get_str(call, "id", "") == "":
                                            return "every tool call must have a non-empty string `id`"
                                        var int previous_call = 0
                                        while previous_call < call_index:
                                            if json_get_str(calls[previous_call], "id", "") == json_get_str(call, "id", ""):
                                                return "tool call ids must be unique within an assistant message"
                                            previous_call += 1
                                        if json_get_str(call, "type", "") != "function":
                                            return "only function tool calls are supported"
                                        let function = json_get(call, "function")
                                        if json_get_str(function, "name", "") == "":
                                            return "every tool call must have a function name"
                                        let arguments = json_get(function, "arguments")
                                        match arguments:
                                            JStr(s): true
                                            JDict(arg_fields, arg_keys): true
                                            _: return "tool call arguments must be a JSON string or object"
                                        call_index += 1
                                _: return "message `tool_calls` must be an array"
                    _: return "every message must be an object"
        _: return "`messages` is required and must be a non-empty array"

    let raw_tools = json_get(body, "tools")
    if not request_value_is_undefined(raw_tools):
        match raw_tools:
            JList(tools):
                var int tool_index = 0
                while tool_index < tools.length:
                    let tool = tools[tool_index]
                    if json_get_str(tool, "type", "") != "function":
                        return "only function tools are supported"
                    let function = json_get(tool, "function")
                    let function_name = json_get_str(function, "name", "")
                    if function_name == "":
                        return "every tool must have a non-empty function name"
                    var int previous_tool = 0
                    while previous_tool < tool_index:
                        if json_get_str(json_get(tools[previous_tool], "function"), "name", "") == function_name:
                            return "tool function names must be unique"
                        previous_tool += 1
                    let parameters = json_get(function, "parameters")
                    if not request_value_is_undefined(parameters):
                        let invalid_schema = tool_schema_validation_error(parameters)
                        if invalid_schema != "":
                            return invalid_schema
                    tool_index += 1
            _: return "`tools` must be an array"
    ""

# ── Generated text -> content + tool calls ───────────────────────────────

pub struct ParsedToolCall:
    string name
    string arguments   # JSON text, as OpenAI's `function.arguments` wants it

pub struct ParsedReply:
    string content
    [ParsedToolCall] calls

# The balanced `{...}` object that starts at `cs[start]` (string-aware: braces
# inside a JSON string, and escaped quotes, do not count), or "" when it never
# closes.
string balanced_object([string] cs, int start):
    var int depth = 0
    var bool in_str = false
    var bool esc = false
    var int i = start
    while i < cs.length:
        let ch = cs[i]
        if in_str:
            if esc:
                esc = false
            elif ch == "\\":
                esc = true
            elif ch == "\"":
                in_str = false
        else:
            if ch == "\"":
                in_str = true
            elif ch == "{{":
                depth += 1
            elif ch == "}}":
                depth -= 1
                if depth == 0:
                    var out = ""
                    var j = start
                    while j <= i:
                        out = "{out}{cs[j]}"
                        j += 1
                    return out
        i += 1
    ""

# Parses one `<tool_call>` body. A strict parse first. Qwen2.5's GGUF-embedded
# chat template renders its own format example with DOUBLED braces (`{{"name":
# ..., "arguments": ...}}` — real jinja2 does too, it is the template text, not
# our renderer), and a small model copies that faithfully (llama.cpp's own
# output for the same prompt is identical) — and, under a long prompt such as
# OpenCode's, often gets the closing braces wrong: `{{"name": ..., "arguments":
# {...}}` (one closing short) or `{{...}}}}` (one too many). So when the strict
# parse fails, take the balanced object starting at each of the first few `{`
# and keep the first one that is an object with a `name` (a legitimate nested
# `}}` inside the object is never touched, and trailing junk is ignored).
JValue? parse_tool_body(string body):
    let direct = try? json_parse(body)
    if let v = direct:
        return v
    let cs = body.chars()
    var int tried = 0
    var int i = 0
    while i < cs.length and tried < 3:
        if cs[i] == "{{":
            tried += 1
            let candidate = balanced_object(cs, i)
            if candidate != "":
                let parsed = try? json_parse(candidate)
                if let v = parsed:
                    if json_get_str(v, "name", "") != "":
                        return v
        i += 1
    nil

# Hermes-style: `<tool_call>\n{"name": "...", "arguments": {...}}\n</tool_call>`
# (zero or more, optionally preceded by plain text). A block whose body isn't
# valid JSON with a `name` is left in `content` verbatim rather than dropped.
pub ParsedReply parse_reply(string text):
    let parts = text.split("<tool_call>")
    var string content = parts[0].trim()
    mut [ParsedToolCall] calls = []
    var int i = 1
    while i < parts.length:
        let seg = parts[i].split("</tool_call>")
        let parsed = parse_tool_body(seg[0].trim())
        var bool ok = false
        if seg.length > 1:
            if let v = parsed:
                let name = json_get_str(v, "name", "")
                if name != "":
                    let args = json_get(v, "arguments")
                    let args_text = if jv_is_str(args): json_get_str(v, "arguments", "") else: jv_to_json(args)
                    calls.push(ParsedToolCall(name, args_text))
                    ok = true
        if not ok:
            content = "{content}<tool_call>{parts[i]}"
        i += 1
    ParsedReply(content, calls)

# `"tool_choice": "none"`: the model must not call tools, so the tool
# definitions are left out of the prompt and `<tool_call>` text in the reply is
# plain content. `required` and named choices are grammar-enforced by server.br;
# `auto` leaves the decision to the model.
pub bool tools_disabled(JValue body):
    json_get_str(body, "tool_choice", "") == "none"

pub string named_tool_choice(JValue body):
    let choice = json_get(body, "tool_choice")
    match choice:
        JDict(fields, keys): json_get_str(json_get(choice, "function"), "name", "")
        _: ""

# Validates tool_choice and returns the tool list that should reach the chat
# template. A named choice exposes only that function to the model; `none`
# exposes none. `required` is also validated here before constrained decoding.
pub string tool_choice_validation_error(JValue body, [JValue] tools):
    let choice = json_get(body, "tool_choice")
    if request_value_is_undefined(choice):
        return ""
    match choice:
        JStr(s):
            if s != "none" and s != "auto" and s != "required":
                return "`tool_choice` must be `none`, `auto`, `required`, or a named function"
            if s == "required" and tools.length == 0:
                return "`tool_choice` is `required` but no tools were provided"
        JDict(fields, keys):
            let name = named_tool_choice(body)
            if json_get_str(choice, "type", "") != "function" or name == "":
                return "a named `tool_choice` must contain `type: function` and `function.name`"
            var bool found = false
            for tool in tools:
                if json_get_str(json_get(tool, "function"), "name", "") == name:
                    found = true
            if not found:
                return "named `tool_choice` function `{name}` was not provided in `tools`"
        _:
            return "`tool_choice` must be a string or a named function"
    ""

pub [JValue] tools_for_request(JValue body, [JValue] tools):
    if tools_disabled(body):
        return []
    let name = named_tool_choice(body)
    if name == "":
        return tools
    mut [JValue] out = []
    for tool in tools:
        if json_get_str(json_get(tool, "function"), "name", "") == name:
            out.push(tool)
    out

pub bool tool_choice_required(JValue body):
    json_get_str(body, "tool_choice", "") == "required" or named_tool_choice(body) != ""

# A bare JSON object is the compact constrained form for an explicit tool
# choice. Named choices use it directly as arguments; `required` uses the
# usual {name, arguments} object. The final value is checked with exactly the
# same schema matcher as parsed tool-call text.
pub bool tool_choice_value_matches(JValue body, [JValue] tools, JValue value):
    let forced = named_tool_choice(body)
    match value:
        JDict(fields, keys):
            var string name = json_get_str(value, "name", "")
            var JValue args = json_get(value, "arguments")
            if forced != "":
                name = forced
                if request_value_is_undefined(args):
                    args = value
            if name == "" or request_value_is_undefined(args):
                return false
            tool_calls_match([ParsedToolCall(name, jv_to_json(args))], tools)
        _: false

pub bool tool_choice_decoded_candidate_allowed(JValue body, [JValue] tools, string decoded_before, string decoded_after, bool is_eos):
    if is_eos:
        let complete = try? json_parse(decoded_before)
        if let value = complete:
            return tool_choice_value_matches(body, tools, value)
        return false
    let state = json_object_prefix_state(decoded_after)
    if state < 0:
        return false
    if state == 1:
        let complete = try? json_parse(decoded_after)
        if let value = complete:
            return tool_choice_value_matches(body, tools, value)
        return false
    true

string sole_tool_name([JValue] tools):
    if tools.length == 1:
        json_get_str(json_get(tools[0], "function"), "name", "")
    else:
        ""

bool schema_type_matches(string kind, JValue value):
    if kind == "object":
        match value:
            JDict(fields, keys): true
            _: false
    elif kind == "array":
        match value:
            JList(items): true
            _: false
    elif kind == "string":
        jv_is_str(value)
    elif kind == "integer":
        match value:
            JInt(n): true
            # JSON Schema classifies numbers mathematically rather than by
            # their JSON spelling, so 1.0 is an integer but 1.5 is not.
            JFloat(f): floor(f) as float == f
            _: false
    elif kind == "number":
        jv_is_number(value)
    elif kind == "boolean":
        match value:
            JBool(b): true
            _: false
    elif kind == "null":
        request_value_is_undefined(value)
    else:
        true

bool json_object_has_key(JValue value, string key):
    match value:
        JDict(fields, keys): fields.contains(key)
        _: false

# JSON numbers are represented as binary floats internally.  A direct
# `value / multipleOf == integer` test therefore rejects ordinary decimal
# values such as 0.3 with multipleOf 0.1 on some platforms.  Keep a very
# small relative allowance for that representation error, not for a genuine
# near-miss such as 0.31.
bool json_number_is_multiple_of(float value, float divisor):
    let quotient = value / divisor
    let nearest = if quotient >= 0.0:
        floor(quotient + 0.5)
    else:
        -floor(-quotient + 0.5)
    let delta = quotient - nearest
    let tolerance = (if nearest >= 0.0: nearest else: -nearest) * 0.0000001 + 0.0000001
    delta <= tolerance and delta >= -tolerance

# The JSON Schema subset used by OpenCode tool definitions. Unknown schema
# keywords remain permissive; recognized constraints must match.
pub bool tool_schema_matches(JValue schema, JValue value):
    tool_schema_matches_root(schema, schema, value, 0)

bool tool_schema_matches_root(JValue root, JValue schema, JValue value, int ref_depth):
    # JSON values are finite, but malformed schemas can make `$ref` chase
    # itself without descending into a value. Bound that path so one request
    # cannot exhaust the server stack; ordinary nested API schemas are tiny.
    if ref_depth > 128:
        return false
    match schema:
        JBool(allowed): return allowed
        _: true
    let reference = json_get_str(schema, "$ref", "")
    if reference != "":
        let target = json_schema_local_ref(root, reference)
        if request_value_is_undefined(target):
            return false
        return tool_schema_matches_root(root, target, value, ref_depth + 1)
    let kind = json_get_str(schema, "type", "")
    if kind != "" and not schema_type_matches(kind, value):
        return false
    let type_choices = json_get_list(schema, "type")
    if type_choices.length > 0:
        var bool type_ok = false
        for choice in type_choices:
            match choice:
                JStr(name):
                    if schema_type_matches(name, value):
                        type_ok = true
                _: true
        if not type_ok:
            return false

    let has_const = json_object_has_key(schema, "const")
    let const_value = json_get(schema, "const")
    if has_const and not json_values_equal(const_value, value):
        return false

    let any_of = json_get_list(schema, "anyOf")
    if any_of.length > 0:
        var bool any_ok = false
        for alternative in any_of:
            if tool_schema_matches_root(root, alternative, value, ref_depth + 1):
                any_ok = true
        if not any_ok:
            return false
    let one_of = json_get_list(schema, "oneOf")
    if one_of.length > 0:
        var int matches = 0
        for alternative in one_of:
            if tool_schema_matches_root(root, alternative, value, ref_depth + 1):
                matches += 1
        if matches != 1:
            return false
    for constraint in json_get_list(schema, "allOf"):
        if not tool_schema_matches_root(root, constraint, value, ref_depth + 1):
            return false
    let condition = json_get(schema, "if")
    if not request_value_is_undefined(condition):
        if tool_schema_matches_root(root, condition, value, ref_depth + 1):
            let then_schema = json_get(schema, "then")
            if not request_value_is_undefined(then_schema) and not tool_schema_matches_root(root, then_schema, value, ref_depth + 1):
                return false
        else:
            let else_schema = json_get(schema, "else")
            if not request_value_is_undefined(else_schema) and not tool_schema_matches_root(root, else_schema, value, ref_depth + 1):
                return false
    if json_object_has_key(schema, "not") and tool_schema_matches_root(root, json_get(schema, "not"), value, ref_depth + 1):
        return false

    let enums = json_get_list(schema, "enum")
    if enums.length > 0:
        var bool found = false
        for item in enums:
            if json_values_equal(item, value):
                found = true
        if not found:
            return false

    match value:
        JDict(fields, keys):
            let property_names = json_get(schema, "propertyNames")
            if not request_value_is_undefined(property_names):
                for key in keys:
                    if not tool_schema_matches_root(root, property_names, JValue.JStr(key), ref_depth + 1):
                        return false
            let min_properties = json_get_int(schema, "minProperties", -1)
            let max_properties = json_get_int(schema, "maxProperties", -1)
            if min_properties >= 0 and keys.length < min_properties:
                return false
            if max_properties >= 0 and keys.length > max_properties:
                return false
            for required in json_get_list(schema, "required"):
                match required:
                    JStr(name):
                        if not fields.contains(name):
                            return false
                    _: return false
            match json_get(schema, "dependentRequired"):
                JDict(deps, dep_keys):
                    for key in dep_keys:
                        if fields.contains(key):
                            for required_name in json_get_list(JValue.JDict(deps, dep_keys), key):
                                match required_name:
                                    JStr(name):
                                        if not fields.contains(name): return false
                                    _: return false
                _: true
            match json_get(schema, "dependentSchemas"):
                JDict(deps, dep_keys):
                    for key in dep_keys:
                        if fields.contains(key) and not tool_schema_matches_root(root, deps[key] else JValue.JUndefined, value, ref_depth + 1):
                            return false
                _: true
            let properties = json_get(schema, "properties")
            let additional = json_get(schema, "additionalProperties")
            match properties:
                JDict(prop_fields, prop_keys):
                    for key in prop_keys:
                        if fields.contains(key):
                            let child_schema = prop_fields[key] else JValue.JUndefined
                            let child_value = fields[key] else JValue.JUndefined
                            if not tool_schema_matches_root(root, child_schema, child_value, ref_depth + 1):
                                return false
                    for key in keys:
                        if not prop_fields.contains(key):
                            let child_value = fields[key] else JValue.JUndefined
                            match additional.clone():
                                JBool(allowed):
                                    if not allowed:
                                        return false
                                JDict(extra_fields, extra_keys):
                                    if not tool_schema_matches_root(root, additional, child_value, ref_depth + 1):
                                        return false
                                _: true
                _:
                    for key in keys:
                        let child_value = fields[key] else JValue.JUndefined
                        match additional.clone():
                            JBool(allowed):
                                if not allowed:
                                    return false
                            JDict(extra_fields, extra_keys):
                                if not tool_schema_matches_root(root, additional, child_value, ref_depth + 1):
                                    return false
                            _: true
        JList(items):
            let min_items = json_get_int(schema, "minItems", -1)
            let max_items = json_get_int(schema, "maxItems", -1)
            if min_items >= 0 and items.length < min_items:
                return false
            if max_items >= 0 and items.length > max_items:
                return false
            if json_get_bool(schema, "uniqueItems", false):
                var int item_index = 0
                while item_index < items.length:
                    var int previous_item = 0
                    while previous_item < item_index:
                        if json_values_equal(items[previous_item], items[item_index]):
                            return false
                        previous_item += 1
                    item_index += 1
            let prefix_items = json_get_list(schema, "prefixItems")
            var prefix_index = 0
            while prefix_index < prefix_items.length and prefix_index < items.length:
                if not tool_schema_matches_root(root, prefix_items[prefix_index], items[prefix_index], ref_depth + 1):
                    return false
                prefix_index += 1
            # In JSON Schema 2020-12, `items` constrains only the suffix after
            # `prefixItems`; without a prefix it still applies to every item.
            let item_schema = json_get(schema, "items")
            if not request_value_is_undefined(item_schema):
                var int item_index = prefix_items.length
                if item_index > items.length:
                    item_index = items.length
                while item_index < items.length:
                    if not tool_schema_matches_root(root, item_schema, items[item_index], ref_depth + 1):
                        return false
                    item_index += 1
            let contains_schema = json_get(schema, "contains")
            if not request_value_is_undefined(contains_schema):
                var int contains_matches = 0
                for item in items:
                    if tool_schema_matches_root(root, contains_schema, item, ref_depth + 1):
                        contains_matches += 1
                let min_contains = json_get_int(schema, "minContains", 1)
                let max_contains = json_get_int(schema, "maxContains", -1)
                if contains_matches < min_contains or (max_contains >= 0 and contains_matches > max_contains):
                    return false
        JStr(text):
            let n = text.chars().length
            let min_length = json_get_int(schema, "minLength", -1)
            let max_length = json_get_int(schema, "maxLength", -1)
            if min_length >= 0 and n < min_length:
                return false
            if max_length >= 0 and n > max_length:
                return false
            if json_object_has_key(schema, "pattern") and not json_pattern_matches(json_get_str(schema, "pattern", ""), text):
                return false
        JInt(n):
            let value_n = n as float
            let multiple_of = json_get_float(schema, "multipleOf", 0.0)
            if multiple_of > 0.0 and not json_number_is_multiple_of(value_n, multiple_of):
                return false
            let minimum = json_get_float(schema, "minimum", value_n)
            let maximum = json_get_float(schema, "maximum", value_n)
            if value_n < minimum or value_n > maximum:
                return false
            if json_object_has_key(schema, "exclusiveMinimum") and value_n <= json_get_float(schema, "exclusiveMinimum", value_n):
                return false
            if json_object_has_key(schema, "exclusiveMaximum") and value_n >= json_get_float(schema, "exclusiveMaximum", value_n):
                return false
        JFloat(f):
            let multiple_of = json_get_float(schema, "multipleOf", 0.0)
            if multiple_of > 0.0 and not json_number_is_multiple_of(f, multiple_of):
                return false
            let minimum = json_get_float(schema, "minimum", f)
            let maximum = json_get_float(schema, "maximum", f)
            if f < minimum or f > maximum:
                return false
            if json_object_has_key(schema, "exclusiveMinimum") and f <= json_get_float(schema, "exclusiveMinimum", f):
                return false
            if json_object_has_key(schema, "exclusiveMaximum") and f >= json_get_float(schema, "exclusiveMaximum", f):
                return false
        _: true
    true

# The response-format schema uses the same JSON Schema subset as tool
# arguments. A token remains eligible while its decoded text is a viable JSON
# value prefix. Once it completes a value, it must already satisfy the schema;
# EOS is likewise available only for a complete matching value. This is the
# safe common denominator for arbitrary tokenizer pieces (including pieces
# that split UTF-8 characters).
pub bool json_schema_decoded_candidate_allowed(JValue schema, string decoded_before, string decoded_after, bool is_eos):
    if is_eos:
        if json_prefix_state(decoded_before) != 1:
            return false
        let complete = try? json_parse(decoded_before)
        if let value = complete:
            return tool_schema_matches(schema, value)
        return false
    let state = json_prefix_state(decoded_after)
    if state < 0:
        return false
    if state == 1:
        let complete = try? json_parse(decoded_after)
        if let value = complete:
            return tool_schema_matches(schema, value)
        return false
    true

# A closed container/string/literal cannot become a different JSON value by
# appending another non-whitespace token, so the sampler can finish eagerly.
# A root number is different: `1` may still grow into `123`, `1.5` or `1e3`.
# Keep EOS as an ordinary allowed candidate instead of forcing it immediately.
pub bool json_schema_should_stop(JValue schema, string decoded):
    if json_prefix_state(decoded) != 1:
        return false
    let parsed = try? json_parse(decoded)
    guard let value = parsed else return false
    if not tool_schema_matches(schema, value):
        return false
    not jv_is_number(value)

pub JValue response_json_schema(JValue body):
    let native_schema = json_get(body, "json_schema")
    if not request_value_is_undefined(native_schema):
        if jv_is_dict(native_schema) and jv_to_json(native_schema) == "{{}}":
            var JValue object_schema = JValue.JDict({=}, [])
            object_schema = jv_set(object_schema, "type", JValue.JStr("object"))
            return object_schema
        return native_schema
    let response_format = json_get(body, "response_format")
    let format_type = json_get_str(response_format, "type", "")
    if format_type == "json_schema":
        let envelope = json_get(response_format, "json_schema")
        if not request_value_is_undefined(envelope):
            return json_get(envelope, "schema")
    if format_type == "json_schema" or format_type == "json_object":
        return json_get(response_format, "schema")
    JValue.JUndefined

bool tool_call_matches(ParsedToolCall call, [JValue] tools):
    var JValue schema = JValue.JUndefined
    var bool found = false
    for tool in tools:
        let function = json_get(tool, "function")
        if json_get_str(function, "name", "") == call.name:
            found = true
            schema = json_get(function, "parameters")
    if not found:
        return false
    let parsed = try? json_parse(call.arguments)
    guard let arguments = parsed else return false
    if request_value_is_undefined(schema): true else: tool_schema_matches(schema, arguments)

bool tool_calls_match([ParsedToolCall] calls, [JValue] tools):
    for call in calls:
        if not tool_call_matches(call, tools):
            return false
    true

# Small models sometimes omit the Hermes wrapper around an otherwise valid
# call. Under an explicit required/named choice, recognize a bare
# `{name, arguments}` object. With one allowed tool, a bare arguments object
# is unambiguous. A named choice also canonicalizes the function name because
# it was the only function exposed to the chat template.
pub ParsedReply parse_reply_for_tools(string text, JValue body, [JValue] tools):
    let parsed = parse_reply(text)
    let forced = named_tool_choice(body)
    if parsed.calls.length > 0:
        mut [ParsedToolCall] calls = []
        for call in parsed.calls:
            let name = if forced == "": call.name else: forced
            calls.push(ParsedToolCall(name, call.arguments))
        if tool_calls_match(calls, tools):
            return ParsedReply(parsed.content, calls)
        return ParsedReply(text.trim(), [])
    if not tool_choice_required(body):
        return parsed

    let bare = try? json_parse(text.trim())
    guard let value = bare else return parsed
    match value:
        JDict(fields, keys):
            var string name = json_get_str(value, "name", "")
            let args = json_get(value, "arguments")
            var string arguments = ""
            if name != "":
                arguments = if jv_is_str(args): json_get_str(value, "arguments", "") else: jv_to_json(args)
            else:
                name = if forced != "": forced else: sole_tool_name(tools)
                arguments = jv_to_json(value)
            if forced != "":
                name = forced
            if name != "":
                let calls = [ParsedToolCall(name, arguments)]
                if tool_calls_match(calls, tools):
                    return ParsedReply("", calls)
        _:
            return parsed
    parsed

# Validates the generation fields consumed by server.br.  Returning one stable
# message (rather than silently substituting a default) makes malformed client
# requests fail like llama-server/OpenAI requests do.  Unknown fields remain
# allowed for forward compatibility.
pub string request_validation_error(JValue body):
    let model = json_get(body, "model")
    if not request_value_is_undefined(model):
        match model:
            JStr(name):
                if name == "":
                    return "`model` must be a non-empty string"
            _: return "`model` must be a non-empty string"

    let n_choices = json_get(body, "n")
    if not request_value_is_undefined(n_choices):
        match n_choices:
            JInt(n):
                if n != 1:
                    return "`n` must be 1; multiple choices are not supported"
            _:
                return "`n` must be an integer"

    let mt = json_get(body, "max_tokens")
    if not request_value_is_undefined(mt):
        match mt:
            JInt(n):
                if n <= 0:
                    return "`max_tokens` must be greater than 0"
            _:
                return "`max_tokens` must be an integer"
    let mct = json_get(body, "max_completion_tokens")
    if not request_value_is_undefined(mct):
        match mct:
            JInt(n):
                if n <= 0:
                    return "`max_completion_tokens` must be greater than 0"
            _:
                return "`max_completion_tokens` must be an integer"
    let np = json_get(body, "n_predict")
    if not request_value_is_undefined(np):
        match np:
            JInt(n):
                if n < -1:
                    return "`n_predict` must be -1 or greater"
            _:
                return "`n_predict` must be an integer"

    let temp = json_get(body, "temperature")
    if not request_value_is_undefined(temp):
        if not jv_is_number(temp):
            return "`temperature` must be a number"
        let v = json_get_float(body, "temperature", 0.0)
        if v < 0.0 or v > 2.0:
            return "`temperature` must be between 0 and 2"
    let dynatemp_range = json_get(body, "dynatemp_range")
    if not request_value_is_undefined(dynatemp_range):
        if not jv_is_number(dynatemp_range):
            return "`dynatemp_range` must be a number"
        if json_get_float(body, "dynatemp_range", 0.0) < 0.0:
            return "`dynatemp_range` must be non-negative"
    let dynatemp_exponent = json_get(body, "dynatemp_exponent")
    if not request_value_is_undefined(dynatemp_exponent):
        if not jv_is_number(dynatemp_exponent):
            return "`dynatemp_exponent` must be a number"
        if json_get_float(body, "dynatemp_exponent", 1.0) <= 0.0:
            return "`dynatemp_exponent` must be positive"
    let tp = json_get(body, "top_p")
    if not request_value_is_undefined(tp):
        if not jv_is_number(tp):
            return "`top_p` must be a number"
        let v = json_get_float(body, "top_p", 1.0)
        if v <= 0.0 or v > 1.0:
            return "`top_p` must be greater than 0 and at most 1"
    let typical = json_get(body, "typical_p")
    if not request_value_is_undefined(typical):
        if not jv_is_number(typical):
            return "`typical_p` must be a number"
        let v = json_get_float(body, "typical_p", 1.0)
        if v <= 0.0 or v > 1.0:
            return "`typical_p` must be greater than 0 and at most 1"
    let top_n_sigma = json_get(body, "top_n_sigma")
    if not request_value_is_undefined(top_n_sigma) and not jv_is_number(top_n_sigma):
        return "`top_n_sigma` must be a number"
    for key in ["xtc_probability", "xtc_threshold"]:
        let value = json_get(body, key)
        if not request_value_is_undefined(value):
            if not jv_is_number(value):
                return "`{key}` must be a number"
            let numeric = json_get_float(body, key, 0.0)
            if numeric < 0.0 or numeric > 1.0:
                return "`{key}` must be between 0 and 1"
    let mp = json_get(body, "min_p")
    if not request_value_is_undefined(mp):
        if not jv_is_number(mp):
            return "`min_p` must be a number"
        let v = json_get_float(body, "min_p", 0.0)
        if v < 0.0 or v > 1.0:
            return "`min_p` must be between 0 and 1"
    let min_keep = json_get(body, "min_keep")
    if not request_value_is_undefined(min_keep):
        match min_keep:
            JInt(value):
                if value < 0:
                    return "`min_keep` must be a non-negative integer"
            _: return "`min_keep` must be an integer"
    let n_indent = json_get(body, "n_indent")
    if not request_value_is_undefined(n_indent):
        match n_indent:
            JInt(value):
                if value < 0: return "`n_indent` must be a non-negative integer"
            _: return "`n_indent` must be an integer"
    let tk = json_get(body, "top_k")
    if not request_value_is_undefined(tk):
        match tk:
            JInt(n): true
            _:
                return "`top_k` must be an integer"
    let seed = json_get(body, "seed")
    if not request_value_is_undefined(seed):
        match seed:
            JInt(n): true
            _: return "`seed` must be an integer"

    for key in ["frequency_penalty", "presence_penalty"]:
        let p = json_get(body, key)
        if not request_value_is_undefined(p):
            if not jv_is_number(p):
                return "`{key}` must be a number"
            let v = json_get_float(body, key, 0.0)
            if v < -2.0 or v > 2.0:
                return "`{key}` must be between -2 and 2"
    let rp = json_get(body, "repeat_penalty")
    if not request_value_is_undefined(rp):
        if not jv_is_number(rp):
            return "`repeat_penalty` must be a number"
        if json_get_float(body, "repeat_penalty", 1.0) <= 0.0:
            return "`repeat_penalty` must be greater than 0"
    let rln = json_get(body, "repeat_last_n")
    if not request_value_is_undefined(rln):
        match rln:
            JInt(n):
                if n < -1:
                    return "`repeat_last_n` must be -1 or greater"
            _: return "`repeat_last_n` must be an integer"
    let samplers = json_get(body, "samplers")
    if not request_value_is_undefined(samplers):
        match samplers:
            JList(items):
                var int previous_rank = -1
                for item in items:
                    match item:
                        JStr(name):
                            let rank = sampler_order_rank(name)
                            if rank < 0: return "unsupported sampler `{name}`"
                            if rank <= previous_rank:
                                return "`samplers` must follow llama.cpp's canonical order"
                            previous_rank = rank
                        _: return "`samplers` must be an array of strings"
            _: return "`samplers` must be an array of strings"
    let dry_multiplier = json_get(body, "dry_multiplier")
    if not request_value_is_undefined(dry_multiplier):
        if not jv_is_number(dry_multiplier):
            return "`dry_multiplier` must be a number"
        if json_get_float(body, "dry_multiplier", 0.0) < 0.0:
            return "`dry_multiplier` must be non-negative"
    let dry_base = json_get(body, "dry_base")
    if not request_value_is_undefined(dry_base) and not jv_is_number(dry_base):
        return "`dry_base` must be a number"
    for key in ["dry_allowed_length", "dry_penalty_last_n"]:
        let value = json_get(body, key)
        if not request_value_is_undefined(value):
            match value:
                JInt(n):
                    if n < 0: return "`{key}` must be a non-negative integer"
                _: return "`{key}` must be an integer"
    let dry_breakers = json_get(body, "dry_sequence_breakers")
    if not request_value_is_undefined(dry_breakers):
        match dry_breakers:
            JList(items):
                if items.length == 0:
                    return "`dry_sequence_breakers` must be a non-empty array of strings"
                for item in items:
                    match item:
                        JStr(value):
                            if value == "": return "`dry_sequence_breakers` entries must not be empty"
                        _: return "`dry_sequence_breakers` must be a non-empty array of strings"
            _: return "`dry_sequence_breakers` must be a non-empty array of strings"
    let mirostat = json_get(body, "mirostat")
    if not request_value_is_undefined(mirostat):
        match mirostat:
            JInt(mode):
                if mode < 0 or mode > 2: return "`mirostat` must be 0, 1, or 2"
            _: return "`mirostat` must be an integer"
    for key in ["mirostat_tau", "mirostat_eta"]:
        let value = json_get(body, key)
        if not request_value_is_undefined(value):
            if not jv_is_number(value): return "`{key}` must be a number"
            if json_get_float(body, key, 0.0) <= 0.0: return "`{key}` must be positive"
    let adaptive_target = json_get(body, "adaptive_target")
    if not request_value_is_undefined(adaptive_target):
        if not jv_is_number(adaptive_target): return "`adaptive_target` must be a number"
        let value = json_get_float(body, "adaptive_target", -1.0)
        if value > 1.0: return "`adaptive_target` must be at most 1"
    let adaptive_decay = json_get(body, "adaptive_decay")
    if not request_value_is_undefined(adaptive_decay):
        if not jv_is_number(adaptive_decay): return "`adaptive_decay` must be a number"
        let value = json_get_float(body, "adaptive_decay", 0.9)
        if value < 0.0 or value > 0.99: return "`adaptive_decay` must be between 0 and 0.99"
    if json_get_int(body, "mirostat", 0) != 0 and json_get_float(body, "adaptive_target", -1.0) >= 0.0:
        return "`mirostat` and `adaptive_target` cannot be enabled together"

    let stream_value = json_get(body, "stream")
    if not request_value_is_undefined(stream_value):
        match stream_value:
            JBool(b): true
            _: return "`stream` must be a boolean"
    let ignore_eos = json_get(body, "ignore_eos")
    if not request_value_is_undefined(ignore_eos) and not jv_is_bool(ignore_eos):
        return "`ignore_eos` must be a boolean"
    let stream_options = json_get(body, "stream_options")
    if not request_value_is_undefined(stream_options):
        match stream_options:
            JDict(fields, keys):
                let include_usage = json_get(stream_options, "include_usage")
                if not request_value_is_undefined(include_usage):
                    match include_usage:
                        JBool(b): true
                        _: return "`stream_options.include_usage` must be a boolean"
            _: return "`stream_options` must be an object"

    let stop = json_get(body, "stop")
    if not request_value_is_undefined(stop):
        match stop:
            JStr(s): true
            JList(items):
                for item in items:
                    if not jv_is_str(item):
                        return "`stop` must contain only strings"
            _: return "`stop` must be a string or an array of strings"

    let kwargs = json_get(body, "chat_template_kwargs")
    if not request_value_is_undefined(kwargs):
        match kwargs:
            JDict(fields, keys): true
            _: return "`chat_template_kwargs` must be an object"
    let reasoning_effort = json_get(body, "reasoning_effort")
    if not request_value_is_undefined(reasoning_effort) and not jv_is_str(reasoning_effort):
        return "`reasoning_effort` must be a string"
    let reasoning_format = json_get(body, "reasoning_format")
    if not request_value_is_undefined(reasoning_format):
        match reasoning_format:
            JStr(format):
                if format != "auto" and format != "deepseek" and format != "deepseek-legacy" and format != "none":
                    return "`reasoning_format` must be one of auto, deepseek, deepseek-legacy, or none"
            _: return "`reasoning_format` must be a string"
    let parallel_tool_calls = json_get(body, "parallel_tool_calls")
    if not request_value_is_undefined(parallel_tool_calls):
        match parallel_tool_calls:
            JBool(enabled): true
            _: return "`parallel_tool_calls` must be a boolean"
    let cache_prompt = json_get(body, "cache_prompt")
    if not request_value_is_undefined(cache_prompt) and not jv_is_bool(cache_prompt):
        return "`cache_prompt` must be a boolean"
    let return_tokens = json_get(body, "return_tokens")
    if not request_value_is_undefined(return_tokens) and not jv_is_bool(return_tokens):
        return "`return_tokens` must be a boolean"
    let predict_timeout = json_get(body, "t_max_predict_ms")
    if not request_value_is_undefined(predict_timeout):
        match predict_timeout:
            JInt(value):
                if value < -1:
                    return "`t_max_predict_ms` must be -1 or a non-negative integer"
            _: return "`t_max_predict_ms` must be an integer"
    let return_progress = json_get(body, "return_progress")
    if not request_value_is_undefined(return_progress) and not jv_is_bool(return_progress):
        return "`return_progress` must be a boolean"
    let timings_per_token = json_get(body, "timings_per_token")
    if not request_value_is_undefined(timings_per_token) and not jv_is_bool(timings_per_token):
        return "`timings_per_token` must be a boolean"
    let sse_ping_interval = json_get(body, "sse_ping_interval")
    if not request_value_is_undefined(sse_ping_interval):
        match sse_ping_interval:
            JInt(value):
                if value < -1: return "`sse_ping_interval` must be -1 or a non-negative integer"
            _: return "`sse_ping_interval` must be an integer"
    let post_sampling_probs = json_get(body, "post_sampling_probs")
    if not request_value_is_undefined(post_sampling_probs) and not jv_is_bool(post_sampling_probs):
        return "`post_sampling_probs` must be a boolean"
    let response_fields = json_get(body, "response_fields")
    if not request_value_is_undefined(response_fields):
        match response_fields:
            JList(items):
                for item in items:
                    match item:
                        JStr(path):
                            if path == "" or path.startsWith("/") or path.endsWith("/") or path.contains("//"):
                                return "`response_fields` entries must be non-empty field paths"
                        _: return "`response_fields` must be an array of strings"
            _: return "`response_fields` must be an array of strings"
    let response_format = json_get(body, "response_format")
    let native_schema = json_get(body, "json_schema")
    if not request_value_is_undefined(native_schema):
        let invalid = tool_schema_validation_error(native_schema)
        if invalid != "":
            return "`json_schema` is invalid: {invalid}"
    let grammar = json_get(body, "grammar")
    if not request_value_is_undefined(grammar):
        match grammar:
            JStr(value):
                if value != "" and request_value_is_undefined(native_schema):
                    return "native `grammar` is not supported; use `json_schema` or `response_format`"
            _: return "`grammar` must be a string"
    if not request_value_is_undefined(response_format):
        match response_format:
            JDict(fields, keys):
                let format_type = json_get_str(response_format, "type", "")
                if format_type == "":
                    return "`response_format.type` is required and must be a string"
                if format_type != "text" and format_type != "json_object" and format_type != "json_schema":
                    return "`response_format.type` `{format_type}` requires constrained decoding, which is not supported"
                let direct_schema = json_get(response_format, "schema")
                if format_type == "json_object" and not request_value_is_undefined(direct_schema):
                    let invalid = tool_schema_validation_error(direct_schema)
                    if invalid != "":
                        return "`response_format.schema` is invalid: {invalid}"
                if format_type == "json_schema":
                    let json_schema = json_get(response_format, "json_schema")
                    if request_value_is_undefined(json_schema):
                        if request_value_is_undefined(direct_schema):
                            return "`response_format.json_schema` or `response_format.schema` is required"
                        let invalid = tool_schema_validation_error(direct_schema)
                        if invalid != "":
                            return "`response_format.schema` is invalid: {invalid}"
                    else:
                        match json_schema:
                            JDict(schema_fields, schema_keys):
                                let name = json_get(json_schema, "name")
                                if not jv_is_str(name) or json_get_str(json_schema, "name", "") == "":
                                    return "`response_format.json_schema.name` must be a non-empty string"
                                let strict = json_get(json_schema, "strict")
                                if not request_value_is_undefined(strict) and not jv_is_bool(strict):
                                    return "`response_format.json_schema.strict` must be a boolean"
                                let schema = json_get(json_schema, "schema")
                                let invalid = tool_schema_validation_error(schema)
                                if invalid != "":
                                    return "`response_format.json_schema.schema` is invalid: {invalid}"
                            _: return "`response_format.json_schema` must be an object"
            _: return "`response_format` must be an object"
    let logprobs = json_get(body, "logprobs")
    if not request_value_is_undefined(logprobs):
        match logprobs:
            JBool(enabled):
                if enabled and json_get_bool(body, "stream", false):
                    if json_get_str(body, "reasoning_format", "auto") != "none":
                        return "streaming Chat `logprobs` require `reasoning_format: none`"
                    if json_get_list(body, "tools").length > 0 and not tools_disabled(body):
                        return "streaming Chat `logprobs` require tools to be absent or `tool_choice: none`"
            JInt(count):
                if count < 0 or count > 5:
                    return "integer `logprobs` must be between 0 and 5"
            _: return "`logprobs` must be a boolean or integer"
    let top_logprobs = json_get(body, "top_logprobs")
    if not request_value_is_undefined(top_logprobs):
        match top_logprobs:
            JInt(count):
                if count < 0 or count > 20:
                    return "`top_logprobs` must be between 0 and 20"
                if count > 0 and not json_get_bool(body, "logprobs", false):
                    return "`top_logprobs` requires `logprobs: true`"
            _: return "`top_logprobs` must be an integer"
    let n_probs = json_get(body, "n_probs")
    if not request_value_is_undefined(n_probs):
        match n_probs:
            JInt(count):
                if count < 0 or count > 20:
                    return "`n_probs` must be between 0 and 20"
            _: return "`n_probs` must be an integer"
    let logit_bias = json_get(body, "logit_bias")
    if not request_value_is_undefined(logit_bias):
        match logit_bias:
            JDict(fields, keys):
                for key in keys:
                    if key == "": return "native `logit_bias` text keys must not be empty"
                    let value = fields[key] else JValue.JUndefined
                    let bias = match value:
                        JInt(n): n as float
                        JFloat(f): f
                        JBool(enabled):
                            if enabled: return "native `logit_bias` boolean values may only be false"
                            -100.0
                        _: 0.0
                    if not jv_is_number(value) and not jv_is_bool(value):
                        return "native `logit_bias` values must be numbers or false"
                    if bias < -100.0 or bias > 100.0:
                        return "native `logit_bias` values must be between -100 and 100"
            JList(items):
                for item in items:
                    match item:
                        JList(pair):
                            if pair.length != 2: return "native `logit_bias` entries must be [token_id, bias] pairs"
                            match pair[0]:
                                JInt(token): true
                                JStr(text):
                                    if text == "": return "native `logit_bias` text entries must not be empty"
                                _: return "native `logit_bias` entries require a token ID or text"
                            match pair[1]:
                                JInt(n):
                                    if n < -100 or n > 100: return "native `logit_bias` values must be between -100 and 100"
                                JFloat(f):
                                    if f < -100.0 or f > 100.0: return "native `logit_bias` values must be between -100 and 100"
                                JBool(enabled):
                                    if enabled: return "native `logit_bias` boolean values may only be false"
                                _: return "native `logit_bias` values must be numbers or false"
                        _: return "native `logit_bias` entries must be [token_id, bias] pairs"
            _: return "`logit_bias` must be an object or an array of pairs"
    ""

# `logprobs` has two incompatible OpenAI spellings: Chat uses a boolean plus
# `top_logprobs`, while legacy Text Completions uses an integer count.  Native
# llama-server requests use `n_probs` instead.  Keep the common validator
# usable by small unit tests, then reject fields that the selected endpoint
# would otherwise accept and silently ignore.
pub string endpoint_request_validation_error(JValue body, bool is_chat, bool is_native):
    let invalid = request_validation_error(body)
    if invalid != "":
        return invalid
    let logprobs = json_get(body, "logprobs")
    let lora = json_get(body, "lora")
    if not request_value_is_undefined(lora):
        match lora:
            JList(items):
                if items.length > 0:
                    return "per-request LoRA adapters are not supported because no adapters are loaded"
            _: return "`lora` must be an array"
    if not is_chat:
        for key in ["tools", "tool_choice", "parallel_tool_calls", "chat_template_kwargs", "reasoning_effort", "reasoning_format"]:
            if not request_value_is_undefined(json_get(body, key)):
                return "non-chat completions do not support `{key}`"
    if not is_native:
        match json_get(body, "logit_bias"):
            JList(items): return "OpenAI endpoints require `logit_bias` to be an object"
            JDict(fields, keys):
                for key in keys:
                    guard let token = (key as int) else return "OpenAI `logit_bias` keys must be token IDs"
                    if token < 0: return "OpenAI `logit_bias` keys must be non-negative token IDs"
                    let value = fields[key] else JValue.JUndefined
                    if not jv_is_number(value): return "OpenAI `logit_bias` values must be numbers"
            _: true
        for key in ["id_slot", "return_tokens", "return_progress", "timings_per_token"]:
            if not request_value_is_undefined(json_get(body, key)):
                return "OpenAI endpoints do not support native `{key}`"
    if is_chat:
        if not request_value_is_undefined(json_get(body, "n_keep")) or not request_value_is_undefined(json_get(body, "n_discard")) or not request_value_is_undefined(json_get(body, "n_cache_reuse")):
            return "Chat completions do not support native context-shift options"
        if not request_value_is_undefined(json_get(body, "n_cmpl")):
            return "Chat completions use `n`, not native `n_cmpl`"
        if not request_value_is_undefined(json_get(body, "post_sampling_probs")):
            return "Chat completions do not support native `post_sampling_probs`"
        if not request_value_is_undefined(json_get(body, "response_fields")):
            return "Chat completions do not support native `response_fields`"
        if not request_value_is_undefined(logprobs) and not jv_is_bool(logprobs):
            return "Chat `logprobs` must be a boolean"
        if not request_value_is_undefined(json_get(body, "n_probs")):
            return "Chat completions do not support `n_probs`; use `logprobs` and `top_logprobs`"
    elif is_native:
        for key in ["n", "max_completion_tokens", "stream_options"]:
            if not request_value_is_undefined(json_get(body, key)):
                return "native completions do not support OpenAI `{key}`"
        for key in ["n_keep", "n_discard", "n_cache_reuse"]:
            let value = json_get(body, key)
            if not request_value_is_undefined(value):
                match value:
                    JInt(count):
                        if key == "n_keep" and count < -1:
                            return "native `n_keep` must be -1 or non-negative"
                        if key != "n_keep" and count < 0:
                            return "native `{key}` must be non-negative"
                        if key == "n_cache_reuse" and count != 0:
                            return "native `n_cache_reuse` is not supported"
                    _: return "native `{key}` must be an integer"
        let n_cmpl = json_get(body, "n_cmpl")
        if not request_value_is_undefined(n_cmpl):
            match n_cmpl:
                JInt(value):
                    if value != 1:
                        return "native `n_cmpl` must be 1; multiple completions are not supported"
                _: return "native `n_cmpl` must be an integer"
        if not request_value_is_undefined(logprobs):
            return "native completions do not support `logprobs`; use `n_probs`"
        if not request_value_is_undefined(json_get(body, "top_logprobs")):
            return "native completions do not support `top_logprobs`; use `n_probs`"
        let id_slot = json_get(body, "id_slot")
        if not request_value_is_undefined(id_slot):
            match id_slot:
                JInt(value):
                    if value < -1:
                        return "native `id_slot` must be -1 or a non-negative integer"
                _: return "native `id_slot` must be an integer"
    else:
        if not request_value_is_undefined(json_get(body, "n_keep")) or not request_value_is_undefined(json_get(body, "n_discard")) or not request_value_is_undefined(json_get(body, "n_cache_reuse")):
            return "Text Completions do not support native context-shift options"
        if not request_value_is_undefined(json_get(body, "n_cmpl")):
            return "Text Completions use `n`, not native `n_cmpl`"
        if not request_value_is_undefined(json_get(body, "post_sampling_probs")):
            return "Text Completions do not support native `post_sampling_probs`"
        if not request_value_is_undefined(json_get(body, "response_fields")):
            return "Text Completions do not support native `response_fields`"
        if not request_value_is_undefined(logprobs) and jv_is_bool(logprobs):
            return "Text Completion `logprobs` must be an integer"
        if not request_value_is_undefined(json_get(body, "top_logprobs")):
            return "Text Completions use the integer `logprobs` field, not `top_logprobs`"
        if not request_value_is_undefined(json_get(body, "n_probs")):
            return "Text Completions do not support `n_probs`; use integer `logprobs`"
    ""

# Truncates `text` at the earliest occurrence of any non-empty stop string.
pub (string, bool, string) apply_stop_with_word(string text, [string] stops):
    var string out = text
    var bool stopped = false
    var string stopping_word = ""
    for s in stops:
        if s != "" and text.contains(s):
            let candidate = text.split(s)[0]
            if not stopped or candidate.chars().length < out.chars().length:
                out = candidate
                stopped = true
                stopping_word = s
    (out, stopped, stopping_word)

pub (string, bool) apply_stop(string text, [string] stops):
    let (out, stopped, stopping_word) = apply_stop_with_word(text, stops)
    (out, stopped)

pub string native_stopping_word(string stop_type, string stopping_word):
    if stop_type == "word": stopping_word else: ""

pub bool native_context_truncated(int prompt_tokens, int completion_tokens, int n_ctx, bool stopped_early):
    not stopped_early and prompt_tokens + completion_tokens >= n_ctx

pub bool native_truncated_status(int prompt_tokens, int completion_tokens, int n_ctx,
                                 bool stopped_early, bool context_shift_enabled, bool context_was_shifted):
    context_was_shifted or (not context_shift_enabled and native_context_truncated(prompt_tokens, completion_tokens, n_ctx, stopped_early))

pub string listen_address(string host, int port):
    if host.contains(":") and not host.startsWith("["):
        "[{host}]:{port}"
    else:
        "{host}:{port}"

# HTTP header names and the Bearer scheme are case-insensitive; API keys are
# not. Anthropic clients send the same raw key through x-api-key. Keeping this
# pure makes authentication testable without a socket.
pub string http_header_value(string headers, string name):
    let prefix = "{name.toLower()}:"
    for line in headers.split("\r\n"):
        if line.toLower().startsWith(prefix):
            let chars = line.chars()
            var string value = ""
            var int i = prefix.chars().length
            while i < chars.length:
                value = "{value}{chars[i]}"
                i += 1
            return value.trim()
    ""

pub string cors_allow_origin(string configured, string origin, bool credentials):
    if origin == "":
        if configured == "*": return "*"
        return ""
    if configured == "*":
        if credentials: return origin
        return "*"
    let lower = origin.toLower()
    if configured == "localhost":
        for base in ["http://localhost", "https://localhost", "http://127.0.0.1", "https://127.0.0.1", "http://[::1]", "https://[::1]"]:
            if lower == base or lower.startsWith("{base}:"): return origin
        return ""
    for allowed in configured.split(","):
        if allowed.trim() == origin: return origin
    ""

pub [string] api_keys_from_file_text(string text):
    mut [string] keys = []
    for line in text.split("\n"):
        let key = line.trim()
        if key != "" and not key.startsWith("#"):
            keys.push(key)
    keys

pub bool api_key_authorized([string] configured_keys, string authorization, string api_key):
    if configured_keys.length == 0: return true
    for key in configured_keys:
        if api_key == key: return true
    let scheme = "bearer "
    guard authorization.toLower().startsWith(scheme) else return false
    let chars = authorization.chars()
    var string token = ""
    var int i = scheme.chars().length
    while i < chars.length:
        token = "{token}{chars[i]}"
        i += 1
    for key in configured_keys:
        if token == key: return true
    false

pub bool api_key_public_path(string path):
    path == "/" or path == "/health" or path == "/v1/health" or path == "/models" or path == "/v1/models"

# Stable scheduler classification for routes that run autoregressive model
# execution. Zero means the request stays on the control/tokenization path.
# 1=Anthropic messages, 2=OpenAI chat, 3=OpenAI completion,
# 4=llama-server native completion, 5=OpenAI Responses.
pub int generation_route_kind(string method, string path):
    if method != "POST": return 0
    if path == "/v1/messages": return 1
    if path == "/v1/chat/completions" or path == "/chat/completions": return 2
    if path == "/v1/completions": return 3
    if path == "/completion" or path == "/completions": return 4
    if path == "/v1/responses" or path == "/responses": return 5
    0

# Optional llama-server model endpoints recognized by the HTTP surface but not
# implemented by the text-only, serialized runtime. An empty string means that
# normal route dispatch should continue.
pub string unsupported_model_endpoint(string method, string path):
    if method == "POST":
        if path == "/embedding" or path == "/embeddings" or path == "/v1/embeddings":
            return "embeddings"
        if path == "/rerank" or path == "/reranking" or path == "/v1/rerank" or path == "/v1/reranking":
            return "reranking"
        if path == "/v1/audio/transcriptions" or path == "/audio/transcriptions":
            return "audio transcriptions"
        if path == "/tts": return "text-to-speech"
        if path == "/infill": return "infill"
        if path == "/v1/systemone": return "decision models"
        if path == "/v1/chat/completions/control": return "in-flight completion control"
        if path == "/v1/streams/lookup": return "resumable stream lookup"
        if path == "/predict": return "Vertex AI prediction"
    if (method == "GET" or method == "POST") and path == "/v1/realtime":
        return "Realtime API"
    if (method == "GET" or method == "DELETE") and path == "/v1/stream":
        return "resumable streams"
    ""

pub bool feature_disabled_endpoint(string method, string path):
    (method == "GET" or method == "POST") and (path == "/tools" or path == "/cors-proxy")

pub string unsupported_router_endpoint(string method, string path):
    if method == "POST" and (path == "/models" or path == "/models/load" or path == "/models/unload"):
        return "dynamic model routing"
    if (method == "GET" or method == "HEAD") and path == "/models/sse":
        return "model router events"
    if method == "DELETE" and path == "/models":
        return "model cache deletion"
    ""

pub bool anthropic_api_path(string path):
    path == "/v1/messages" or path == "/v1/messages/count_tokens"

pub string http_request_path(string target):
    target.split("?")[0]

pub string http_query_value(string target, string name):
    let parts = target.split("?")
    if parts.length < 2: return ""
    let prefix = "{name}="
    for field in parts[1].split("&"):
        if field.startsWith(prefix):
            let chars = field.chars()
            var string value = ""
            var int i = prefix.chars().length
            while i < chars.length:
                value = "{value}{chars[i]}"
                i += 1
            return value
    ""

# Returns the internal route path, or "" when the request is outside the
# configured prefix. An exact prefix targets the server root.
pub string strip_api_prefix(string path, string prefix):
    if prefix == "": return path
    if path == prefix: return "/"
    let expected = "{prefix}/"
    if not path.startsWith(expected): return ""
    let chars = path.chars()
    var string out = ""
    var int i = prefix.chars().length
    while i < chars.length:
        out = "{out}{chars[i]}"
        i += 1
    out

pub string api_prefix_validation_error(string prefix):
    if prefix == "": return ""
    if not prefix.startsWith("/"): return "--api-prefix must start with `/`"
    if prefix.endsWith("/"): return "--api-prefix must not end with `/`"
    if prefix.contains("?") or prefix.contains("#"): return "--api-prefix must be a URL path without query or fragment"
    ""

pub [string] model_alias_list(string configured, string fallback):
    if configured == "": return [fallback]
    mut [string] aliases = []
    for alias in configured.split(","):
        aliases.push(alias.trim())
    aliases

# RFC 3986 path-segment encoding used by `GET /v1/models/{model}`. Work on
# UTF-8 bytes so non-ASCII ids round-trip through ordinary OpenAI SDKs too.
pub string url_path_segment(string text):
    let hex = "0123456789ABCDEF".chars()
    var string out = ""
    for ch in text.chars():
        let cp = ord(ch)
        let bytes = if cp <= 0x7F:
            [cp]
        elif cp <= 0x7FF:
            [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
        elif cp <= 0xFFFF:
            [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
        else:
            [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
        for b in bytes:
            if (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 46 or b == 95 or b == 126:
                out = "{out}{chr(b)}"
            else:
                out = "{out}%{hex[b / 16]}{hex[b % 16]}"
    out

pub bool model_alias_path_matches([string] aliases, string path):
    for alias in aliases:
        if path == "/v1/models/{url_path_segment(alias)}" or path == "/v1/models/{alias}": return true
    false

string model_aliases_json([string] aliases):
    var string out = "["
    var int i = 0
    while i < aliases.length:
        if i > 0: out = "{out}, "
        out = "{out}\"{json_escape(aliases[i])}\""
        i += 1
    "{out}]"

# The first generated line is unrestricted. After a newline, stop immediately
# before the first non-whitespace character when its indentation is too small.
pub (string, bool) apply_min_indent(string text, int minimum):
    if minimum <= 0:
        return (text, false)
    let chars = text.chars()
    var bool line_start = false
    var int indentation = 0
    var int i = 0
    while i < chars.length:
        let ch = chars[i]
        if line_start:
            if ch == " " or ch == "\t":
                indentation += 1
            else:
                if indentation < minimum:
                    var string out = ""
                    var int j = 0
                    while j < i:
                        out = "{out}{chars[j]}"
                        j += 1
                    return (out, true)
                line_start = false
        elif ch == "\n":
            line_start = true
            indentation = 0
        i += 1
    (text, false)

pub bool sse_ping_due(int interval_seconds, int last_activity_ms, int now_ms):
    interval_seconds >= 0 and (interval_seconds == 0 or now_ms - last_activity_ms >= interval_seconds * 1000)

pub string reasoning_format_for_request(JValue body, string server_default, bool is_chat):
    if is_chat: json_get_str(body, "reasoning_format", server_default) else: "none"

# ── Response bodies ──────────────────────────────────────────────────────

string tool_calls_json(string id, [ParsedToolCall] calls, bool with_index):
    var string out = "["
    var int i = 0
    while i < calls.length:
        if i > 0:
            out = "{out}, "
        let idx = if with_index: "\"index\": {i}, " else: ""
        out = "{out}{{{idx}\"id\": \"call_{id}_{i}\", \"type\": \"function\", \"function\": {{\"name\": \"{json_escape(calls[i].name)}\", \"arguments\": \"{json_escape(calls[i].arguments)}\"}}}}"
        i += 1
    "{out}]"

string usage_json(int prompt_tokens, int completion_tokens, int cached_tokens):
    "{{\"prompt_tokens\": {prompt_tokens}, \"completion_tokens\": {completion_tokens}, \"total_tokens\": {prompt_tokens + completion_tokens}, \"prompt_tokens_details\": {{\"cached_tokens\": {cached_tokens}}}}}"

pub string error_json(string message, string kind, string code):
    "{{\"error\": {{\"message\": \"{json_escape(message)}\", \"type\": \"{kind}\", \"code\": \"{code}\"}}}}"

pub string anthropic_error_json(string request_id, string message, string kind):
    "{{\"type\":\"error\",\"error\":{{\"type\":\"{json_escape(kind)}\",\"message\":\"{json_escape(message)}\"}},\"request_id\":\"req_{json_escape(request_id)}\"}}"

pub string provider_error_json(bool is_anthropic, string request_id, string message, string kind, string code):
    if is_anthropic: anthropic_error_json(request_id, message, kind) else: error_json(message, kind, code)

# llama-server uses a numeric code for optional endpoints which are compiled
# in but disabled. Keep this separate from OpenAI request errors, whose codes
# are stable strings consumed by SDKs.
pub string endpoint_not_supported_json(string endpoint):
    "{{\"error\": {{\"code\": 501, \"message\": \"This server does not support {json_escape(endpoint)} endpoint.\", \"type\": \"not_supported_error\"}}}}"

pub string feature_disabled_json():
    "{{\"error\": {{\"message\": \"this feature is disabled\", \"type\": \"feature_disabled\"}}}}"

pub string lora_adapters_json():
    "[]"

pub string slot_erased_json(int id_slot, int n_erased):
    "{{\"id_slot\": {id_slot}, \"n_erased\": {n_erased}}}"

pub string slot_filename_validation_error(string filename):
    if filename == "": return "`filename` is required and must be a non-empty string"
    if filename.contains("/") or filename.contains("\\") or filename == "." or filename == "..":
        return "`filename` must be a plain file name without path components"
    ""

pub string slot_saved_json(int id_slot, string filename, int n_saved, int n_written, int elapsed_ms):
    "{{\"id_slot\": {id_slot}, \"filename\": \"{json_escape(filename)}\", \"n_saved\": {n_saved}, \"n_written\": {n_written}, \"timings\": {{\"save_ms\": {elapsed_ms}}}}}"

pub string slot_restored_json(int id_slot, string filename, int n_restored, int n_read, int elapsed_ms):
    "{{\"id_slot\": {id_slot}, \"filename\": \"{json_escape(filename)}\", \"n_restored\": {n_restored}, \"n_read\": {n_read}, \"timings\": {{\"restore_ms\": {elapsed_ms}}}}}"

pub string metrics_text(int prompt_tokens, int prompt_ms, int predicted_tokens,
                         int predicted_ms, int n_tokens_max, int n_decode):
    let prompt_seconds = prompt_ms as float / 1000.0
    let predicted_seconds = predicted_ms as float / 1000.0
    let prompt_rate = if prompt_ms > 0: prompt_tokens as float * 1000.0 / prompt_ms as float else: 0.0
    let predicted_rate = if predicted_ms > 0: predicted_tokens as float * 1000.0 / predicted_ms as float else: 0.0
    let busy_slots = if n_decode > 0: 1 else: 0
    "# TYPE llamacpp:prompt_tokens_total counter\nllamacpp:prompt_tokens_total {prompt_tokens}\n# TYPE llamacpp:prompt_seconds_total counter\nllamacpp:prompt_seconds_total {prompt_seconds}\n# TYPE llamacpp:prompt_tokens_seconds gauge\nllamacpp:prompt_tokens_seconds {prompt_rate}\n# TYPE llamacpp:tokens_predicted_total counter\nllamacpp:tokens_predicted_total {predicted_tokens}\n# TYPE llamacpp:tokens_predicted_seconds_total counter\nllamacpp:tokens_predicted_seconds_total {predicted_seconds}\n# TYPE llamacpp:predicted_tokens_seconds gauge\nllamacpp:predicted_tokens_seconds {predicted_rate}\n# TYPE llamacpp:requests_processing gauge\nllamacpp:requests_processing 0\n# TYPE llamacpp:requests_deferred gauge\nllamacpp:requests_deferred 0\n# TYPE llamacpp:n_tokens_max counter\nllamacpp:n_tokens_max {n_tokens_max}\n# TYPE llamacpp:n_decode_total counter\nllamacpp:n_decode_total {n_decode}\n# TYPE llamacpp:n_busy_slots_per_decode gauge\nllamacpp:n_busy_slots_per_decode {busy_slots}\n# TYPE llamacpp:spec_decode_num_draft_tokens_total counter\nllamacpp:spec_decode_num_draft_tokens_total 0\n# TYPE llamacpp:spec_decode_num_accepted_tokens_total counter\nllamacpp:spec_decode_num_accepted_tokens_total 0\n# TYPE llamacpp:spec_decode_num_drafts_total counter\nllamacpp:spec_decode_num_drafts_total 0\n"

# The 400 for a prompt that does not fit the context (`--ctx-size`). Clients
# detect an overflow from the error code (OpenAI's `context_length_exceeded`)
# or from phrases in the message ("maximum context length", llama.cpp's
# "exceeds the available context size"), so the message carries both, and the
# counts are also given as fields (like llama.cpp's `n_prompt_tokens`, `n_ctx`).
pub string context_exceeded_json(int n_prompt, int n_ctx):
    let message = "This model's maximum context length is {n_ctx} tokens. The request exceeds the available context size: your messages resulted in {n_prompt} tokens (the reply needs room too). Shorten the conversation or start the server with a larger --ctx-size."
    "{{\"error\": {{\"message\": \"{json_escape(message)}\", \"type\": \"invalid_request_error\", \"code\": \"context_length_exceeded\", \"param\": \"messages\", \"n_prompt_tokens\": {n_prompt}, \"n_ctx\": {n_ctx}}}}}"

pub string provider_context_exceeded_json(bool is_anthropic, string request_id, int n_prompt, int n_ctx):
    if is_anthropic:
        let message = "This model's maximum context length is {n_ctx} tokens. The request exceeds the available context size: your messages resulted in {n_prompt} tokens (the reply needs room too). Shorten the conversation or start the server with a larger --ctx-size."
        anthropic_error_json(request_id, message, "invalid_request_error")
    else:
        context_exceeded_json(n_prompt, n_ctx)

pub uint64 unix_timestamp() throws:
    SystemTime.now().durationSince(UNIX_EPOCH).asSecs()

