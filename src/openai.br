# boring-llm — OpenAI-compatible API plumbing (pure, no sockets, no GPU)
#
# Everything server.br needs that doesn't touch a socket or the model:
# normalizing an OpenAI-style `messages` array into what a GGUF chat template
# expects, pulling Hermes-style `<tool_call>` blocks (the format Qwen2.5 and
# many other instruct models emit) back out of generated text, and building
# the JSON / SSE response bodies. Kept separate so all of it can be unit-tested
# under `boring run` (test/test_openai.br) without a model or a port.
#
# Literal `{`/`}` in the JSON-building strings below are written doubled
# (`{{`/`}}`) — Boring's own interpolation syntax otherwise.

use jinja
use json

# ── JValue helpers ───────────────────────────────────────────────────────

bool jv_is_list(JValue v):
    match v:
        JList(items): true
        _: false

bool jv_is_str(JValue v):
    match v:
        JStr(s): true
        _: false

bool jv_is_number(JValue v):
    match v:
        JInt(n): true
        JFloat(f): true
        _: false

bool request_value_is_undefined(JValue v):
    match v:
        JUndefined: true
        _: false

# JSON Schema equality is structural: object key order is irrelevant and the
# mathematical numbers 1 and 1.0 compare equal even if the parser stored them
# in different variants.
pub bool json_values_equal(JValue a, JValue b):
    match a:
        JUndefined:
            match b:
                JUndefined: true
                _: false
        JBool(av):
            match b:
                JBool(bv): av == bv
                _: false
        JInt(av):
            match b:
                JInt(bv): av == bv
                JFloat(bv): av as float == bv
                _: false
        JFloat(av):
            match b:
                JInt(bv): av == bv as float
                JFloat(bv): av == bv
                _: false
        JStr(av):
            match b:
                JStr(bv): av == bv
                _: false
        JList(a_items):
            match b:
                JList(b_items):
                    if a_items.length != b_items.length: return false
                    var int i = 0
                    while i < a_items.length:
                        if not json_values_equal(a_items[i], b_items[i]): return false
                        i += 1
                    true
                _: false
        JDict(a_fields, a_keys):
            match b:
                JDict(b_fields, b_keys):
                    if a_keys.length != b_keys.length: return false
                    for key in a_keys:
                        if not b_fields.contains(key): return false
                        let av = a_fields[key] else JValue.JUndefined
                        let bv = b_fields[key] else JValue.JUndefined
                        if not json_values_equal(av, bv): return false
                    true
                _: false

# Returns `d` with `key` set to `value` (appended to the key order if new).
pub JValue jv_set(JValue d, string key, JValue value):
    match d:
        JDict(fields, keys):
            mut {string=JValue} nf = fields.clone()
            mut [string] nk = keys.clone()
            if not fields.contains(key):
                nk.push(key)
            nf[key] = value
            JValue.JDict(nf, nk)
        _: d

# Template variables derived from the OpenAI request. llama-server exposes
# `reasoning_effort` directly to the Jinja template. Qwen3 templates predate
# that name and read `enable_thinking`, so effort `none` also supplies false
# unless the caller explicitly set that lower-level variable.
pub JValue chat_template_variables(JValue body):
    let raw = json_get(body, "chat_template_kwargs")
    var JValue out = match raw:
        JDict(fields, keys): raw.clone()
        _: JValue.JDict({=}, [])
    let effort = json_get(body, "reasoning_effort")
    if jv_is_str(effort):
        out = jv_set(out, "reasoning_effort", effort)
        if json_get_str(body, "reasoning_effort", "") == "none" and request_value_is_undefined(json_get(out, "enable_thinking")):
            out = jv_set(out, "enable_thinking", JValue.JBool(false))
    let parallel = json_get(body, "parallel_tool_calls")
    match parallel:
        JBool(enabled): out = jv_set(out, "parallel_tool_calls", JValue.JBool(enabled))
        _: true
    out

# ── Prompt-prefix reuse ──────────────────────────────────────────────────

# Length of the longest common prefix of two token sequences — how many
# positions of a previous request's KV cache are still valid for this one.
pub int common_prefix_len([int] a, [int] b):
    let n = if a.length < b.length: a.length else: b.length
    var int i = 0
    while i < n and a[i] == b[i]:
        i += 1
    i

# Which cached sequence shares the longest prefix with `prompt`: (slot index,
# shared length), or (-1, 0) when none shares even one token. Ties keep the
# earliest slot.
pub (int, int) best_prefix_slot([[int]] slots, [int] prompt):
    var int best = -1
    var int best_len = 0
    var int i = 0
    while i < slots.length:
        let c = common_prefix_len(slots[i], prompt)
        if c > best_len:
            best_len = c
            best = i
        i += 1
    (best, best_len)

# ── Message normalization ────────────────────────────────────────────────

# `content` may be a plain string, null, or an array of typed parts
# (`[{"type": "text", "text": "..."}]` — what the AI SDK sends); chat
# templates only understand a string.
pub string content_to_text(JValue c):
    match c:
        JStr(s): s
        JList(parts):
            var string out = ""
            for p in parts:
                let t = json_get_str(p, "text", "")
                out = "{out}{t}"
            out
        _: ""

# OpenAI sends an assistant `tool_calls[i].function.arguments` as a JSON
# *string*; chat templates (Qwen's, ...) apply `| tojson` to it and expect an
# object — parse it once here. A string that isn't valid JSON is left alone.
JValue normalize_tool_call(JValue call):
    let func = json_get(call, "function")
    if not jv_is_str(json_get(func, "arguments")):
        return call
    let parsed = try? json_parse(json_get_str(func, "arguments", ""))
    if let pv = parsed:
        return jv_set(call, "function", jv_set(func, "arguments", pv))
    call

pub [JValue] normalize_messages([JValue] messages) throws:
    mut [JValue] out = []
    for m in messages:
        var JValue nm = m.clone()
        # llama.cpp maps the modern OpenAI `developer` role to `system` for
        # templates other than GPT-OSS. boring-llm currently supports Qwen/Llama
        # layouts, whose embedded templates likewise expect `system`.
        if json_get_str(m, "role", "") == "developer":
            nm = jv_set(nm, "role", JValue.JStr("system"))
        if jv_is_list(json_get(m, "content")):
            nm = jv_set(nm, "content", JValue.JStr(content_to_text(json_get(m, "content"))))
        elif not jv_is_str(json_get(m, "content")):
            # `content: null` (an assistant message that only carries tool calls) or no
            # content at all: templates do string operations on it (Qwen3's tests
            # `'</think>' in message.content`), which fail on a null.
            nm = jv_set(nm, "content", JValue.JStr(""))
        if jv_is_list(json_get(m, "tool_calls")):
            mut [JValue] calls = []
            for c in json_get_list(m, "tool_calls"):
                calls.push(normalize_tool_call(c))
            nm = jv_set(nm, "tool_calls", JValue.JList(calls))
        out.push(nm)
    out

# Checks the JSON Schema subset enforced later by `tool_schema_matches`.
# Rejecting malformed recognized keywords avoids silently weakening a tool's
# argument contract while leaving unknown keywords forward-compatible.
pub string tool_schema_validation_error(JValue schema):
    match schema:
        JDict(fields, keys):
            let schema_type = json_get(schema, "type")
            match schema_type:
                JUndefined:
                    if fields.contains("type"): return "JSON Schema `type` must not be null"
                JStr(name):
                    if name != "object" and name != "array" and name != "string" and name != "integer" and name != "number" and name != "boolean" and name != "null":
                        return "JSON Schema `type` `{name}` is not supported"
                JList(types):
                    if types.length == 0:
                        return "JSON Schema `type` array must not be empty"
                    for item in types:
                        match item:
                            JStr(name):
                                if name != "object" and name != "array" and name != "string" and name != "integer" and name != "number" and name != "boolean" and name != "null":
                                    return "JSON Schema `type` `{name}` is not supported"
                            _: return "JSON Schema `type` array must contain only strings"
                _: return "JSON Schema `type` must be a string or array of strings"

            let properties = json_get(schema, "properties")
            if fields.contains("properties"):
                match properties:
                    JDict(prop_fields, prop_keys):
                        for key in prop_keys:
                            let child = prop_fields[key] else JValue.JUndefined
                            let invalid = tool_schema_validation_error(child)
                            if invalid != "": return invalid
                    _: return "JSON Schema `properties` must be an object"
            let required = json_get(schema, "required")
            if fields.contains("required"):
                match required:
                    JList(items):
                        for item in items:
                            if not jv_is_str(item): return "JSON Schema `required` must contain only strings"
                    _: return "JSON Schema `required` must be an array"
            let additional = json_get(schema, "additionalProperties")
            if fields.contains("additionalProperties"):
                match additional:
                    JBool(allowed): true
                    JDict(extra_fields, extra_keys):
                        let invalid = tool_schema_validation_error(additional)
                        if invalid != "": return invalid
                    _: return "JSON Schema `additionalProperties` must be a boolean or object"
            let items_schema = json_get(schema, "items")
            if fields.contains("items"):
                let invalid = tool_schema_validation_error(items_schema)
                if invalid != "": return invalid
            for key in ["anyOf", "oneOf", "allOf"]:
                let composition = json_get(schema, key)
                if fields.contains(key):
                    match composition:
                        JList(alternatives):
                            if alternatives.length == 0: return "JSON Schema `{key}` must not be empty"
                            for alternative in alternatives:
                                let invalid = tool_schema_validation_error(alternative)
                                if invalid != "": return invalid
                        _: return "JSON Schema `{key}` must be an array"
            if fields.contains("not"):
                let invalid = tool_schema_validation_error(json_get(schema, "not"))
                if invalid != "": return invalid
            let enum_value = json_get(schema, "enum")
            if fields.contains("enum"):
                match enum_value:
                    JList(items):
                        if items.length == 0: return "JSON Schema `enum` must not be empty"
                    _: return "JSON Schema `enum` must be an array"
            for key in ["minLength", "maxLength", "minItems", "maxItems", "minProperties", "maxProperties"]:
                let limit = json_get(schema, key)
                if fields.contains(key):
                    match limit:
                        JInt(n):
                            if n < 0: return "JSON Schema `{key}` must not be negative"
                        _: return "JSON Schema `{key}` must be an integer"
            for key in ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum"]:
                let bound = json_get(schema, key)
                if fields.contains(key) and not jv_is_number(bound):
                    return "JSON Schema `{key}` must be a number"
            let unique_items = json_get(schema, "uniqueItems")
            if fields.contains("uniqueItems"):
                match unique_items:
                    JBool(enabled): true
                    _: return "JSON Schema `uniqueItems` must be a boolean"
        _: return "tool function `parameters` must be a JSON Schema object"
    ""

# Structural validation before a request reaches a model-specific Jinja
# template. This keeps malformed or unsupported client input as a stable 400
# instead of surfacing a template exception as a 500.
pub string request_shape_error(JValue body):
    let raw_messages = json_get(body, "messages")
    match raw_messages:
        JList(messages):
            if messages.length == 0:
                return "`messages` is required and must be a non-empty array"
            for message in messages:
                match message:
                    JDict(fields, keys):
                        let role = json_get_str(message, "role", "")
                        if role == "":
                            return "every message must have a non-empty string `role`"
                        if role != "system" and role != "developer" and role != "user" and role != "assistant" and role != "tool":
                            return "message role `{role}` is not supported"
                        if role == "tool" and json_get_str(message, "tool_call_id", "") == "":
                            return "a tool message must have a non-empty string `tool_call_id`"
                        let content = json_get(message, "content")
                        match content:
                            JStr(s): true
                            JUndefined: true
                            JList(parts):
                                for part in parts:
                                    let kind = json_get_str(part, "type", "")
                                    if kind != "text":
                                        return "only text message content parts are supported"
                                    if not jv_is_str(json_get(part, "text")):
                                        return "a text content part must contain a string `text`"
                            _: return "message `content` must be a string, null, or an array of text parts"
                        let raw_calls = json_get(message, "tool_calls")
                        if not request_value_is_undefined(raw_calls):
                            if role != "assistant":
                                return "only assistant messages may contain `tool_calls`"
                            match raw_calls:
                                JList(calls):
                                    if calls.length == 0:
                                        return "message `tool_calls` must not be empty"
                                    var int call_index = 0
                                    while call_index < calls.length:
                                        let call = calls[call_index]
                                        if json_get_str(call, "id", "") == "":
                                            return "every tool call must have a non-empty string `id`"
                                        var int previous_call = 0
                                        while previous_call < call_index:
                                            if json_get_str(calls[previous_call], "id", "") == json_get_str(call, "id", ""):
                                                return "tool call ids must be unique within an assistant message"
                                            previous_call += 1
                                        if json_get_str(call, "type", "") != "function":
                                            return "only function tool calls are supported"
                                        let function = json_get(call, "function")
                                        if json_get_str(function, "name", "") == "":
                                            return "every tool call must have a function name"
                                        let arguments = json_get(function, "arguments")
                                        match arguments:
                                            JStr(s): true
                                            JDict(arg_fields, arg_keys): true
                                            _: return "tool call arguments must be a JSON string or object"
                                        call_index += 1
                                _: return "message `tool_calls` must be an array"
                    _: return "every message must be an object"
        _: return "`messages` is required and must be a non-empty array"

    let raw_tools = json_get(body, "tools")
    if not request_value_is_undefined(raw_tools):
        match raw_tools:
            JList(tools):
                var int tool_index = 0
                while tool_index < tools.length:
                    let tool = tools[tool_index]
                    if json_get_str(tool, "type", "") != "function":
                        return "only function tools are supported"
                    let function = json_get(tool, "function")
                    let function_name = json_get_str(function, "name", "")
                    if function_name == "":
                        return "every tool must have a non-empty function name"
                    var int previous_tool = 0
                    while previous_tool < tool_index:
                        if json_get_str(json_get(tools[previous_tool], "function"), "name", "") == function_name:
                            return "tool function names must be unique"
                        previous_tool += 1
                    let parameters = json_get(function, "parameters")
                    if not request_value_is_undefined(parameters):
                        let invalid_schema = tool_schema_validation_error(parameters)
                        if invalid_schema != "":
                            return invalid_schema
                    tool_index += 1
            _: return "`tools` must be an array"
    ""

# ── Generated text -> content + tool calls ───────────────────────────────

pub struct ParsedToolCall:
    string name
    string arguments   # JSON text, as OpenAI's `function.arguments` wants it

pub struct ParsedReply:
    string content
    [ParsedToolCall] calls

# The balanced `{...}` object that starts at `cs[start]` (string-aware: braces
# inside a JSON string, and escaped quotes, do not count), or "" when it never
# closes.
string balanced_object([string] cs, int start):
    var int depth = 0
    var bool in_str = false
    var bool esc = false
    var int i = start
    while i < cs.length:
        let ch = cs[i]
        if in_str:
            if esc:
                esc = false
            elif ch == "\\":
                esc = true
            elif ch == "\"":
                in_str = false
        else:
            if ch == "\"":
                in_str = true
            elif ch == "{{":
                depth += 1
            elif ch == "}}":
                depth -= 1
                if depth == 0:
                    var out = ""
                    var j = start
                    while j <= i:
                        out = "{out}{cs[j]}"
                        j += 1
                    return out
        i += 1
    ""

# Parses one `<tool_call>` body. A strict parse first. Qwen2.5's GGUF-embedded
# chat template renders its own format example with DOUBLED braces (`{{"name":
# ..., "arguments": ...}}` — real jinja2 does too, it is the template text, not
# our renderer), and a small model copies that faithfully (llama.cpp's own
# output for the same prompt is identical) — and, under a long prompt such as
# OpenCode's, often gets the closing braces wrong: `{{"name": ..., "arguments":
# {...}}` (one closing short) or `{{...}}}}` (one too many). So when the strict
# parse fails, take the balanced object starting at each of the first few `{`
# and keep the first one that is an object with a `name` (a legitimate nested
# `}}` inside the object is never touched, and trailing junk is ignored).
JValue? parse_tool_body(string body):
    let direct = try? json_parse(body)
    if let v = direct:
        return v
    let cs = body.chars()
    var int tried = 0
    var int i = 0
    while i < cs.length and tried < 3:
        if cs[i] == "{{":
            tried += 1
            let candidate = balanced_object(cs, i)
            if candidate != "":
                let parsed = try? json_parse(candidate)
                if let v = parsed:
                    if json_get_str(v, "name", "") != "":
                        return v
        i += 1
    nil

# Hermes-style: `<tool_call>\n{"name": "...", "arguments": {...}}\n</tool_call>`
# (zero or more, optionally preceded by plain text). A block whose body isn't
# valid JSON with a `name` is left in `content` verbatim rather than dropped.
pub ParsedReply parse_reply(string text):
    let parts = text.split("<tool_call>")
    var string content = parts[0].trim()
    mut [ParsedToolCall] calls = []
    var int i = 1
    while i < parts.length:
        let seg = parts[i].split("</tool_call>")
        let parsed = parse_tool_body(seg[0].trim())
        var bool ok = false
        if seg.length > 1:
            if let v = parsed:
                let name = json_get_str(v, "name", "")
                if name != "":
                    let args = json_get(v, "arguments")
                    let args_text = if jv_is_str(args): json_get_str(v, "arguments", "") else: jv_to_json(args)
                    calls.push(ParsedToolCall(name, args_text))
                    ok = true
        if not ok:
            content = "{content}<tool_call>{parts[i]}"
        i += 1
    ParsedReply(content, calls)

# `"tool_choice": "none"`: the model must not call tools, so the tool
# definitions are left out of the prompt and `<tool_call>` text in the reply is
# plain content. Other values ("auto", "required", a named function) are
# accepted; they are not enforced (that needs constrained decoding), the
# model decides as with "auto".
pub bool tools_disabled(JValue body):
    json_get_str(body, "tool_choice", "") == "none"

pub string named_tool_choice(JValue body):
    let choice = json_get(body, "tool_choice")
    match choice:
        JDict(fields, keys): json_get_str(json_get(choice, "function"), "name", "")
        _: ""

# Validates tool_choice and returns the tool list that should reach the chat
# template.  A named choice exposes only that function to the model; `none`
# exposes none. `required` still needs constrained decoding to guarantee that
# the model emits a call, but unlike the former behavior it is validated.
pub string tool_choice_validation_error(JValue body, [JValue] tools):
    let choice = json_get(body, "tool_choice")
    if request_value_is_undefined(choice):
        return ""
    match choice:
        JStr(s):
            if s != "none" and s != "auto" and s != "required":
                return "`tool_choice` must be `none`, `auto`, `required`, or a named function"
            if s == "required" and tools.length == 0:
                return "`tool_choice` is `required` but no tools were provided"
        JDict(fields, keys):
            let name = named_tool_choice(body)
            if json_get_str(choice, "type", "") != "function" or name == "":
                return "a named `tool_choice` must contain `type: function` and `function.name`"
            var bool found = false
            for tool in tools:
                if json_get_str(json_get(tool, "function"), "name", "") == name:
                    found = true
            if not found:
                return "named `tool_choice` function `{name}` was not provided in `tools`"
        _:
            return "`tool_choice` must be a string or a named function"
    ""

pub [JValue] tools_for_request(JValue body, [JValue] tools):
    if tools_disabled(body):
        return []
    let name = named_tool_choice(body)
    if name == "":
        return tools
    mut [JValue] out = []
    for tool in tools:
        if json_get_str(json_get(tool, "function"), "name", "") == name:
            out.push(tool)
    out

bool tool_choice_required(JValue body):
    json_get_str(body, "tool_choice", "") == "required" or named_tool_choice(body) != ""

string sole_tool_name([JValue] tools):
    if tools.length == 1:
        json_get_str(json_get(tools[0], "function"), "name", "")
    else:
        ""

bool schema_type_matches(string kind, JValue value):
    if kind == "object":
        match value:
            JDict(fields, keys): true
            _: false
    elif kind == "array":
        match value:
            JList(items): true
            _: false
    elif kind == "string":
        jv_is_str(value)
    elif kind == "integer":
        match value:
            JInt(n): true
            # JSON Schema classifies numbers mathematically rather than by
            # their JSON spelling, so 1.0 is an integer but 1.5 is not.
            JFloat(f): floor(f) as float == f
            _: false
    elif kind == "number":
        jv_is_number(value)
    elif kind == "boolean":
        match value:
            JBool(b): true
            _: false
    elif kind == "null":
        request_value_is_undefined(value)
    else:
        true

bool json_object_has_key(JValue value, string key):
    match value:
        JDict(fields, keys): fields.contains(key)
        _: false

# The JSON Schema subset used by OpenCode tool definitions. Unknown schema
# keywords remain permissive; recognized constraints must match.
pub bool tool_schema_matches(JValue schema, JValue value):
    let kind = json_get_str(schema, "type", "")
    if kind != "" and not schema_type_matches(kind, value):
        return false
    let type_choices = json_get_list(schema, "type")
    if type_choices.length > 0:
        var bool type_ok = false
        for choice in type_choices:
            match choice:
                JStr(name):
                    if schema_type_matches(name, value):
                        type_ok = true
                _: true
        if not type_ok:
            return false

    let has_const = json_object_has_key(schema, "const")
    let const_value = json_get(schema, "const")
    if has_const and not json_values_equal(const_value, value):
        return false

    let any_of = json_get_list(schema, "anyOf")
    if any_of.length > 0:
        var bool any_ok = false
        for alternative in any_of:
            if tool_schema_matches(alternative, value):
                any_ok = true
        if not any_ok:
            return false
    let one_of = json_get_list(schema, "oneOf")
    if one_of.length > 0:
        var int matches = 0
        for alternative in one_of:
            if tool_schema_matches(alternative, value):
                matches += 1
        if matches != 1:
            return false
    for constraint in json_get_list(schema, "allOf"):
        if not tool_schema_matches(constraint, value):
            return false
    if json_object_has_key(schema, "not") and tool_schema_matches(json_get(schema, "not"), value):
        return false

    let enums = json_get_list(schema, "enum")
    if enums.length > 0:
        var bool found = false
        for item in enums:
            if json_values_equal(item, value):
                found = true
        if not found:
            return false

    match value:
        JDict(fields, keys):
            let min_properties = json_get_int(schema, "minProperties", -1)
            let max_properties = json_get_int(schema, "maxProperties", -1)
            if min_properties >= 0 and keys.length < min_properties:
                return false
            if max_properties >= 0 and keys.length > max_properties:
                return false
            for required in json_get_list(schema, "required"):
                match required:
                    JStr(name):
                        if not fields.contains(name):
                            return false
                    _: return false
            let properties = json_get(schema, "properties")
            let additional = json_get(schema, "additionalProperties")
            match properties:
                JDict(prop_fields, prop_keys):
                    for key in prop_keys:
                        if fields.contains(key):
                            let child_schema = prop_fields[key] else JValue.JUndefined
                            let child_value = fields[key] else JValue.JUndefined
                            if not tool_schema_matches(child_schema, child_value):
                                return false
                    for key in keys:
                        if not prop_fields.contains(key):
                            let child_value = fields[key] else JValue.JUndefined
                            match additional.clone():
                                JBool(allowed):
                                    if not allowed:
                                        return false
                                JDict(extra_fields, extra_keys):
                                    if not tool_schema_matches(additional, child_value):
                                        return false
                                _: true
                _:
                    for key in keys:
                        let child_value = fields[key] else JValue.JUndefined
                        match additional.clone():
                            JBool(allowed):
                                if not allowed:
                                    return false
                            JDict(extra_fields, extra_keys):
                                if not tool_schema_matches(additional, child_value):
                                    return false
                            _: true
        JList(items):
            let min_items = json_get_int(schema, "minItems", -1)
            let max_items = json_get_int(schema, "maxItems", -1)
            if min_items >= 0 and items.length < min_items:
                return false
            if max_items >= 0 and items.length > max_items:
                return false
            if json_get_bool(schema, "uniqueItems", false):
                var int item_index = 0
                while item_index < items.length:
                    var int previous_item = 0
                    while previous_item < item_index:
                        if json_values_equal(items[previous_item], items[item_index]):
                            return false
                        previous_item += 1
                    item_index += 1
            let item_schema = json_get(schema, "items")
            if not request_value_is_undefined(item_schema):
                for item in items:
                    if not tool_schema_matches(item_schema, item):
                        return false
        JStr(text):
            let n = text.chars().length
            let min_length = json_get_int(schema, "minLength", -1)
            let max_length = json_get_int(schema, "maxLength", -1)
            if min_length >= 0 and n < min_length:
                return false
            if max_length >= 0 and n > max_length:
                return false
        JInt(n):
            let value_n = n as float
            let minimum = json_get_float(schema, "minimum", value_n)
            let maximum = json_get_float(schema, "maximum", value_n)
            if value_n < minimum or value_n > maximum:
                return false
            if json_object_has_key(schema, "exclusiveMinimum") and value_n <= json_get_float(schema, "exclusiveMinimum", value_n):
                return false
            if json_object_has_key(schema, "exclusiveMaximum") and value_n >= json_get_float(schema, "exclusiveMaximum", value_n):
                return false
        JFloat(f):
            let minimum = json_get_float(schema, "minimum", f)
            let maximum = json_get_float(schema, "maximum", f)
            if f < minimum or f > maximum:
                return false
            if json_object_has_key(schema, "exclusiveMinimum") and f <= json_get_float(schema, "exclusiveMinimum", f):
                return false
            if json_object_has_key(schema, "exclusiveMaximum") and f >= json_get_float(schema, "exclusiveMaximum", f):
                return false
        _: true
    true

bool tool_call_matches(ParsedToolCall call, [JValue] tools):
    var JValue schema = JValue.JUndefined
    var bool found = false
    for tool in tools:
        let function = json_get(tool, "function")
        if json_get_str(function, "name", "") == call.name:
            found = true
            schema = json_get(function, "parameters")
    if not found:
        return false
    let parsed = try? json_parse(call.arguments)
    guard let arguments = parsed else return false
    if request_value_is_undefined(schema): true else: tool_schema_matches(schema, arguments)

bool tool_calls_match([ParsedToolCall] calls, [JValue] tools):
    for call in calls:
        if not tool_call_matches(call, tools):
            return false
    true

# Small models sometimes omit the Hermes wrapper around an otherwise valid
# call. Under an explicit required/named choice, recognize a bare
# `{name, arguments}` object. With one allowed tool, a bare arguments object
# is unambiguous. A named choice also canonicalizes the function name because
# it was the only function exposed to the chat template.
pub ParsedReply parse_reply_for_tools(string text, JValue body, [JValue] tools):
    let parsed = parse_reply(text)
    let forced = named_tool_choice(body)
    if parsed.calls.length > 0:
        mut [ParsedToolCall] calls = []
        for call in parsed.calls:
            let name = if forced == "": call.name else: forced
            calls.push(ParsedToolCall(name, call.arguments))
        if tool_calls_match(calls, tools):
            return ParsedReply(parsed.content, calls)
        return ParsedReply(text.trim(), [])
    if not tool_choice_required(body):
        return parsed

    let bare = try? json_parse(text.trim())
    guard let value = bare else return parsed
    match value:
        JDict(fields, keys):
            var string name = json_get_str(value, "name", "")
            let args = json_get(value, "arguments")
            var string arguments = ""
            if name != "":
                arguments = if jv_is_str(args): json_get_str(value, "arguments", "") else: jv_to_json(args)
            else:
                name = if forced != "": forced else: sole_tool_name(tools)
                arguments = jv_to_json(value)
            if forced != "":
                name = forced
            if name != "":
                let calls = [ParsedToolCall(name, arguments)]
                if tool_calls_match(calls, tools):
                    return ParsedReply("", calls)
        _:
            return parsed
    parsed

# Validates the generation fields consumed by server.br.  Returning one stable
# message (rather than silently substituting a default) makes malformed client
# requests fail like llama-server/OpenAI requests do.  Unknown fields remain
# allowed for forward compatibility.
pub string request_validation_error(JValue body):
    let model = json_get(body, "model")
    if not request_value_is_undefined(model):
        match model:
            JStr(name):
                if name == "":
                    return "`model` must be a non-empty string"
            _: return "`model` must be a non-empty string"

    let n_choices = json_get(body, "n")
    if not request_value_is_undefined(n_choices):
        match n_choices:
            JInt(n):
                if n != 1:
                    return "`n` must be 1; multiple choices are not supported"
            _:
                return "`n` must be an integer"

    let mt = json_get(body, "max_tokens")
    if not request_value_is_undefined(mt):
        match mt:
            JInt(n):
                if n <= 0:
                    return "`max_tokens` must be greater than 0"
            _:
                return "`max_tokens` must be an integer"
    let mct = json_get(body, "max_completion_tokens")
    if not request_value_is_undefined(mct):
        match mct:
            JInt(n):
                if n <= 0:
                    return "`max_completion_tokens` must be greater than 0"
            _:
                return "`max_completion_tokens` must be an integer"
    let np = json_get(body, "n_predict")
    if not request_value_is_undefined(np):
        match np:
            JInt(n):
                if n < -1:
                    return "`n_predict` must be -1 or greater"
            _:
                return "`n_predict` must be an integer"

    let temp = json_get(body, "temperature")
    if not request_value_is_undefined(temp):
        if not jv_is_number(temp):
            return "`temperature` must be a number"
        let v = json_get_float(body, "temperature", 0.0)
        if v < 0.0 or v > 2.0:
            return "`temperature` must be between 0 and 2"
    let tp = json_get(body, "top_p")
    if not request_value_is_undefined(tp):
        if not jv_is_number(tp):
            return "`top_p` must be a number"
        let v = json_get_float(body, "top_p", 1.0)
        if v <= 0.0 or v > 1.0:
            return "`top_p` must be greater than 0 and at most 1"
    let mp = json_get(body, "min_p")
    if not request_value_is_undefined(mp):
        if not jv_is_number(mp):
            return "`min_p` must be a number"
        let v = json_get_float(body, "min_p", 0.0)
        if v < 0.0 or v > 1.0:
            return "`min_p` must be between 0 and 1"
    let tk = json_get(body, "top_k")
    if not request_value_is_undefined(tk):
        match tk:
            JInt(n):
                if n < 0:
                    return "`top_k` must not be negative"
            _:
                return "`top_k` must be an integer"
    let seed = json_get(body, "seed")
    if not request_value_is_undefined(seed):
        match seed:
            JInt(n): true
            _: return "`seed` must be an integer"

    for key in ["frequency_penalty", "presence_penalty"]:
        let p = json_get(body, key)
        if not request_value_is_undefined(p):
            if not jv_is_number(p):
                return "`{key}` must be a number"
            let v = json_get_float(body, key, 0.0)
            if v < -2.0 or v > 2.0:
                return "`{key}` must be between -2 and 2"
    let rp = json_get(body, "repeat_penalty")
    if not request_value_is_undefined(rp):
        if not jv_is_number(rp):
            return "`repeat_penalty` must be a number"
        if json_get_float(body, "repeat_penalty", 1.0) <= 0.0:
            return "`repeat_penalty` must be greater than 0"

    let stream_value = json_get(body, "stream")
    if not request_value_is_undefined(stream_value):
        match stream_value:
            JBool(b): true
            _: return "`stream` must be a boolean"
    let stream_options = json_get(body, "stream_options")
    if not request_value_is_undefined(stream_options):
        match stream_options:
            JDict(fields, keys):
                let include_usage = json_get(stream_options, "include_usage")
                if not request_value_is_undefined(include_usage):
                    match include_usage:
                        JBool(b): true
                        _: return "`stream_options.include_usage` must be a boolean"
            _: return "`stream_options` must be an object"

    let stop = json_get(body, "stop")
    if not request_value_is_undefined(stop):
        match stop:
            JStr(s): true
            JList(items):
                for item in items:
                    if not jv_is_str(item):
                        return "`stop` must contain only strings"
            _: return "`stop` must be a string or an array of strings"

    let kwargs = json_get(body, "chat_template_kwargs")
    if not request_value_is_undefined(kwargs):
        match kwargs:
            JDict(fields, keys): true
            _: return "`chat_template_kwargs` must be an object"
    let reasoning_effort = json_get(body, "reasoning_effort")
    if not request_value_is_undefined(reasoning_effort) and not jv_is_str(reasoning_effort):
        return "`reasoning_effort` must be a string"
    let parallel_tool_calls = json_get(body, "parallel_tool_calls")
    if not request_value_is_undefined(parallel_tool_calls):
        match parallel_tool_calls:
            JBool(enabled): true
            _: return "`parallel_tool_calls` must be a boolean"
    let response_format = json_get(body, "response_format")
    if not request_value_is_undefined(response_format):
        match response_format:
            JDict(fields, keys):
                let format_type = json_get_str(response_format, "type", "")
                if format_type == "":
                    return "`response_format.type` is required and must be a string"
                if format_type != "text" and format_type != "json_object":
                    return "`response_format.type` `{format_type}` requires constrained decoding, which is not supported"
            _: return "`response_format` must be an object"
    let logprobs = json_get(body, "logprobs")
    if not request_value_is_undefined(logprobs):
        match logprobs:
            JBool(enabled):
                if enabled:
                    return "requested `logprobs` are not supported"
            JInt(count):
                if count != 0:
                    return "requested `logprobs` are not supported"
            _: return "`logprobs` must be a boolean or integer"
    let top_logprobs = json_get(body, "top_logprobs")
    if not request_value_is_undefined(top_logprobs):
        match top_logprobs:
            JInt(count):
                if count != 0:
                    return "requested `top_logprobs` are not supported"
            _: return "`top_logprobs` must be an integer"
    let logit_bias = json_get(body, "logit_bias")
    if not request_value_is_undefined(logit_bias):
        match logit_bias:
            JDict(fields, keys):
                for key in keys:
                    guard let token = (key as int) else return "`logit_bias` keys must be token IDs"
                    if token < 0:
                        return "`logit_bias` keys must be non-negative token IDs"
                    let value = fields[key] else JValue.JUndefined
                    if not jv_is_number(value):
                        return "`logit_bias` values must be numbers"
                    let bias = match value:
                        JInt(n): n as float
                        JFloat(f): f
                        _: 0.0
                    if bias < -100.0 or bias > 100.0:
                        return "`logit_bias` values must be between -100 and 100"
            _: return "`logit_bias` must be an object"
    ""

# Truncates `text` at the earliest occurrence of any non-empty stop string.
pub (string, bool) apply_stop(string text, [string] stops):
    var string out = text
    var bool stopped = false
    for s in stops:
        if s != "" and out.contains(s):
            out = out.split(s)[0]
            stopped = true
    (out, stopped)

# ── Response bodies ──────────────────────────────────────────────────────

string tool_calls_json(string id, [ParsedToolCall] calls, bool with_index):
    var string out = "["
    var int i = 0
    while i < calls.length:
        if i > 0:
            out = "{out}, "
        let idx = if with_index: "\"index\": {i}, " else: ""
        out = "{out}{{{idx}\"id\": \"call_{id}_{i}\", \"type\": \"function\", \"function\": {{\"name\": \"{json_escape(calls[i].name)}\", \"arguments\": \"{json_escape(calls[i].arguments)}\"}}}}"
        i += 1
    "{out}]"

string usage_json(int prompt_tokens, int completion_tokens):
    "{{\"prompt_tokens\": {prompt_tokens}, \"completion_tokens\": {completion_tokens}, \"total_tokens\": {prompt_tokens + completion_tokens}}}"

pub string error_json(string message, string kind, string code):
    "{{\"error\": {{\"message\": \"{json_escape(message)}\", \"type\": \"{kind}\", \"code\": \"{code}\"}}}}"

# The 400 for a prompt that does not fit the context (`--ctx-size`). Clients
# detect an overflow from the error code (OpenAI's `context_length_exceeded`)
# or from phrases in the message ("maximum context length", llama.cpp's
# "exceeds the available context size"), so the message carries both, and the
# counts are also given as fields (like llama.cpp's `n_prompt_tokens`, `n_ctx`).
pub string context_exceeded_json(int n_prompt, int n_ctx):
    let message = "This model's maximum context length is {n_ctx} tokens. The request exceeds the available context size: your messages resulted in {n_prompt} tokens (the reply needs room too). Shorten the conversation or start the server with a larger --ctx-size."
    "{{\"error\": {{\"message\": \"{json_escape(message)}\", \"type\": \"invalid_request_error\", \"code\": \"context_length_exceeded\", \"param\": \"messages\", \"n_prompt_tokens\": {n_prompt}, \"n_ctx\": {n_ctx}}}}}"

pub string models_json(string model_id):
    "{{\"object\": \"list\", \"data\": [{{\"id\": \"{json_escape(model_id)}\", \"object\": \"model\", \"created\": 0, \"owned_by\": \"boring-llm\"}}]}}"

pub string model_json_meta(string model_id, int vocab_type, int n_vocab, int n_ctx,
                           int n_ctx_train, int n_embd, int n_params, int size):
    "{{\"id\": \"{json_escape(model_id)}\", \"aliases\": [\"{json_escape(model_id)}\"], \"tags\": [], \"object\": \"model\", \"created\": 0, \"owned_by\": \"boring-llm\", \"meta\": {{\"vocab_type\": {vocab_type}, \"n_vocab\": {n_vocab}, \"n_ctx\": {n_ctx}, \"n_ctx_train\": {n_ctx_train}, \"n_embd\": {n_embd}, \"n_params\": {n_params}, \"size\": {size}}}}}"

# llama-server exposes these GGUF/model facts in a non-standard `meta` object.
# They are useful to clients which choose a context window or sanity-check the
# loaded model, while the surrounding response remains OpenAI-compatible.
pub string models_json_meta(string model_id, int vocab_type, int n_vocab, int n_ctx,
                            int n_ctx_train, int n_embd, int n_params, int size):
    "{{\"object\": \"list\", \"data\": [{model_json_meta(model_id, vocab_type, n_vocab, n_ctx, n_ctx_train, n_embd, n_params, size)}]}}"

pub string input_tokens_json(int input_tokens):
    "{{\"object\": \"response.input_tokens\", \"input_tokens\": {input_tokens}}}"

pub string tokens_json([int] tokens):
    var string out = "["
    var int i = 0
    while i < tokens.length:
        if i > 0:
            out = "{out}, "
        out = "{out}{tokens[i]}"
        i += 1
    "{{\"tokens\": {out}]}}"

pub string content_json(string content):
    "{{\"content\": \"{json_escape(content)}\"}}"

pub string prompt_json(string prompt):
    "{{\"prompt\": \"{json_escape(prompt)}\"}}"

pub string props_json(string model_path, string chat_template, int n_ctx, int max_tokens,
                         float32 temperature, int top_k, float32 top_p, float32 min_p, int seed,
                         float32 repeat_penalty, int repeat_last_n):
    "{{\"default_generation_settings\": {{\"n_ctx\": {n_ctx}, \"params\": {{\"n_predict\": {max_tokens}, \"seed\": {seed}, \"temperature\": {temperature}, \"top_k\": {top_k}, \"top_p\": {top_p}, \"min_p\": {min_p}, \"repeat_penalty\": {repeat_penalty}, \"repeat_last_n\": {repeat_last_n}}}}}, \"total_slots\": 1, \"model_path\": \"{json_escape(model_path)}\", \"chat_template\": \"{json_escape(chat_template)}\", \"chat_template_caps\": {{\"supports_tools\": true}}, \"modalities\": {{\"vision\": false}}, \"is_sleeping\": false}}"

pub string completion_json(string id, string model, ParsedReply reply, string finish_reason,
                            int prompt_tokens, int completion_tokens):
    completion_json_r(id, model, reply, "", finish_reason, prompt_tokens, completion_tokens)

# The same with `reasoning`, the model's `<think>` text (Qwen3 and other
# reasoning models), returned as `message.reasoning_content` like llama.cpp and
# DeepSeek's API do, when there is any.
pub string completion_json_r(string id, string model, ParsedReply reply, string reasoning, string finish_reason,
                              int prompt_tokens, int completion_tokens):
    let content = if reply.content == "" and reply.calls.length > 0: "null" else: "\"{json_escape(reply.content)}\""
    let thinking = if reasoning != "": ", \"reasoning_content\": \"{json_escape(reasoning)}\"" else: ""
    let calls = if reply.calls.length > 0: ", \"tool_calls\": {tool_calls_json(id, reply.calls, false)}" else: ""
    "{{\"id\": \"chatcmpl-{id}\", \"object\": \"chat.completion\", \"created\": 0, \"model\": \"{json_escape(model)}\", \"choices\": [{{\"index\": 0, \"message\": {{\"role\": \"assistant\", \"content\": {content}{thinking}{calls}}}, \"finish_reason\": \"{finish_reason}\"}}], \"usage\": {usage_json(prompt_tokens, completion_tokens)}}}"

pub string text_completion_json(string id, string model, string content, string finish_reason,
                                int prompt_tokens, int completion_tokens):
    "{{\"id\": \"cmpl-{id}\", \"object\": \"text_completion\", \"created\": 0, \"model\": \"{json_escape(model)}\", \"choices\": [{{\"text\": \"{json_escape(content)}\", \"index\": 0, \"logprobs\": null, \"finish_reason\": \"{finish_reason}\"}}], \"usage\": {usage_json(prompt_tokens, completion_tokens)}}}"

string sse_chunk(string id, string model, string delta, string finish_reason):
    let fr = if finish_reason == "": "null" else: "\"{finish_reason}\""
    "data: {{\"id\": \"chatcmpl-{id}\", \"object\": \"chat.completion.chunk\", \"created\": 0, \"model\": \"{json_escape(model)}\", \"choices\": [{{\"index\": 0, \"delta\": {delta}, \"finish_reason\": {fr}}}]}}\n\n"

# ── SSE events ───────────────────────────────────────────────────────────
# One function per event so the server can write them as tokens arrive;
# completion_sse (below) composes the same events into a complete body.

pub string sse_role_event(string id, string model):
    sse_chunk(id, model, "{{\"role\": \"assistant\", \"content\": \"\"}}", "")

pub string sse_content_event(string id, string model, string text):
    sse_chunk(id, model, "{{\"content\": \"{json_escape(text)}\"}}", "")

pub string sse_reasoning_event(string id, string model, string text):
    sse_chunk(id, model, "{{\"reasoning_content\": \"{json_escape(text)}\"}}", "")

pub string sse_tool_calls_event(string id, string model, [ParsedToolCall] calls):
    sse_chunk(id, model, "{{\"tool_calls\": {tool_calls_json(id, calls, true)}}}", "")

pub string sse_finish_event(string id, string model, string finish_reason):
    sse_chunk(id, model, "{{}}", finish_reason)

pub string sse_usage_event(string id, string model, int prompt_tokens, int completion_tokens):
    "data: {{\"id\": \"chatcmpl-{id}\", \"object\": \"chat.completion.chunk\", \"created\": 0, \"model\": \"{json_escape(model)}\", \"choices\": [], \"usage\": {usage_json(prompt_tokens, completion_tokens)}}}\n\n"

pub string sse_done_event():
    "data: [DONE]\n\n"

pub string text_completion_sse_event(string id, string model, string text, string finish_reason):
    let fr = if finish_reason == "": "null" else: "\"{finish_reason}\""
    "data: {{\"id\": \"cmpl-{id}\", \"object\": \"text_completion\", \"created\": 0, \"model\": \"{json_escape(model)}\", \"choices\": [{{\"text\": \"{json_escape(text)}\", \"index\": 0, \"logprobs\": null, \"finish_reason\": {fr}}}]}}\n\n"

pub string text_completion_usage_sse_event(string id, string model, int prompt_tokens, int completion_tokens):
    "data: {{\"id\": \"cmpl-{id}\", \"object\": \"text_completion\", \"created\": 0, \"model\": \"{json_escape(model)}\", \"choices\": [], \"usage\": {usage_json(prompt_tokens, completion_tokens)}}}\n\n"

string token_ids_json([int] tokens):
    var string out = "["
    var int i = 0
    while i < tokens.length:
        if i > 0: out = "{out}, "
        out = "{out}{tokens[i]}"
        i += 1
    "{out}]"

pub string native_completion_json(string model, string content, [int] tokens, bool stopped,
                                  string stop_type, int prompt_tokens, int completion_tokens, int cached_tokens):
    let stop_value = if stopped: "true" else: "false"
    "{{\"index\": 0, \"content\": \"{json_escape(content)}\", \"tokens\": {token_ids_json(tokens)}, \"id_slot\": 0, \"stop\": {stop_value}, \"model\": \"{json_escape(model)}\", \"tokens_predicted\": {completion_tokens}, \"tokens_evaluated\": {prompt_tokens}, \"truncated\": false, \"stop_type\": \"{stop_type}\", \"stopping_word\": \"\", \"tokens_cached\": {cached_tokens}}}"

pub string native_completion_sse_event(string content, [int] tokens, bool stopped):
    let stop_value = if stopped: "true" else: "false"
    "data: {{\"index\": 0, \"content\": \"{json_escape(content)}\", \"tokens\": {token_ids_json(tokens)}, \"stop\": {stop_value}}}\n\n"

pub string sse_error_event(string message):
    "data: {{\"error\": {{\"message\": \"{json_escape(message)}\", \"type\": \"server_error\", \"code\": \"internal_error\"}}}}\n\n"

# A complete `stream: true` response body, for a reply that is already
# generated (the server streams the same events token by token instead):
# role chunk, one content chunk, optional tool-call chunk, a finish chunk and
# (when asked via `stream_options.include_usage`) a usage chunk.
pub string completion_sse(string id, string model, ParsedReply reply, string finish_reason,
                           int prompt_tokens, int completion_tokens, bool include_usage):
    var string out = sse_role_event(id, model)
    if reply.content != "":
        out = "{out}{sse_content_event(id, model, reply.content)}"
    if reply.calls.length > 0:
        out = "{out}{sse_tool_calls_event(id, model, reply.calls)}"
    out = "{out}{sse_finish_event(id, model, finish_reason)}"
    if include_usage:
        out = "{out}{sse_usage_event(id, model, prompt_tokens, completion_tokens)}"
    "{out}{sse_done_event()}"

# ── Incremental streaming of the reply text ──────────────────────────────

bool reply_is_space(string ch):
    ch == " " or ch == "\n" or ch == "\t" or ch == "\r"

# How much of the reply generated SO FAR can be sent as content without ever
# having to take it back: the character range [start, limit) of `text`.
# `text` is the visible reply with any stop string already cut off. The range
# is what parse_reply would call `content` for a finished reply — surrounding
# whitespace trimmed, nothing from a `<tool_call>` marker on — except that the
# tail stays held back while it could still grow into `<tool_call>` or into
# one of `stops`. The range only ever extends: `start` stays put once a
# non-whitespace character exists (until then the range is empty), `limit` never
# decreases, so the part already sent is always a prefix of what comes next.
pub (int, int) stream_bounds(string text, [string] stops):
    let cs = text.chars()
    let n = cs.length
    let marker = "<tool_call>".chars()
    var int limit = n
    var int found = -1
    var int i = 0
    while i + marker.length <= n and found < 0:
        var bool ok = true
        var int j = 0
        while j < marker.length and ok:
            if cs[i + j] != marker[j]:
                ok = false
            j += 1
        if ok:
            found = i
        i += 1
    if found >= 0:
        limit = found
    else:
        mut [[string]] pats = [marker]
        for st in stops:
            if st != "":
                pats.push(st.chars())
        var int hold = 0
        for p in pats:
            var int k = p.length - 1
            if k > n:
                k = n
            while k > hold:
                var bool ok = true
                var int j = 0
                while j < k and ok:
                    if cs[n - k + j] != p[j]:
                        ok = false
                    j += 1
                if ok:
                    hold = k
                k -= 1
        limit = n - hold
    var int start = 0
    while start < limit and reply_is_space(cs[start]):
        start += 1
    while limit > start and reply_is_space(cs[limit - 1]):
        limit -= 1
    (start, limit)

# Raw completions preserve leading and trailing whitespace and have no tool-call
# envelope. Only hold back a suffix that may still become a configured stop.
pub int text_stream_limit(string text, [string] stops):
    let cs = text.chars()
    let n = cs.length
    var int hold = 0
    for st in stops:
        if st != "":
            let p = st.chars()
            var int k = p.length - 1
            if k > n:
                k = n
            while k > hold:
                var bool ok = true
                var int j = 0
                while j < k and ok:
                    if cs[n - k + j] != p[j]:
                        ok = false
                    j += 1
                if ok:
                    hold = k
                k -= 1
    n - hold


# ── Reasoning (`<think>...</think>`) ─────────────────────────────────────
# Qwen3 (thinking mode) writes `<think>`, its reasoning, `</think>`, then the
# answer. Clients get the reasoning as `reasoning_content` and the answer as
# `content`, so the raw markers never show up in a chat window or in the
# next request's history.

string join_from([string] parts, int from, string sep):
    var string out = ""
    var int i = from
    while i < parts.length:
        out = if i == from: parts[i] else: "{out}{sep}{parts[i]}"
        i += 1
    out

# Python's `str.strip('\n')`, on either side.
string trim_nl(string s, bool left, bool right):
    let cs = s.chars()
    var int a = 0
    var int b = cs.length
    if left:
        while a < b and cs[a] == "\n":
            a += 1
    if right:
        while b > a and cs[b - 1] == "\n":
            b -= 1
    var string out = ""
    var int i = a
    while i < b:
        out = "{out}{cs[i]}"
        i += 1
    out

# (starts with `<think>`, has its `</think>`, the text after `<think>` up to
# `</think>`, the text after `</think>`); an unterminated block has all its text
# in the third part. Text that does not start with `<think>` (leading whitespace
# aside) has no reasoning.
(bool, bool, string, string) think_parts(string text):
    let head = text.trim()
    if not head.startsWith("<think>"):
        return (false, false, "", text)
    let after = join_from(head.split("<think>"), 1, "<think>")
    let closed = after.split("</think>")
    if closed.length >= 2:
        (true, true, closed[0], join_from(closed, 1, "</think>"))
    else:
        (true, false, after, "")

# A finished reply: (reasoning, the rest). Whitespace newlines around the
# reasoning and before the answer are dropped, as Qwen3's own template does.
pub (string, string) split_reasoning(string text):
    let (has, closed, r, c) = think_parts(text)
    if not has:
        ("", text)
    elif closed:
        (trim_nl(r, true, true), trim_nl(c, true, false))
    else:
        (trim_nl(r, true, true), "")

# `r` without a trailing piece that could still grow into `</think>`.
string without_partial_close(string r):
    let cs = r.chars()
    let marker = "</think>".chars()
    let n = cs.length
    var int hold = 0
    var int k = marker.length - 1
    if k > n:
        k = n
    while k > 0 and hold == 0:
        var bool ok = true
        var int j = 0
        while j < k and ok:
            if cs[n - k + j] != marker[j]:
                ok = false
            j += 1
        if ok:
            hold = k
        k -= 1
    var string out = ""
    var int i = 0
    while i < n - hold:
        out = "{out}{cs[i]}"
        i += 1
    out

# The reply generated SO FAR: (reasoning, content) that can be sent without ever
# being taken back. Both only grow: the reasoning holds back a trailing
# newline run and a piece that could become `</think>`, and nothing is sent
# while the text so far is still only the start of `<think>`.
pub (string, string) stream_split(string text):
    let head = text.trim()
    if head.length > 0 and head.length < 7 and "<think>".startsWith(head):
        return ("", "")
    let (has, closed, r, c) = think_parts(text)
    if not has:
        ("", text)
    elif closed:
        (trim_nl(r, true, true), trim_nl(c, true, false))
    else:
        (trim_nl(without_partial_close(r), true, true), "")

# The characters of `s` from index `from` on.
pub string chars_from(string s, int from):
    let cs = s.chars()
    var string out = ""
    var int i = from
    while i < cs.length:
        out = "{out}{cs[i]}"
        i += 1
    out
